lib test

// TODO: test anonymous structs

fn main() {
    var has_error = false

    if test_cast_int() {
        has_error = true
    }
    if test_cast_float() {
        has_error = true
    }
    if test_cast_array() {
        has_error = true
    }
    if test_cast_struct() {
        has_error = true
    }
    if test_cast_string() {
        has_error = true
    }

    if has_error {
        exit(1)
    }
    exit(0)
}

fn test_cast_int() bool {
    var has_error = false

    if u8(255) != 255 {
        has_error = true
        print_error("expected u8(255) != 255")
    }
    if u8(3) != u8(3) {
        has_error = true
        print_error("expected u8(3) != u8(3)")
    } 
    
    return has_error
}

fn test_cast_float() bool {
    var has_error = false

    if f32(1.5) != 1.5 {
        has_error = true
        print_error("expected f32 cast to equal literal")
    }
    if f64(341.409) != 341.409 {
        has_error = true
        print_error("expected f64 cast to equal literal")
    }

    return has_error
}

type custom_a []bool
type custom_b []bool

fn test_cast_array() bool {
    var has_error = false

    let x = custom_a([true, false])
    let y = custom_b(x)

    if x[0] != true {
        has_error = true
        print_error("expected x[0] == true")
    }
    if x[1] != false {
        has_error = true
        print_error("expected x[1] == false")
    }
    if x[0] != y[0] {
        has_error = true
        print_error("expected x[0] == y[0]")
    }
    if x[1] != y[1] {
        has_error = true
        print_error("expected x[1] == y[1]")
    }

    return false
}

struct struct_a {
    a i64
    b string
}
struct struct_b {
    a i64
    b string
}

fn test_cast_struct() bool {
    var has_error = false

    let x = struct_a{b: "hejsan", a: 11}
    let y = struct_b(x)

    if x.a != y.a {
        has_error = true
        print_error("expected x.a == y.a")
    }
    if x.b != y.b {
        has_error = true
        print_error("expected x.b == y.b")
    }

    return has_error
}

fn test_cast_string() bool {
    var has_error = false

    let s = "hello, world!"
    let b = []byte(s)

    if len(s) != len(b) {
        has_error = true
        print_error("expected len(s) == len(b)")
    }
    if s != string(b) {
        has_error = true
        print_error("expected s == string(b)")
    }

    return has_error
}

// ------- //
// Helpers //
// ------- //

let std_out = 1
let std_err = 2

fn print_info(rsn string) {
    let buf = []byte(rsn)
    write(std_out, &buf, len(buf))
}

fn print_error(rsn string) {
    // BUG: add \n does not work as expected
    let buf = []byte(rsn)
    write(std_err, &buf, len(buf))
}

// ---- //
// libc //
// ---- //

@extern(c)
pub fn write(fd i64, buf *[]byte, size i64)

@extern(c)
pub fn exit(c i64)



