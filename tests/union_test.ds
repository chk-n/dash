lib test

// TODO: add nested unions

fn main() {
    var has_error = false

    if test_union_init() {
        has_error = true
    }
    if test_union_param() {
        has_error = true
    }
    if test_union_return() {
        has_error = true
    }
     
    if has_error {
        exit(1)
    }
    exit(0)
}

union union_a {
    i64,
    f64,
    bool,
    byte,
}

fn test_union_init() bool {
    var has_error = false
    
    let v1 = union_a(42)
    let v2 = union_a(3.14)
    let v3 = union_a(true)
    let v4 = union_a(byte(65))
    
    let res1 = match v1 {
        case i64: true
        case _: false
    }
    let res2 = match v2 {
        case i64: false
        case f64: true
        case _: false
    }
    let res3 = match v3 {
        case bool: true
        case byte: false
        case _: false
    }
    let res4 = match v4 {
        case byte: true
        case _: false
    }
    
    if !res1 || !res2 || !res3 || !res4 {
        has_error = true
        print_error("union initialization test failed")
    }
    
    return has_error
}

fn process_union(u union_a) bool {
    let res = match u {
        case i64: true
        case f64: false
        case bool: true
        case byte: false
        case _: false
    }
    return res
}

fn test_union_param() bool {
    var has_error = false
    
    let v1 = union_a(42)
    let v2 = union_a(3.14)
    
    let res1 = process_union(v1)
    let res2 = process_union(v2)
    
    if !res1 || res2 {
        has_error = true
        print_error("union parameter test failed")
    }
    
    return has_error
}

fn create_union(t i64) union_a {
    if t == 0 {
        return union_a(42)
    } else if t == 1 {
        return union_a(3.14)
    } else if t == 2 {
        return union_a(true)
    } else {
        return union_a(byte(65))
    }
    // required as control flow analysis not implemented yet
    return union_a(false)
}

fn test_union_return() bool {
    var has_error = false
    
    let v1 = create_union(0)
    let v2 = create_union(1)
    
    let res1 = match v1 {
        case i64: true
        case _: false
    }
    let res2 = match v2 {
        case f64: true
        case _: false
    }
    
    if !res1 || !res2 {
        has_error = true
        print_error("union return test failed")
    }
    
    return has_error
}

