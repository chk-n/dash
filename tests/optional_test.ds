fn test_optional_in_control_flow() bool {
    var has_error = false
    
    let get_opt = fn(i ?bool) ?bool {
        return i
    }
    
    if  get_opt(null) ?? false {
        has_error = true
        print_error("expected get_opt(null) ?? false == false")
    }
    if  get_opt(true) ?? false != true {
        has_error = true
        print_error("expected get_opt(true) ?? false == true")
    }
    if get_opt(true) != true {
        has_error = true
        print_error("expected get_opt(true) == true")
    }

    return has_error
}

struct opt {
    val ?i64
}
fn test_optional_in_struct() bool {
    var has_error = false
    
    let res = opt{val: null}
    if res.val ?? 10 != 10 {
        has_error = true
        print_error("expected res.val ?? 10 == 10")
    }
    if res.val == 10 {
        has_error = true
        print_error("expected res.val != 10")
    }
    if res.val != 10 {
        // do nothing
    } else {
        has_error = true
        print_error("expected res.val != 10")
    }

    return has_error
}
fn test_force_unwrap_scalar() bool {
    var has_error = false
    
    let get_opt = fn(i ?u8) ?u8 {
        return i
    }

    if ?get_opt(11) != 11 {
        has_error = true
        print_error("expected unwrap of optional == 11")
    }

    return has_error    
}

struct abc {
    s string
}
fn test_force_unwrap_struct() bool {
    var has_error = false

    let get_opt = fn(v ?abc) ?abc {
        return v
    }

    let res' = get_opt(abc{s: "hello"})
    let res = ?res'

    if len(res.s) != 5 {
        has_error = true
        print_error("expected length of str in optional == 5")
    }
    if res.s != "hello" {
        has_error = true
        print_error("expected unwrap of optionao == 'hello'")
    }
    

    return has_error
}

fn test_force_unwrap_pointer() bool {
     var has_error = false

    let get_opt = fn(v ?abc) ?abc {
        return v
    }

    let res' = &(get_opt(abc{s: "world"}))
    let res = ?*res'

    if len(res.s) != 5 {
        has_error = true
        print_error("expected length of str in optional == 5")
    }
    if res.s != "world" {
        has_error = true
        print_error("expected unwrap of optional == 'world'")
    }
    

    return has_error
}
// ------- //
// Helpers //
// ------- //

let std_out = 1
let std_err = 2

fn print_info(rsn string) {
    let buf = []byte(rsn)
    write(std_out, &buf, len(buf))
}

fn print_error(rsn string) {
    let buf = []byte(rsn)
    write(std_err, &buf, len(buf))
}

// -------- //
// OS calls //
// -------- //

@extern(c)
pub fn write(fd i64, buf *[]byte, size i64) i64 

@extern(c)
pub fn exit(c i64)
