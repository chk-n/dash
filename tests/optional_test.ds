lib test

// TODO: test array with optional values and null (requires semsis to be able to infer if null found)
// TODO: test passing optional array (returning array requires heap)

fn main() {
    var has_error = false

    if test_returning_null() {
        has_error = true
    }
    if test_passing_optionals() {
        has_error = true
    }
    if test_arithmetic_with_optionals() {
        has_error = true
    }
    // if test_chained_null_coalescing() {
    //     has_error = true
    // }
    if test_optional_in_control_flow() {
        has_error = true
    }  
    if test_optional_in_struct() {
        has_error = true
    }
    if test_force_unwrap_scalar() {
        has_error = true
    }
    if test_force_unwrap_struct() {
        has_error = true
    }
    if test_force_unwrap_pointer() {
        has_error = true
    }
        
    if has_error {
        exit(1)
    }
    
    exit(0)
}

fn test_returning_null() bool {
    var has_error = false
    
    let null_i64 = fn() ?i64 { return null }
    let null_arr = fn() ?[]f64 { return null }
    let null_str = fn() ?string { return null }

    if null_i64() != null {
        has_error = true
        print_error("expected null_i64() == null")
    }
    if null_arr() != null {
        has_error = true
        print_error("expected null_arr() == null")
    }
    if null_str() != null {
        has_error = true
        print_error("expected null_str() == null")
    }
    if null_i64() == 1 {
        has_error = true
        print_error("expected null_i64() != 1")
    }
    if null_str() == "hey" {
        has_error = true
        print_error("expected null_str() != 'hey'")
    }

    return has_error
}

fn test_passing_optionals() bool {
    var has_error = false
    let optional_i64 = fn(i ?i64) i64 {
        return i ?? 5
    }
    let optional_str = fn(s ?string) string {
        return s ?? "12"
    }
    if optional_i64(null) != 5 {
        has_error = true
        print_error("expected optional_i64(null) == 5")
    }
    if optional_i64(100) != 100 {
        has_error = true
        print_error("expected optional_i64(100) == 100")
    }
    if optional_str(null) != "12" {
        has_error = true
        print_error("expected optional_str(null) == '12'")
    }
    if optional_str("1") != "1" {
        has_error = true
        print_error("expected optional_str('1') == '1'")
    }

    return has_error
}

fn test_arithmetic_with_optionals() bool {
    var has_error = false

    let add = fn(i ?i64) i64 {
        return i ?? 5 + 10
    }
    
    if add(null) != 15 {
        has_error = true
        print_error("expected add(null) == 15")
    }
    if add(10) != 20 {
        has_error = true
        print_error("expected add(10) == 20")
    }

    return has_error
}

