lib test


fn main() {
    var has_error = false

    if test_cmp() {
        has_error = true
    }

    if test_identical_cmp() {
        has_error = true
    }

    if test_concat() {
        has_error = true
    }

    if test_empty() {
        has_error = true
    }
    
    if has_error {
        exit(1)
    }

    exit(0)
}

fn test_cmp() bool {
    var has_error = false
    
    let x = "1"
    let y = "2"
    let x_ref = &x

    if x == y {
        has_error = true
        print_error("expected x != y")
    } 
    if x != "1" {
        has_error = true
        print_error("expected x == '1'")
    }
    if &x == &y {
        has_error = true
        print_error("expected &x != &y")
    }
    if &x != &x {
        has_error = true
        print_error("expected &x == &x")
    }
    if len(x) != 1 {
        has_error = true
        print_error("expected len(x) == 1")
    }
    // BUG: Call parameter type does not match function signature!
    // if *x_ref != "1" {
    //     print_error("expected *x_ref == '1'")
    // }

    return has_error
}

fn test_identical_cmp() bool {
    var has_error = false
    
    let x = "hello"
    let y = "hello"

    let x_ref = &x
    let y_ref = &y

    if x != y {
        has_error = true
        print_error("expected x == y for identical string values")
    } else if x_ref == y_ref {
        has_error = true
        print_error("expected &x != &y for different string instances")
    } else if len(x) != 5 {
        has_error = true
        print_error("expected len(x) == 5")
    } else if len(x) != len(y) {
        has_error = true
        print_error("expected len(x) == len(y)")
    }

    return has_error
}

fn test_concat() bool {
    var has_error = false

    let x = "1" + "2"

    if x != "12" {
        has_error = true
        print_error("expected x == '12'")
    }
    if len(x) != 2 {
        has_error = true
        print_error("expected len(x) == 2")
    }

    // BUG: Instruction does not dominate all uses!
    //    %20 = add i64 %18, %19
    //    %10 = alloca i8, i64 %20, align 1
    // if x != "1" + "2" {
    //     has_error = true
    //     print_error("expected x == '12'")
    // }

    return has_error
}

fn test_empty() bool {
    var has_error = false
    let empty = ""
    let also_empty = ""
    
    if empty != also_empty {
        has_error = true
        print_error("expected empty strings to be equal")
    }
    if len(empty) != 0 {
        has_error = true
        print_error("expected len(empty) == 0")
    }
    // BUG: concat doesnt work within if branch
    // if empty + "x" != "x" {
    //     has_error = true
    //     print_error("expected empty + 'x' == 'x'")
    // }
    return has_error
}

// ------- //
// Helpers //
// ------- //

fn print_error(rsn string) {
    let buf = []byte(rsn+"\n")
    write(std_err, &buf, len(buf))
}

// -- //
// OS //
//--- //

let std_out = 1
let std_err = 2

@extern(c)
pub fn write(fd i64, buf *[]byte, size i64)

@extern(c)
pub fn exit(c i64)



