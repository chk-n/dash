lib main

fn main() {
    var has_error = false

    if test_for_classic() {
        has_error = true
    }
    if test_for_boolean() {
        has_error = true
    }

    if has_error {
        exit(1)
    }
    exit(0)
}

fn test_for_classic() bool {
    var has_error = false

    var x = 10
    for i = 10; i > 0; i-- {
        x = i
    }

    if x != 1 {
        has_error = true
        print_error("expected x == 1")
    }

    return has_error
}

fn test_for_boolean() bool {
    var has_error = false

    var x = 1
    for x < 10 {
        x = x + 1
    }

    if x != 10 {
        has_error = true
        print_error("expected x == 10")
    }

    return has_error
}

