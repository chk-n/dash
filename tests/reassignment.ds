lib main

fn main() {
    var has_error = false

    if test_scalar() {
        has_error = true
    }
    if test_scalar_with_fn() {
        has_error = true
    }
    if test_scalar_with_pointer() {
        has_error = true
    }
    if test_struct() {
        has_error = true
    } 
    if test_struct_with_fn() {
        has_error = true
    } 
    if test_array() {
        has_error = true
    } 
    // if test_string() {
    //     has_error = true
    // } 
    if test_union() {
        has_error = true
    } 
    if test_union_with_fn() {
        has_error = true
    }
    
    if has_error {
        exit(1)
    }
    exit(0)
}

// ------- //
// Scalars //
// ------- //

fn test_scalar() bool {
    var has_error = false

    var i = -1
	for {
		if i > 10 {
			break
		}
		i = i + 1
	}

    if i != 11 {
        has_error = true
        print_error("expected i == 11")
    }
    
    return has_error
}

fn test_scalar_with_fn() bool {
    var has_error = false

    let add = fn(i i64) i64 { return i + 1}
    
    var i = -1
	for {
		if i > 10 {
			break
		}
		i = add(i)
	}

    if i != 11 {
        has_error = true
        print_error("expected i == 11")
    }
    
    return has_error
}

fn test_scalar_with_pointer() bool {
    var has_error = false
     
    var x = 1
    var y = &x
    var z = *y
    
    if x != 1 {
        has_error = true
        print_error("expected x == 1")
    }
    if x != z {
        has_error = true
        print_error("expected x == z")
    }
    if y == &z {
        has_error = true
        print_error("expected y != &z")
    }
    
    return has_error
}

// ------- //
// Structs //
// ------- //

struct abc{
    x i64
}

fn test_struct() bool {
    var has_error = false

    var a = abc{x: 1}
    for { 
        if a.x > 5 { 
            break 
        } 
        a = abc{x: a.x + 1}
    }

    if a.x != 6 {
        has_error = true
        print_error("expected a.x == 6")
    }

    return has_error    
}

fn test_struct_with_fn() bool {
    var has_error = false

    var a = abc{x: 0}
    for {   
        if a.x == 5 { 
            break 
        } 
        a = _get_abc(a) 
    }  

    if a.x != 5 {
        has_error = true
        print_error("expected a.x == 5")
    } 
    return has_error
}

fn _get_abc(s abc) abc { return abc{x: s.x + 1} }

// ------ //
// Arrays // 
// ------ //

fn test_array() bool {
    var has_error = false

    var i = 0
    var a = [3,5,2,8]
    for {
        if i == 1 {
            break
        }
        a = [4,5]
        i++
    }

    if len(a) != 2 {
        has_error = true
        print_error("expected length to be 2")
    } else if a[0] != 4 && a[1] != 5 {
        has_error = true
        print_error("expected contents of 'a' to match")
    }
    
    return has_error
}

