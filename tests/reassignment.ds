// ------ //
// Unions //
// ------ //

union xyz {
    abc
    string
}

fn test_union() bool {
    var has_error = false

    var x = xyz(abc{x: 1})
	for {
		match x' = x {
		case abc:
			if x'.x > 10 {
				break
			}
		    x = xyz(abc{x: x'.x + 1})
		}
	}

    match x' = x {
    case abc:
        if x'.x != 11 {
            has_error = true
            print_error("expected x'.x == 11")
        }
    case _:
        has_error = true
        print_error("expected different block to match")
    }

    return has_error
}

fn test_union_with_fn() bool {
    var has_error = false

    var x = xyz(abc{x: 1})
	for {
		match x' = x {
		case abc:
			if x'.x > 10 {
				break
			}
		}
		x = _get_xyz(x)
	}

    match x' = x {
    case abc:
        if x'.x != 11 {
            has_error = true
            print_error("expected x.x == 11")
        }
    case _:
        has_error = true
        print_error("expected different block to match")
    }

    return has_error
}

fn _get_xyz(x xyz) xyz { 
	return match x { 
		case abc: xyz(abc{x: x.x + 1}) 
        case _: xyz(abc{x: 0}) 	
    } 
}

// ------- //
// Helpers //
// ------- //

let std_out = 1
let std_err = 2

fn print_info(rsn string) {
    let buf = []byte(rsn)
    write(std_out, &buf, len(buf))
}

fn print_error(rsn string) {
    let buf = []byte(rsn+"\n")
    write(std_err, &buf, len(buf))
}

// -------- //
// OS calls //
// -------- //

@extern(c)
pub fn write(fd i64, buf *[]byte, size i64) i64 

@extern(c)
pub fn exit(c i64)
