lib test

fn main() {
    var has_error = false

    if test_pass_function() {
        has_error = true
    }
    if test_pass_anonymous_function() {
        has_error = true
    }

    if has_error {
        exit(1)
    }
    exit(0)
}

fn add(a, b i64) i64 {
    return a + b
}

fn test_pass_function() bool {
    var has_error = false

    let do = fn(f fn(i64, i64)i64) i64 {
        return f(1,2)
    }

    if do(add) != 3 {
        has_error = true
        print_error("expected do(add) == 3")
    }

    return has_error
}

fn test_pass_anonymous_function() bool {
    var has_error = false

    let concat = fn(a, b string) string {
        return a + b
    }   

    let do = fn(l, r string, f fn(string, string)string) string {
        return f(l, r)
    }

    if do("12","12", concat) != "1212" {
        has_error = true
        print_error("expected do(concat) == '1212'")
    }

    return has_error
}

// ------- //
// Helpers //
// ------- //

let std_out = 1
let std_err = 2

fn print_info(rsn string) {
    let buf = []byte(rsn)
    write(std_out, &buf, len(buf))
}

fn print_error(rsn string) {
    let buf = []byte(rsn)
    write(std_err, &buf, len(buf))
}

// -------- //
// OS calls //
// -------- //

@extern(c)
pub fn write(fd i64, buf *[]byte, size i64) i64 

@extern(c)
pub fn exit(c i64)
