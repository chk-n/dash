lib test

// TODO: add returning anonymous struct literal

fn main() {
    var has_error = false

    if test_return_one() {
        has_error = true
    } 
    if test_return_pointer() {
        has_error = true
    }
    if test_return_multi() {
        has_error = true
    }
    if test_return_fn() {
        has_error = true
    }

    if has_error {
        exit(1)
    }
    exit(0)
}

struct abc {
    x i64
}

fn test_return_one() bool {
    var has_error = false

    let test = fn() abc {
        return abc{x: 10}
    }

    let res = test()

    if res.x != 10 {
        has_error = true
        print_error("expected res.x == 10")
    }

    return has_error
}

fn test_return_pointer() bool {
    var has_error = false

    let test = fn() *abc {
        return &abc{x: 11}
    }

    let res = test()
   
    if res.x != 11 {
        has_error = true
        print_error("expected res.x == 11")
    }

    return has_error
}

fn test_return_multi() bool {
    var has_error = false

    let test = fn() abc, abc {
        let a = abc{x: 9}
        let b = abc{x: 5}
        return a, b
    }
    let a, let b = test()
    
    if &a == &b {
        has_error = true
        print_error("expected &a != &b")
    }
    if a.x != 9 {
        has_error = true
        print_error("expected a.x == 9")
    }
    if b.x != 5 {
        has_error = true
        print_error("expected b.x == 5")
    }
    
    return has_error
}

struct xyz{ x i64, y string } 

fn test1() xyz {
	return xyz{x: 1, y: "hello!"}
}

fn test2() xyz {
	return test1()
}

// validate string nothing truncated
fn test_return_fn() bool {
    var has_error = false
    
    let res = test2() 

    if res.x != 1 {
        has_error = true
        print_error("expected res.x == 1")
    }
    if len(res.y) != 6 {
        has_error = true
        print_error("expected len(res.y) == 6")
    }
    if res.y != "hello!" {
        has_error = true
        print_error("expected res.y == 'hello!'")
    }

    return has_error
}

// ------- //
// Helpers //
// ------- //

let std_out = 1
let std_err = 2

fn print_info(rsn string) {
    let buf = []byte(rsn)
    write(std_out, &buf, len(buf))
}

fn print_error(rsn string) {
    let buf = []byte(rsn)
    write(std_err, &buf, len(buf))
}

// -------- //
// OS calls //
// -------- //

@extern(c)
pub fn write(fd i64, buf *[]byte, size i64) i64 

@extern(c)
pub fn exit(c i64)
