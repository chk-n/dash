lib test

fn main() {
    var has_error = false
    
    if test_no_default_match() {
        has_error = true
    }
    if test_empty_block_match() {
        has_error = true
    }
    if test_default_match() {
        has_error = true
    }
    if test_only_default_match() {
        has_error = true
    }
    if test_assign_expression_match() {
        has_error = true    
    }   
    if test_return_expression_match() {
        has_error = true
    }
    if test_scoping_in_match() {
        has_error = true
    }
    if test_match_scalar() {
        has_error = true
    }
    if test_match_aggregate() {
        has_error = true
    }
    if test_match_and_use_int() {
        has_error = true
    }
    if test_match_and_use_struct() {
        has_error = true
    }
    
    if has_error {
        exit(1)
    }
    exit(0)
}

// NOTE: this causes signal: trace/BPT trap 
fn test_no_default_match() bool {
    var has_error = false
    let x = 42

    match x {
    case 1: 
        has_error = true
        print_error("expected 'case 1' to not match")
    case 2: 
        has_error = true
        print_error("expected 'case 2' to not match")
    }
    return has_error
}

fn test_empty_block_match() bool {
    let x = 1

    match x {
    case 0: 
    case 1:
    case _:
    }

    return false
}

fn test_default_match() bool {
    let x = 1

    match x {
    case 2: 
        print_error("expected 'case 41' to not match")
        return true
    case _:
        return false
    }
    return true
}

fn test_only_default_match() bool {
    let x = 42

    match x {
    case _:
        return false
    }

     return true
}

fn test_assign_expression_match() bool {
    let x = 0.0
    let res = match x {
        case 0.0: 0
        case 1.1: 1
        case _: 10
    }

    if res != 0 {
        print_error("expected res == 0")
        return true
    }
    return false
}

fn test_return_expression_match() bool {
    var has_error = false

    let m = fn(x i64) i64 {
        return match x {
            case 1: x
            case 2: x
            case 3: x
            case _: 0
        }
    }

    if m(1) != 1 {
        has_error = true
        print_error("expected m(1) == 1")
    }
    if m(2) != 2 {
        has_error = true
        print_error("expected m(2) == 2")
    }
    if m(3) != 3 {
        has_error = true
        print_error("expected m(3) == 3")
    }
    if m(10) != 0 {
        has_error = true
        print_error("expected m(10) == 0")
    }

    return has_error
}


fn test_scoping_in_match() bool {
    var has_error = true
    let x = 1

    match x {
    case 1:
        if x == 1 {
            has_error = false
        }
    }

    return has_error
}

union union_a {
    i64,
    f64,
    bool,
    byte,
}

fn test_match_scalar() bool {
    var has_error = false
    
    let v = union_a(false)

    let res = match v {
        case i64: 10
        case f64: 11
        case bool: 12
        case byte: 13
        case _: 0
    }

    if res != 12 {
        has_error = true
        print_error("expected res == 12")
    }

    return has_error
}

struct abc {
    i string
}

union union_b {
    abc,
    []i64,
}

fn test_match_aggregate() bool {
    var has_error = false

    let v1 = union_b(abc{i: "hello"})
    let res1 = match v1 {
        case abc: true
        case _: false
    }
    if res1 != true {
        has_error = true
        print_error("expected res1 == true")
    }

    let v2 = union_b([1,2,3,4])
    let res2 = match v2 {
        case abc: true
        case _: false
    }
    if res2 != false {
        has_error = true
        print_error("expected res2 == false")
    }

    return has_error
}

fn test_match_and_use_int() bool {
    var has_error = false

    let v = union_a(14)
    let res = match v {
        case f64: 20
        case i64: v + 1
        case bool: 21
        case _: 22
    }
    if res != 15 {
        has_error = true
        print_error("expected res == 15")
    }
    
    return has_error
}

fn test_match_and_use_struct() bool {
    var has_error = false

    let v = union_b(abc{i: "hello"})
    let res = match v {
        case abc: v.i
        case _: ""
    }

    if res != "hello" {
        has_error = true
        print_error("expected res == 'hello'")
    }

    return has_error
}

// TODO: match against type def

// ------- //
// Helpers //
// ------- //

let std_out = 1
let std_err = 2

fn print_info(rsn string) {
    let buf = []byte(rsn)
    write(std_out, &buf, len(buf))
}

fn print_error(rsn string) {
    let buf = []byte(rsn)
    write(std_err, &buf, len(buf))
}

// -------- //
// OS calls //
// -------- //

@extern(c)
pub fn write(fd i64, buf *[]byte, size i64) i64 

@extern(c)
pub fn exit(c i64)
