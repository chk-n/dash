lib types

use "dash/intern"
use "dash/convert"
use "dash/hash/rapidhash"
use "dash/map"
use "dash/strings"

// Semantic types represent high-level language type information
// preserved during semantic analysis for correct IR lowering.
// These are distinct from IR structural types.

pub enum tag {
    // primitive types
    u8_type
    u16_type
    u32_type
    u64_type
    i8_type
    i16_type
    i32_type
    i64_type
    f32_type
    f64_type
    bool_type
    char_type
    string_type
    many_type

    // composite types
    // x points to inner semantic type index
    optional_type
    pointer_type
    memory_type
    array_type

    // named types
    // x points to intern.index of FQN string
    struct_type
    struct_generic_type
    enum_type
    union_type
    error_generic_type
    error_custom_type
    function_type
    function_fallible_type
    function_generic_type
    function_generic_fallible_type
    
    // x points to extra with signature data, hashed by function type index
    // Extras layout: [fn_type, param_count, p1, p2, ..., ret_count, r1, r2, ...]
    function_signature

    // Multi type for grouping multiple function return types
    // x points to extra with layout: [count, t1, t2, ...]
    multi_type

    // x points to intern.index of FQN string
    // underlying type stored in extra array
    type_def_type

    // Metadata entries for type members (stored separately from type definitions)
    // x = hash key for lookup, data in extra array

    // Struct fields metadata
    // Extra layout: [struct_type_idx, field_count, name1, type1, name2, type2, ...]
    struct_fields

    // Enum variants metadata
    // Extra layout: [enum_type_idx, variant_count, name1, name2, ...]
    enum_variants

    // Union subtypes metadata
    // Extra layout: [union_type_idx, subtype_count, name1, type1, name2, type2, ...]
    union_subtypes
}

pub struct st {
    tag tag
    x   u32
}

// Semantic type pool with deduplication
pub struct pool {
    types      []st
    types_map  *map.map[u64, u32]
    extra      []u32
}

pub type index u32
pub let NULL_IDX = index(4_294_967_295)

// constant types
pub let U8_IDX = index(0)
pub let U16_IDX = index(1)
pub let U32_IDX = index(2)
pub let U64_IDX = index(3)
pub let I8_IDX = index(4)
pub let I16_IDX = index(5)
pub let I32_IDX = index(6)
pub let I64_IDX = index(7)
pub let F32_IDX = index(8)
pub let F64_IDX = index(9)
pub let BOOL_IDX = index(10)
pub let CHAR_IDX = index(11)
pub let STRING_IDX = index(12)
pub let MANY_IDX = index(13)
pub let ERROR_IDX = index(14)

// default types initialised at pool creation
let default_types = [
    st{tag: tag.u8_type, x: u32(NULL_IDX)},
    st{tag: tag.u16_type, x: u32(NULL_IDX)},
    st{tag: tag.u32_type, x: u32(NULL_IDX)},
    st{tag: tag.u64_type, x: u32(NULL_IDX)},
    st{tag: tag.i8_type, x: u32(NULL_IDX)},
    st{tag: tag.i16_type, x: u32(NULL_IDX)},
    st{tag: tag.i32_type, x: u32(NULL_IDX)},
    st{tag: tag.i64_type, x: u32(NULL_IDX)},
    st{tag: tag.f32_type, x: u32(NULL_IDX)},
    st{tag: tag.f64_type, x: u32(NULL_IDX)},
    st{tag: tag.bool_type, x: u32(NULL_IDX)},
    st{tag: tag.char_type, x: u32(NULL_IDX)},
    st{tag: tag.string_type, x: u32(NULL_IDX)},
    st{tag: tag.many_type, x: u32(NULL_IDX)},
    st{tag: tag.error_generic_type, x: u32(NULL_IDX)},
]

pub fn new() *pool {
    var p = &pool{
        types:     [],
        types_map: map.new[u64, u32](),
        extra:     [],
    }
    p = init(p)
    return p
}

// Hash a semantic type for deduplication
fn hash_st(t st)! u64 {
    let k1 = u8(t.tag)
    let k2 = try convert.to_u8_array(t.x)
    let k = append(k2, k1)
    return try rapidhash.nano(k, 0)
}

// Intern a semantic type returns deduplicated index
pub fn intern(p *pool, t st)! *pool, index {
    let h = try hash_st(t)
    let existing = try map.get_val(p.types_map, h)
    if existing != null {
        return p, index(?existing)
    }

    let idx = u32(len(p.types))
    var types = try append(p.types, t)
    let m = try map.insert(p.types_map, h, idx)

    return &pool{
        types:     types,
        types_map: m,
        extra:     p.extra,
    }, index(idx)
}

// Lookup a semantic type by index
pub fn lookup(p *pool, idx index)! st {
    return try get(p.types, idx)
}

pub fn make_u8(p *pool)! *pool, index {
    return p, U8_IDX
}

pub fn make_u16(p *pool)! *pool, index {
    return p, U16_IDX
}

pub fn make_u32(p *pool)! *pool, index {
    return p, U32_IDX
}

pub fn make_u64(p *pool)! *pool, index {
    return p, U64_IDX
}

pub fn make_i8(p *pool)! *pool, index {
    return p, I8_IDX
}

pub fn make_i16(p *pool)! *pool, index {
    return p, I16_IDX
}

pub fn make_i32(p *pool)! *pool, index {
    return p, I32_IDX
}

pub fn make_i64(p *pool)! *pool, index {
    return p, I64_IDX
}

pub fn make_f32(p *pool)! *pool, index {
    return p, F32_IDX
}

pub fn make_f64(p *pool)! *pool, index {
    return p, F64_IDX
}

pub fn make_bool(p *pool)! *pool, index {
    return p, BOOL_IDX
}

pub fn make_char(p *pool)! *pool, index {
    return p, CHAR_IDX
}

pub fn make_string(p *pool)! *pool, index {
    return p, STRING_IDX
}

pub fn make_many(p *pool)! *pool, index {
    return p, MANY_IDX
}

pub fn make_generic_error(p *pool)! *pool, index {
    return p, ERROR_IDX
}

pub fn make_optional(p *pool, inner index)! *pool, index {
    let st = st{tag: tag.optional_type, x: u32(inner)}
    return try intern(p, st)
}

pub fn make_pointer(p *pool, inner index)! *pool, index {
    let st = st{tag: tag.pointer_type, x: u32(inner)}
    return try intern(p, st)
}

pub fn make_memory(p *pool, inner index)! *pool, index {
    let st = st{tag: tag.memory_type, x: u32(inner)}
    return try intern(p, st)
}

pub fn make_array(p *pool, inner index)! *pool, index {
    let st = st{tag: tag.array_type, x: u32(inner)}
    return try intern(p, st)
}

pub fn make_struct(p *pool, fqn_intern_idx intern.index)! *pool, index {
    let st = st{tag: tag.struct_type, x: u32(fqn_intern_idx)}
    return try intern(p, st)
}

pub fn make_struct_generic(p *pool, fqn_intern_idx intern.index)! *pool, index {
    let st = st{tag: tag.struct_generic_type, x: u32(fqn_intern_idx)}
    return try intern(p, st)
}

pub fn make_enum(p *pool, fqn_intern_idx intern.index)! *pool, index {
    let st = st{tag: tag.enum_type, x: u32(fqn_intern_idx)}
    return try intern(p, st)
}

pub fn make_union(p *pool, fqn_intern_idx intern.index)! *pool, index {
    let st = st{tag: tag.union_type, x: u32(fqn_intern_idx)}
    return try intern(p, st)
}

pub fn make_error(p *pool, fqn_intern_idx intern.index)! *pool, index {
    let st = st{tag: tag.error_custom_type, x: u32(fqn_intern_idx)}
    return try intern(p, st)
}

pub fn make_function(p *pool, fqn_intern_idx intern.index)! *pool, index {
    let st = st{tag: tag.function_type, x: u32(fqn_intern_idx)}
    return try intern(p, st)
}

pub fn make_function_fallible(p *pool, fqn_intern_idx intern.index)! *pool, index {
    let st = st{tag: tag.function_fallible_type, x: u32(fqn_intern_idx)}
    return try intern(p, st)
}

pub fn make_function_generic(p *pool, fqn_intern_idx intern.index)! *pool, index {
    let st = st{tag: tag.function_generic_type, x: u32(fqn_intern_idx)}
    return try intern(p, st)
}

pub fn make_function_generic_fallible(p *pool, fqn_intern_idx intern.index)! *pool, index {
    let st = st{tag: tag.function_generic_fallible_type, x: u32(fqn_intern_idx)}
    return try intern(p, st)
}

pub fn make_type_def(p *pool, fqn_intern_idx intern.index)! *pool, index {
    let st = st{tag: tag.type_def_type, x: u32(fqn_intern_idx)}
    return try intern(p, st)
}

// make_multi creates a multi type for grouping function return types.
// Extras layout: [count, t1, t2, ...]
pub fn make_multi(p *pool, types []index)! *pool, index {
    let extras_start = u32(len(p.extra))
    var extra = try append(p.extra, u32(len(types)))
    for i = 0; i < len(types); i++ {
        let t = try get(types, i)
        extra = try append(extra, u32(t))
    }

    var p = &pool{..p, extra: extra}

    let st = st{tag: tag.multi_type, x: extras_start}
    return try intern(p, st)
}

pub fn is_optional(p *pool, idx index)! bool {
    if idx == NULL_IDX {
        return false
    }
    let st = try lookup(p, idx)
    return st.tag == tag.optional_type
}

pub fn is_many(p *pool, idx index)! bool {
    if idx == NULL_IDX {
        return false
    }
    let st = try lookup(p, idx)
    return st.tag == tag.many_type
}

pub fn is_pointer(p *pool, idx index)! bool {
    if idx == NULL_IDX {
        return false
    }
    let st = try lookup(p, idx)
    return st.tag == tag.pointer_type
}

pub fn is_string(p *pool, idx index)! bool {
    if idx == NULL_IDX {
        return false
    }
    let st = try lookup(p, idx)
    return st.tag == tag.string_type
}

pub fn is_primitive(p *pool, idx index)! bool {
    if idx == NULL_IDX {
        return false
    }
    let st = try lookup(p, idx)
    match st.tag {
    case tag.u8_type, tag.u16_type, tag.u32_type, tag.u64_type,
         tag.i8_type, tag.i16_type, tag.i32_type, tag.i64_type,
         tag.f32_type, tag.f64_type, tag.bool_type, tag.char_type,
         tag.string_type, tag.many_type:
        return true
    case _:
        return false
    }
}

pub fn is_function(p *pool, idx index)! bool {
    if idx == NULL_IDX {
        return false
    }
    let st = try lookup(p, idx)
    return st.tag == tag.function_type || st.tag == tag.function_fallible_type
}

pub fn is_generic_function(p *pool, idx index)! bool {
    if idx == NULL_IDX {
        return false
    }
    let st = try lookup(p, idx)
    return st.tag == tag.function_generic_type || st.tag == tag.function_generic_fallible_type
}

pub fn is_generic_struct(p *pool, idx index)! bool {
    if idx == NULL_IDX {
        return false
    }
    let st = try lookup(p, idx)
    return st.tag == tag.struct_generic_type
}

pub fn is_fallible(p *pool, idx index)! bool {
    if idx == NULL_IDX {
        return false
    }
    let st = try lookup(p, idx)
    return st.tag == tag.function_fallible_type || st.tag == tag.function_generic_fallible_type
}

pub fn is_struct(p *pool, idx index)! bool {
    if idx == NULL_IDX {
        return false
    }
    let st = try lookup(p, idx)
    return st.tag == tag.struct_type
}

pub fn get_optional_inner(p *pool, idx index)! index {
    let st = try lookup(p, idx)
    try assert(st.tag == tag.optional_type, "expected optional_type")
    return index(st.x)
}

pub fn get_inner(p *pool, idx index)! index {
    let st = try lookup(p, idx)
    match st.tag {
    case tag.optional_type, tag.pointer_type, tag.memory_type,
         tag.array_type:
        return index(st.x)
    case _:
        raise error("type has no inner type")
    }
}

pub fn is_integer(p *pool, idx index)! bool {
    if idx == NULL_IDX {
        return false
    }
    let st = try lookup(p, idx)
    match st.tag {
    case tag.u8_type, tag.u16_type, tag.u32_type, tag.u64_type,
         tag.i8_type, tag.i16_type, tag.i32_type, tag.i64_type:
        return true
    case _:
        return false
    }
}

