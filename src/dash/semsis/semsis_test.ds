@test
fn test_slice_error_no_arguments()! {
    try assert_error(
        `lib a
        fn foo() {
            slice()
        }`,
        [too_few_arguments{expected: 3, found: 0, pos: ast.index(3)}]
    )
}

@test
fn test_slice_error_too_few_arguments()! {
    try assert_error(
        `lib a
        fn foo(arr []i64, start i64) {
            slice(arr, start)
        }`,
        [too_few_arguments{expected: 3, found: 2, pos: ast.index(12)}]
    )
}

@test
fn test_slice_error_too_many_arguments()! {
    try assert_error(
        `lib a
        fn foo(arr []i64, a i64, b i64, c i64) {
            slice(arr, a, b, c)
        }`,
        [too_many_arguments{expected: 3, found: 4, pos: ast.index(18)}]
    )
}

@test
fn test_slice_error_wrong_type()! {
    try assert_error(
        `lib a
        fn foo(x i64, start i64, end i64) {
            slice(x, start, end)
        }`,
        [type_mismatch{got: types.I64_IDX, want: types.NULL_IDX, pos: ast.index(10)}]
    )
}

@test
fn test_append_error_no_arguments()! {
    try assert_error(
        `lib a
        fn foo()! {
            try append()
        }`,
        [too_few_arguments{expected: 2, found: 0, pos: ast.index(3)}]
    )
}

@test
fn test_append_error_one_argument()! {
    try assert_error(
        `lib a
        fn foo(arr []i64)! {
            try append(arr)
        }`,
        [too_few_arguments{expected: 2, found: 1, pos: ast.index(9)}]
    )
}

@test
fn test_append_error_too_many_arguments()! {
    try assert_error(
        `lib a
        fn foo(arr []i64, a i64, b i64)! {
            try append(arr, a, b)
        }`,
        [too_many_arguments{expected: 2, found: 3, pos: ast.index(15)}]
    )
}

@test
fn test_append_error_wrong_collection_type()! {
    try assert_error(
        `lib a
        fn foo(x i64, val i64)! {
            try append(x, val)
        }`,
        [type_mismatch{got: types.I64_IDX, want: types.NULL_IDX, pos: ast.index(8)}]
    )
}

@test
fn test_append_elem_i64()! {
    try assert_gen(
        `lib a
        fn foo(arr []i64, val i64)! []i64 {
            return try append(arr, val)
        }`,
        `a/init:
