            %4 = const(true,bool)
            %5 = alloca([u32,slot[u64]],8)
            %6 = const(1,u32)
            %7 = const(0,u32)
            %8 = gep(%5,%7,*u32)
            store(%8,%6)
            %10 = const(1,u32)
            %11 = gep(%5,%10,*slot[u64])
            %12 = bitcast(%4,slot[u64])
            store(%11,%12)`
    )
}
@test
fn test_union_type_select_first_variant()! {
    try assert_gen(
        `lib a
        union u { i32 bool }
        fn f(x u) ?i32 { return i32(x) }`,
        `fn a/f:
            %2 = arg(x,*[u32,slot[u64]])
            jmp(a/f/0)
          a/f/0:
            %5 = const(0,u32)
            %6 = gep(%2,%5,*u32)
            %7 = load(%6,u32)
            %8 = const(0,u32)
            %9 = eq(%7,%8)
            br(%9,a/f/1,a/f/2)
          a/f/1:
            %12 = const(1,u32)
            %13 = gep(%2,%12,*slot[u64])
            %14 = load(%13,slot[u64])
            %15 = bitcast(%14,i32)
            jmp(a/f/3(%15))
          a/f/2:
            %18 = poison(i32)
            jmp(a/f/3(%18))
          a/f/3:
            %21 = block_arg(i32)
            %22 = alloca([bool,i32],8)
            %23 = const(0,u32)
            %24 = gep(%22,%23,*bool)
            store(%24,%9)
            %26 = const(1,u32)
            %27 = gep(%22,%26,*i32)
            store(%27,%21)`
    )
}

@test
fn test_union_type_select_second_variant()! {
    try assert_gen(
        `lib a
        union u { i32 bool }
        fn f(x u) ?bool { return bool(x) }`,
        `fn a/f:
            %2 = arg(x,*[u32,slot[u64]])
            jmp(a/f/0)
          a/f/0:
            %5 = const(0,u32)
            %6 = gep(%2,%5,*u32)
            %7 = load(%6,u32)
            %8 = const(1,u32)
            %9 = eq(%7,%8)
            br(%9,a/f/1,a/f/2)
          a/f/1:
            %12 = const(1,u32)
            %13 = gep(%2,%12,*slot[u64])
            %14 = load(%13,slot[u64])
            %15 = bitcast(%14,bool)
            jmp(a/f/3(%15))
          a/f/2:
            %18 = poison(bool)
            jmp(a/f/3(%18))
          a/f/3:
            %21 = block_arg(bool)
            %22 = alloca([bool,bool],8)
            %23 = const(0,u32)
            %24 = gep(%22,%23,*bool)
            store(%24,%9)
            %26 = const(1,u32)
            %27 = gep(%22,%26,*bool)
            store(%27,%21)`
    )
}
@test
fn test_union_type_construct_third_variant()! {
    try assert_gen(
        `lib a
        union u { i32 bool string }
        fn f() u { return u("abc") }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %4 = const(3,u64)
            %5 = const_array("abc",1,*[]u8)
            %6 = alloca([u64,*[]u8],8)
            %7 = const(0,u32)
            %8 = gep(%6,%7,*u64)
            store(%8,%4)
            %10 = const(1,u32)
            %11 = gep(%6,%10,**[]u8)
            store(%11,%5)
            %13 = alloca([u32,slot[u64]],8)
            %14 = const(2,u32)
            %15 = const(0,u32)
            %16 = gep(%13,%15,*u32)
            store(%16,%14)
            %18 = const(1,u32)
            %19 = gep(%13,%18,*slot[u64])
            %20 = bitcast(%6,slot[u64])
            store(%19,%20)`
    )
}

@test
fn test_union_type_construct_struct_variant()! {
    try assert_gen(
        `lib a
        struct s { a i32 b i64 }
        union u { i32 s }
        fn f() u { return u(s{a: 1, b: 2}) }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %4 = const(1,i64)
            %5 = cast(%4,i32)
            %6 = const(2,i64)
            %7 = alloca([i32,i64],8)
            %8 = const(0,u32)
            %9 = gep(%7,%8,*i32)
            store(%9,%5)
            %11 = const(1,u32)
            %12 = gep(%7,%11,*i64)
            store(%12,%6)
            %14 = alloca([u32,slot[u64]],8)
            %15 = const(1,u32)
            %16 = const(0,u32)
            %17 = gep(%14,%16,*u32)
            store(%17,%15)
            %19 = const(1,u32)
            %20 = gep(%14,%19,*slot[u64])
            %21 = bitcast(%7,slot[u64])
            store(%20,%21)`
    )
}

@test
fn test_union_type_select_struct_variant()! {
    try assert_gen(
        `lib a
        struct s { a i32 b i64 }
        union u { i32 s }
        fn f(x u) ?s { return s(x) }`,
        `fn a/f:
            %2 = arg(x,*[u32,slot[u64]])
            jmp(a/f/0)
          a/f/0:
            %5 = const(0,u32)
            %6 = gep(%2,%5,*u32)
            %7 = load(%6,u32)
            %8 = const(1,u32)
            %9 = eq(%7,%8)
            br(%9,a/f/1,a/f/2)
          a/f/1:
            %12 = const(1,u32)
            %13 = gep(%2,%12,*slot[u64])
            %14 = load(%13,slot[u64])
            %15 = bitcast(%14,*[i32,i64])
            %16 = load(%15,[i32,i64])
            jmp(a/f/3(%16))
          a/f/2:
            %19 = poison([i32,i64])
            jmp(a/f/3(%19))
          a/f/3:
            %22 = block_arg([i32,i64])
            %23 = alloca([bool,[i32,i64]],8)
            %24 = const(0,u32)
            %25 = gep(%23,%24,*bool)
            store(%25,%9)`
    )
}

