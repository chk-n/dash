    sem_b = try register_imports(sem_b, m)

    try assert(len(sem_b.errs) == 1, "expected exactly one error")
    let err = try get(sem_b.errs, 0)
    match e = err {
    case duplicate_import:
        return
    case _:
        raise test_error{reason: "expected duplicate_import error"}
    }
}

@test
fn test_resolve_imports_library_name_mismatch()! {
    var ctx = try new_context()

    let lib_ast = try parser.parse([]byte(`lib wrongname`), parser.mode.lib)
    var s = try new("path/rightname", lib_ast, ctx)
    var m = map.new[intern.index, namespace.index]()
    s = try register_imports(s, m)

    try assert(len(s.errs) == 1, "expected exactly one error")
    let err = try get(s.errs, 0)
    match e = err {
    case library_name_mismatch:
        try assert(e.declared == "wrongname", "error should contain declared name")
        try assert(e.expected == "rightname", "error should contain expected name")
    case _:
        raise test_error{reason: "expected library_name_mismatch error"}
    }
}

@test
fn test_register_types_public_scope()! {
    var ctx = try new_context()
    let a = try parser.parse([]byte(`lib a
        pub struct s { a string }
        pub enum e { f }
        pub union u { e s }
        pub error err { f []string }
        pub fn f1() {}
        pub fn f2()! {}
        pub type t u32`), parser.mode.lib)

    try assert(len(a.errs) == 0, "expected no parser errors")

    var s = try new("test", a, ctx)

    s = try register_types(s)
    try assert(len(s.errs) == 0, "expected no semsis errors")

    let _, let s_idx = try intern.intern_string(s.ip, "test/s")
    let val1_idx = try namespace.lookup(s.np, s.current_scope, s_idx)
    s.tp, let typ1 = try types.make_struct(s.tp, s_idx)
    let val1_entry = try namespace.get_entry(s.np, ?val1_idx)

    let _, let e_idx = try intern.intern_string(s.ip, "test/e")
    let val2_idx = try namespace.lookup(s.np, s.current_scope, e_idx)
    s.tp, let typ2 = try types.make_enum(s.tp, e_idx)
    let val2_entry = try namespace.get_entry(s.np, ?val2_idx)
    try assert_ns_lib_scope(s.np, val2_entry, typ2)

    let _, let u_idx = try intern.intern_string(s.ip, "test/u")
    let val3_idx = try namespace.lookup(s.np, s.current_scope, u_idx)
    s.tp, let typ3 = try types.make_union(s.tp, u_idx)
    let val3_entry = try namespace.get_entry(s.np, ?val3_idx)
    try assert_ns_lib_scope(s.np, val3_entry, typ3)

    let _, let err_idx = try intern.intern_string(s.ip, "test/err")
    let val4_idx = try namespace.lookup(s.np, s.current_scope, err_idx)
    s.tp, let typ4 = try types.make_error(s.tp, err_idx)
    let val4_entry = try namespace.get_entry(s.np, ?val4_idx)
    try assert_ns_lib_scope(s.np, val4_entry, typ4)

    let _, let f1_idx = try intern.intern_string(s.ip, "test/f1")
    let val5_idx = try namespace.lookup(s.np, s.current_scope, f1_idx)
    s.tp, let typ5 = try types.make_function(s.tp, f1_idx)
    let val5_entry = try namespace.get_entry(s.np, ?val5_idx)
    try assert_ns_lib_scope(s.np, val5_entry, typ5)

    let _, let f2_idx = try intern.intern_string(s.ip, "test/f2")
    let val6_idx = try namespace.lookup(s.np, s.current_scope, f2_idx)
    s.tp, let typ6 = try types.make_function_fallible(s.tp, f2_idx)
    let val6_entry = try namespace.get_entry(s.np, ?val6_idx)
    try assert_ns_lib_scope(s.np, val6_entry, typ6)

    let _, let t_idx = try intern.intern_string(s.ip, "test/t")
    let val7_idx = try namespace.lookup(s.np, s.current_scope, t_idx)
    s.tp, let typ7 = try types.make_type_def(s.tp, t_idx)
    let val7_entry = try namespace.get_entry(s.np, ?val7_idx)
    try assert_ns_lib_scope(s.np, val7_entry, typ7)
}

@test
fn test_resolve_types()! {
    var ctx = try new_context()
    let a = try parser.parse([]byte(`lib a
        pub struct s { a e }
        pub enum e { f }
        pub union u { t1 s }
        pub error err { c u32 msg s }
        pub type t1 t2
        pub type t2 u32
        pub fn f1(a t1, b, c u8) s, err {}
        pub fn f2[T many]() {}
        pub struct s1[T,E many] { f err }`), parser.mode.lib)
    try assert(len(a.errs) == 0, "expected no parser errors")

    var s = try new("test", a, ctx)

    s = try register_types(s)
    s = try resolve_types(s)
    try assert(len(s.errs) == 0, "expected no semsis errors")

    s.tp, let u32_type_idx = try types.make_u32(s.tp)

    let e_type_idx = try assert_type(s, "test/e")
    let s_type_idx = try assert_type(s, "test/s")
    let t1_type_idx = try assert_type(s, "test/t1")
    let t2_type_idx = try assert_type(s, "test/t2")
    let err_type_idx = try assert_type(s, "test/err")
    let u_type_idx = try assert_type(s, "test/u")
    let _ = try assert_type(s, "test/f1")
    let _ = try assert_type(s, "test/f2")
    let _ = try assert_type(s, "test/s1")

    s.ip, let a_name = try intern.intern_string(s.ip, "a")
    let a_field = try types.get_struct_field(s.tp, s_type_idx, a_name)
    try assert(a_field != null, "struct s should have field 'a'")
    try assert((?a_field).type_idx == e_type_idx, "field 'a' should have type e")

    s.ip, let f_name = try intern.intern_string(s.ip, "f")
    let f_variant = try types.get_enum_variant(s.tp, e_type_idx, f_name)
    try assert(f_variant != null, "enum e should have variant 'f'")

    s.ip, let t1_name = try intern.intern_string(s.ip, "t1")
    let t1_subtype = try types.get_union_subtype(s.tp, u_type_idx, t1_name)
    try assert(t1_subtype != null, "union u should have subtype 't1'")
    try assert((?t1_subtype).type_idx == t1_type_idx, "subtype 't1' should have type t1")

    s.ip, let s_name = try intern.intern_string(s.ip, "s")
    let s_subtype = try types.get_union_subtype(s.tp, u_type_idx, s_name)
    try assert(s_subtype != null, "union u should have subtype 's'")
    try assert((?s_subtype).type_idx == s_type_idx, "subtype 's' should have type s")

    s.ip, let c_name = try intern.intern_string(s.ip, "c")
    let c_field = try types.get_struct_field(s.tp, err_type_idx, c_name)
    try assert(c_field != null, "error err should have field 'c'")
    try assert((?c_field).type_idx == u32_type_idx, "field 'c' should have type u32")

    s.ip, let msg_name = try intern.intern_string(s.ip, "msg")
    let msg_field = try types.get_struct_field(s.tp, err_type_idx, msg_name)
    try assert(msg_field != null, "error err should have field 'msg'")
    try assert((?msg_field).type_idx == s_type_idx, "field 'msg' should have type s")

    let t1_underlying = try types.get_type_def_underlying(s.tp, t1_type_idx)
    try assert(t1_underlying == t2_type_idx, "t1 should have underlying type t2")
    let t2_underlying = try types.get_type_def_underlying(s.tp, t2_type_idx)
    try assert(t2_underlying == u32_type_idx, "t2 should have underlying type u32")
}

@test
fn test_global_identifier_duplicates()! {
    let tests = [
        {"struct foo { a i32 } struct foo { b i64 }", ast.index(6)},
        {"enum bar { x } enum bar { y }", ast.index(5)},
        {"union baz { i32 } union baz { i64 }", ast.index(5)},
        {"error myerr { a i32 } error myerr { b i64 }", ast.index(6)},
        {"fn myfn() {} fn myfn() {}", ast.index(4)},
        {"type mytype i32 type mytype i64", ast.index(4)},
        {"struct mixed { a i32 } enum mixed { x }", ast.index(6)},
    ]

    for i = 0; i < len(tests); i++ {
        let t = try get(tests, i)
        let ctx = try new_context()
        let a = try parser.parse([]byte("lib a " + t.0), parser.mode.lib)
        try assert(len(a.errs) == 0, "expected no parser errors")
        var s = try new("test", a, ctx)
        s = try register_types(s)
        try assert_has_identifier_redeclared_error(s, t.1)
    }
}

@test
fn test_inner_ident_duplicates()! {
    // Function parameters are stored as namespace.value, so duplicate detection works
    let tests = [
        {"fn f(a i32, a i64) {}", ast.index(2)},
    ]

    for i = 0; i < len(tests); i++ {
        let t = try get(tests, i)
        let ctx = try new_context()
        let a = try parser.parse([]byte("lib a " + t.0), parser.mode.lib)
        try assert(len(a.errs) == 0, "expected no parser errors")
        var s = try new("test", a, ctx)
        s = try register_types(s)
        s = try resolve_types(s)
        try assert_has_identifier_redeclared_error(s, t.1)
    }
    // TODO: Add duplicate detection for struct fields, enum variants, union subtypes, type parameters
    // These are now stored in types pool, not namespace, so need different duplicate detection
}

@test
fn test_assignment_integer_literal()! {
    try assert_gen(
        `lib a
        let x = 1`,
        `%1 = const(1,i64)`
    )
}

@test
