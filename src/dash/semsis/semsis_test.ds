@test
fn test_fallible_try_void_call()! {
    try assert_gen(
        `lib a
        fn g()! {}
        fn f()! { try g() }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %7 = extern_ref("a/g",a/g)
            %8 = call(%7,[[u64,slot[u64]]])
            %9 = const(0,u32)
            %10 = gep(%8,%9,*[u64,slot[u64]])
            %11 = const(0,u32)
            %12 = gep(%10,%11,*u64)
            %13 = load(%12,u64)
            %14 = const(0,u64)
            %15 = eq(%13,%14)
            br(%15,a/f/1,a/f/2)
          a/f/2:
            %18 = const(1,u32)
            %19 = gep(%10,%18,*slot[u64])
            %20 = load(%19,slot[u64])
            %21 = alloca([u64,slot[u64]],8)
            %22 = const(0,u32)
            %23 = gep(%21,%22,*u64)
            store(%23,%13)
            %25 = const(1,u32)
            %26 = gep(%21,%25,*slot[u64])
            store(%26,%20)
            %28 = alloca([[u64,slot[u64]]],8)
            %29 = load(%21,[u64,slot[u64]])
            %30 = const(0,u32)
            %31 = gep(%28,%30,*[u64,slot[u64]])
            store(%31,%29)
            ret_1(%28)
          a/f/1:`
    )
}

@test
fn test_fallible_try_value_call()! {
    try assert_gen(
        `lib a
        fn g()! i32 { return 1 }
        fn f()! i32 { return try g() }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %27 = extern_ref("a/g",a/g)
            %28 = call(%27,[i32,[u64,slot[u64]]])
            %29 = const(1,u32)
            %30 = gep(%28,%29,*[u64,slot[u64]])
            %31 = const(0,u32)
            %32 = gep(%30,%31,*u64)
            %33 = load(%32,u64)
            %34 = const(0,u64)
            %35 = eq(%33,%34)
            br(%35,a/f/1,a/f/2)
          a/f/2:
            %38 = const(1,u32)
            %39 = gep(%30,%38,*slot[u64])
            %40 = load(%39,slot[u64])
            %41 = alloca([u64,slot[u64]],8)
            %42 = const(0,u32)
            %43 = gep(%41,%42,*u64)
            store(%43,%33)
            %45 = const(1,u32)
            %46 = gep(%41,%45,*slot[u64])
            store(%46,%40)
            %48 = poison(i32)
            %49 = alloca([i32,[u64,slot[u64]]],8)
            %50 = const(0,u32)
            %51 = gep(%49,%50,*i32)
            store(%51,%48)
            %53 = load(%41,[u64,slot[u64]])
            %54 = const(1,u32)
            %55 = gep(%49,%54,*[u64,slot[u64]])
            store(%55,%53)
            ret_1(%49)
          a/f/1:
            %59 = const(0,u32)
            %60 = gep(%28,%59,*i32)
            %61 = load(%60,i32)
            %62 = const(0,u64)
            %63 = poison(slot[u64])
            %64 = alloca([u64,slot[u64]],8)
            %65 = const(0,u32)
            %66 = gep(%64,%65,*u64)
            store(%66,%62)
            %68 = const(1,u32)
            %69 = gep(%64,%68,*slot[u64])
            store(%69,%63)
            %71 = alloca([i32,[u64,slot[u64]]],8)
            %72 = const(0,u32)
            %73 = gep(%71,%72,*i32)
            store(%73,%61)
            %75 = load(%64,[u64,slot[u64]])
            %76 = const(1,u32)
            %77 = gep(%71,%76,*[u64,slot[u64]])
            store(%77,%75)
            ret_1(%71)`
    )
}

@test
fn test_fallible_calling_non_fallible()! {
    try assert_gen(
        `lib a
        fn g() i32 { return 1 }
        fn f()! i32 { return g() }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %14 = extern_ref("a/g",a/g)
            %15 = call(%14,[i32])
            %16 = const(0,u64)
            %17 = poison(slot[u64])
            %18 = alloca([u64,slot[u64]],8)
            %19 = const(0,u32)
            %20 = gep(%18,%19,*u64)
            store(%20,%16)
            %22 = const(1,u32)
            %23 = gep(%18,%22,*slot[u64])
            store(%23,%17)
            %25 = alloca([i32,[u64,slot[u64]]],8)
            %26 = const(0,u32)
            %27 = gep(%25,%26,*i32)
            store(%27,%15)
            %29 = load(%18,[u64,slot[u64]])
            %30 = const(1,u32)
            %31 = gep(%25,%30,*[u64,slot[u64]])
            store(%31,%29)
            ret_1(%25)`
    )
}

@test
fn test_fallible_try_assigns_to_variable()! {
    try assert_gen(
        `lib a
        fn g()! i32 { return 1 }
        fn f()! {
            let x = try g()
        }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %27 = extern_ref("a/g",a/g)
            %28 = call(%27,[i32,[u64,slot[u64]]])
            %29 = const(1,u32)
            %30 = gep(%28,%29,*[u64,slot[u64]])
            %31 = const(0,u32)
            %32 = gep(%30,%31,*u64)
            %33 = load(%32,u64)
            %34 = const(0,u64)
            %35 = eq(%33,%34)
            br(%35,a/f/1,a/f/2)
          a/f/2:
            %38 = const(1,u32)
            %39 = gep(%30,%38,*slot[u64])
            %40 = load(%39,slot[u64])
            %41 = alloca([u64,slot[u64]],8)
            %42 = const(0,u32)
            %43 = gep(%41,%42,*u64)
            store(%43,%33)
            %45 = const(1,u32)
            %46 = gep(%41,%45,*slot[u64])
            store(%46,%40)
            %48 = alloca([[u64,slot[u64]]],8)
            %49 = load(%41,[u64,slot[u64]])
            %50 = const(0,u32)
            %51 = gep(%48,%50,*[u64,slot[u64]])
            store(%51,%49)
            ret_1(%48)
          a/f/1:
            %55 = const(0,u32)
            %56 = gep(%28,%55,*i32)
            %57 = load(%56,i32)`
    )
}

@test
fn test_fallible_error_raise_in_non_fallible()! {
    try assert_error(
        `lib a
        error myerr {}
        fn f() { raise myerr{} }`,
        [raise_in_non_fallible{pos: ast.index(8)}]
    )
}

@test
fn test_fallible_error_try_in_non_fallible()! {
    try assert_error(
        `lib a
        fn g()! {}
        fn f() { try g() }`,
