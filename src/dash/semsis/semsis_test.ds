@test
fn test_assignment_error_type_mismatch()! {
    try assert_error(
        `lib a
        fn main() {
           var x = 1
           x = true
        }`,
        [cannot_assign_to_type{
            got: types.BOOL_IDX,
            want: types.I64_IDX,
            pos: ast.index(8)
        }]
    )
}

@test
fn test_assignment_error_not_reassignable()! {
    try assert_error(
        `lib a
        fn main() {
           let x = 1
           x = 1
        }`,
        [not_reassignable{pos: 8}]
    )
}

@test
fn test_assignment_error_count_mismatch_too_many_values()! {
    try assert_error(
        `lib a
        fn main() {
           let x = 1, 2
        }`,
        [assignment_count_mismatch{var_cnt: 1, val_cnt: 2, pos: ast.index(8)}]
    )
}

@test
fn test_assignment_error_count_mismatch_too_few_values()! {
    try assert_error(
        `lib a
        fn main() {
           let x, let y = 1
        }`,
        [assignment_count_mismatch{var_cnt: 2, val_cnt: 1, pos: ast.index(9)}]
    )
}

let ints = ["u8","u16","u32","u64","i8","i16","i32","i64"]
let floats = ["f32", "f64"]

@test
fn test_cast_int_to_int()! {
    for i = 0; i < len(ints); i++ {
        let typ1 = try get(ints, i)
        if typ1 == "i64" { next }
        for j = 0; j < len(ints); j++ {
            if i == j { next }
            let typ2 = try get(ints, j)
                    let inp = fmt.stringf(`lib a
        let x = %s(1)
        let y = %s(x)`, [typ1, typ2])
            let out = fmt.stringf(`%%1 = const(1,i64)
            %%2 = cast(%%1,%s)
            %%3 = cast(%%2,%s)`, [typ1,typ2])
            try assert_gen(inp, out)
        }
    }
}

@test
fn test_cast_u32_char_bidirectional()! {
    // casting u32<>char and char<>u32 generates one cast only
    try assert_gen(
        `lib a
        let x = u32(1)
        let y = char(x)`,
        `%1 = const(1,i64)
            %2 = cast(%1,u32)`
    )
    try assert_gen(
        `lib a
        let x = char(1)
        let y = u32(x)`,
        `%1 = const(1,i64)
            %2 = cast(%1,u32)`
    )
}

@test
fn test_cast_int_to_char()! {
    for i = 0; i < len(ints); i++ {
        let typ = try get(ints, i)
        if typ == "u32" || typ == "i64" { next }
        let inp = fmt.stringf(`lib a
        let x = %s(1)
        let y = char(x)`, [typ])
        let out = fmt.stringf(`%%1 = const(1,i64)
            %%2 = cast(%%1,%s)
            %%3 = cast(%%2,u32)`, [typ])

        try assert_gen(inp, out)
    }
}

@test
fn test_cast_char_to_int()! {
    for i = 0; i < len(ints); i++ {
        let typ = try get(ints, i)
        if typ == "u32" || typ == "i64" { next }
        let inp = fmt.stringf(`lib a
        let x = char(1)
        let y = %s(x)`, [typ])
        let out = fmt.stringf(`%%1 = const(1,i64)
            %%2 = cast(%%1,u32)
            %%3 = cast(%%2,%s)`, [typ])

        try assert_gen(inp, out)
    }
}

