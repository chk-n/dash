@test
fn test_dot_expression_nested()! {
    try assert_gen(
        `lib a
        struct inner { val i32 }
        struct outer { i inner }
        fn f() {
            let o = outer{i: inner{val: 99}}
            let x = o.i.val
        }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %4 = const(99,i64)
            %5 = cast(%4,i32)
            %6 = alloca([i32],8)
            %7 = const(0,u32)
            %8 = gep(%6,%7,*i32)
            store(%8,%5)
            %10 = alloca([[i32]],8)
            %11 = load(%6,[i32])
            %12 = const(0,u32)
            %13 = gep(%10,%12,*[i32])
            store(%13,%11)
            %15 = const(0,u32)
            %16 = gep(%10,%15,*[i32])
            %17 = const(0,u32)
            %18 = gep(%16,%17,*i32)
            %19 = load(%18,i32)`
    )
}

@test
fn test_dot_expression_nested_different_fields()! {
