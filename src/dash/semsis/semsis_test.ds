    )
}

@test
fn test_if_expr_else_if_chain()! {
    try assert_gen(`lib a
        fn test(x i64) i64 { let y = if x > 10 { 1 } else if x > 5 { 2 } else { 3 } return y }`,
        `fn a/test:
            %2 = arg(x,i64)
            jmp(a/test/0)
          a/test/0:
            %5 = const(10,i64)
            %6 = gt(%2,%5)
            br(%6,a/test/1,a/test/2)
          a/test/1:
            %9 = const(1,i64)
            jmp(a/test/5(%9))
          a/test/2:
            %12 = const(5,i64)
            %13 = gt(%2,%12)
            br(%13,a/test/3,a/test/4)
          a/test/3:
            %16 = const(2,i64)
            jmp(a/test/5(%16))
          a/test/4:
            %19 = const(3,i64)
            jmp(a/test/5(%19))
          a/test/5:
            %22 = block_arg(i64)
            %23 = alloca([i64],8)
            %24 = const(0,u32)
            %25 = gep(%23,%24,*i64)
            store(%25,%22)
            ret_1(%23)`
    )
}
@test
fn test_if_expr_function_call()! {
    try assert_gen(`lib a
        fn one() i64 { return 1 }
        fn two() i64 { return 2 }
        fn test(b bool) { let x = if b { one() } else { two() } }`,
        `fn a/test:
            %20 = arg(b,bool)
            jmp(a/test/0)
          a/test/0:
            br(%20,a/test/1,a/test/2)
          a/test/1:
            %25 = extern_ref("a/one",a/one)
            %26 = call(%25,[i64])
            %27 = const(0,u32)
            %28 = gep(%26,%27,*i64)
            %29 = load(%28,i64)
            jmp(a/test/3(%29))
          a/test/2:
            %32 = extern_ref("a/two",a/two)
            %33 = call(%32,[i64])
            %34 = const(0,u32)
            %35 = gep(%33,%34,*i64)
            %36 = load(%35,i64)
            jmp(a/test/3(%36))
          a/test/3:
            %39 = block_arg(i64)`
    )
}

@test
fn test_if_expr_struct()! {
    try assert_gen(`lib a
        struct point { x i64 y i64 }
        fn test(b bool) point { let p = if b { point{x:1,y:2} } else { point{x:3,y:4} } return p }`,
        `fn a/test:
            %2 = arg(b,bool)
            jmp(a/test/0)
          a/test/0:
            br(%2,a/test/1,a/test/2)
          a/test/1:
            %7 = const(1,i64)
            %8 = const(2,i64)
            %9 = alloca([i64,i64],8)
            %10 = const(0,u32)
            %11 = gep(%9,%10,*i64)
            store(%11,%7)
            %13 = const(1,u32)
            %14 = gep(%9,%13,*i64)
            store(%14,%8)
            jmp(a/test/3(%9))
          a/test/2:
            %18 = const(3,i64)
            %19 = const(4,i64)
            %20 = alloca([i64,i64],8)
            %21 = const(0,u32)
            %22 = gep(%20,%21,*i64)
            store(%22,%18)
            %24 = const(1,u32)
            %25 = gep(%20,%24,*i64)
            store(%25,%19)
            jmp(a/test/3(%20))
          a/test/3:
            %29 = block_arg(*[i64,i64])
            %30 = load(%29,[i64,i64])
            %31 = alloca([[i64,i64]],8)
            %32 = const(0,u32)
