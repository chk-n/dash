@test
fn test_for_ssa_var_modified_in_loop()! {
    try assert_gen(
        `lib a
        fn f() {
            var x = 0
            for x < 5 {
                x = x + 1
            }
        }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %4 = const(0,i64)
            jmp(a/f/1(%4))
          a/f/1:
            %7 = block_arg(i64)
            %8 = const(5,i64)
            %9 = lt(%7,%8)
            br(%9,a/f/2(%7),a/f/3)
          a/f/2:
            %12 = block_arg(i64)
            %13 = const(1,i64)
            %14 = add(%12,%13)
            jmp(a/f/1(%14))
          a/f/3:`
    )
}

@test
fn test_for_ssa_var_used_after_loop()! {
    try assert_gen(
        `lib a
        fn f() i64 {
            var x = 0
            for x <= 3 {
                x = x + 1
            }
            return x
        }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %4 = const(0,i64)
            jmp(a/f/1(%4))
          a/f/1:
            %7 = block_arg(i64)
            %8 = const(3,i64)
            %9 = lte(%7,%8)
            br(%9,a/f/2(%7),a/f/3)
          a/f/2:
            %12 = block_arg(i64)
            %13 = const(1,i64)
            %14 = add(%12,%13)
            jmp(a/f/1(%14))
          a/f/3:
            %17 = alloca([i64],8)
            %18 = const(0,u32)
            %19 = gep(%17,%18,*i64)
            store(%19,%7)
            ret_1(%17)`
    )
}

@test
fn test_for_classic_loop_var_not_found_outside()! {
    try assert_error(
        `lib a
        fn f() {
            for i = 0; i < 5; i = i + 1 { }
            let x = i
        }`,
        [identifier_not_found{pos: ast.index(23)}]
    )
}

@test
fn test_for_classic_init_uses_existing_var()! {
    try assert_gen(
        `lib a
        fn f() {
            var i = 10
            for i = 0; i < 5; i = i + 1 { }
        }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %4 = const(10,i64)
            %5 = const(0,i64)
            jmp(a/f/1(%5))
          a/f/1:
            %8 = block_arg(i64)
            %9 = const(5,i64)
            %10 = lt(%8,%9)
            br(%10,a/f/2(%8),a/f/3)
          a/f/2:
            %13 = block_arg(i64)
            %14 = const(1,i64)
            %15 = add(%13,%14)
            jmp(a/f/1(%15))
          a/f/3:`
    )
}

@test
fn test_for_classic_redeclare_loop_var_inside()! {
    try assert_error(
        `lib a
        fn f() {
            for i = 0; i < 5; i = i + 1 {
                let i = 10
            }
        }`,
        [identifier_redeclared{pos: ast.index(18)}]
    )
}

@test
fn test_for_bool_redeclare_outer_var_inside()! {
    try assert_error(
        `lib a
        fn f(x bool) {
            let y = 0
            for x {
                let y = 1
                break
            }
        }`,
        [identifier_redeclared{pos: ast.index(12)}]
    )
}

@test
fn test_for_classic_nested_inner_var_not_visible_outer()! {
    try assert_error(
        `lib a
        fn f() {
            for i = 0; i < 2; i = i + 1 {
                for j = 0; j < 2; j = j + 1 { }
                let x = j
            }
        }`,
        [identifier_not_found{pos: ast.index(39)}]
    )
}

@test
fn test_for_classic_condition_identifier_not_found_error()! {
    try assert_error(
