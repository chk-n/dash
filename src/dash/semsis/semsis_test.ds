@test
fn test_function_error_param_missing_type()! {
    try assert_error(
        `lib a
        fn foo(a) {
            return
        }`,
        [parameter_missing_type{name: "a", pos: ast.index(2)}]
    )
    try assert_error(
        `lib a
        fn foo(a i32, b) {
            return
        }`,
        [parameter_missing_type{name: "b", pos: ast.index(4)}]
    )
    try assert_error(
        `lib a
        fn foo(a, b) {
            return
        }`,
        [
            parameter_missing_type{name: "b", pos: ast.index(3)},
            parameter_missing_type{name: "a", pos: ast.index(2)}
        ]
    )
    try assert_error(
        `lib a
        fn foo(a, b i32, c, d) {
            return
        }`,
        [
            parameter_missing_type{name: "d", pos: ast.index(6)},
            parameter_missing_type{name: "c", pos: ast.index(5)}
        ]
    )
}

@test
fn test_function_error_param_redeclared()! {
    try assert_error(
        `lib a
        fn foo(a i32, a string) {
            return
        }`,
        [identifier_redeclared{pos: ast.index(2)}]
    )
    try assert_error(
        `lib a
        fn foo(x, x i32) {
            return
        }`,
        [identifier_redeclared{pos: ast.index(2)}]
    )
}

@test
