@test
fn test_strings()! {
    try assert_gen(
        `lib a
        let x = "hello"`,
        `%1 = const(5,u64)
            %2 = const_array("hello",1,*[]u8)
            %3 = alloca([u64,*[]u8],8)
            %4 = const(0,u32)
            %5 = gep(%3,%4,*u64)
            store(%5,%1)
            %7 = const(1,u32)
            %8 = gep(%3,%7,**[]u8)
            store(%8,%2)`
    )
    try assert_gen(
        `lib a
        let x = ""`,
        `%1 = const(0,u64)
            %2 = const_array("",1,*[]u8)
            %3 = alloca([u64,*[]u8],8)
            %4 = const(0,u32)
            %5 = gep(%3,%4,*u64)
            store(%5,%1)
            %7 = const(1,u32)
            %8 = gep(%3,%7,**[]u8)
            store(%8,%2)`
    )
    try assert_gen(
        `lib a
        let x = "" == ""`,
        `%19 = extern_ref("dash/internal/runtime/string_compare",dash/internal/runtime/string_compare)
            %20 = call(%19,%3,%12,[bool])
            %21 = const(0,u32)
            %22 = gep(%20,%21,*bool)
            %23 = load(%22,bool)`
    )
    try assert_gen(
        `lib a
        let x = "1" + "2"`,
        `%19 = extern_ref("dash/internal/runtime/string_concat",dash/internal/runtime/string_concat)
            %20 = call(%19,%3,%12,[[u64,*[]u8]])
            %21 = const(0,u32)
            %22 = gep(%20,%21,*[u64,*[]u8])
            %23 = load(%22,[u64,*[]u8])`
    )
    try assert_gen(
        `lib a
        let x = "" != ""`,
        `%19 = extern_ref("dash/internal/runtime/string_compare",dash/internal/runtime/string_compare)
            %20 = call(%19,%3,%12,[bool])
            %21 = const(0,u32)
            %22 = gep(%20,%21,*bool)
            %23 = load(%22,bool)
            %24 = lnot(%23)`
    )
}

@test
fn test_dot_expression_first_field()! {
    try assert_gen(
        `lib a
        struct point { x i32 y i32 }
        fn f() i32 {
            let p = point{x: 1, y: 2}
            return p.x
        }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %4 = const(1,i64)
            %5 = cast(%4,i32)
            %6 = const(2,i64)
            %7 = cast(%6,i32)
            %8 = alloca([i32,i32],8)
            %9 = const(0,u32)
            %10 = gep(%8,%9,*i32)
            store(%10,%5)
            %12 = const(1,u32)
            %13 = gep(%8,%12,*i32)
            store(%13,%7)
            %15 = const(0,u32)
            %16 = gep(%8,%15,*i32)
            %17 = load(%16,i32)
            %18 = alloca([i32],8)
            %19 = const(0,u32)
            %20 = gep(%18,%19,*i32)
            store(%20,%17)
            ret_1(%18)`
    )
}

