            store(%25,%23)
            %27 = poison(slot[u64])
            %28 = const(2,u32)
            %29 = gep(%6,%28,*slot[u64])
            store(%29,%27)
            jmp(a/foo/3)
          a/foo/1:
            %33 = const(1,u32)
            %34 = gep(%2,%33,**[]i64)
            %35 = load(%34,*[]i64)
            %36 = gep(%35,%15,*i64)
            %37 = load(%36,i64)
            %38 = const(0,u32)
            %39 = gep(%6,%38,*i64)
            store(%39,%37)
            %41 = const(0,u32)
            %42 = const(1,u32)
            %43 = gep(%6,%42,*u32)
            store(%43,%41)
            %45 = poison(slot[u64])
            %46 = const(2,u32)
            %47 = gep(%6,%46,*slot[u64])
            store(%47,%45)
            jmp(a/foo/3)
          a/foo/3:
            %51 = const(1,u32)
            %52 = gep(%6,%51,*[u64,slot[u64]])
            %53 = const(0,u32)
            %54 = gep(%52,%53,*u64)
            %55 = load(%54,u64)
            %56 = const(0,u64)
            %57 = eq(%55,%56)
            br(%57,a/foo/4,a/foo/5)
          a/foo/5:
            %60 = const(1,u32)
            %61 = gep(%52,%60,*slot[u64])
            %62 = load(%61,slot[u64])
            %63 = alloca([u64,slot[u64]],8)
            %64 = const(0,u32)
            %65 = gep(%63,%64,*u64)
            store(%65,%55)
            %67 = const(1,u32)
            %68 = gep(%63,%67,*slot[u64])
            store(%68,%62)
            %70 = poison(i64)
            %71 = alloca([i64,[u64,slot[u64]]],8)
            %72 = const(0,u32)
            %73 = gep(%71,%72,*i64)
            store(%73,%70)
            %75 = load(%63,[u64,slot[u64]])
            %76 = const(1,u32)
            %77 = gep(%71,%76,*[u64,slot[u64]])
            store(%77,%75)
            ret_1(%71)
          a/foo/4:
            %81 = const(0,u32)
            %82 = gep(%6,%81,*i64)
            %83 = load(%82,i64)
            %84 = const(0,u64)
            %85 = poison(slot[u64])
            %86 = alloca([u64,slot[u64]],8)
            %87 = const(0,u32)
            %88 = gep(%86,%87,*u64)
            store(%88,%84)
            %90 = const(1,u32)
            %91 = gep(%86,%90,*slot[u64])
            store(%91,%85)
            %93 = alloca([i64,[u64,slot[u64]]],8)
            %94 = const(0,u32)
            %95 = gep(%93,%94,*i64)
            store(%95,%83)
            %97 = load(%86,[u64,slot[u64]])
            %98 = const(1,u32)
            %99 = gep(%93,%98,*[u64,slot[u64]])
            store(%99,%97)
