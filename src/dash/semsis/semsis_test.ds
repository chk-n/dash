@test
fn test_for_infinite_empty_body()! {
    try assert_gen(
        `lib a
        fn f() { for { break } }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            jmp(a/f/1)
          a/f/1:
            jmp(a/f/2)
          a/f/2:`
    )
}

@test
fn test_for_infinite_with_next()! {
    try assert_gen(
        `lib a
        fn f(x bool) {
            for {
                if x { next }
                break
            }
        }`,
        `fn a/f:
            %2 = arg(x,bool)
            jmp(a/f/0)
          a/f/0:
            jmp(a/f/1)
          a/f/1:
            br(%2,a/f/3,a/f/4)
          a/f/3:
            jmp(a/f/1)
          a/f/4:
            jmp(a/f/2)
          a/f/2:`
    )
}

