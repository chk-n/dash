@test
fn test_fallible_function_void_return()! {
    try assert_gen(
        `lib a
        fn f()! { return }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %4 = const(0,u64)
            %5 = poison(slot[u64])
            %6 = alloca([u64,slot[u64]],8)
            %7 = const(0,u32)
            %8 = gep(%6,%7,*u64)
            store(%8,%4)
            %10 = const(1,u32)
            %11 = gep(%6,%10,*slot[u64])
            store(%11,%5)
            %13 = alloca([[u64,slot[u64]]],8)
            %14 = load(%6,[u64,slot[u64]])
            %15 = const(0,u32)
            %16 = gep(%13,%15,*[u64,slot[u64]])
            store(%16,%14)
            ret_1(%13)`
    )
}

@test
fn test_fallible_function_value_return()! {
    try assert_gen(
        `lib a
        fn f()! i32 { return 42 }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %4 = const(42,i64)
            %5 = cast(%4,i32)
            %6 = const(0,u64)
            %7 = poison(slot[u64])
            %8 = alloca([u64,slot[u64]],8)
            %9 = const(0,u32)
            %10 = gep(%8,%9,*u64)
            store(%10,%6)
            %12 = const(1,u32)
            %13 = gep(%8,%12,*slot[u64])
            store(%13,%7)
            %15 = alloca([i32,[u64,slot[u64]]],8)
            %16 = const(0,u32)
            %17 = gep(%15,%16,*i32)
            store(%17,%5)
            %19 = load(%8,[u64,slot[u64]])
            %20 = const(1,u32)
            %21 = gep(%15,%20,*[u64,slot[u64]])
            store(%21,%19)
            ret_1(%15)`
    )
}

@test
fn test_fallible_function_multi_value_return()! {
    try assert_gen(
        `lib a
        fn f()! i32, bool { return 1, true }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %4 = const(1,i64)
            %5 = cast(%4,i32)
            %6 = const(true,bool)
            %7 = const(0,u64)
            %8 = poison(slot[u64])
            %9 = alloca([u64,slot[u64]],8)
            %10 = const(0,u32)
            %11 = gep(%9,%10,*u64)
            store(%11,%7)
            %13 = const(1,u32)
            %14 = gep(%9,%13,*slot[u64])
            store(%14,%8)
            %16 = alloca([i32,bool,[u64,slot[u64]]],8)
            %17 = const(0,u32)
            %18 = gep(%16,%17,*i32)
            store(%18,%5)
            %20 = const(1,u32)
            %21 = gep(%16,%20,*bool)
            store(%21,%6)
            %23 = load(%9,[u64,slot[u64]])
            %24 = const(2,u32)
            %25 = gep(%16,%24,*[u64,slot[u64]])
            store(%25,%23)
            ret_1(%16)`
    )
}

