            %12 = const(1,u32)
            %13 = gep(%8,%12,*i32)
            store(%13,%7)
            %15 = const(10,i64)
            %16 = cast(%15,i32)
            %17 = const(20,i64)
            %18 = cast(%17,i32)
            %19 = alloca([i32,i32],8)
