@test
fn test_dot_expression_sequence()! {
    try assert_gen(
        `lib a
        struct triple { a i32 b i32 c i32 }
        fn f(t triple) i32 {
            let x = t.a
            let y = t.b
            let z = t.c
            return x + y + z
        }`,
        `fn a/f:
            %2 = arg(t,*[i32,i32,i32])
            jmp(a/f/0)
          a/f/0:
            %5 = const(0,u32)
            %6 = gep(%2,%5,*i32)
            %7 = load(%6,i32)
            %8 = const(1,u32)
            %9 = gep(%2,%8,*i32)
            %10 = load(%9,i32)
            %11 = const(2,u32)
            %12 = gep(%2,%11,*i32)
            %13 = load(%12,i32)
            %14 = add(%7,%10)
            %15 = add(%14,%13)
            %16 = alloca([i32],8)
            %17 = const(0,u32)
            %18 = gep(%16,%17,*i32)
            store(%18,%15)
            ret_1(%16)`
    )
}

