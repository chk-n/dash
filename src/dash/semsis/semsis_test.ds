@test
fn test_get_array_i64()! {
    try assert_gen(
        `lib a
        fn foo(arr []i64, idx i64)! i64 {
            return try get(arr, idx)
        }`,
        `a/init:
        fn a/foo:
            %2 = arg(arr,*[u64,*[]i64])
            %3 = arg(idx,i64)
