@test
fn test_any_error_no_arguments()! {
    try assert_error(
        `lib a
        fn main() {
           let x = many()
        }`,
        [too_few_arguments{expected: 1, found: 0, pos: ast.index(6)}]
    )
}

@test
fn test_any_error_too_many_arguments()! {
    try assert_error(
        `lib a
        fn main() {
           let x = many(1, 2)
        }`,
        [too_many_arguments{expected: 1, found: 2, pos: ast.index(9)}]
    )
}

@test
fn test_any_error_assign_to_concrete()! {
    try assert_error(
        `lib a
        fn f(x i64) {}
        fn main() {
           let x = many(42)
           f(x)
        }`,
        [cannot_assign_to_type{got: types.MANY_IDX, want: types.I64_IDX, pos: ast.index(18)}]
    )
}

