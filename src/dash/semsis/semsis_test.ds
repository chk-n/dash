@test
fn test_struct_literal_module_scope()! {
    try assert_gen(
        `lib a
        struct b{f1 u64 f2 bool}
        let x = b{f1: 10, f2: true}`,
        `a/init:
            %1 = const(10,i64)
            %2 = cast(%1,u64)
            %3 = const(true,bool)
            %4 = alloca([u64,bool],8)
            %5 = const(0,u32)
            %6 = gep(%4,%5,*u64)
            store(%6,%2)
            %8 = const(1,u32)
            %9 = gep(%4,%8,*bool)
            store(%9,%3)`
    )
}

@test
fn test_struct_literal_function_scope()! {
    try assert_gen(
        `lib a
        struct b{f1 u64 f2 bool}
        fn main() {
            let x = b{f1: 10, f2: true}
        }`,
        `a/main/0:
            %4 = const(10,i64)
            %5 = cast(%4,u64)
            %6 = const(true,bool)
            %7 = alloca([u64,bool],8)
            %8 = const(0,u32)
            %9 = gep(%7,%8,*u64)
            store(%9,%5)
            %11 = const(1,u32)
            %12 = gep(%7,%11,*bool)
            store(%12,%6)`
    )
}

@test
fn test_struct_literal_nested()! {
    // TODO: nested structs through pointer
    // TODO: nested structs through optional
    try assert_gen(
        `lib a
        struct b {f1 c f2 u32}
        struct c {f1 u64 f2 u64}
        fn main() {
            let x = b{f1: c{f1: 2, f2: 3}, f2: 10}
        }`,
        `a/main/0:
            %4 = const(2,i64)
            %5 = cast(%4,u64)
            %6 = const(3,i64)
            %7 = cast(%6,u64)
            %8 = alloca([u64,u64],8)
            %9 = const(0,u32)
            %10 = gep(%8,%9,*u64)
            store(%10,%5)
            %12 = const(1,u32)
            %13 = gep(%8,%12,*u64)
            store(%13,%7)
            %15 = const(10,i64)
            %16 = cast(%15,u32)
            %17 = alloca([[u64,u64],u32],8)
            %18 = load(%8,[u64,u64])
            %19 = const(0,u32)
            %20 = gep(%17,%19,*[u64,u64])
            store(%20,%18)
            %22 = const(1,u32)
            %23 = gep(%17,%22,*u32)
            store(%23,%16)`
    )
}

