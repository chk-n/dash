        let x = true - false`,
        [illegal_operator_use{type_idx: types.BOOL_IDX, pos: ast.index(6)}])
    try assert_error(`lib a
        let x = true & false`,
        [illegal_operator_use{type_idx: types.BOOL_IDX, pos: ast.index(6)}])
    try assert_error(`lib a
