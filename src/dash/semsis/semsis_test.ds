@test
fn test_address_of_integer_literal()! {
    try assert_gen(`lib a
        let x = &5`,
        `a/init:
            %1 = const(5,i64)
            %2 = alloca(i64,8)
            store(%2,%1)`
    )
}

@test
fn test_address_of_variable()! {
    try assert_gen(`lib a
        let x = 10
        let y = &x`,
        `a/init:
            %1 = const(10,i64)
            %2 = alloca(i64,8)
            store(%2,%1)`
    )
}

@test
fn test_address_of_bool_literal()! {
    try assert_gen(`lib a
        let x = &true`,
        `a/init:
            %1 = const(true,bool)
            %2 = alloca(bool,8)
            store(%2,%1)`
    )
}

@test
fn test_address_of_u32_param()! {
    try assert_gen(`lib a
        fn f(x u32) *u32 {
            return &x
        }`,
        `fn a/f:
            %2 = arg(x,u32)
            jmp(a/f/0)
          a/f/0:
            %5 = alloca(u32,8)
            store(%5,%2)
            %7 = alloca([*u32],8)
            %8 = const(0,u32)
            %9 = gep(%7,%8,**u32)
            store(%9,%5)
            ret_1(%7)`
    )
}

@test
fn test_address_of_string_param()! {
    try assert_gen(`lib a
        fn f(x string) *string {
            return &x
        }`,
        `fn a/f:
            %2 = arg(x,*[u64,*[]u8])
            jmp(a/f/0)
          a/f/0:
            %5 = alloca([*[u64,*[]u8]],8)
            %6 = const(0,u32)
            %7 = gep(%5,%6,**[u64,*[]u8])
            store(%7,%2)
            ret_1(%5)`
    )
}

@test
fn test_address_of_struct_var()! {
    try assert_gen(`lib a
        struct point { x i64 y i64 }
        let p = point{x: 4, y: 5}
        let x = &p`,
        `a/init:
            %1 = const(4,i64)
            %2 = const(5,i64)
            %3 = alloca([i64,i64],8)
            %4 = const(0,u32)
            %5 = gep(%3,%4,*i64)
            store(%5,%1)
            %7 = const(1,u32)
            %8 = gep(%3,%7,*i64)
            store(%8,%2)`
    )
}

@test
fn test_address_of_struct_literal()! {
    try assert_gen(`lib a
        struct point { x i64 y i64 }
        let p = &point{x: 4, y: 5}`,
        `a/init:
            %1 = const(4,i64)
            %2 = const(5,i64)
            %3 = alloca([i64,i64],8)
            %4 = const(0,u32)
            %5 = gep(%3,%4,*i64)
            store(%5,%1)
            %7 = const(1,u32)
            %8 = gep(%3,%7,*i64)
            store(%8,%2)`
    )
}

@test
fn test_address_of_in_condition()! {
    try assert_gen(`lib a
        let x = 10
        let y = if true { &x } else { &x }`,
        `a/init:
            %1 = const(10,i64)
            %2 = const(true,bool)
            br(%2,a/init/0,a/init/1)
          a/init/0:
            %5 = alloca(i64,8)
            store(%5,%1)
            jmp(a/init/2(%5))
          a/init/1:
            %9 = alloca(i64,8)
            store(%9,%1)
            jmp(a/init/2(%9))
          a/init/2:
            %13 = block_arg(*i64)`
    )
}

