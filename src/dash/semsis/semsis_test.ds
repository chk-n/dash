@test
fn test_function_call_basic()! {
    try assert_gen(
        `lib a
        fn bar() { }
        fn foo() {
            bar()
        }`,
        `fn a/foo:
            jmp(a/foo/0)
          a/foo/0:
            %7 = extern_ref("a/bar",a/bar)
            %8 = call(%7,null)`
    )
}

@test
fn test_function_call_single_return()! {
    try assert_gen(
        `lib a
        fn getv() i32 {
            return 1
        }
        fn foo() {
            let x = getv()
        }`,
        `fn a/getv:
            jmp(a/getv/0)
          a/getv/0:
            %4 = const(1,i64)
            %5 = cast(%4,i32)
            %6 = alloca([i32],8)
            %7 = const(0,u32)
            %8 = gep(%6,%7,*i32)
            store(%8,%5)
            ret_1(%6)
        fn a/foo:
            jmp(a/foo/0)
          a/foo/0:
            %14 = extern_ref("a/getv",a/getv)
            %15 = call(%14,[i32])
            %16 = const(0,u32)
            %17 = gep(%15,%16,*i32)
            %18 = load(%17,i32)`
    )
}

@test
fn test_function_call_multiple_returns()! {
    try assert_gen(
        `lib a
        fn swap(x, y i32) i32, i32 {
            return y, x
        }
        fn foo() {
            let a, let b = swap(1,2)
        }`,
        `fn a/swap:
            %2 = arg(x,i32)
            %3 = arg(y,i32)
            jmp(a/swap/0)
          a/swap/0:
            %6 = alloca([i32,i32],8)
            %7 = const(0,u32)
            %8 = gep(%6,%7,*i32)
            store(%8,%3)
            %10 = const(1,u32)
            %11 = gep(%6,%10,*i32)
            store(%11,%2)
            ret_1(%6)
        fn a/foo:
            jmp(a/foo/0)
          a/foo/0:
            %17 = extern_ref("a/swap",a/swap)
            %18 = const(1,i64)
            %19 = cast(%18,i32)
            %20 = const(2,i64)
            %21 = cast(%20,i32)
            %22 = call(%17,%19,%21,[i32,i32])
            %23 = const(0,u32)
            %24 = gep(%22,%23,*i32)
            %25 = load(%24,i32)
            %26 = const(1,u32)
            %27 = gep(%22,%26,*i32)
            %28 = load(%27,i32)`
    )
}

