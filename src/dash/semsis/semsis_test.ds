@test
fn test_optionals_pass_value()! {
    try assert_gen(
        `lib a
        fn test(a ?i64) {}
        fn main() { test(42) }`,
        `fn a/test:
            %2 = arg(a,*[bool,i64])
            jmp(a/test/0)
          a/test/0:
        fn a/main:
            jmp(a/main/0)
          a/main/0:
            %8 = extern_ref("a/test",a/test)
            %9 = const(42,i64)
            %10 = const(true,bool)
            %11 = alloca([bool,i64],8)
            %12 = const(0,u32)
            %13 = gep(%11,%12,*bool)
            store(%13,%10)
            %15 = const(1,u32)
            %16 = gep(%11,%15,*i64)
            store(%16,%9)
            %18 = call(%8,%11,null)`
    )
}

@test
fn test_optionals_pass_none()! {
    try assert_gen(
        `lib a
        fn test(a ?i64) {}
        fn main() { test(none) }`,
        `fn a/test:
            %2 = arg(a,*[bool,i64])
            jmp(a/test/0)
          a/test/0:
        fn a/main:
            jmp(a/main/0)
          a/main/0:
            %8 = extern_ref("a/test",a/test)
            %9 = const(false,bool)
            %10 = poison(i64)
            %11 = alloca([bool,i64],8)
            %12 = const(0,u32)
            %13 = gep(%11,%12,*bool)
            store(%13,%9)
            %15 = const(1,u32)
            %16 = gep(%11,%15,*i64)
            store(%16,%10)
            %18 = call(%8,%11,null)`
    )
}
@test
fn test_optionals_return_none()! {
