@test
fn test_value_of_struct()! {
    try assert_gen(`lib a
        struct point { x i64 y i64 }
        fn f(p *point) point {
            return *p
        }`,
        `fn a/f:
            %2 = arg(p,*[i64,i64])
            jmp(a/f/0)
          a/f/0:
            %5 = alloca([[i64,i64]],8)
            %6 = const(0,u32)
            %7 = gep(%5,%6,*[i64,i64])
            store(%7,%2)
            ret_1(%5)`
    )
}

@test
fn test_value_of_expression_context()! {
    try assert_gen(`lib a
        fn f(x *i64, y *i64) i64 {
            return *x + *y
        }`,
        `fn a/f:
            %2 = arg(x,*i64)
            %3 = arg(y,*i64)
            jmp(a/f/0)
          a/f/0:
            %6 = load(%2,i64)
            %7 = load(%3,i64)
            %8 = add(%6,%7)
            %9 = alloca([i64],8)
            %10 = const(0,u32)
            %11 = gep(%9,%10,*i64)
            store(%11,%8)
            ret_1(%9)`
    )
}
@test
fn test_value_of_string()! {
    try assert_gen(`lib a
        fn f(x *string) string {
            return *x
        }`,
        `fn a/f:
            %2 = arg(x,*[u64,*[]u8])
            jmp(a/f/0)
          a/f/0:
            %5 = alloca([[u64,*[]u8]],8)
            %6 = const(0,u32)
            %7 = gep(%5,%6,*[u64,*[]u8])
            store(%7,%2)
            ret_1(%5)`
    )
}

