@test
fn test_union_type_construct_first_variant()! {
    try assert_gen(
        `lib a
        union u { i32 bool }
        fn f() u { return u(42) }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %4 = const(42,i64)
            %5 = cast(%4,i32)
            %6 = alloca([u32,slot[u64]],8)
            %7 = const(0,u32)
            %8 = const(0,u32)
            %9 = gep(%6,%8,*u32)
            store(%9,%7)
            %11 = const(1,u32)
            %12 = gep(%6,%11,*slot[u64])
            %13 = bitcast(%5,slot[u64])
            store(%12,%13)`
    )
}

@test
fn test_union_type_construct_second_variant()! {
