    )
}

@test
fn test_catch_expr_uses_error_ident()! {
    try assert_error(
        `lib a
        fn g()! u32 { return 1 }
        fn f() u32 {
            let x = g() catch e { e }
            return x
        }`,
        [cannot_assign_to_type{got: types.ERROR_IDX, want: types.U32_IDX, pos: ast.index(18)}]
    )
}

@test
fn test_catch_expr_type_mismatch()! {
    try assert_error(
        `lib a
        fn g()! i32 { return 1 }
        fn f() i32 {
            let x = g() catch e { "hello" }
            return x
        }`,
        [cannot_assign_to_type{got: types.STRING_IDX, want: types.I32_IDX, pos: ast.index(19)}]
    )
}

