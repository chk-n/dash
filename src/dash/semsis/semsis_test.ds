            %45 = gep(%43,%44,*u64)
            store(%45,%11)
            %47 = const(1,u32)
            %48 = gep(%43,%47,**[]i64)
            store(%48,%40)
            %50 = const(0,u32)
            %51 = gep(%6,%50,*[u64,*[]i64])
            store(%51,%43)
            %53 = const(0,u32)
            %54 = const(1,u32)
            %55 = gep(%6,%54,*u32)
            store(%55,%53)
            %57 = poison(slot[u64])
            %58 = const(2,u32)
            %59 = gep(%6,%58,*slot[u64])
            store(%59,%57)
            jmp(a/foo/1)
          a/foo/1:
            %63 = const(1,u32)
            %64 = gep(%6,%63,*[u64,slot[u64]])
            %65 = const(0,u32)
            %66 = gep(%64,%65,*u64)
            %67 = load(%66,u64)
            %68 = const(0,u64)
            %69 = eq(%67,%68)
            br(%69,a/foo/4,a/foo/5)
          a/foo/5:
            %72 = const(1,u32)
            %73 = gep(%64,%72,*slot[u64])
            %74 = load(%73,slot[u64])
            %75 = alloca([u64,slot[u64]],8)
            %76 = const(0,u32)
            %77 = gep(%75,%76,*u64)
            store(%77,%67)
            %79 = const(1,u32)
            %80 = gep(%75,%79,*slot[u64])
            store(%80,%74)
            %82 = poison([u64,*[]i64])
            %83 = alloca([[u64,*[]i64],[u64,slot[u64]]],8)
            %84 = const(0,u32)
            %85 = gep(%83,%84,*[u64,*[]i64])
            store(%85,%82)
            %87 = load(%75,[u64,slot[u64]])
            %88 = const(1,u32)
            %89 = gep(%83,%88,*[u64,slot[u64]])
            store(%89,%87)
            ret_1(%83)
          a/foo/4:
            %93 = const(0,u32)
            %94 = gep(%6,%93,*[u64,*[]i64])
            %95 = load(%94,[u64,*[]i64])
