@test
fn test_catch_raise_propagate()! {
    try assert_gen(
        `lib a
        error my_err
        fn g()! i32 { raise my_err }
        fn f()! i32 {
            let x = g() catch e { raise e }
            return x
        }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %26 = extern_ref("a/g",a/g)
            %27 = call(%26,[i32,[u64,slot[u64]]])
            %28 = const(1,u32)
            %29 = gep(%27,%28,*[u64,slot[u64]])
            %30 = const(0,u32)
            %31 = gep(%29,%30,*u64)
            %32 = load(%31,u64)
            %33 = const(0,u64)
            %34 = eq(%32,%33)
            br(%34,a/f/1,a/f/2)
          a/f/1:
            %37 = const(0,u32)
            %38 = gep(%27,%37,*i32)
            %39 = load(%38,i32)
            jmp(a/f/3(%39))
          a/f/2:
            %42 = const(0,u32)
            %43 = gep(%29,%42,*u64)
            %44 = load(%43,u64)
            %45 = const(1,u32)
            %46 = gep(%29,%45,*slot[u64])
            %47 = load(%46,slot[u64])
            %48 = alloca([u64,slot[u64]],8)
            %49 = const(0,u32)
            %50 = gep(%48,%49,*u64)
            store(%50,%44)
            %52 = const(1,u32)
            %53 = gep(%48,%52,*slot[u64])
            store(%53,%47)
            %55 = poison(i32)
            %56 = alloca([i32,[u64,slot[u64]]],8)
            %57 = const(0,u32)
            %58 = gep(%56,%57,*i32)
            store(%58,%55)
            %60 = load(%48,[u64,slot[u64]])
            %61 = const(1,u32)
            %62 = gep(%56,%61,*[u64,slot[u64]])
            store(%62,%60)
            ret_1(%56)
          a/f/3:
            %66 = block_arg(i32)
            %67 = const(0,u64)
            %68 = poison(slot[u64])
            %69 = alloca([u64,slot[u64]],8)
            %70 = const(0,u32)
            %71 = gep(%69,%70,*u64)
            store(%71,%67)
            %73 = const(1,u32)
            %74 = gep(%69,%73,*slot[u64])
            store(%74,%68)
            %76 = alloca([i32,[u64,slot[u64]]],8)
            %77 = const(0,u32)
            %78 = gep(%76,%77,*i32)
            store(%78,%66)
            %80 = load(%69,[u64,slot[u64]])
            %81 = const(1,u32)
            %82 = gep(%76,%81,*[u64,slot[u64]])
            store(%82,%80)
            ret_1(%76)`
    )
}

