@test
fn test_many_type_struct_small()! {
    // BUG: right now struct does not fit in slot due to 8 byte
    // alignment BUT fits_in_slot does not take this into account.
    // it just outright rejects structs.
    // we need a better solution for this
    try assert_gen(
        `lib a
        struct point { x i32  y i32 }
        fn main() {
           let p = point{x: 1, y: 2}
           let a = many(p)
        }`,
        `fn a/main:
            jmp(a/main/0)
          a/main/0:
            %4 = const(1,i64)
            %5 = cast(%4,i32)
            %6 = const(2,i64)
            %7 = cast(%6,i32)
            %8 = alloca([i32,i32],8)
            %9 = const(0,u32)
            %10 = gep(%8,%9,*i32)
            store(%10,%5)
            %12 = const(1,u32)
            %13 = gep(%8,%12,*i32)
            store(%13,%7)
            %15 = alloca([u32,slot[u64]],8)
            %16 = const(15,u32)
            %17 = const(0,u32)
            %18 = gep(%15,%17,*u32)
            store(%18,%16)
            %20 = const(1,u32)
            %21 = gep(%15,%20,*slot[u64])
            %22 = bitcast(%8,slot[u64])
            store(%21,%22)`
    )
}

