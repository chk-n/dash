}


@test
fn test_defer_zero_arg_block_fallthrough()! {
    try assert_gen(
        `lib a
        fn cleanup() {}
        fn f() {
            defer cleanup()
        }`,
        `a/init:
        fn a/cleanup:
            jmp(a/cleanup/0)
          a/cleanup/0:
        fn a/f:
            jmp(a/f/0)
          a/f/0:
            %7 = extern_ref("a/f_defer$0",a/f_defer$0)
            %8 = bitcast(%7,slot[u64])
            %9 = const(0,u64)
            %10 = alloca_array([]slot[u64],%9,8)
            %11 = alloca([u64,*[]slot[u64]],8)
            %12 = const(0,u32)
            %13 = gep(%11,%12,*u64)
            store(%13,%9)
            %15 = const(1,u32)
            %16 = gep(%11,%15,**[]slot[u64])
            store(%16,%10)
            %18 = extern_ref("dash/internal/runtime/defer_register",dash/internal/runtime/defer_register)
            %19 = call(%18,%8,%11,null)
            %20 = extern_ref("dash/internal/runtime/defer_pop",dash/internal/runtime/defer_pop)
            %21 = call(%20,*dash/internal/runtime/defer_node)
            %22 = extern_ref("a/f_defer$0",a/f_defer$0)
            %23 = call(%22,%21,null)
        fn a/f_defer$0:
            %25 = arg(node,*dash/internal/runtime/defer_node)
          a/f_defer$0/1:
            %27 = const(2,u32)
            %28 = gep(%25,%27,*[]slot[u64])
            %29 = const(0,u32)
            %30 = gep(%28,%29,*u64)
            %31 = load(%30,u64)
            %32 = const(1,u32)
            %33 = gep(%28,%32,**slot[u64])
            %34 = load(%33,*slot[u64])
            %35 = extern_ref("a/cleanup",a/cleanup)
            %36 = call(%35,null)
            ret_1()`
    )
}

