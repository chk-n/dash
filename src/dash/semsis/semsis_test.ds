// assert_type returns type_idx, raises if not found
fn assert_type(s *semsis, path string)! types.index {
    let idx = try get_type_idx(s, s.current_scope, path)
    if idx == null {
        raise test_error{reason: "expected type: " + path}
    }
    return ?idx
}

fn assert_ns_lib_scope(np *namespace.pool, val namespace.entry, owner types.index)! {
    match v = val {
    case namespace.scope:
        try assert(v.owner == owner, "owner type should match")
        try assert(v.parent_idx != namespace.NULL_IDX, "parent should point to library scope")
        let parent = try namespace.get_scope(np, v.parent_idx)
        try assert(parent.parent_idx == namespace.NULL_IDX, "expected library scope")
        try assert(parent.owner == types.NULL_IDX, "expected library scope")
    case _:
        raise test_error{reason: "expected namespace.scope type"}
    }
}

fn assert_has_identifier_redeclared_error(s *semsis, expected_pos ast.index)! {
    for i = 0; i < len(s.errs); i++ {
        let err = try get(s.errs, i)
        match e = err {
        case identifier_redeclared:
            if e.pos != expected_pos {
                println(ast.print_token_marker(s.ast, e.pos))
            }
            let msg = fmt.stringf("identifier_redeclared pos mismatch, want: %d got: %d", [expected_pos, e.pos])
            try assert(e.pos == expected_pos, msg)
            return
        case _:
            println(err)
            next
        }
    }
    raise test_error{reason: "expected identifier_redeclared error"}
}

error test_error {
    reason string
}

// assert_gen verifies the block of instructions found in 'want'
// are found consecutively within got, but this matching only starts
// once first instruction in want matched one in got. thereafter each
// instruction found in want needs to be in got
fn assert_gen(got, want string)! {
    let a = try parser.parse([]byte(got), parser.mode.lib)
    if len(a.errs) != 0 {
        println(a.errs)
    }
    try assert(len(a.errs) == 0, "expected no parser errors")

    var ctx = try new_context()
    var s = try new("a", a, ctx)

    let m =  map.new[intern.index, namespace.index]()
    let l, ctx, let _ = try analyse(s, m)
    if len(l.errs) != 0 {
        println("expected no errors but got:")
        for i = 0; i < len(l.errs); i++ {
            let err = try get(l.errs, i)
            println(err)
            let pos = try get_error_pos(err)
            println(ast.print_token_marker(s.ast, pos))
        }
    }
    try assert(len(l.errs) == 0, "expected no semsis errors")

    let got = try ir.to_string(l, ctx.ip, len(l.ins)-1, "")
    let got_parts = try strings.split(got, "\n")
    let want_parts = try strings.split(want, "\n")
    var success = true
    var matched = false
    let wp = try get(want_parts, 0)
    for i = 0; i < len(got_parts); i++ {
        let gp = try get(got_parts, i)
        if strings.contains(gp, wp) {
            matched = true
            for j = 0; j < len(want_parts); j++ {
                if i >= len(got_parts) {
                    success = false
                    break
                }
                var gp = try get(got_parts, i)
                var wp = try get(want_parts, j)
                gp = strings.trim(gp)
                wp = strings.trim(wp)
                if !strings.contains(gp, wp) {
                    success = false
                }
                i = i + 1
            }
            break
        }
    }
    if !matched || !success {
        println(got)
    }
    try assert(matched && success, "expected to find matching instruction")
}

fn assert_error(inp string, want_errs []error)! {
    let a = try parser.parse([]byte(inp), parser.mode.lib)
    if len(a.errs) != 0 {
        println("Parser errors:")
        println(a.errs)
    }
    try assert(len(a.errs) == 0, "expected no parser errors")

    var ctx = try new_context()
    var s = try new("a", a, ctx)

    let m =  map.new[intern.index, namespace.index]()
    let l, let _, let _ = try analyse(s, m)

    if len(l.errs) != len(want_errs) {
        println(fmt.stringf("error count mismatch: got %d, want %d", [len(l.errs), len(want_errs)]))
        println("got errors:")
        for i = 0; i < len(l.errs); i++ {
            let err = try get(l.errs, i)
            println(err)
            let pos = try get_error_pos(err)
            println(ast.print_token_marker(s.ast, pos))
        }
        println("want errors:")
        for i = 0; i < len(want_errs); i++ {
            println(try get(want_errs, i))
        }
    }

    try assert(len(l.errs) == len(want_errs), "expected error count to match")

    for i = 0; i < len(want_errs); i++ {
        let got_err = try get(l.errs, i)
        let want_err = try get(want_errs, i)
        if got_err != want_err {
            println(fmt.stringf("error[%d] mismatch:", [i]))
            println("  got: ")
            println(got_err)
            println("  want:")
            println(want_err)
            let pos = try get_error_pos(got_err)
            println(ast.print_token_marker(s.ast, pos))
        }
        try assert(got_err == want_err, "expected errors to match")
    }
}

