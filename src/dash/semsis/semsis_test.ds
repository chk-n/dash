}

@test
fn test_panic_terminates_block()! {
    try assert_gen(
        `lib a
        fn foo(x i64) i64 {
            if x < 0 {
                panic("negative")
            }
            return x
        }`,
        `fn a/foo:
            %2 = arg(x,i64)
            jmp(a/foo/0)
          a/foo/0:
            %5 = const(0,i64)
            %6 = lt(%2,%5)
            br(%6,a/foo/1,a/foo/2)
          a/foo/1:
            %9 = const(8,u64)
            %10 = const_array("negative",1,*[]u8)
            %11 = alloca([u64,*[]u8],8)
            %12 = const(0,u32)
            %13 = gep(%11,%12,*u64)
            store(%13,%9)
            %15 = const(1,u32)
            %16 = gep(%11,%15,**[]u8)
            store(%16,%10)
            %18 = extern_ref("dash/internal/runtime/panic",dash/internal/runtime/panic)
            %19 = call(%18,%11,null)
            unreachable
          a/foo/2:
            %22 = alloca([i64],8)
            %23 = const(0,u32)
            %24 = gep(%22,%23,*i64)
            store(%24,%2)
            ret_1(%22)`
    )
}

