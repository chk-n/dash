@test
fn test_dot_expression_deeply_nested()! {
    try assert_gen(
        `lib a
        struct d_s { d i32 }
        struct c_s { c d_s }
        struct b_s { b c_s }
        fn f() {
            let x = b_s{b: c_s{c: d_s{d: 7}}}
            let y = x.b.c.d
        }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %4 = const(7,i64)
            %5 = cast(%4,i32)
            %6 = alloca([i32],8)
            %7 = const(0,u32)
            %8 = gep(%6,%7,*i32)
            store(%8,%5)
            %10 = alloca([[i32]],8)
            %11 = load(%6,[i32])
            %12 = const(0,u32)
            %13 = gep(%10,%12,*[i32])
            store(%13,%11)
            %15 = alloca([[[i32]]],8)
            %16 = load(%10,[[i32]])
            %17 = const(0,u32)
            %18 = gep(%15,%17,*[[i32]])
            store(%18,%16)
            %20 = const(0,u32)
            %21 = gep(%15,%20,*[[i32]])
            %22 = const(0,u32)
            %23 = gep(%21,%22,*[i32])
            %24 = const(0,u32)
            %25 = gep(%23,%24,*i32)
            %26 = load(%25,i32)`
    )
}

@test
fn test_dot_expression_fn_arg()! {
    try assert_gen(
        `lib a
        struct point { x i32 y i32 }
        fn double(v i32) { }
        fn f(p point) {
            double(p.x)
        }`,
        `fn a/f:
            %6 = arg(p,*[i32,i32])
            jmp(a/f/0)
          a/f/0:
            %9 = extern_ref("a/double",a/double)
            %10 = const(0,u32)
            %11 = gep(%6,%10,*i32)
            %12 = load(%11,i32)
            %13 = call(%9,%12,null)`
    )
}

