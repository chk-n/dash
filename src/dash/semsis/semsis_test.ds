            %93 = load(%85,[u64,slot[u64]])
            %94 = const(0,u32)
            %95 = gep(%92,%94,*[u64,slot[u64]])
            store(%95,%93)
            ret_1(%92)
          a/main/6:`
    )
}

@test
fn test_linear_consumed_then_used_in_cap()! {
    try assert_error(
        `lib a
        fn consume(m memory[[]u8]) {}
        fn main()! {
           let m = try make([]u8, 10)
           consume(m)
           let c = cap(m)
        }`,
        [linear_consumed_already{name: intern.index(35), pos: ast.index(30)}]
    )
}

@test
fn test_make_error_non_integer_capacity()! {
    try assert_error(
        `lib a
        fn main()! {
           let m = try make([]u8, 10, true)
        }`,
        [make_invalid_size_argument{pos: ast.index(9)}]
    )
}

@test
fn test_make_zero_length()! {
    try assert_error(
        `lib a
        fn main()! {
           let m = try make([]u8, 0)
        }`,
        []
    )
}

@test
