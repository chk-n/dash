@test
fn test_if_stmt_ssa_vars_reassigned_order_reversed()! {
    // QUESTION: why are we swapping %10 and %9 in the branch
    // and then correctly using %16 first (i.e. "f1(x)"). Would be
    // more readable to pass %9 and %10 and then using %15 first in
    // f1(x) call
    try assert_gen(`lib a
        fn f1(x i64) {}
        fn f2(a bool) { var x, var y = 1, 2 if a { y = x x = y } f1(x) f1(y) }`,
        `fn a/f2:
            %6 = arg(a,bool)
            jmp(a/f2/0)
          a/f2/0:
            %9 = const(1,i64)
            %10 = const(2,i64)
            br(%6,a/f2/1,a/f2/2(%10,%9))
          a/f2/1:
            jmp(a/f2/2(%9,%9))
          a/f2/2:
            %15 = block_arg(i64)
            %16 = block_arg(i64)
            %17 = extern_ref("a/f1",a/f1)
            %18 = call(%17,%16,null)
            %19 = extern_ref("a/f1",a/f1)
            %20 = call(%19,%15,null)`
    )
}
@test
fn test_if_stmt_ssa_early_return_after_reassignment()! {
    // NOTE: semsis outputs block_arg in block f/2 but none is needed as
    // f/1 returns so reassignment is "unreachable"
    try assert_gen(`lib a
        fn f1(x i64) {}
        fn f(c bool) {
            var x = 1
            if c { x = 2 return }
            x = 3
            f1(x)
        }`,
        `fn a/f:
            %6 = arg(c,bool)
            jmp(a/f/0)
          a/f/0:
            %9 = const(1,i64)
            br(%6,a/f/1,a/f/2(%9))
          a/f/1:
            %12 = const(2,i64)
            ret_1()
          a/f/2:
            %15 = block_arg(i64)
            %16 = const(3,i64)
            %17 = extern_ref("a/f1",a/f1)
            %18 = call(%17,%16,null)`
    )
}

