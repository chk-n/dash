@test
fn test_fallible_raise_error_with_fields()! {
    try assert_gen(
        `lib a
        error myerr { code i32 }
        fn f()! { raise myerr{code: 42} }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %4 = const(42,i64)
            %5 = cast(%4,i32)
            %6 = alloca([i32],8)
            %7 = const(0,u32)
            %8 = gep(%6,%7,*i32)
            store(%8,%5)
            %10 = const(15,u64)
            %11 = bitcast(%6,slot[u64])
            %12 = alloca([u64,slot[u64]],8)
            %13 = const(0,u32)
            %14 = gep(%12,%13,*u64)
            store(%14,%10)
            %16 = const(1,u32)
            %17 = gep(%12,%16,*slot[u64])
            store(%17,%11)
            %19 = alloca([[u64,slot[u64]]],8)
            %20 = load(%12,[u64,slot[u64]])
            %21 = const(0,u32)
            %22 = gep(%19,%21,*[u64,slot[u64]])
            store(%22,%20)
            ret_1(%19)`
    )
}

