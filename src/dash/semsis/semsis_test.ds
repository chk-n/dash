            jmp(a/main/2)
          a/main/2:`
    )
}

@test
fn test_if_stmt_short_circuit_nested_body()! {
    try assert_gen(
        `lib a
        fn t() bool { return true }
        fn main(a, b bool) {
            if a {
                if b && t() { }
            }
        }`,
        `fn a/main:
            %11 = arg(a,bool)
            %12 = arg(b,bool)
            jmp(a/main/0)
          a/main/0:
            br(%11,a/main/1,a/main/2)
          a/main/1:
            br(%12,a/main/5,a/main/4)
          a/main/5:
            %19 = extern_ref("a/t",a/t)
            %20 = call(%19,[bool])
            %21 = const(0,u32)
            %22 = gep(%20,%21,*bool)
            %23 = load(%22,bool)
            br(%23,a/main/3,a/main/4)
          a/main/3:
            jmp(a/main/4)
          a/main/4:
            jmp(a/main/2)
          a/main/2:`
    )
}

@test
fn test_if_stmt_short_circuit_else_if()! {
    try assert_gen(
        `lib a
        fn t() bool { return true }
        fn main(a, b bool) {
            if a { } else if b && t() { }
        }`,
        `fn a/main:
            %11 = arg(a,bool)
            %12 = arg(b,bool)
            jmp(a/main/0)
          a/main/0:
            br(%11,a/main/1,a/main/2)
          a/main/1:
            jmp(a/main/4)
          a/main/2:
            br(%12,a/main/5,a/main/4)
          a/main/5:
            %21 = extern_ref("a/t",a/t)
            %22 = call(%21,[bool])
            %23 = const(0,u32)
            %24 = gep(%22,%23,*bool)
            %25 = load(%24,bool)
            br(%25,a/main/3,a/main/4)
          a/main/3:
            jmp(a/main/4)
          a/main/4:`
    )
}

@test
fn test_if_stmt_short_circuit_deeply_nested()! {
    try assert_gen(
        `lib a
        fn t() bool { return true }
        fn main(a, b, c bool) {
            if a && (b && (c || t())) { }
        }`,
        `fn a/main:
            %11 = arg(a,bool)
            %12 = arg(b,bool)
            %13 = arg(c,bool)
            jmp(a/main/0)
          a/main/0:
            br(%11,a/main/3,a/main/2)
          a/main/3:
            br(%12,a/main/4,a/main/2)
          a/main/4:
            br(%13,a/main/1,a/main/5)
          a/main/5:
            %22 = extern_ref("a/t",a/t)
            %23 = call(%22,[bool])
            %24 = const(0,u32)
            %25 = gep(%23,%24,*bool)
            %26 = load(%25,bool)
            br(%26,a/main/1,a/main/2)
          a/main/1:
            jmp(a/main/2)
          a/main/2:`
    )
}

