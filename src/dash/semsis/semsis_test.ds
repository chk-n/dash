@test
fn test_put_error_no_arguments()! {
    try assert_error(
        `lib a
        fn foo()! {
            try put()
        }`,
        [too_few_arguments{expected: 3, found: 0, pos: ast.index(3)}]
    )
}

@test
fn test_put_error_too_few_arguments()! {
    try assert_error(
        `lib a
        fn foo(arr []i64, idx i64)! {
            try put(arr, idx)
        }`,
        [too_few_arguments{expected: 3, found: 2, pos: ast.index(12)}]
    )
}

@test
fn test_put_error_too_many_arguments()! {
    try assert_error(
        `lib a
        fn foo(arr []i64, idx i64, val i64, extra i64)! {
            try put(arr, idx, val, extra)
        }`,
        [too_many_arguments{expected: 3, found: 4, pos: ast.index(18)}]
    )
}

