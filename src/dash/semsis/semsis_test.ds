@test
fn test_resolve_imports_one_lib()! {
    var ctx = try new_context()

    let lib_a_ast = try parser.parse([]byte(`lib a`), parser.mode.lib)
    try assert(len(lib_a_ast.errs) == 0, "expected no parser errors for lib_a")
    var sem_a = try new("path/a", lib_a_ast, ctx)
    try assert(len(sem_a.errs) == 0, "expected no errors")
    ctx = &context{ip: sem_a.ip, tp: sem_a.tp, np: sem_a.np, generic_defs: sem_a.generic_defs, mode: mode.debug}

    var m = map.new[intern.index, namespace.index]()
    let _, let a_path = try intern.intern_string(ctx.ip, "path/a")
    m = try map.insert(m, a_path, sem_a.current_scope)

    let lib_b_ast = try parser.parse([]byte(`lib b
        use "path/a"`), parser.mode.lib)
    try assert(len(lib_b_ast.errs) == 0, "expected no parser errors for lib_b")
    var sem_b = try new("path/b", lib_b_ast, ctx)
    sem_b = try register_imports(sem_b, m)
    try assert(len(sem_b.errs) == 0, "expected no errors")

    let scope = try get_scope_idx(sem_b, sem_b.current_scope, "a")
    try assert(scope != null, "expected import 'a' to be registered")
}

@test
fn test_resolve_imports_multiple_libs()! {
    var ctx = try new_context()

    let lib_a_ast = try parser.parse([]byte(`lib a
        pub struct foo { x i32 }`), parser.mode.lib)
    var sem_a = try new("path/a", lib_a_ast, ctx)
    sem_a = try register_types(sem_a)
    ctx = &context{ip: sem_a.ip, tp: sem_a.tp, np: sem_a.np, generic_defs: sem_a.generic_defs, mode: mode.debug}

    let lib_b_ast = try parser.parse([]byte(`lib b
        pub struct bar { y i32 }`), parser.mode.lib)
    var sem_b = try new("path/b", lib_b_ast, ctx)
    sem_b = try register_types(sem_b)
    ctx = &context{ip: sem_b.ip, tp: sem_b.tp, np: sem_b.np, generic_defs: sem_b.generic_defs, mode: mode.debug}

    let lib_c_ast = try parser.parse([]byte(`lib c
        pub struct baz { z i32 }`), parser.mode.lib)
    var sem_c = try new("path/c", lib_c_ast, ctx)
    sem_c = try register_types(sem_c)
    ctx = &context{ip: sem_c.ip, tp: sem_c.tp, np: sem_c.np, generic_defs: sem_c.generic_defs, mode: mode.debug}

    let main_ast = try parser.parse([]byte(`lib main
        use "path/a"
        use "path/b"
        use "path/c"`), parser.mode.lib)

    // Build map with library scopes BEFORE creating sem_main so intern pool is shared
    var m = map.new[intern.index, namespace.index]()
    ctx.ip, let a_path = try intern.intern_string(ctx.ip, "path/a")
    m = try map.insert(m, a_path, sem_a.current_scope)
    ctx.ip, let b_path = try intern.intern_string(ctx.ip, "path/b")
    m = try map.insert(m, b_path, sem_b.current_scope)
    ctx.ip, let c_path = try intern.intern_string(ctx.ip, "path/c")
    m = try map.insert(m, c_path, sem_c.current_scope)

    var sem_main = try new("path/main", main_ast, ctx)
    sem_main = try register_imports(sem_main, m)

    try assert(len(sem_main.errs) == 0, "expected no errors")

    let scope_a = try get_scope_idx(sem_main, sem_main.current_scope, "a")
    try assert(scope_a != null, "expected import 'a' to be registered")
    let scope_b = try get_scope_idx(sem_main, sem_main.current_scope, "b")
    try assert(scope_b != null, "expected import 'b' to be registered")
    let scope_c = try get_scope_idx(sem_main, sem_main.current_scope, "c")
    try assert(scope_c != null, "expected import 'c' to be registered")
}

@test
fn test_resolve_imports_with_alias()! {
    var ctx = try new_context()

    let lib_a_ast = try parser.parse([]byte(`lib a`), parser.mode.lib)
    var sem_a = try new("path/a", lib_a_ast, ctx)
    ctx = &context{ip: sem_a.ip, tp: sem_a.tp, np: sem_a.np, generic_defs: sem_a.generic_defs, mode: mode.debug}

    let lib_b_ast = try parser.parse([]byte(`lib b
        use myalias "path/a"`), parser.mode.lib)
    var sem_b = try new("path/b", lib_b_ast, ctx)

    var m = map.new[intern.index, namespace.index]()
    let _, let a_path = try intern.intern_string(ctx.ip, "path/a")
    m = try map.insert(m, a_path, sem_a.current_scope)

    sem_b = try register_imports(sem_b, m)

    try assert(len(sem_b.errs) == 0, "expected no errors")

    let scope = try get_scope_idx(sem_b, sem_b.current_scope, "myalias")
    try assert(scope != null, "expected import 'myalias' to be registered")
}

@test
fn test_resolve_imports_not_found()! {
    var ctx = try new_context()

    let lib_b_ast = try parser.parse([]byte(`lib b
        use "path/nonexistent"`), parser.mode.lib)
    var s = try new("path/b", lib_b_ast, ctx)
    var m = map.new[intern.index, namespace.index]()
    s = try register_imports(s, m)

    try assert(len(s.errs) == 1, "expected exactly one error")
    let err = try get(s.errs, 0)
    match e = err {
    case library_not_found:
        try assert(e.name == "path/nonexistent", "error should contain correct library path")
    case _:
        raise test_error{reason: "expected library_not_found error"}
    }
}

@test
fn test_resolve_imports_duplicate_name()! {
    var ctx = try new_context()

    let lib_a_ast = try parser.parse([]byte(`lib a`), parser.mode.lib)
    var sem_a = try new("path/a", lib_a_ast, ctx)
    ctx = &context{ip: sem_a.ip, tp: sem_a.tp, np: sem_a.np, generic_defs: sem_a.generic_defs, mode: mode.debug}

    let lib_b_ast = try parser.parse([]byte(`lib b
        use "path/a"
        use "path/a"`), parser.mode.lib)
    var sem_b = try new("path/b", lib_b_ast, ctx)

    var m = map.new[intern.index, namespace.index]()
    let _, let a_path = try intern.intern_string(ctx.ip, "path/a")
    m = try map.insert(m, a_path, sem_a.current_scope)

    sem_b = try register_imports(sem_b, m)

    try assert(len(sem_b.errs) == 1, "expected exactly one error")
    let err = try get(sem_b.errs, 0)
    match e = err {
    case duplicate_import:
        return
    case _:
        raise test_error{reason: "expected duplicate_import error"}
    }
}

@test
fn test_resolve_imports_duplicate_alias()! {
    var ctx = try new_context()

    let lib_a_ast = try parser.parse([]byte(`lib a`), parser.mode.lib)
    var sem_a = try new("path/a", lib_a_ast, ctx)
    ctx = &context{ip: sem_a.ip, tp: sem_a.tp, np: sem_a.np, generic_defs: sem_a.generic_defs, mode: mode.debug}

    let lib_c_ast = try parser.parse([]byte(`lib c`), parser.mode.lib)
    var sem_c = try new("path/c", lib_c_ast, ctx)
