@test
fn test_cast_error_too_few_arguments()! {
    try assert_error(
        `lib a
        let x = u8()`,
        [too_few_arguments{expected: 1, found: 0, pos: ast.index(5)}]
    )
}

@test
fn test_cast_error_too_many_arguments()! {
    try assert_error(`lib a
        let x = u8(1,1)`,
        [too_many_arguments{expected: 1, found: 2, pos: ast.index(8)}]
    )
}

@test
fn test_lnot_true_literal()! {
    try assert_gen(`lib a
        let x = !true`,
        `a/init:
            %1 = const(true,bool)
            %2 = lnot(%1)`
    )
}

@test
fn test_lnot_false_literal()! {
    try assert_gen(`lib a
        let x = !false`,
        `a/init:
            %1 = const(false,bool)
            %2 = lnot(%1)`
    )
}

@test
fn test_lnot_variable()! {
    try assert_gen(`lib a
        let x = true
        let y = !x`,
        `a/init:
            %1 = const(true,bool)
            %2 = lnot(%1)`
    )
}

@test
fn test_lnot_function_parameter()! {
    try assert_gen(`lib a
        fn f(x bool) bool { return !x }`,
        `fn a/f:
            %2 = arg(x,bool)
            jmp(a/f/0)
          a/f/0:
            %5 = lnot(%2)
            %6 = alloca([bool],8)
            %7 = const(0,u32)
            %8 = gep(%6,%7,*bool)
            store(%8,%5)
            ret_1(%6)`
    )
}

@test
fn test_lnot_double()! {
    try assert_gen(`lib a
        let x = !!true`,
        `a/init:
            %1 = const(true,bool)
            %2 = lnot(%1)
            %3 = lnot(%2)`
    )
}

@test
fn test_lnot_comparison()! {
    try assert_gen(`lib a
        let x = 1
        let y = !(x == 1)`,
        `a/init:
            %1 = const(1,i64)
            %2 = const(1,i64)
            %3 = eq(%1,%2)
            %4 = lnot(%3)`
    )
}

@test
fn test_lnot_logical_and()! {
    try assert_gen(`lib a
        let x = true
        let y = false
        let z = !(x && y)`,
        `a/init:
            %1 = const(true,bool)
            %2 = const(false,bool)
            %3 = land(%1,%2)
            %4 = lnot(%3)`
    )
}

@test
fn test_lnot_logical_or()! {
    try assert_gen(`lib a
        let x = true
        let y = false
        let z = !(x || y)`,
        `a/init:
            %1 = const(true,bool)
            %2 = const(false,bool)
            %3 = lor(%1,%2)
            %4 = lnot(%3)`
    )
}

