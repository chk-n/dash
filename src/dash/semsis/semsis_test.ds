            %12 = bitcast(%2,slot[u64])
            store(%11,%12)
            %14 = alloca([[u32,slot[u64]]],8)
            %15 = load(%5,[u32,slot[u64]])
            %16 = const(0,u32)
            %17 = gep(%14,%16,*[u32,slot[u64]])
            store(%17,%15)
            ret_1(%14)`
    )
}

