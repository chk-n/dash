@test
fn test_infix_coalesce_const_fixed()! {
    for i = 0; i < len(ints); i++ {
        let typ = try get(ints, i)
        if typ == "i64" { next }
        let inp = fmt.stringf(`lib a
        let x = %s(1)
        let y = 10 + x`, [typ])
        let out = fmt.stringf(`%%1 = const(1,i64)
            %%2 = cast(%%1,%s)
            %%3 = const(10,i64)
            %%4 = cast(%%3,%s)
            %%5 = add(%%4,%%2)`, [typ,typ])
        try assert_gen(inp, out)
    }
}

@test
fn test_infix_coalesce_fixed_const()! {
    for i = 0; i < len(ints); i++ {
        let typ = try get(ints, i)
        if typ == "i64" { next }
        let inp = fmt.stringf(`lib a
        let x = %s(1)
        let y = x + 10`, [typ])
        let out = fmt.stringf(`%%1 = const(1,i64)
            %%2 = cast(%%1,%s)
            %%3 = const(10,i64)
            %%4 = cast(%%3,%s)
            %%5 = add(%%2,%%4)`, [typ,typ])
        try assert_gen(inp, out)
    }
}

