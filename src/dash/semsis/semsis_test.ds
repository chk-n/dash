        }`,
        `fn a/foo:
            %2 = arg(s,*[u64,*[]u8])
            jmp(a/foo/0)
          a/foo/0:
            %5 = const(0,u32)
            %6 = gep(%2,%5,*u64)
            %7 = load(%6,u64)
            %8 = cast(%7,i64)
            %9 = alloca([i64],8)
            %10 = const(0,u32)
            %11 = gep(%9,%10,*i64)
            store(%11,%8)
            ret_1(%9)`
    )
}

@test
fn test_len_error_no_arguments()! {
    try assert_error(
        `lib a
        fn foo() {
            len()
        }`,
        [too_few_arguments{expected: 1, found: 0, pos: ast.index(3)}]
    )
}

@test
fn test_len_error_too_many_arguments()! {
    try assert_error(
        `lib a
        fn foo(a []i64, b []i64) {
            len(a, b)
        }`,
        [too_many_arguments{expected: 1, found: 2, pos: ast.index(13)}]
    )
}

@test
fn test_len_error_wrong_type()! {
    try assert_error(
        `lib a
        fn foo(x i64) {
            len(x)
        }`,
        [type_mismatch{got: types.I64_IDX, want: types.NULL_IDX, pos: ast.index(6)}]
    )
}

@test
fn test_assert_basic()! {
    try assert_gen(
        `lib a
        fn foo(cond bool, msg string) {
            assert(cond, msg)
        }`,
        `fn a/foo:
            %2 = arg(cond,bool)
            %3 = arg(msg,*[u64,*[]u8])
            jmp(a/foo/0)
          a/foo/0:
            br(%2,a/foo/1,a/foo/2)
          a/foo/2:
            %8 = extern_ref("dash/internal/runtime/panic",dash/internal/runtime/panic)
            %9 = call(%8,%3,null)
            unreachable
          a/foo/1:`
    )
}

