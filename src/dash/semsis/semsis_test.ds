            %10 = const(1,u64)
            %11 = add(%9,%10)
            %12 = const(8,u64)
            %13 = extern_ref("dash/internal/runtime/malloc",dash/internal/runtime/malloc)
            %14 = call(%13,%12,%11,*u8)
            %15 = const(null,*u8)
            %16 = eq(%14,%15)
            br(%16,a/foo/2,a/foo/3)
