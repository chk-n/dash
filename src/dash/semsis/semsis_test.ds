@test
fn test_defer_raise()! {
    try assert_gen(
        `lib a
        fn cleanup() {}
        error myerr {}
        fn f()! {
            defer cleanup()
            raise myerr{}
        }`,
        `a/init:
        fn a/cleanup:
            jmp(a/cleanup/0)
          a/cleanup/0:
        fn a/f:
