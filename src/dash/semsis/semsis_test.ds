@test
fn test_match_stmt_integer_cases()! {
    try assert_gen(
        `lib a
        fn foo(x i64) i64 {
            match x {
            case 1: return 10
            case 2: return 20
            case 3: return 30
            case _: return 0
            }
        }`,
        `fn a/foo:
            %2 = arg(x,i64)
            jmp(a/foo/0)
          a/foo/0:
            switch(%2,default:a/foo/4,1:a/foo/1,2:a/foo/2,3:a/foo/3)
          a/foo/1:
            %7 = const(10,i64)
            %8 = alloca([i64],8)
            %9 = const(0,u32)
            %10 = gep(%8,%9,*i64)
            store(%10,%7)
            ret_1(%8)
          a/foo/2:
            %14 = const(20,i64)
            %15 = alloca([i64],8)
            %16 = const(0,u32)
            %17 = gep(%15,%16,*i64)
            store(%17,%14)
            ret_1(%15)
          a/foo/3:
            %21 = const(30,i64)
            %22 = alloca([i64],8)
            %23 = const(0,u32)
            %24 = gep(%22,%23,*i64)
            store(%24,%21)
            ret_1(%22)
          a/foo/4:
            %28 = const(0,i64)
            %29 = alloca([i64],8)
            %30 = const(0,u32)
            %31 = gep(%29,%30,*i64)
            store(%31,%28)
            ret_1(%29)`
    )
}

@test
fn test_match_stmt_bool_cases()! {
    // BUG: a/foo/3 (default) missing terminator 
    try assert_gen(
        `lib a
        fn foo(b bool) i64 {
            match b {
            case true: return 1
            case false: return 0
            }
        }`,
        `fn a/foo:
            %2 = arg(b,bool)
            jmp(a/foo/0)
          a/foo/0:
            switch(%2,default:a/foo/3,1:a/foo/1,0:a/foo/2)
          a/foo/1:
            %7 = const(1,i64)
            %8 = alloca([i64],8)
            %9 = const(0,u32)
            %10 = gep(%8,%9,*i64)
            store(%10,%7)
            ret_1(%8)
          a/foo/2:
            %14 = const(0,i64)
            %15 = alloca([i64],8)
            %16 = const(0,u32)
            %17 = gep(%15,%16,*i64)
            store(%17,%14)
