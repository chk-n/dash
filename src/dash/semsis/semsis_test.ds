@test
fn test_infix_error_type_mismatch()! {
    try assert_error(`lib a
        let a = u8(1)
        let b = u16(2)
        let c = a + b`,
        [type_mismatch{got: types.U16_IDX, want: types.U8_IDX, pos: ast.index(24)}])
    try assert_error(`lib a
        let a = u8(1)
        let b = i8(2)
        let c = a + b`,
        [type_mismatch{got: types.I8_IDX, want: types.U8_IDX, pos: ast.index(24)}])
    try assert_error(`lib a
        let a = u32(1)
        let b = i32(2)
        let c = a + b`,
        [type_mismatch{got: types.I32_IDX, want: types.U32_IDX, pos: ast.index(24)}])
    try assert_error(`lib a
        fn f(a i32, b bool) { let x = a + b }`,
        [type_mismatch{got: types.BOOL_IDX, want: types.I32_IDX, pos: ast.index(12)}])
    try assert_error(`lib a
        fn f(a bool, b i32) { let x = a + b }`,
        [type_mismatch{got: types.I32_IDX, want: types.BOOL_IDX, pos: ast.index(12)}])
}

@test
fn test_infix_error_coercion_overflow()! {
    try assert_error(`lib a
        let a = u8(1)
        let b = a + 256`,
        [cannot_assign_to_type{got: types.I64_IDX, want: types.U8_IDX, pos: ast.index(15)}])
    try assert_error(`lib a
        let a = u16(1)
        let b = a + 65536`,
        [cannot_assign_to_type{got: types.I64_IDX, want: types.U16_IDX, pos: ast.index(15)}])
    try assert_error(`lib a
        let a = i8(1)
        let b = a + 128`,
        [cannot_assign_to_type{got: types.I64_IDX, want: types.I8_IDX, pos: ast.index(15)}])
    try assert_error(`lib a
        let a = u8(1)
        let b = a + true`,
        [cannot_assign_to_type{got: types.BOOL_IDX, want: types.U8_IDX, pos: ast.index(15)}])
    try assert_error(`lib a
        let a = u8(1)
        let b = a + "hi"`,
        [type_mismatch{got: types.STRING_IDX, want: types.U8_IDX, pos: ast.index(15)}])
    try assert_error(`lib a
        let x = true + 1`,
        [cannot_assign_to_type{got: types.I64_IDX, want: types.BOOL_IDX, pos: ast.index(6)}])
}

