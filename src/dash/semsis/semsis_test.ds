@test
fn test_any_selection_primitive()! {
    try assert_gen(
        `lib a
        fn main(x many) {
           let y = i64(x)
        }`,
        `fn a/main:
            %2 = arg(x,*[u32,slot[u64]])
            jmp(a/main/0)
          a/main/0:
            %5 = const(0,u32)
            %6 = gep(%2,%5,*u32)
            %7 = load(%6,u32)
            %8 = const(7,u32)
            %9 = eq(%7,%8)
            br(%9,a/main/1,a/main/2)
          a/main/1:
            %12 = const(1,u32)
            %13 = gep(%2,%12,*slot[u64])
            %14 = load(%13,slot[u64])
            %15 = bitcast(%14,i64)
            jmp(a/main/3(%15))
          a/main/2:
            %18 = poison(i64)
            jmp(a/main/3(%18))
          a/main/3:
            %21 = block_arg(i64)
            %22 = alloca([bool,i64],8)
            %23 = const(0,u32)
            %24 = gep(%22,%23,*bool)
            store(%24,%9)
            %26 = const(1,u32)
            %27 = gep(%22,%26,*i64)
            store(%27,%21)`
    )
}

