@test
fn test_defer_non_call_error()! {
    try assert_error(
        `lib a
        fn f(x u64) {
            defer x
        }`,
        [defer_not_call{pos: ast.index(6)}]
    )
}

@test
fn test_len_array()! {
    try assert_gen(
        `lib a
        fn foo(arr []i64) i64 {
            return len(arr)
        }`,
        `fn a/foo:
            %2 = arg(arr,*[u64,*[]i64])
            jmp(a/foo/0)
          a/foo/0:
            %5 = const(0,u32)
            %6 = gep(%2,%5,*u64)
            %7 = load(%6,u64)
            %8 = cast(%7,i64)
            %9 = alloca([i64],8)
            %10 = const(0,u32)
            %11 = gep(%9,%10,*i64)
            store(%11,%8)
            ret_1(%9)`
    )
}

@test
fn test_len_string()! {
    try assert_gen(
        `lib a
        fn foo(s string) i64 {
