@test
fn test_size_error_no_arguments()! {
    try assert_error(
        `lib a
        fn foo() {
            size()
        }`,
        [too_few_arguments{expected: 1, found: 0, pos: ast.index(3)}]
    )
}

@test
fn test_size_error_too_many_arguments()! {
    try assert_error(
        `lib a
        fn foo(a i64, b i64) {
            size(a, b)
        }`,
        [too_many_arguments{expected: 1, found: 2, pos: ast.index(11)}]
    )
}

@test
fn test_slice_array_i64()! {
    try assert_gen(
        `lib a
        fn foo(arr []i64, start i64, end i64)! []i64 {
            return try slice(arr, start, end)
        }`,
        `a/init:
        fn a/foo:
            %2 = arg(arr,*[u64,*[]i64])
            %3 = arg(start,i64)
            %4 = arg(end,i64)
            jmp(a/foo/0)
          a/foo/0:
            %7 = const(0,u32)
            %8 = gep(%2,%7,*u64)
            %9 = load(%8,u64)
            %10 = const(0,i64)
            %11 = lt(%3,%10)
            %12 = cast(%9,i64)
            %13 = add(%3,%12)
            %14 = select(%11,%13,%3)
            %15 = lt(%4,%10)
            %16 = add(%4,%12)
            %17 = select(%15,%16,%4)
            %18 = cast(%14,u64)
            %19 = cast(%17,u64)
            %20 = gt(%19,%9)
            %21 = gt(%18,%19)
            %22 = lor(%20,%21)
            %23 = alloca([[u64,*[]i64],u32,slot[u64]],8)
            br(%22,a/foo/2,a/foo/1)
          a/foo/2:
            %26 = poison([u64,*[]i64])
            %27 = const(0,u32)
            %28 = gep(%23,%27,*[u64,*[]i64])
            store(%28,%26)
            %30 = const(19,u32)
            %31 = const(1,u32)
            %32 = gep(%23,%31,*u32)
            store(%32,%30)
            %34 = poison(slot[u64])
            %35 = const(2,u32)
            %36 = gep(%23,%35,*slot[u64])
            store(%36,%34)
            jmp(a/foo/3)
          a/foo/1:
            %40 = sub(%19,%18)
            %41 = const(1,u32)
            %42 = gep(%2,%41,**[]i64)
            %43 = load(%42,*[]i64)
            %44 = gep(%43,%18,*i64)
            %45 = bitcast(%44,*[]i64)
            %46 = alloca([u64,*[]i64],8)
            %47 = const(0,u32)
            %48 = gep(%46,%47,*u64)
            store(%48,%40)
            %50 = const(1,u32)
            %51 = gep(%46,%50,**[]i64)
            store(%51,%45)
            %53 = const(0,u32)
            %54 = gep(%23,%53,*[u64,*[]i64])
            store(%54,%46)
            %56 = const(0,u32)
            %57 = const(1,u32)
            %58 = gep(%23,%57,*u32)
            store(%58,%56)
            %60 = poison(slot[u64])
            %61 = const(2,u32)
            %62 = gep(%23,%61,*slot[u64])
            store(%62,%60)
            jmp(a/foo/3)
          a/foo/3:
            %66 = const(1,u32)
            %67 = gep(%23,%66,*[u64,slot[u64]])
            %68 = const(0,u32)
            %69 = gep(%67,%68,*u64)
            %70 = load(%69,u64)
            %71 = const(0,u64)
            %72 = eq(%70,%71)
            br(%72,a/foo/4,a/foo/5)
          a/foo/5:
            %75 = const(1,u32)
            %76 = gep(%67,%75,*slot[u64])
            %77 = load(%76,slot[u64])
            %78 = alloca([u64,slot[u64]],8)
            %79 = const(0,u32)
            %80 = gep(%78,%79,*u64)
            store(%80,%70)
            %82 = const(1,u32)
            %83 = gep(%78,%82,*slot[u64])
            store(%83,%77)
            %85 = poison([u64,*[]i64])
            %86 = alloca([[u64,*[]i64],[u64,slot[u64]]],8)
            %87 = const(0,u32)
            %88 = gep(%86,%87,*[u64,*[]i64])
            store(%88,%85)
            %90 = load(%78,[u64,slot[u64]])
            %91 = const(1,u32)
            %92 = gep(%86,%91,*[u64,slot[u64]])
            store(%92,%90)
            ret_1(%86)
          a/foo/4:
            %96 = const(0,u32)
            %97 = gep(%23,%96,*[u64,*[]i64])
            %98 = load(%97,[u64,*[]i64])
            %99 = const(0,u64)
            %100 = poison(slot[u64])
            %101 = alloca([u64,slot[u64]],8)
            %102 = const(0,u32)
            %103 = gep(%101,%102,*u64)
            store(%103,%99)
            %105 = const(1,u32)
            %106 = gep(%101,%105,*slot[u64])
            store(%106,%100)
            %108 = alloca([[u64,*[]i64],[u64,slot[u64]]],8)
            %109 = const(0,u32)
            %110 = gep(%108,%109,*[u64,*[]i64])
            store(%110,%98)
            %112 = load(%101,[u64,slot[u64]])
            %113 = const(1,u32)
            %114 = gep(%108,%113,*[u64,slot[u64]])
            store(%114,%112)
            ret_1(%108)`
    )
}

@test
fn test_slice_string()! {
    try assert_gen(
        `lib a
        fn foo(s string, start i64, end i64)! string {
            return try slice(s, start, end)
        }`,
        `fn a/foo:
            %2 = arg(s,*[u64,*[]u8])
            %3 = arg(start,i64)
            %4 = arg(end,i64)
            jmp(a/foo/0)
          a/foo/0:
            %7 = const(0,u32)
            %8 = gep(%2,%7,*u64)
            %9 = load(%8,u64)
            %10 = const(0,i64)
            %11 = lt(%3,%10)
            %12 = cast(%9,i64)
            %13 = add(%3,%12)
            %14 = select(%11,%13,%3)
            %15 = lt(%4,%10)
            %16 = add(%4,%12)
            %17 = select(%15,%16,%4)
            %18 = cast(%14,u64)
            %19 = cast(%17,u64)
            %20 = gt(%19,%9)
            %21 = gt(%18,%19)
            %22 = lor(%20,%21)
            %23 = alloca([[u64,*[]u8],u32,slot[u64]],8)
            br(%22,a/foo/2,a/foo/1)
          a/foo/2:
            %26 = poison([u64,*[]u8])
            %27 = const(0,u32)
            %28 = gep(%23,%27,*[u64,*[]u8])
            store(%28,%26)
            %30 = const(18,u32)
            %31 = const(1,u32)
            %32 = gep(%23,%31,*u32)
            store(%32,%30)
            %34 = poison(slot[u64])
            %35 = const(2,u32)
            %36 = gep(%23,%35,*slot[u64])
            store(%36,%34)
            jmp(a/foo/3)
          a/foo/1:
            %40 = sub(%19,%18)
            %41 = const(1,u32)
            %42 = gep(%2,%41,**[]u8)
            %43 = load(%42,*[]u8)
            %44 = gep(%43,%18,*u8)
            %45 = bitcast(%44,*[]u8)
            %46 = alloca([u64,*[]u8],8)
            %47 = const(0,u32)
            %48 = gep(%46,%47,*u64)
            store(%48,%40)
            %50 = const(1,u32)
            %51 = gep(%46,%50,**[]u8)
            store(%51,%45)
            %53 = const(0,u32)
            %54 = gep(%23,%53,*[u64,*[]u8])
            store(%54,%46)
            %56 = const(0,u32)
            %57 = const(1,u32)
            %58 = gep(%23,%57,*u32)
            store(%58,%56)
            %60 = poison(slot[u64])
            %61 = const(2,u32)
            %62 = gep(%23,%61,*slot[u64])
            store(%62,%60)
            jmp(a/foo/3)
          a/foo/3:
            %66 = const(1,u32)
            %67 = gep(%23,%66,*[u64,slot[u64]])
            %68 = const(0,u32)
            %69 = gep(%67,%68,*u64)
            %70 = load(%69,u64)
            %71 = const(0,u64)
            %72 = eq(%70,%71)
            br(%72,a/foo/4,a/foo/5)
          a/foo/5:
            %75 = const(1,u32)
            %76 = gep(%67,%75,*slot[u64])
            %77 = load(%76,slot[u64])
            %78 = alloca([u64,slot[u64]],8)
            %79 = const(0,u32)
            %80 = gep(%78,%79,*u64)
            store(%80,%70)
            %82 = const(1,u32)
            %83 = gep(%78,%82,*slot[u64])
            store(%83,%77)
            %85 = poison([u64,*[]u8])
            %86 = alloca([[u64,*[]u8],[u64,slot[u64]]],8)
            %87 = const(0,u32)
            %88 = gep(%86,%87,*[u64,*[]u8])
            store(%88,%85)
            %90 = load(%78,[u64,slot[u64]])
            %91 = const(1,u32)
            %92 = gep(%86,%91,*[u64,slot[u64]])
            store(%92,%90)
            ret_1(%86)
          a/foo/4:
            %96 = const(0,u32)
            %97 = gep(%23,%96,*[u64,*[]u8])
            %98 = load(%97,[u64,*[]u8])
