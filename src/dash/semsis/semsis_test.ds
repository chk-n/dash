@test
fn test_value_of_roundtrip_global()! {
    try assert_gen(`lib a
        let x = 5
        let y = *&x`,
        `a/init:
            %1 = const(5,i64)
            %2 = alloca(i64,8)
            store(%2,%1)
            %4 = load(%2,i64)`
    )
}

