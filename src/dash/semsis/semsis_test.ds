            %6 = gep(%2,%5,*u32)
            %7 = load(%6,u32)
            switch(%7,default:a/foo/3,0:a/foo/1,1:a/foo/2)
          a/foo/1:
            %10 = const(1,u32)
            %11 = gep(%2,%10,*slot[u64])
            %12 = load(%11,slot[u64])
            %13 = bitcast(%12,i64)
            %14 = alloca([i64],8)
            %15 = const(0,u32)
            %16 = gep(%14,%15,*i64)
            store(%16,%13)
            ret_1(%14)
          a/foo/2:
            %20 = const(1,u32)
            %21 = gep(%2,%20,*slot[u64])
            %22 = load(%21,slot[u64])
            %23 = bitcast(%22,bool)
            %24 = const(0,i64)
            %25 = alloca([i64],8)
            %26 = const(0,u32)
            %27 = gep(%25,%26,*i64)
            store(%27,%24)
