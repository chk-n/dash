            store(%29,%27)
            jmp(a/foo/1)
          a/foo/3:
            %33 = const(1,u32)
            %34 = gep(%2,%33,**[]i64)
            %35 = load(%34,*[]i64)
            %36 = mul(%9,%12)
            %37 = bitcast(%35,*u8)
            %38 = extern_ref("dash/internal/runtime/mcopy",dash/internal/runtime/mcopy)
            %39 = call(%38,%14,%37,%36,null)
            %40 = bitcast(%14,*[]i64)
            %41 = gep(%40,%9,*i64)
            store(%41,%3)
            %43 = alloca([u64,*[]i64],8)
