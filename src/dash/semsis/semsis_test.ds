@test
fn test_for_classic_counter()! {
    try assert_gen(
        `lib a
        fn f() {
            for i = 0; i < 5; i = i + 1 { }
        }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %4 = const(0,i64)
            jmp(a/f/1(%4))
          a/f/1:
            %7 = block_arg(i64)
            %8 = const(5,i64)
            %9 = lt(%7,%8)
            br(%9,a/f/2(%7),a/f/3)
          a/f/2:
            %12 = block_arg(i64)
            %13 = const(1,i64)
            %14 = add(%12,%13)
            jmp(a/f/1(%14))
          a/f/3:`
    )
}

@test
fn test_for_classic_with_body()! {
    try assert_gen(
        `lib a
        fn f() {
            var sum = 0
            for i = 1; i <= 3; i = i + 1 {
                sum = sum + i
            }
        }`,
        `fn a/f:
            jmp(a/f/0)
          a/f/0:
            %4 = const(0,i64)
            %5 = const(1,i64)
            jmp(a/f/1(%4,%5))
          a/f/1:
            %8 = block_arg(i64)
            %9 = block_arg(i64)
            %10 = const(3,i64)
            %11 = lte(%9,%10)
            br(%11,a/f/2(%8,%9),a/f/3)
          a/f/2:
            %14 = block_arg(i64)
            %15 = block_arg(i64)
            %16 = add(%14,%15)
            %17 = const(1,i64)
            %18 = add(%15,%17)
            jmp(a/f/1(%16,%18))
          a/f/3:`
    )
}

@test
fn test_for_classic_next_executes_incr()! {
    // NOTE: maybe this is a bug but here we duplicate
    // the incr block due to the next
    try assert_gen(
        `lib a
        fn f(skip bool) {
            for i = 0; i < 10; i = i + 1 {
                if skip { next }
            }
        }`,
        `fn a/f:
            %2 = arg(skip,bool)
            jmp(a/f/0)
          a/f/0:
            %5 = const(0,i64)
            jmp(a/f/1(%5))
          a/f/1:
            %8 = block_arg(i64)
            %9 = const(10,i64)
            %10 = lt(%8,%9)
            br(%10,a/f/2(%8),a/f/3)
          a/f/2:
            %13 = block_arg(i64)
            br(%2,a/f/4,a/f/5)
          a/f/4:
            %16 = const(1,i64)
            %17 = add(%13,%16)
            jmp(a/f/1(%17))
          a/f/5:
            %20 = const(1,i64)
            %21 = add(%13,%20)
            jmp(a/f/1(%21))
          a/f/3:`
    )
}

@test
fn test_for_nested_break_inner()! {
    try assert_gen(
        `lib a
        fn f(x bool) {
            for {
                for x { break }
                break
            }
        }`,
        `fn a/f:
            %2 = arg(x,bool)
            jmp(a/f/0)
          a/f/0:
            jmp(a/f/1)
          a/f/1:
            jmp(a/f/3)
          a/f/3:
            br(%2,a/f/4,a/f/5)
          a/f/4:
            jmp(a/f/5)
          a/f/5:
            jmp(a/f/2)
          a/f/2:`
    )
}

