@test
fn test_if_expr_nested()! {
    try assert_gen(`lib a
        fn test(a bool, b bool) i64 { let x = if a { if b { 1 } else { 2 } } else { 3 } return x }`,
        `fn a/test:
            %2 = arg(a,bool)
            %3 = arg(b,bool)
            jmp(a/test/0)
          a/test/0:
            br(%2,a/test/1,a/test/2)
          a/test/1:
            br(%3,a/test/4,a/test/5)
          a/test/4:
            %10 = const(1,i64)
            jmp(a/test/6(%10))
          a/test/5:
            %13 = const(2,i64)
            jmp(a/test/6(%13))
          a/test/6:
            %16 = block_arg(i64)
            jmp(a/test/3(%16))
          a/test/2:
            %19 = const(3,i64)
            jmp(a/test/3(%19))
          a/test/3:
            %22 = block_arg(i64)
            %23 = alloca([i64],8)
            %24 = const(0,u32)
            %25 = gep(%23,%24,*i64)
            store(%25,%22)
            ret_1(%23)`
    )
}

