fn test_if_expr_integer()! {
    try assert_gen(`lib a
        fn test(y bool) i64 { let x = if y { 1 } else { 2 } return x }`,
        `a/test/0:
            br(%2,a/test/1,a/test/2)
          a/test/1:
            const(1,i64)
            jmp(a/test/3(
          a/test/2:
            const(2,i64)
            jmp(a/test/3(
            a/test/3
