            store(%73,%67)
            %75 = alloca([[u64,slot[u64]]],8)
            %76 = load(%68,[u64,slot[u64]])
            %77 = const(0,u32)
            %78 = gep(%75,%77,*[u64,slot[u64]])
            store(%78,%76)
            ret_1(%75)
          a/main/4:`
    )
}

