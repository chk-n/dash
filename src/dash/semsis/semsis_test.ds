    try assert_error(`lib a
        fn main() { if 42 { } }`, [condition_not_bool{got: types.I64_IDX, pos: ast.index(2)}]
    )
}

@test
fn test_if_stmt_error_var_not_bool()! {
    try assert_error(`lib a
        fn main(x i64) { if x { } }`, [condition_not_bool{got: types.I64_IDX, pos: ast.index(5)}]
    )
}

