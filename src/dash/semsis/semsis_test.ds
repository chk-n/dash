            store(%47,%12)
            %49 = poison(slot[u64])
            %50 = const(2,u32)
            %51 = gep(%14,%50,*slot[u64])
            store(%51,%49)
            jmp(a/main/3)
          a/main/3:
            %55 = load(%14,[[u64,*[]u8],u32,slot[u64]])
            %56 = const(1,u32)
            %57 = gep(%55,%56,*[u64,slot[u64]])
            %58 = const(0,u32)
            %59 = gep(%57,%58,*u64)
            %60 = load(%59,u64)
            %61 = const(0,u64)
            %62 = eq(%60,%61)
            br(%62,a/main/4,a/main/5)
          a/main/5:
            %65 = const(1,u32)
            %66 = gep(%57,%65,*slot[u64])
            %67 = load(%66,slot[u64])
            %68 = alloca([u64,slot[u64]],8)
            %69 = const(0,u32)
