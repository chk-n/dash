@test
fn test_function_call_struct_arg()! {
    try assert_gen(
         `lib a
        struct point { x i32 y i32 }
        fn foo(p point) {}
        fn bar() { foo(point{x: 1, y: 2}) }`,
        `fn a/foo:
            %2 = arg(p,*[i32,i32])
            jmp(a/foo/0)
          a/foo/0:
        fn a/bar:
            jmp(a/bar/0)
          a/bar/0:
            %8 = extern_ref("a/foo",a/foo)
            %9 = const(1,i64)
            %10 = cast(%9,i32)
            %11 = const(2,i64)
            %12 = cast(%11,i32)
            %13 = alloca([i32,i32],8)
            %14 = const(0,u32)
            %15 = gep(%13,%14,*i32)
            store(%15,%10)
            %17 = const(1,u32)
            %18 = gep(%13,%17,*i32)
            store(%18,%12)
            %20 = call(%8,%13,null)`
    )
}

@test
fn test_function_call_array_arg()! {
    try assert_gen(
         `lib a
        fn foo(arr []i32) {}
        fn bar() { foo([i32(10)]) }`,
        `a/init:
        fn a/foo:
            %2 = arg(arr,*[u64,*[]i32])
            jmp(a/foo/0)
          a/foo/0:
        fn a/bar:
            jmp(a/bar/0)
          a/bar/0:
            %8 = extern_ref("a/foo",a/foo)
            %9 = const(10,i64)
            %10 = cast(%9,i32)
            %11 = const(1,u64)
            %12 = alloca_array([]i32,%11,8)
            %13 = const(0,u32)
            %14 = gep(%12,%13,*i32)
            store(%14,%10)
            %16 = alloca([u64,*[]i32],8)
            %17 = const(0,u32)
            %18 = gep(%16,%17,*u64)
            store(%18,%11)
            %20 = const(1,u32)
            %21 = gep(%16,%20,**[]i32)
            store(%21,%12)
            %23 = call(%8,%16,null)`
    )
}

