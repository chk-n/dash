lib semsis

use "dash/ast"
use "dash/convert"
use "dash/hash/rapidhash"
use "dash/intern"
use "dash/ir"
use "dash/map"
use "dash/path"
use "dash/semsis/namespace"
use "dash/types"

pub enum mode {
    debug
    release
}

struct generic_def {
    source_ast   *ast.ast
    source_scope namespace.index
    ast_node_idx ast.index
}

pub type generic_def_index u32

struct mono_job {
    generic_fqn    intern.index
    mono_fqn       intern.index
    concrete_types []types.index
    call_pos       ast.index
}

struct generic_registry {
    defs []generic_def
    keys *map.map[intern.index, generic_def_index]
}

fn new_generic_registry() *generic_registry {
    return &generic_registry{
        defs: [],
        keys: map.new[intern.index, generic_def_index](),
    }
}

fn register_generic(r *generic_registry, fqn intern.index, def generic_def)! *generic_registry {
    let idx = generic_def_index(u32(len(r.defs)))
    let defs = try append(r.defs, def)
    let keys = try map.insert(r.keys, fqn, idx)
    return &generic_registry{defs: defs, keys: keys}
}

fn lookup_generic(r *generic_registry, fqn intern.index)! ?generic_def {
    let idx_opt = try map.get_val(r.keys, fqn)
    if idx_opt == null {
        return null
    }
    return try get(r.defs, ?idx_opt)
}

// context holds shared state across library analyses.
// This is passed to new() and returned from analyse() to enable
// cross-library type and symbol resolution.
pub struct context {
    ip           *intern.pool
    tp           *types.pool
    np           *namespace.pool
    generic_defs *generic_registry
    mode         mode
}

pub fn new_context()! *context {
    return new_context_with_mode(mode.debug)
}

pub fn new_context_with_mode(m mode)! *context {
    return &context{
        ip:           intern.new(),
        tp:           types.new(),
        np:           namespace.new(),
        generic_defs: new_generic_registry(),
        mode:         m,
    }
}

struct loop_context {
    exit_fqn        intern.index
    continue_fqn    intern.index
    incr_idx        ast.index
    header_join     join_info
    exit_join       join_info
    defer_start_idx u32
}

struct defer_block {
    scope_idx namespace.index
    start_idx u32
    end_idx   u32
}

pub struct semsis {
    np            *namespace.pool
    current_scope namespace.index
    ast           *ast.ast
    ip            *intern.pool
    tp            *types.pool
    ins           []ir.inst
    extra         []u32
    errs          []error

    generic_defs *generic_registry
    mono_cache   *map.map[intern.index, ir.index]
    mono_queue   []mono_job
    mode         mode

    // The following fields are reset / defined per function
    // analysed and dont live throughout the analysis lifetime
    // of the library

    block_counter       u32
    ssa                 ?*ssa_builder
    current_func_fqn    intern.index
    current_fn_sem_type types.index
    current_fn_ir       ir.index
    loop_ctx            ?loop_context
    // TODO: remove this and check fn_sem_type is fallible instead
    current_fn_is_fallible bool
    last_call_was_fallible bool
    defer_stack []defer_block
    // tracks all defers defined within a function and should only be used
    // to generate the cleanup wrappers that call the underlying deferred
    // function with the required arguments (if any)
    defer_registry []ast.index
    defer_arg_types []types.index
    defer_arg_counts []u32
}

pub fn new(lib_path string, a *ast.ast, ctx *context)! *semsis {
    var np = ctx.np
    np, let root_idx = try namespace.new_scope(np, lib_path, types.NULL_IDX, namespace.NULL_IDX)

    return &semsis{
        np:               np,
        current_scope:    root_idx,
        ast:              a,
        ip:               ctx.ip,
        tp:               ctx.tp,
        ins:              [],
        extra:            [],
        errs:             [],
        generic_defs:     ctx.generic_defs,
        mono_cache:       map.new[intern.index, ir.index](),
        mono_queue:       [],
        mode:             ctx.mode,
        block_counter:    0,
        ssa:              null,
        current_func_fqn: intern.NULL_IDX,
        current_fn_sem_type: types.NULL_IDX,
        current_fn_ir: ir.NULL_IDX,
        loop_ctx:         null,
        current_fn_is_fallible: false,
        last_call_was_fallible: false,
        defer_stack:      [],
        defer_registry:   [],
        defer_arg_types:  [],
        defer_arg_counts: [],
    }
}

// analyse is the entry point which starts the analysis of the entire library. it requires
// a map of the root scope indices of libraries the current library imports.
// Returns the IR, updated context, and this library's root scope index.
pub fn analyse(s *semsis, m *map.map[intern.index, namespace.index])! *ir.ir, *context, namespace.index {
    var s = try register_imports(s, m)
    s = try register_types(s)
    s = try resolve_types(s)

    let current_scope = try namespace.get_scope(s.np, s.current_scope)
    try assert(current_scope.parent_idx == namespace.NULL_IDX, "expected to be in global scope")

    s = try analyse_and_generate(s)

    return &ir.ir{
        ins:   s.ins
        extra: s.extra,
        errs:  s.errs
    }, &context{ip: s.ip, tp: s.tp, np: s.np, generic_defs: s.generic_defs, mode: s.mode}, s.current_scope
}

// register_imports stores root scope indices from imported libraries in current namespace.
// It does this by mapping the base of library path (for "dash/semsis" -> "semsis") to that
// library's root scope index in the global pool
fn register_imports(s *semsis, m *map.map[intern.index, namespace.index])! *semsis {
    var s = s
    s = try rule_library_name_equals_directory(s)

    let stmts = try ast.library_stmts(s.ast)
    let data = stmts.data

    for i = data.x; i < data.y; i++ {
        let idx = try get(s.ast.extras, i)
        let node = try get(s.ast.nodes, idx)

        match node.tag {
        case ast.tag.use_def:
            let path_node = try get(s.ast.nodes, node.data.y)
            let lib_path = try ast.get_string_literal(s.ast, path_node)
            s.ip, let fqn_interned = try intern.intern_string(s.ip, lib_path)

            let lib_root_idx_opt = try map.get_val(m, fqn_interned)
            if lib_root_idx_opt == null {
                s = try add_error(s, library_not_found{
                    name: lib_path,
                    pos: idx
                })
                next
            }
            let lib_root_idx = ?lib_root_idx_opt

            var import_name = ""
            if node.data.x != ast.NULL_IDX {
                let alias_node = try get(s.ast.nodes, node.data.x)
                import_name = try ast.identifier(s.ast, alias_node)
            } else {
                import_name = try path.base(lib_path)
            }
            s.ip, let import_name_idx = try intern.intern_string(s.ip, import_name)
            let existing = try namespace.lookup(s.np, s.current_scope, import_name_idx)
            if existing != null {
                s = try add_error(s, duplicate_import{pos: idx})
                next
            }

            s.np = try namespace.link_public(
                s.np,
                s.current_scope,
                import_name_idx,
                lib_root_idx
            )
        case _:
            next
        }
    }
    return s
}

// rule_library_name_equals_directory enforces that the library
// name matches the name of the directory it is currently in
fn rule_library_name_equals_directory(s *semsis)! *semsis {
    let lib_idx = ast.index(len(s.ast.nodes)-1)
    let lib_name = try ast.identifier(s.ast, get(s.ast.nodes, lib_idx))
    let current_scope = try namespace.get_scope(s.np, s.current_scope)
    let dir_name = try path.base(current_scope.path)

    if dir_name != lib_name {
        return add_error(s, library_name_mismatch{
            declared: lib_name,
            expected: dir_name,
            pos: lib_idx
        })
    }
    return s
}

// register_types registers all global type names in intern.pool
// and in global namespace. At this point, global types are not
// fully resolved (fields reference not-yet-seen types). All types
// are stored using the library path + type name, this is also
// done for non-exported types, see make_fqn().
fn register_types(s *semsis)! *semsis {
    var s = s
    let stmts = try ast.library_stmts(s.ast)
    let data = stmts.data
    let current_scope = try namespace.get_scope(s.np, s.current_scope)

    for i = data.x; i < data.y; i++ {
        let idx = try get(s.ast.extras, i)
        let node = try get(s.ast.nodes, idx)

        match node.tag {
        case ast.tag.struct_def, ast.tag.struct_gen_def,
            ast.tag.enum_def, ast.tag.union_def,
            ast.tag.type_def,ast.tag.error_def,
            ast.tag.fn_def, ast.tag.fn_err_def,
            ast.tag.fn_gen_def, ast.tag.fn_gen_err_def:

            let ident = try ast.identifier(s.ast, node)
            let fqn = try make_fqn(current_scope.path, ident)
            s.ip, let fqn_idx = try intern.intern_string(s.ip, fqn)

            // check if simple identifier conflicts with an import alias
            // but we dont want to update intern pool as if there is no conflict
            // the identifier was never defined
            let _, let ident_idx = try intern.intern_string(s.ip, ident)
            let import_conflict = try namespace.lookup_local(s.np, s.current_scope, ident_idx)
            if import_conflict != null {
                s = try add_error(s, identifier_redeclared{pos: idx})
            }

            s, let ok = try rule_ident_unique(s, s.current_scope, fqn_idx, idx)
            if !ok {
                next
            }

            var sem_type = match node.tag {
                case ast.tag.struct_def:
                    s.tp, let idx = try types.make_struct(s.tp, fqn_idx)
                    idx
                case ast.tag.struct_gen_def:
                    s.tp, let idx = try types.make_struct_generic(s.tp, fqn_idx)
                    idx
                case ast.tag.enum_def:
                    s.tp, let idx = try types.make_enum(s.tp, fqn_idx)
                    idx
                case ast.tag.union_def:
                    s.tp, let idx = try types.make_union(s.tp, fqn_idx)
                    idx
                case ast.tag.error_def:
                    s.tp, let idx = try types.make_error(s.tp, fqn_idx)
                    idx
                case ast.tag.type_def:
                    s.tp, let idx = try types.make_type_def(s.tp, fqn_idx)
                    idx
                case ast.tag.fn_def:
                    s.tp, let idx = try types.make_function(s.tp, fqn_idx)
                    idx
                case ast.tag.fn_err_def:
                    s.tp, let idx = try types.make_function_fallible(s.tp, fqn_idx)
                    idx
                case ast.tag.fn_gen_def:
                    s.tp, let idx = try types.make_function_generic(s.tp, fqn_idx)
                    idx
                case ast.tag.fn_gen_err_def:
                    s.tp, let idx = try types.make_function_generic_fallible(s.tp, fqn_idx)
                    idx
                case _:
                    raise compiler_error{rsn: "unexpected node tag in register_types", pos: idx}
            }

            let scope_entry = namespace.scope{
                path:       current_scope.path,
                owner:      sem_type,
                parent_idx: s.current_scope,
                pub_decl:   map.new[intern.index, namespace.index](),
                priv_decl:  map.new[intern.index, namespace.index](),
            }

            s.np, let scope_idx = try namespace.add_entry(s.np, namespace.entry(scope_entry))

            let is_pub = try ast.is_public(s.ast, node)
            if is_pub {
                s.np = try namespace.link_public(s.np, s.current_scope, fqn_idx, scope_idx)
            } else {
                s.np = try namespace.link_private(s.np, s.current_scope, fqn_idx, scope_idx)
            }

            if node.tag == ast.tag.fn_gen_def || node.tag == ast.tag.fn_gen_err_def || node.tag == ast.tag.struct_gen_def {
                s.generic_defs = try register_generic(s.generic_defs, fqn_idx, generic_def{
                    source_ast:   s.ast,
                    source_scope: s.current_scope,
                    ast_node_idx: idx,
                })
            }
        case _:
            next
        }
    }
    return s
}

// resolve all type references by iterating over struct fields,
// enum variants, union types, function argument and return types
// and type definitions to resolve their types. this phase interns
// the fields/variants/sub-types using their identifier without
// first creating a fqn. we do this to simplify lookup during
// later stages without having to know e.g. which library path
// an import comes from
fn resolve_types(s *semsis)! *semsis {
    var s = s

    let stmts = try ast.library_stmts(s.ast)
    let data = stmts.data
    let current_scope = try namespace.get_scope(s.np, s.current_scope)
    for i = data.x; i < data.y; i++ {
        let idx = try get(s.ast.extras, i)
        let node = try get(s.ast.nodes, idx)

        match node.tag {
        case ast.tag.struct_def, ast.tag.error_def:
            let ident = try ast.identifier(s.ast, node)
            let fqn = try make_fqn(current_scope.path, ident)
            let name_idx, let maybe_type_scope_idx = try get_type_scope(s.ip, s.np, s.current_scope, fqn)
            try assert(maybe_type_scope_idx != null, "expected type to be found")
            let type_scope_idx = ?maybe_type_scope_idx
            let type_scope = try namespace.get_scope(s.np, type_scope_idx)
            let sem_type = type_scope.owner

            if node.data.y == ast.NULL_IDX {
                let empty_fields = try make([]u32, 0, 0)
                s.tp = try types.set_struct_fields(s.tp, sem_type, empty_fields)
                s, let struct_ir_type = try lower_semantic_to_ir(s, sem_type)
                let empty_ir_types = try make([]intern.index, 0, 0)
                s.ip, let _ = try intern.make_struct_fields(s.ip, struct_ir_type, empty_ir_types)
            } else {
                let fields_node = try get(s.ast.nodes, node.data.y)
                let fields_data = fields_node.data

                let field_count = (fields_data.y - fields_data.x) / 2
                var field_data = try make([]u32, 0, field_count * 2)
                var field_ir_types = try make([]intern.index, 0, field_count)

                for j = fields_data.x; j < fields_data.y; j = j+2 {
                    let field_name_idx = try get(s.ast.extras, j)
                    let field_type_idx = try get(s.ast.extras, j+1)

                    let field_name_node = try get(s.ast.nodes, field_name_idx)
                    let field_name = try ast.identifier(s.ast, field_name_node)
                    s.ip, let field_name_interned = try intern.intern_string(s.ip, field_name)

                    s, let ok = try rule_ident_unique(s, type_scope_idx, field_name_interned, field_name_idx)
                    if !ok {
                        next
                    }

                    s, let resolved_type = try resolve_type_ref(s, s.current_scope, field_type_idx)
                    s, let ir_type = try lower_semantic_to_ir(s, resolved_type)
                    field_ir_types = try append(field_ir_types, ir_type)

                    field_data = try append(field_data, u32(field_name_interned))
                    field_data = try append(field_data, u32(resolved_type))
                }

                s.tp = try types.set_struct_fields(s.tp, sem_type, field_data)

                s, let struct_ir_type = try lower_semantic_to_ir(s, sem_type)
                s.ip, let _ = try intern.make_struct_fields(s.ip, struct_ir_type, field_ir_types)
            }
        case ast.tag.struct_gen_def:
            let ident = try ast.identifier(s.ast, node)
            let fqn = try make_fqn(current_scope.path, ident)
            let name_idx, let maybe_type_scope_idx = try get_type_scope(s.ip, s.np, s.current_scope, fqn)
            try assert(maybe_type_scope_idx != null, "expected type to be found")
            let type_scope_idx = ?maybe_type_scope_idx

            let type_params = try get(s.ast.extras, node.data.x+1)
            s = try resolve_type_parameters(s, type_scope_idx, type_params)

            let type_scope = try namespace.get_scope(s.np, type_scope_idx)
            let sem_type = type_scope.owner

            let fields_idx = try get(s.ast.extras, node.data.x+2)
            let fields_node = try get(s.ast.nodes, fields_idx)
            let fields_data = fields_node.data

            let field_count = (fields_data.y - fields_data.x) / 2
            var field_data = try make([]u32, 0, field_count * 2)
            var field_ir_types = try make([]intern.index, 0, field_count)

            for j = fields_data.x; j < fields_data.y; j = j+2 {
                let field_name_idx = try get(s.ast.extras, j)
                let field_type_idx = try get(s.ast.extras, j+1)

                let field_name_node = try get(s.ast.nodes, field_name_idx)
                let field_name = try ast.identifier(s.ast, field_name_node)
                s.ip, let field_name_interned = try intern.intern_string(s.ip, field_name)

                s, let ok = try rule_ident_unique(s, type_scope_idx, field_name_interned, field_name_idx)
                if !ok {
                    next
                }

                s, let resolved_type = try resolve_type_ref(s, type_scope_idx, field_type_idx)
                s, let ir_type = try lower_semantic_to_ir(s, resolved_type)
                field_ir_types = try append(field_ir_types, ir_type)

                field_data = try append(field_data, u32(field_name_interned))
                field_data = try append(field_data, u32(resolved_type))
            }

            s.tp = try types.set_struct_fields(s.tp, sem_type, field_data)

            s, let struct_ir_type = try lower_semantic_to_ir(s, sem_type)
            s.ip, let _ = try intern.make_struct_fields(s.ip, struct_ir_type, field_ir_types)

        case ast.tag.enum_def:
            let ident = try ast.identifier(s.ast, node)
            let fqn = try make_fqn(current_scope.path, ident)
            let name_idx, let maybe_type_scope_idx = try get_type_scope(s.ip, s.np, s.current_scope, fqn)
            try assert(maybe_type_scope_idx != null, "expected type to be found")
            let type_scope_idx = ?maybe_type_scope_idx

            let enum_scope = try namespace.get_scope(s.np, type_scope_idx)
            let enum_sem_type = enum_scope.owner

            let fields_node = try get(s.ast.nodes, node.data.y)
            let fields_data = fields_node.data

            let variant_count = fields_data.y - fields_data.x
            var variant_names = try make([]intern.index, 0, variant_count)

            for j = fields_data.x; j < fields_data.y; j++ {
                let variant_idx = try get(s.ast.extras, j)
                let variant_node = try get(s.ast.nodes, variant_idx)
                let variant_name = try ast.identifier(s.ast, variant_node)
                s.ip, let variant_name_interned = try intern.intern_string(s.ip, variant_name)

                s, let ok = try rule_ident_unique(s, type_scope_idx, variant_name_interned, variant_idx)
                if !ok {
                    next
                }

                variant_names = try append(variant_names, variant_name_interned)
            }

            s.tp = try types.set_enum_variants(s.tp, enum_sem_type, variant_names)

        case ast.tag.union_def:
            let ident = try ast.identifier(s.ast, node)
            let fqn = try make_fqn(current_scope.path, ident)
            let name_idx, let maybe_type_scope_idx = try get_type_scope(s.ip, s.np, s.current_scope, fqn)
            try assert(maybe_type_scope_idx != null, "expected union to be found")
            let type_scope_idx = ?maybe_type_scope_idx

            let union_scope = try namespace.get_scope(s.np, type_scope_idx)
            let union_sem_type = union_scope.owner

            let types_node = try get(s.ast.nodes, node.data.y)
            let types_data = types_node.data

            let subtype_count = types_data.y - types_data.x
            var subtype_data = try make([]u32, 0, subtype_count * 2)

            for j = types_data.x; j < types_data.y; j++ {
                let variant_idx = try get(s.ast.extras, j)
                let variant_name = try ast.get_type_name(s.ast, variant_idx)
                s.ip, let variant_name_interned = try intern.intern_string(s.ip, variant_name)

                s, let ok = try rule_ident_unique(s, type_scope_idx, variant_name_interned, variant_idx)
                if !ok {
                    next
                }

                s, let resolved_type = try resolve_type_ref(s, s.current_scope, variant_idx)

                subtype_data = try append(subtype_data, u32(variant_name_interned))
                subtype_data = try append(subtype_data, u32(resolved_type))
            }

            s.tp = try types.set_union_subtypes(s.tp, union_sem_type, subtype_data)

        case ast.tag.type_def:
            let ident = try ast.identifier(s.ast, node)
            let fqn = try make_fqn(current_scope.path, ident)
            let name_idx, let maybe_type_scope_idx = try get_type_scope(s.ip, s.np, s.current_scope, fqn)
            try assert(maybe_type_scope_idx != null, "expected type to be found")
            let type_scope_idx = ?maybe_type_scope_idx

            s, let resolved_type = try resolve_type_ref(s, s.current_scope, node.data.y)

            let is_ptr = try types.is_pointer(s.tp, resolved_type)
            let is_opt = try types.is_optional(s.tp, resolved_type)
            if is_ptr || is_opt {
                s = try add_error(s, invalid_type_def_underlying{
                    type_name: name_idx,
                    pos: idx,
                })
                next
            }

            let type_scope = try namespace.get_scope(s.np, type_scope_idx)
            s.tp = try types.set_type_def_underlying(s.tp, type_scope.owner, resolved_type)

        case ast.tag.fn_def, ast.tag.fn_err_def:
            let ident = try ast.identifier(s.ast, node)
            let fqn = try make_fqn(current_scope.path, ident)
            let name_idx, let maybe_fn_scope_idx = try get_type_scope(s.ip, s.np, s.current_scope, fqn)
            try assert(maybe_fn_scope_idx != null, "expected fn to be found")
            let fn_scope_idx = ?maybe_fn_scope_idx

            let fn_scope = try namespace.get_scope(s.np, fn_scope_idx)
            let fn_sem_type = fn_scope.owner
            s, let fn_type_ir = try lower_semantic_to_ir(s, fn_sem_type)

            let params_idx = try get(s.ast.extras, node.data.x+1)
            s, let param_ir_types, let param_sem_types = try resolve_function_argument_types(s, fn_scope_idx, params_idx)
            let rets_idx = try get(s.ast.extras, node.data.x+2)
            s, let ret_ir_types, let ret_sem_types = try resolve_function_return_types(s, fn_scope_idx, rets_idx)

            s.ip, let _ = try intern.make_function_signature(s.ip, fn_type_ir, param_ir_types, ret_ir_types)
            s.tp = try types.make_function_signature(s.tp, fn_sem_type, param_sem_types, ret_sem_types)

        case ast.tag.fn_gen_def, ast.tag.fn_gen_err_def:
            let ident = try ast.identifier(s.ast, node)
            let fqn = try make_fqn(current_scope.path, ident)
            let name_idx, let maybe_fn_scope_idx = try get_type_scope(s.ip, s.np, s.current_scope, fqn)
            try assert(maybe_fn_scope_idx != null, "expected fn to be found")
            let fn_scope_idx = ?maybe_fn_scope_idx

            let type_params_idx = try get(s.ast.extras, node.data.x+1)
            s = try resolve_type_parameters(s, fn_scope_idx, type_params_idx)
           
        case _:
            next
        }
    }

    s = try rule_no_type_cycles(s)
    
    return s
}

// rule_no_type_cycles verifies types do not cyclically reference
// themselves or others without breaking the cycle using optionals
fn rule_no_type_cycles(s *semsis) *semsis {
    return s
}

// resolve_type_parameters resolves generic type parameters like [T many, E error]
// and registers them in the given namespace scope. Type parameter names are
// interned globally but the type declarations are stored in the local scope
// (function or struct namespace) 'ns' since they are tied to that specific context.
fn resolve_type_parameters(s *semsis, scope_idx namespace.index, idx ast.index)! *semsis {
    if idx == ast.NULL_IDX {
        return s
    }

    var s = s
    let node = try get(s.ast.nodes, idx)
    let data = node.data

    // shared types like [T, E many] where both map to 'many'
    // are handled by iterating in reverse
    var constraint_type_idx = ast.NULL_IDX
    for i = i64(data.y-1); i >= i64(data.x); i = i-2 {
        let param_name_idx = try get(s.ast.extras, i-1)
        let param_type_idx = try get(s.ast.extras, i)

        if param_type_idx != ast.NULL_IDX {
            constraint_type_idx = param_type_idx
        }

        let param_name_node = try get(s.ast.nodes, param_name_idx)

        let param_name = try ast.identifier(s.ast, param_name_node)
        s.ip, let param_name_interned = try intern.intern_string(s.ip, param_name)

        s, let ok = try rule_ident_unique(s, scope_idx, param_name_interned, param_name_idx)
        if !ok {
            next
        }

        s, let resolved_constraint = try resolve_type_ref(s, scope_idx, constraint_type_idx)
        s.ip, let _ = try intern.make_generic_type(s.ip, param_name_interned)

        let scope = try namespace.get_scope(s.np, scope_idx)
        let type_param_fqn = try make_fqn(scope.path, param_name)
        s.ip, let type_param_fqn_idx = try intern.intern_string(s.ip, type_param_fqn)

        let type_param_entry = namespace.scope{
            path:       scope.path,
            owner:      resolved_constraint,
            parent_idx: scope_idx,
            pub_decl:   map.new[intern.index, namespace.index](),
            priv_decl:  map.new[intern.index, namespace.index](),
        }
        s.np = try namespace.put_public(s.np, scope_idx, type_param_fqn_idx, namespace.entry(type_param_entry))
    }

    return s
}

// resolve_function_argument_types resolves function parameter types.
// Handles implicit types like (a, b i64) where multiple params share one type annotation.
// Returns the collected param types in order (for interning the function signature).
// Note: Parameters are stored as namespace.value later in analyse_function when
// arg() instructions are generated.
// Returns both IR types (for intern signature) and semantic types (for types pool signature)
fn resolve_function_argument_types(s *semsis, scope_idx namespace.index, idx ast.index)! *semsis, []intern.index, []types.index {
    if idx == ast.NULL_IDX {
        return s, [], []
    }

    var s = s
    let params_node = try get(s.ast.nodes, idx)
    let params_data = params_node.data

    let param_count = i64((params_data.y - params_data.x) / 2)
    var param_ir_types = try make([]intern.index, param_count, param_count)
    var param_sem_types = try make([]types.index, param_count, param_count)

    var type_idx = ast.NULL_IDX
    var has_error = false
    // NOTE: maybe we change algorithm and dont iterate backwards
    // so we get errors ordered. Also e.g. "fn x(a, a i32)" its
    // unnatural that first 'a' is marked as duplicate
    for i = i64(params_data.y-1); i >= i64(params_data.x); i = i-2 {
        let param_name_idx = try get(s.ast.extras, i-1)
        let param_type_idx = try get(s.ast.extras, i)
        if param_type_idx != ast.NULL_IDX {
            type_idx = param_type_idx
        }
        let param_name_node = try get(s.ast.nodes, param_name_idx)
        let param_name = try ast.identifier(s.ast, param_name_node)

        if param_type_idx == ast.NULL_IDX && type_idx == ast.NULL_IDX {
            s = add_error(s, parameter_missing_type{name: param_name, pos: param_name_idx})
            // we dont return here so we can catch all arguments who might have a missing type
            has_error = true
            next
        }

        s.ip, let param_name_interned = try intern.intern_string(s.ip, param_name)
        s, let ok = try rule_ident_unique(s, scope_idx, param_name_interned, param_name_idx)
        if !ok {
            has_error = true
            next
        }

        s, let sem_type = try resolve_type_ref(s, scope_idx, type_idx)
        if sem_type == types.NULL_IDX {
            has_error = true
            next
        }
        s, let ir_type = try lower_fn_param_type_to_ir(s, sem_type)

        let param_pos = (i - i64(params_data.x)) / 2

        param_ir_types = try put(param_ir_types, param_pos, ir_type)
        param_sem_types = try put(param_sem_types, param_pos, sem_type)

        let param_is_linear = try types.is_linear(s.tp, sem_type)
        if param_is_linear {
            let lv = namespace.linear_value{
                is_reassignable: false,
                is_consumed:     false,
                name:            param_name_interned,
                type_idx:        sem_type,
                index:           ir.NULL_IDX,
            }
            s.np = try namespace.put_public(s.np, scope_idx, param_name_interned, namespace.entry(lv))
        } else {
            let pv = namespace.value{
                is_reassignable: false,
                name:            param_name_interned,
                type_idx:        sem_type,
                index:           ir.NULL_IDX,
            }
            s.np = try namespace.put_public(s.np, scope_idx, param_name_interned, namespace.entry(pv))
        }
    }
    if has_error {
        return s, [], []
    }

    return s, param_ir_types, param_sem_types
}

// resolve_function_return_types resolves function return types.
// Returns both IR return types (for interning) and semantic return types (for types pool).
fn resolve_function_return_types(s *semsis, scope_idx namespace.index, idx ast.index)! *semsis, []intern.index, []types.index {
    if idx == ast.NULL_IDX {
        return s, [], []
    }

    var s = s
    let rets_node = try get(s.ast.nodes, idx)
    let rets_data = rets_node.data

    let ret_count = rets_data.y - rets_data.x
    var ret_ir_types = try make([]intern.index, 0, ret_count)
    var ret_sem_types = try make([]types.index, 0, ret_count)

    for i = rets_data.x; i < rets_data.y; i++ {
        let ret_type_idx = try get(s.ast.extras, i)
        s, let sem_type = try resolve_type_ref(s, scope_idx, ret_type_idx)
        s, let ir_type = try lower_semantic_to_ir(s, sem_type)
        ret_ir_types = try append(ret_ir_types, ir_type)
        ret_sem_types = try append(ret_sem_types, sem_type)
    }

    return s, ret_ir_types, ret_sem_types
}

// resolve_type_ref resolves a type reference from AST node to types.index (semantic type)
// if NULL_IDX returned it means there was an error resolving the type reference
fn resolve_type_ref(s *semsis, scope_idx namespace.index, idx ast.index)! *semsis, types.index {
    if idx == ast.NULL_IDX {
        return s, types.NULL_IDX
    }

    var s = s
    let node = try get(s.ast.nodes, idx)

    match node.tag {
    case ast.tag.u8_type:
        s.tp, let type_idx = try types.make_u8(s.tp)
        return s, type_idx
    case ast.tag.u16_type:
        s.tp, let type_idx = try types.make_u16(s.tp)
        return s, type_idx
    case ast.tag.u32_type:
        s.tp, let type_idx = try types.make_u32(s.tp)
        return s, type_idx
    case ast.tag.u64_type:
        s.tp, let type_idx = try types.make_u64(s.tp)
        return s, type_idx
    case ast.tag.i8_type:
        s.tp, let type_idx = try types.make_i8(s.tp)
        return s, type_idx
    case ast.tag.i16_type:
        s.tp, let type_idx = try types.make_i16(s.tp)
        return s, type_idx
    case ast.tag.i32_type:
        s.tp, let type_idx = try types.make_i32(s.tp)
        return s, type_idx
    case ast.tag.i64_type:
        s.tp, let type_idx = try types.make_i64(s.tp)
        return s, type_idx
    case ast.tag.int_type:
        s.tp, let type_idx = try types.make_i64(s.tp)
        return s, type_idx
    case ast.tag.char_type:
        s.tp, let type_idx = try types.make_char(s.tp)
        return s, type_idx
    case ast.tag.f32_type:
        s.tp, let type_idx = try types.make_f32(s.tp)
        return s, type_idx
    case ast.tag.f64_type:
        s.tp, let type_idx = try types.make_f64(s.tp)
        return s, type_idx
    case ast.tag.float_type:
        s.tp, let type_idx = try types.make_f64(s.tp)
        return s, type_idx
    case ast.tag.string_type:
        s.tp, let type_idx = try types.make_string(s.tp)
        return s, type_idx
    case ast.tag.bool_type:
        s.tp, let type_idx = try types.make_bool(s.tp)
        return s, type_idx
    case ast.tag.many_type:
        s.tp, let type_idx = try types.make_many(s.tp)
        return s, type_idx
    case ast.tag.error_type:
        s.tp, let type_idx = try types.make_generic_error(s.tp)
        return s, type_idx

    case ast.tag.optional_type:
        s, let inner = try resolve_type_ref(s, scope_idx, node.data.x)
        s.tp, let type_idx = try types.make_optional(s.tp, inner)
        return s, type_idx

    case ast.tag.array_type:
        s, let inner = try resolve_type_ref(s, scope_idx, node.data.x)
        s.tp, let type_idx = try types.make_array(s.tp, inner)
        return s, type_idx

    case ast.tag.pointer_type:
        s, let inner = try resolve_type_ref(s, scope_idx, node.data.x)
        s.tp, let type_idx = try types.make_pointer(s.tp, inner)
        return s, type_idx

    case ast.tag.memory_type:
        s, let inner = try resolve_type_ref(s, scope_idx, node.data.x)
        s.tp, let type_idx = try types.make_memory(s.tp, inner)
        return s, type_idx

    case ast.tag.ident:
        let type_name = try ast.identifier(s.ast, node)
        let current_scope = try namespace.get_scope(s.np, scope_idx)
        let fqn = try make_fqn(current_scope.path, type_name)
        let type_idx = try get_type_idx(s, scope_idx, fqn)
        if type_idx == null {
            s = try add_error(s, type_not_found{name: fqn, pos: idx})
            return s, types.NULL_IDX
        }
        return s, ?type_idx

    case ast.tag.dot:
        let lhs_idx = node.data.x
        let lhs = try get(s.ast.nodes, lhs_idx)
        let rhs_idx = node.data.y
        let rhs = try get(s.ast.nodes, rhs_idx)

        // TODO: rename to something else without lib
        let lib_name = try ast.identifier(s.ast, lhs)
        let lib_scope_idx_opt = try get_scope_idx(s, scope_idx, lib_name)
        if lib_scope_idx_opt == null {
            return s, types.NULL_IDX
        }

        return try resolve_type_ref(s, ?lib_scope_idx_opt, rhs_idx)
    case ast.tag.type_params:
        s, let mono_type = try instantiate_generic_struct(s, idx)
        return s, mono_type
    case _:
        return s, types.NULL_IDX
    }
}

// TODO: create a new function called resolve variable ref 
// that returns the type of a variable within a namespace

fn with_scope(s *semsis, scope_idx namespace.index) *semsis {
    return &semsis{
        ..s,
        current_scope: scope_idx,
    }
}

fn with_errs(s *semsis, errs []error) *semsis {
    return &semsis{
        ..s,
        errs: errs,
    }
}

// from_function assigns instructions, extra and any errors
// to main semsis struct. implementation tightly dependent
// on how fn_s is initialised in analyse_and_generate
fn from_function(s, fn_s *semsis) *semsis {
    // we can not append or do any other modifications as
    // indices of instructions reference index in array
    // hence we assign, as fn scope appended to previous
    // array
    var s = s
    s.ip = fn_s.ip
    s.np = fn_s.np
    s.tp = fn_s.tp
    s.ins = fn_s.ins
    s.extra = fn_s.extra
    s.errs = try append(s.errs, fn_s.errs)
    s.generic_defs = fn_s.generic_defs
    s.mono_queue = fn_s.mono_queue
    s.mono_cache = fn_s.mono_cache
    return s
}

// analyse_global_variables analyses all global variables
// after all types have been resolved and before any function
// definitions are analysed and generated as global variables
// might types (but types cant reference global variables) and
// functions might depend on global variables. 
fn analyse_global_variables(s *semsis)! *semsis {
    var s = s

    let stmts = try ast.library_stmts(s.ast)
    let data = stmts.data

    s, let init_block_idx = try generate_init_block(s)

    // Get init block FQN and initialise SSA builder for global scope control flow
    let current_scope = try namespace.get_scope(s.np, s.current_scope)
    let init_name = try make_fqn(current_scope.path, "init")
    s.ip, let init_fqn = try intern.intern_string(s.ip, init_name)
    s = &semsis{..s, ssa: new_ssa_builder(), current_func_fqn: init_fqn}

    for i = data.x; i < data.y; i++ {
        let idx = try get(s.ast.extras, i)
        let node = try get(s.ast.nodes, idx)
        match node.tag {
        case ast.tag.assignment:
            s, let _ = try analyse_global_assignment(s, idx)
        case _:
            next
        }
    }
    return s
}

fn analyse_and_generate(s *semsis)! *semsis {
    var s = s

    s = try analyse_global_variables(s)

    let stmts = try ast.library_stmts(s.ast)
    let data = stmts.data

    for i = data.x; i < data.y; i++ {
        let idx = try get(s.ast.extras, i)
        let node = try get(s.ast.nodes, idx)
        match node.tag {
        case ast.tag.fn_def, ast.tag.fn_err_def:
            let name = try ast.identifier(s.ast, node)
            let current_scope = try namespace.get_scope(s.np, s.current_scope)
            let fqn = try make_fqn(current_scope.path, name)
            let _, let fqn_interned = try intern.intern_string(s.ip, fqn)
            let fn_scope_idx_opt = try get_scope_idx(s, s.current_scope, fqn)
            try assert(fn_scope_idx_opt != null, "function scope not found")
            let fn_scope_idx = ?fn_scope_idx_opt

            var fn_s = with_scope(s, fn_scope_idx)
            fn_s = with_errs(fn_s, [])

            fn_s = &semsis{..fn_s, block_counter: 0}

            fn_s, let fn_idx = try analyse_function(fn_s, fqn_interned, idx)
            s = from_function(s, fn_s)
        case ast.tag.fn_gen_def, ast.tag.fn_gen_err_def:
            next
        case _:
            next
        }
    }
    s = try drain_mono_queue(s)
    return s
}

fn drain_mono_queue(s *semsis)! *semsis {
    var s = s
    var i = 0
    for i < len(s.mono_queue) {
        let job = try get(s.mono_queue, i)
        i = i + 1

        let cached_val = try map.get_val(s.mono_cache, job.mono_fqn)
        if cached_val != null && ?cached_val != ir.NULL_IDX {
            next
        }

        let gdef_opt = try lookup_generic(s.generic_defs, job.generic_fqn)
        if gdef_opt == null {
            s = try add_error(s, compiler_error{rsn: "generic definition not found during drain", pos: job.call_pos})
            next
        }
        let gdef = ?gdef_opt

        let mono_scope_idx_opt = try namespace.lookup(s.np, gdef.source_scope, job.mono_fqn)
        if mono_scope_idx_opt == null {
            s = try add_error(s, compiler_error{rsn: "mono scope not found during drain", pos: job.call_pos})
            next
        }
        let mono_scope_idx = ?mono_scope_idx_opt

        var fn_s = with_scope(s, mono_scope_idx)
        fn_s = with_errs(fn_s, [])
        fn_s = &semsis{..fn_s, block_counter: 0, ast: gdef.source_ast}

        fn_s, let func_idx = try analyse_function(fn_s, job.mono_fqn, gdef.ast_node_idx)

        fn_s = &semsis{..fn_s, ast: s.ast}
        s = from_function(s, fn_s)
        s.mono_cache = try map.insert(s.mono_cache, job.mono_fqn, func_idx)
    }
    return s
}

fn analyse_function(s *semsis, fqn intern.index, idx ast.index)! *semsis, ir.index {
    var s = s

    try assert(s.block_counter == 0, "block_counter must be 0 on function entry")

    let node = try get(s.ast.nodes, idx)
    let data = node.data
    let offset = if node.tag == ast.tag.fn_gen_def || node.tag == ast.tag.fn_gen_err_def { ast.index(1) } else { ast.index(0) }
    let args = try get(s.ast.extras, data.x + 1 + offset)

    let rets_idx = try get(s.ast.extras, data.x + 2 + offset)
    let body = try get(s.ast.extras, data.x + 3 + offset)
    if body != ast.NULL_IDX {
        let fn_scope = try namespace.get_scope(s.np, s.current_scope)
        let fn_sem_type = fn_scope.owner
        let fn_is_fallible = try types.is_fallible(s.tp, fn_sem_type)

        s = &semsis{
            ..s,
            ssa: new_ssa_builder(),
            current_func_fqn: fqn,
            current_fn_sem_type: fn_sem_type,
            current_fn_is_fallible: fn_is_fallible,
            defer_stack: [],
            defer_registry: [],
            defer_arg_types: [],
            defer_arg_counts: [],
        }

        s, let entry_block_fqn = try reserve_block(s, fqn)

        s, let func_idx = try generate_function(s, fqn, args, entry_block_fqn)
        s = &semsis{..s, current_fn_ir: func_idx}
        s, let _, let terminated = try analyse_block(s, body, entry_block_fqn, fqn)

        s = &semsis{..s, ssa: null}

        if rets_idx != ast.NULL_IDX && !terminated {
            s = try add_error(s, missing_return{pos: body})
        }

        s = try generate_defer_wrappers(s, fqn)

        return s, func_idx
    } else {
        // if we have no body it might be @extern(c)
        // TODO: validate types for extern(c) fns
        // TODO: generate IR with c call conv
        return s, ir.NULL_IDX
    }
}

fn generate_function(s *semsis, fn_fqn intern.index, args ast.index, block_fqn intern.index)! *semsis, ir.index {
    var s = s

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.func, x: fn_fqn, y: ir.NULL_IDX})
    let func_idx = ir.index(u32(len(s.ins)-1))

    var has_error = false
    let start = u32(len(s.extra))
    if args != ast.NULL_IDX {
        let node = try get(s.ast.nodes, args)
        let data = node.data

        var type_idx = ast.NULL_IDX
        for i = i64(data.x); i < i64(data.y); i = i+2 {
            let param_name_idx = try get(s.ast.extras, i)
            let param_type_idx = try get(s.ast.extras, i+1)
            if param_type_idx != ast.NULL_IDX {
                type_idx = param_type_idx
            } else if type_idx != ast.NULL_IDX && param_type_idx == ast.NULL_IDX {
                type_idx = ast.NULL_IDX
            }

            if type_idx == ast.NULL_IDX {
                for j = i+2; j < i64(data.y); j = j+2 {
                    let param_type_idx = try get(s.ast.extras, j+1)
                    if param_type_idx != ast.NULL_IDX {
                        type_idx = param_type_idx
                        break
                    }
                }
            }

            let param_name_node = try get(s.ast.nodes, param_name_idx)
            let param_name = try ast.identifier(s.ast, param_name_node)
            s.ip, let param_name_interned = try intern.intern_string(s.ip, param_name)

            let param_entry_idx_opt = try namespace.lookup(s.np, s.current_scope, param_name_interned)
            let resolved_sem = if param_entry_idx_opt != null {
                let entry_idx = ?param_entry_idx_opt
                let entry = try namespace.get_entry(s.np, entry_idx)
                match entry = entry {
                    case namespace.value: entry.type_idx
                    case namespace.linear_value: entry.type_idx
                    case _: types.NULL_IDX
                }
            } else {
                types.NULL_IDX
            }
            if resolved_sem == types.NULL_IDX {
                // if this is the case it means another
                // error occurred when analysing function
                // signature in resolve_types
                has_error = true
                next
            }

            s, let resolved_ir = try lower_fn_param_type_to_ir(s, resolved_sem)

            s.ins = try append(s.ins, ir.inst{tag: ir.tag.arg, x: param_name_interned, y: resolved_ir})
            let arg_idx = ir.index(u32(len(s.ins)-1))

            let arg_val = namespace.value{
                is_reassignable: false,
                name: param_name_interned,
                type_idx: resolved_sem,
                index: arg_idx
            }
            s.np = try namespace.put_public(s.np, s.current_scope, param_name_interned, namespace.entry(arg_val))
        }
    }
    if has_error {
        return s, ir.NULL_IDX
    }

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.jmp, x: u32(block_fqn), y: ir.NULL_IDX})

    return s, func_idx
}

fn generate_init_block(s *semsis)! *semsis, ir.index {
    var s = s

    let current_scope = try namespace.get_scope(s.np, s.current_scope)
    let init_name = try make_fqn(current_scope.path, "init")
    s.ip, let init_name_interned = try intern.intern_string(s.ip, init_name)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.init, x: init_name_interned, y: ir.NULL_IDX})
    let init_idx = ir.index(u32(len(s.ins)-1))

    return s, init_idx
}

// rule_ident_unique verifies this identifier is not already defined
// within namespace or parent namespaces
fn rule_ident_unique(s *semsis, scope_idx namespace.index, name_idx intern.index, idx ast.index)! *semsis, bool {
    var s = s
    if name_idx == intern.NULL_IDX {
        return s, true
    }

    let v = try namespace.lookup(s.np, scope_idx, name_idx)
    if v != null {
        let ident_idx = try ast.identifier_index(s.ast, idx)
        s = try add_error(s, identifier_redeclared{pos: ident_idx})
        return s, false
    }

    // For variable scopes (not type scopes), also check FQN version to catch
    // local variables shadowing globals. Type scopes have owner != NULL_IDX.
    let scope = try namespace.get_scope(s.np, scope_idx)
    if scope.owner == types.NULL_IDX {
        let name = try intern.get_string(s.ip, name_idx)
        let current_scope = try namespace.get_scope(s.np, s.current_scope)
        let fqn = try make_fqn(current_scope.path, name)
        s.ip, let fqn_idx = try intern.intern_string(s.ip, fqn)

        // Only check FQN if it differs from the original name
        if fqn_idx != name_idx {
            let v_fqn = try namespace.lookup(s.np, scope_idx, fqn_idx)
            if v_fqn != null {
                let ident_idx = try ast.identifier_index(s.ast, idx)
                s = try add_error(s, identifier_redeclared{pos: ident_idx})
                return s, false
            }
        }
    }

    return s, true
}

// analyse_block returns (semsis, ir.index, bool)
// The bool indicates if ALL paths through the block terminate (return/unreachable)
fn analyse_block(s *semsis, idx ast.index, block_fqn, func_fqn intern.index)! *semsis, ir.index, bool {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let data = node.data

    let saved_scope = s.current_scope

    let parent_scope = try namespace.get_scope(s.np, s.current_scope)
    s.np, let block_scope = try namespace.new_scope(s.np, parent_scope.path, types.NULL_IDX, s.current_scope)
    s = &semsis{..s, current_scope: block_scope}

    s.defer_stack = try append(s.defer_stack, defer_block{
        scope_idx: block_scope,
        start_idx: u32(len(s.defer_registry)),
        end_idx:   u32(len(s.defer_registry)),
    })

    s, let block_idx = try generate_block(s, block_fqn)

    var terminated = false

    for i = data.x; i < data.y; i++  {
        let stmt_idx = try get(s.ast.extras, i)
        let stmt = try get(s.ast.nodes, stmt_idx)
        match stmt.tag {
        case ast.tag.assignment:
            s, let _ = try analyse_assignment(s, stmt_idx)
            terminated = false
        case ast.tag.raise_stmt:
            s, let _ = try analyse_raise(s, stmt_idx)
            terminated = true
        case ast.tag.try_expr:
            s, let _, let _ = try analyse_try_expr(s, stmt_idx)
            terminated = false
        case ast.tag.catch_expr:
            s, let _, let _ = try analyse_catch_expr(s, stmt_idx)
            terminated = false
        case ast.tag.call:
            s, let _, let _ = try analyse_call(s, stmt_idx)
            let last = try get(s.ins, len(s.ins) - 1)
            terminated = last.tag == ir.tag.unreachable
        case ast.tag.return_stmt:
            s, let _ = try analyse_return(s, stmt_idx)
            terminated = true
        case ast.tag.defer_stmt:
            s, let _ = try analyse_defer(s, stmt_idx)
            terminated = false
        case ast.tag.if_stmt:
            s, let _, let if_terminated = try analyse_if_stmt(s, stmt_idx, func_fqn)
            terminated = if_terminated
        case ast.tag.match_stmt:
            s, let _, let match_terminated = try analyse_match_stmt(s, stmt_idx, func_fqn)
            terminated = match_terminated
        case ast.tag.for_infinite, ast.tag.for_bool, ast.tag.for_classic, ast.tag.for_range:
            s, let _, let for_terminated = try analyse_for_stmt(s, stmt_idx, func_fqn)
            terminated = for_terminated
        case ast.tag.break_stmt:
            s, let break_terminated = try analyse_break(s, stmt_idx, i == data.y - 1)
            terminated = break_terminated
        case ast.tag.next_stmt:
            s, let next_terminated = try analyse_next(s, stmt_idx, i == data.y - 1)
            terminated = next_terminated
        case _:
            terminated = false
        //   // TODO: add compiler error, parser should have caught this
        }
    }

    if !terminated {
        let current_defer = try get(s.defer_stack, len(s.defer_stack) - 1)
        s = try generate_block_defer_cleanup(s, current_defer)
    }

    s.defer_stack = try slice(s.defer_stack, 0, len(s.defer_stack)-1)
    s = &semsis{..s, current_scope: saved_scope}

    return s, block_idx, terminated
}

// analyse_block_inline analyses statements inside a block AST node
// without generating a block instruction or creating a scope.
// Used by loop bodies where the block header was already emitted with block_args.
fn analyse_block_inline(s *semsis, idx ast.index, func_fqn intern.index)! *semsis, ir.index, bool {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let data = node.data

    let saved_scope = s.current_scope

    let parent_scope = try namespace.get_scope(s.np, s.current_scope)
    s.np, let block_scope = try namespace.new_scope(s.np, parent_scope.path, types.NULL_IDX, s.current_scope)
    s = &semsis{..s, current_scope: block_scope}

    s.defer_stack = try append(s.defer_stack, defer_block{
        scope_idx: block_scope,
        start_idx: u32(len(s.defer_registry)),
        end_idx:   u32(len(s.defer_registry)),
    })

    var terminated = false

    for i = data.x; i < data.y; i++ {
        let stmt_idx = try get(s.ast.extras, i)
        let stmt = try get(s.ast.nodes, stmt_idx)
        match stmt.tag {
        case ast.tag.assignment:
            s, let _ = try analyse_assignment(s, stmt_idx)
            terminated = false
        case ast.tag.raise_stmt:
            s, let _ = try analyse_raise(s, stmt_idx)
            terminated = true
        case ast.tag.try_expr:
            s, let _, let _ = try analyse_try_expr(s, stmt_idx)
            terminated = false
        case ast.tag.catch_expr:
            s, let _, let _ = try analyse_catch_expr(s, stmt_idx)
            terminated = false
        case ast.tag.call:
            s, let _, let _ = try analyse_call(s, stmt_idx)
            let last = try get(s.ins, len(s.ins) - 1)
            terminated = last.tag == ir.tag.unreachable
        case ast.tag.return_stmt:
            s, let _ = try analyse_return(s, stmt_idx)
            terminated = true
        case ast.tag.defer_stmt:
            s, let _ = try analyse_defer(s, stmt_idx)
            terminated = false
        case ast.tag.if_stmt:
            s, let _, let if_terminated = try analyse_if_stmt(s, stmt_idx, func_fqn)
            terminated = if_terminated
        case ast.tag.match_stmt:
            s, let _, let match_terminated = try analyse_match_stmt(s, stmt_idx, func_fqn)
            terminated = match_terminated
        case ast.tag.for_infinite, ast.tag.for_bool, ast.tag.for_classic, ast.tag.for_range:
            s, let _, let for_terminated = try analyse_for_stmt(s, stmt_idx, func_fqn)
            terminated = for_terminated
        case ast.tag.break_stmt:
            s, let break_terminated = try analyse_break(s, stmt_idx, i == data.y - 1)
            terminated = break_terminated
        case ast.tag.next_stmt:
            s, let next_terminated = try analyse_next(s, stmt_idx, i == data.y - 1)
            terminated = next_terminated
        case _:
            terminated = false
        }
    }

    if !terminated {
        let current_defer = try get(s.defer_stack, len(s.defer_stack) - 1)
        s = try generate_block_defer_cleanup(s, current_defer)
    }

    s.defer_stack = try slice(s.defer_stack, 0, len(s.defer_stack)-1)
    s = &semsis{..s, current_scope: saved_scope}

    return s, ir.NULL_IDX, terminated
}

fn is_logical_operator(tag ast.tag) bool {
    return tag == ast.tag.land || tag == ast.tag.lor
}

// try_evaluate_constant_bool attempts to evaluate a boolean expression at compile time.
// Returns the compile-time value if constant, null if the value is only known at runtime.
// Handles short-circuit semantics for && and ||.
fn try_evaluate_constant_bool(s *semsis, idx ast.index)! ?bool {
    let node = try get(s.ast.nodes, idx)

    match node.tag {
        case ast.tag.true_lit:
            return true
        case ast.tag.false_lit:
            return false
        case ast.tag.land:
            let data = node.data
            let lhs_val = try try_evaluate_constant_bool(s, data.x)
            if lhs_val != null {
                if !?lhs_val {
                    // false && _ = false (short-circuit)
                    return false
                }
                // true && rhs = rhs
                return try try_evaluate_constant_bool(s, data.y)
            }
            return null
        case ast.tag.lor:
            let data = node.data
            let lhs_val = try try_evaluate_constant_bool(s, data.x)
            if lhs_val != null {
                if ?lhs_val {
                    // true || _ = true (short-circuit)
                    return true
                }
                // false || rhs = rhs
                return try try_evaluate_constant_bool(s, data.y)
            }
            return null
        case _:
            return null
    }
}

// analyse_condition analyses a condition expression with short-circuit
// semantics for logical operators (&& and ||).
// For && (land): if LHS is false, jump to else_target without evaluating RHS
// For || (lor): if LHS is true, jump to then_target without evaluating RHS
fn analyse_condition(s *semsis, cond_idx ast.index, func_fqn intern.index,
                     then_target intern.index, then_args []ir.index,
                     else_target intern.index, else_args []ir.index)! *semsis {
    var s = s
    let node = try get(s.ast.nodes, cond_idx)
    let data = node.data

    if node.tag == ast.tag.land {
        let lhs_const = try try_evaluate_constant_bool(s, data.x)

        if lhs_const != null {
            if !?lhs_const {
                s = try generate_jmp_with_args(s, else_target, else_args)
                return s
            }
            return try analyse_condition(s, data.y, func_fqn,
                then_target, then_args, else_target, else_args)
        }

        s, let rhs_block = try reserve_block(s, func_fqn)

        s = try analyse_condition(s, data.x, func_fqn,
            rhs_block, [], else_target, else_args)

        s, let _ = try generate_block(s, rhs_block)

        return try analyse_condition(s, data.y, func_fqn,
            then_target, then_args, else_target, else_args)

    } else if node.tag == ast.tag.lor {
        let lhs_const = try try_evaluate_constant_bool(s, data.x)

        if lhs_const != null {
            if ?lhs_const {
                s = try generate_jmp_with_args(s, then_target, then_args)
                return s
            }
            return try analyse_condition(s, data.y, func_fqn,
                then_target, then_args, else_target, else_args)
        }

        s, let rhs_block = try reserve_block(s, func_fqn)

        s = try analyse_condition(s, data.x, func_fqn,
            then_target, then_args, rhs_block, [])

        s, let _ = try generate_block(s, rhs_block)

        return try analyse_condition(s, data.y, func_fqn,
            then_target, then_args, else_target, else_args)
    }

    s, var cond_ir, let cond_sem_type = try analyse_expression(s, cond_idx)
    if cond_ir == ir.NULL_IDX {
        return s
    }

    s, cond_ir = try extract_single_return_value(s, cond_ir, cond_idx)
    if cond_ir == ir.NULL_IDX {
        return s
    }

    if !try types.is_bool(s.tp, cond_sem_type) {
        s = try add_error(s, condition_not_bool{got: cond_sem_type, pos: cond_idx})
        return s
    }

    s = try generate_br_with_args(s, cond_ir, then_target, then_args, else_target, else_args)
    return s
}

fn generate_block(s *semsis, fqn intern.index)! *semsis, ir.index {
    var s = s
    s.ins = try append(s.ins, ir.inst{
        tag: ir.tag.block,
        x: u32(fqn),
        y: ir.NULL_IDX
    })
    let block_idx = ir.index(u32(len(s.ins)-1))
    return s, block_idx
}

// generate_block_with_args creates a block with parameters
// Returns the block IR index and an array of IR indices for the block arguments
// arg_types: intern.index types for each block parameter
fn generate_block_with_args(s *semsis, fqn intern.index, arg_types []intern.index)! *semsis, ir.index, []ir.index {
    var s = s
    if len(arg_types) == 0 {
        s, let block_idx = try generate_block(s, fqn)
        return s, block_idx, []
    }

    s.ins = try append(s.ins, ir.inst{
        tag: ir.tag.block,
        x: u32(fqn),
        y: ir.NULL_IDX
    })
    let block_idx = ir.index(u32(len(s.ins)-1))

    var arg_indices = try make([]ir.index, 0, len(arg_types))
    for i = 0; i < len(arg_types); i++ {
        let arg_type = try get(arg_types, i)
        s.ins = try append(s.ins, ir.inst{
            tag: ir.tag.block_arg,
            x: u32(arg_type),
            y: ir.NULL_IDX
        })
        arg_indices = try append(arg_indices, ir.index(u32(len(s.ins)-1)))
    }

    return s, block_idx, arg_indices
}

// analyse_if_stmt handles if/else-if/else statements with SSA support
// AST structure: extras contains [cond1, body1, cond2, body2, ..., ?else_body]
// Returns (semsis, ir.index, bool) where bool indicates if ALL paths terminate
fn analyse_if_stmt(s *semsis, idx ast.index, func_fqn intern.index)! *semsis, ir.index, bool {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let data = node.data

    let n = data.y - data.x
    let has_else = n % 2 != 0
    let cond_count = u32(n / 2)

    // forward scan all branch bodies to find assigned variables
    var all_scan = scan_result{assigned: [], has_break: false, has_next: false}
    for i = u32(0); i < cond_count; i++ {
        let body_idx = try get(s.ast.extras, u32(data.x) + i * 2 + 1)
        s, let sub = try collect_assignments(s, body_idx)
        all_scan = try merge_scan_results(all_scan, sub)
    }
    if has_else {
        let else_body_idx = try get(s.ast.extras, data.y - 1)
        s, let sub = try collect_assignments(s, else_body_idx)
        all_scan = try merge_scan_results(all_scan, sub)
    }

    s, let join = try compute_join_info(s, all_scan.assigned)

    var then_blocks = try make([]intern.index, 0, cond_count)
    var check_blocks = try make([]intern.index, 0, cond_count)
    for i = u32(0); i < cond_count; i++ {
        s, let then_fqn = try reserve_block(s, func_fqn)
        then_blocks = try append(then_blocks, then_fqn)
        if i < cond_count - 1 {
            s, let check_fqn = try reserve_block(s, func_fqn)
            check_blocks = try append(check_blocks, check_fqn)
        }
    }

    var else_fqn = intern.NULL_IDX
    if has_else {
        s, else_fqn = try reserve_block(s, func_fqn)
    }
    s, let merge_fqn = try reserve_block(s, func_fqn)

    let pre_branch_env = try snapshot_var_env(s)

    var all_terminated = true
    var merge_pred_count = u32(0)

    for i = u32(0); i < cond_count; i++ {
        if i > 0 {
            s = try restore_var_env(s, pre_branch_env)
            let check_fqn = try get(check_blocks, i - 1)
            s, let _ = try generate_block(s, check_fqn)
        }

        let cond_idx = try get(s.ast.extras, u32(data.x) + i * 2)
        let body_idx = try get(s.ast.extras, u32(data.x) + i * 2 + 1)

        var else_target = merge_fqn
        if i < cond_count - 1 {
            else_target = try get(check_blocks, i)
        } else if has_else {
            else_target = else_fqn
        }

        let then_fqn = try get(then_blocks, i)

        var else_args = try make([]ir.index, 0, len(join.var_ids))
        if else_target == merge_fqn && !has_else && i == cond_count - 1 {
            else_args = try collect_args_for_vars(s, join.var_ids)
        }

        s = try analyse_condition(s, cond_idx, func_fqn,
            then_fqn, [], else_target, else_args)

        s, let _, let branch_terminated = try analyse_block(s, body_idx, then_fqn, func_fqn)
        if !branch_terminated {
            let merge_args = try collect_args_for_vars(s, join.var_ids)
            s = try generate_jmp_with_args(s, merge_fqn, merge_args)
            merge_pred_count = merge_pred_count + 1
        }
        all_terminated = all_terminated && branch_terminated
    }

    if has_else {
        s = try restore_var_env(s, pre_branch_env)

        let else_body_idx = try get(s.ast.extras, data.y - 1)
        s, let _, let else_terminated = try analyse_block(s, else_body_idx, else_fqn, func_fqn)
        if !else_terminated {
            let merge_args = try collect_args_for_vars(s, join.var_ids)
            s = try generate_jmp_with_args(s, merge_fqn, merge_args)
            merge_pred_count = merge_pred_count + 1
        }
        all_terminated = all_terminated && else_terminated
    } else {
        merge_pred_count = merge_pred_count + 1
        all_terminated = false
    }

    if !all_terminated {
        if merge_pred_count >= 1 && len(join.var_ids) > 0 {
            s, let merge_idx, let arg_indices = try generate_block_with_args(s, merge_fqn, join.ir_types)
            s = try apply_block_args_to_env(s, join.var_ids, arg_indices)
            return s, merge_idx, false
        }
        if merge_pred_count == 1 && !has_else {
            s = try restore_var_env(s, pre_branch_env)
        }
        s, let merge_idx = try generate_block(s, merge_fqn)
        return s, merge_idx, false
    }

    return s, ir.NULL_IDX, true
}

// analyse_if_expr handles if-else as an expression that returns a value.
// Unlike if statements, if expressions:
// 1. Must have an else clause (unless compiler can prove branches are exhaustive)
// 2. Each branch must produce a value (the last expression in the block)
// 3. All branches must produce values of the same type
// Returns the IR index of the block_arg that receives the expression result.
fn analyse_if_expr(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let data = node.data

    let n = data.y - data.x
    let has_else = n % 2 != 0
    let cond_count = u32(n / 2)

    if !has_else {
        s = try add_error(s, if_expr_missing_else{pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let func_fqn_idx = s.current_func_fqn

    var then_blocks = try make([]intern.index, 0, cond_count)
    var check_blocks = try make([]intern.index, 0, cond_count)

    for i = u32(0); i < cond_count; i++ {
        s, let then_fqn = try reserve_block(s, func_fqn_idx)
        then_blocks = try append(then_blocks, then_fqn)
        if i < cond_count - 1 {
            s, let check_fqn = try reserve_block(s, func_fqn_idx)
            check_blocks = try append(check_blocks, check_fqn)
        }
    }

    s, let else_fqn = try reserve_block(s, func_fqn_idx)
    s, let merge_fqn = try reserve_block(s, func_fqn_idx)

    var expected_types = try make([]types.index, 0, 1)
    var has_error = false

    let pre_branch_env = try snapshot_var_env(s)

    for i = u32(0); i < cond_count; i++ {
        if i > 0 {
            s = try restore_var_env(s, pre_branch_env)
            let check_fqn = try get(check_blocks, i - 1)
            s, let _ = try generate_block(s, check_fqn)
        }

        let cond_idx = try get(s.ast.extras, u32(data.x) + i * 2)
        let body_idx = try get(s.ast.extras, u32(data.x) + i * 2 + 1)

        var else_target = else_fqn
        if i < cond_count - 1 {
            else_target = try get(check_blocks, i)
        }

        let then_fqn = try get(then_blocks, i)

        s = try analyse_condition(s, cond_idx, func_fqn_idx,
            then_fqn, [], else_target, [])

        s, let result_irs, let result_types, let block_has_error = try analyse_block_as_expr(s, body_idx, then_fqn, func_fqn_idx)
        if block_has_error {
            has_error = true
            next
        }

        if i == 0 {
            expected_types = result_types
        } else {
            if len(result_types) != len(expected_types) {
                s = try add_error(s, assignment_count_mismatch{
                    var_cnt: u32(len(expected_types)),
                    val_cnt: u32(len(result_types)),
                    pos: idx
                })
                has_error = true
                next
            }
            for j = 0; j < len(result_types); j++ {
                let result_type = try get(result_types, j)
                let expected_type = try get(expected_types, j)
                if result_type != expected_type {
                    s = try add_error(s, type_mismatch{
                        got: result_type,
                        want: expected_type,
                        pos: body_idx
                    })
                    has_error = true
                }
            }
        }

        if !has_error {
            s = try generate_jmp_with_args(s, merge_fqn, result_irs)
        }
    }

    s = try restore_var_env(s, pre_branch_env)

    let else_body_idx = try get(s.ast.extras, data.y - 1)
    s, let else_result_irs, let else_result_types, let else_has_error = try analyse_block_as_expr(s, else_body_idx, else_fqn, func_fqn_idx)
    if else_has_error {
        has_error = true
    } else if !has_error {
        if len(else_result_types) != len(expected_types) {
            s = try add_error(s, assignment_count_mismatch{
                var_cnt: u32(len(expected_types)),
                val_cnt: u32(len(else_result_types)),
                pos: idx
            })
            has_error = true
        } else {
            for j = 0; j < len(else_result_types); j++ {
                let result_type = try get(else_result_types, j)
                let expected_type = try get(expected_types, j)
                if result_type != expected_type {
                    s = try add_error(s, type_mismatch{
                        got: result_type,
                        want: expected_type,
                        pos: else_body_idx
                    })
                    has_error = true
                }
            }
        }
        if !has_error {
            s = try generate_jmp_with_args(s, merge_fqn, else_result_irs)
        }
    }

    if has_error {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    var ir_types = try make([]intern.index, 0, len(expected_types))
    for i = 0; i < len(expected_types); i++ {
        let sem_type = try get(expected_types, i)
        s, var ir_type = try lower_semantic_to_ir(s, sem_type)
        if try is_aggregate_ir_type(s, ir_type) {
            s.ip, ir_type = try intern.make_pointer_type(s.ip, ir_type)
        }
        ir_types = try append(ir_types, ir_type)
    }

    s, let merge_idx, let block_arg_indices = try generate_block_with_args(s, merge_fqn, ir_types)

    var result_indices = try make([]ir.index, 0, len(block_arg_indices))
    for i = 0; i < len(block_arg_indices); i++ {
        let block_arg_idx = try get(block_arg_indices, i)
        let sem_type = try get(expected_types, i)
        s, let ir_type = try lower_semantic_to_ir(s, sem_type)

        var result_idx = block_arg_idx
        // as block_args for aggregates are pointers we need to load
        if try is_aggregate_ir_type(s, ir_type) {
            s, result_idx = try generate_load(s, block_arg_idx, ir_type)
        }
        result_indices = try append(result_indices, result_idx)
    }
    
    if len(expected_types) == 0 {
        return s, ir.NULL_IDX, types.NULL_IDX
    } else if len(result_indices) == 0 {
        return s, ir.NULL_IDX, types.NULL_IDX
    } 

    let result_sem_type = try get(expected_types, 0)
    if len(result_indices) == 1 {
        return s, try get(result_indices, 0), result_sem_type
    }

    // TODO: raise multi value not supported yet
    return s, try get(result_indices, 0), result_sem_type
}

// analyse_block_as_expr analyses a block and extracts its result expression(s).
// Returns the IR indices and semantic types of the last expression(s) in the block.
// If the block is empty or the last item is not an expression, returns an error.
fn analyse_block_as_expr(s *semsis, idx ast.index, block_fqn, func_fqn intern.index)!
    *semsis, []ir.index, []types.index, bool
{
    var s = s
    let node = try get(s.ast.nodes, idx)
    let data = node.data

    if data.y <= data.x {
        s = try add_error(s, if_expr_no_value{pos: idx})
        return s, [], [], true
    }

    let saved_scope = s.current_scope

    let parent_scope = try namespace.get_scope(s.np, s.current_scope)
    s.np, let block_scope = try namespace.new_scope(s.np, parent_scope.path, types.NULL_IDX, s.current_scope)
    s = &semsis{..s, current_scope: block_scope}

    s.defer_stack = try append(s.defer_stack, defer_block{
        scope_idx: block_scope,
        start_idx: u32(len(s.defer_registry)),
        end_idx:   u32(len(s.defer_registry)),
    })

    s, let _ = try generate_block(s, block_fqn)

    let last_stmt_pos = data.y - 1
    for i = data.x; i < last_stmt_pos; i++ {
        let stmt_idx = try get(s.ast.extras, i)
        let stmt = try get(s.ast.nodes, stmt_idx)
        match stmt.tag {
        case ast.tag.assignment:
            s, let _ = try analyse_assignment(s, stmt_idx)
        case ast.tag.call:
            s, let _, let _ = try analyse_call(s, stmt_idx)
        case ast.tag.return_stmt:
            s, let _ = try analyse_return(s, stmt_idx)
        case ast.tag.defer_stmt:
            s, let _ = try analyse_defer(s, stmt_idx)
        case ast.tag.if_stmt:
            s, let _, let _ = try analyse_if_stmt(s, stmt_idx, func_fqn)
        case _:
            // TODO: raise error for unhandled statement types
        }
    }

    let last_idx = try get(s.ast.extras, last_stmt_pos)
    let last_node = try get(s.ast.nodes, last_idx)

    if last_node.tag == ast.tag.raise_stmt {
        s, let _ = try analyse_raise(s, last_idx)
        let current_defer = try get(s.defer_stack, len(s.defer_stack) - 1)
        s = try generate_block_defer_cleanup(s, current_defer)
        s.defer_stack = try slice(s.defer_stack, 0, len(s.defer_stack)-1)
        s = &semsis{..s, current_scope: saved_scope}
        return s, [], [], false
    }

    var result_irs = try make([]ir.index, 0, 1)
    var result_types = try make([]types.index, 0, 1)

    if last_node.tag == ast.tag.expr_list {
        let expr_data = last_node.data
        for i = expr_data.x; i < expr_data.y; i++ {
            let expr_idx = try get(s.ast.extras, i)
            s, let expr_ir, let sem_type = try analyse_expression(s, expr_idx)
            if expr_ir == ir.NULL_IDX {
                s = &semsis{..s, current_scope: saved_scope}
                return s, [], [], true
            }
            s, let extracted_ir = try extract_single_return_value(s, expr_ir, expr_idx)
            if extracted_ir == ir.NULL_IDX {
                s = &semsis{..s, current_scope: saved_scope}
                return s, [], [], true
            }
            result_irs = try append(result_irs, extracted_ir)
            result_types = try append(result_types, sem_type)
        }
    } else {
        s, let expr_ir, let sem_type = try analyse_expression(s, last_idx)
        if expr_ir == ir.NULL_IDX {
            return s, [], [], true
        }
        s, let extracted_ir = try extract_single_return_value(s, expr_ir, last_idx)
        if extracted_ir == ir.NULL_IDX {
            s = &semsis{..s, current_scope: saved_scope}
            return s, [], [], true
        }
        result_irs = try append(result_irs, extracted_ir)
        result_types = try append(result_types, sem_type)
    }

    let current_defer = try get(s.defer_stack, len(s.defer_stack) - 1)
    s = try generate_block_defer_cleanup(s, current_defer)

    s.defer_stack = try slice(s.defer_stack, 0, len(s.defer_stack)-1)
    s = &semsis{..s, current_scope: saved_scope}

    return s, result_irs, result_types, false
}

fn analyse_match_stmt(s *semsis, idx ast.index, func_fqn intern.index)! *semsis, ir.index, bool {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let data = node.data

    s, let binding_name, let actual_scrutinee_idx = try extract_match_binding(s, data.x)

    s, var scrutinee_ir, let scrutinee_sem_type = try analyse_expression(s, actual_scrutinee_idx)
    if scrutinee_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, false
    }

    s, scrutinee_ir = try extract_single_return_value(s, scrutinee_ir, actual_scrutinee_idx)
    if scrutinee_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, false
    }

    if !try is_matchable_type(s.tp, scrutinee_sem_type) {
        s = try add_error(s, match_invalid_scrutinee{
            scrutinee_type: scrutinee_sem_type,
            pos: idx
        })
        return s, ir.NULL_IDX, false
    }

    let is_union = try types.is_union(s.tp, scrutinee_sem_type)
    let is_many = try types.is_many(s.tp, scrutinee_sem_type)
    let is_error = try types.is_error(s.tp, scrutinee_sem_type)
    let is_type_match = is_union || is_many || is_error

    var tag_ir = scrutinee_ir
    if is_type_match {
        s, tag_ir = try extract_tag_ir(s, scrutinee_ir, scrutinee_sem_type)
    }

    let match_block_idx = data.y
    let match_block = try get(s.ast.nodes, match_block_idx)
    let match_data = match_block.data

    let case_count = match_data.y - match_data.x
    if case_count == 0 {
        s = try add_error(s, match_non_exhaustive{
            scrutinee_type: scrutinee_sem_type,
            pos: idx
        })
        return s, ir.NULL_IDX, false
    }

    var seen_values = try make([]u32, 0, case_count * 2)
    var seen_types = try make([]types.index, 0, case_count * 2)
    var has_default = false
    var default_case_idx = ast.NULL_IDX

    for i = match_data.x; i < match_data.y; i++ {
        let case_idx = try get(s.ast.extras, i)
        let case_node = try get(s.ast.nodes, case_idx)

        if case_node.tag != ast.tag.case_stmt {
            next
        }

        let case_expr_idx = case_node.data.x
        let case_expr_node = try get(s.ast.nodes, case_expr_idx)

        if case_expr_node.tag == ast.tag.ident {
            let ident_name = try ast.identifier(s.ast, case_expr_node)
            if ident_name == "_" {
                if has_default {
                    s = try add_error(s, match_duplicate_case{value: 0, pos: case_idx})
                    next
                }
                has_default = true
                default_case_idx = case_idx
                next
            }
        }

        s, seen_values, seen_types = try collect_case_expr_values(
            s, case_expr_idx, scrutinee_sem_type, is_type_match, is_union, seen_values, seen_types
        )
    }

    let is_enum = try types.is_enum(s.tp, scrutinee_sem_type)
    if is_enum && !has_default {
        s = try check_exhaustiveness(s, scrutinee_sem_type, seen_values, has_default, idx)
    }
    if is_type_match && !has_default {
        s = try check_type_match_exhaustiveness(s, scrutinee_sem_type, seen_values, is_union, is_many, is_error, idx)
    }

    // forward scan all case bodies
    var all_scan = scan_result{assigned: [], has_break: false, has_next: false}
    for i = match_data.x; i < match_data.y; i++ {
        let case_idx = try get(s.ast.extras, i)
        let case_node = try get(s.ast.nodes, case_idx)
        if case_node.tag == ast.tag.case_stmt && case_node.data.y != ast.NULL_IDX {
            s, let sub = try collect_assignments(s, case_node.data.y)
            all_scan = try merge_scan_results(all_scan, sub)
        }
    }
    s, let join = try compute_join_info(s, all_scan.assigned)

    var case_fqns = try make([]intern.index, 0, case_count)
    var case_indices = try make([]ast.index, 0, case_count)
    for i = match_data.x; i < match_data.y; i++ {
        let case_idx = try get(s.ast.extras, i)
        let case_node = try get(s.ast.nodes, case_idx)
        if case_node.tag != ast.tag.case_stmt {
            next
        }

        s, let case_fqn = try reserve_block(s, func_fqn)
        case_fqns = try append(case_fqns, case_fqn)
        case_indices = try append(case_indices, case_idx)
    }

    var default_fqn = intern.NULL_IDX
    if has_default {
        for i = 0; i < len(case_indices); i++ {
            if try get(case_indices, i) == default_case_idx {
                default_fqn = try get(case_fqns, i)
                break
            }
        }
    } else {
        s, default_fqn = try reserve_block(s, func_fqn)
    }

    s, let merge_fqn = try reserve_block(s, func_fqn)

    var switch_cases = try make([]switch_case, 0, len(seen_values))
    for i = 0; i < len(case_indices); i++ {
        let case_idx = try get(case_indices, i)
        if case_idx == default_case_idx {
            next
        }
        let case_fqn = try get(case_fqns, i)
        let case_node = try get(s.ast.nodes, case_idx)
        let case_expr_idx = case_node.data.x
        s, switch_cases = try build_case_switch_entries(
            s, case_expr_idx, case_fqn, scrutinee_sem_type, is_type_match, is_union, switch_cases
        )
    }

    s = try generate_switch(s, tag_ir, default_fqn, switch_cases)

    let pre_switch_env = try snapshot_var_env(s)

    var all_terminated = true
    var merge_pred_count = u32(0)

    for i = 0; i < len(case_indices); i++ {
        let case_idx = try get(case_indices, i)
        let case_fqn = try get(case_fqns, i)
        let case_node = try get(s.ast.nodes, case_idx)
        let case_data = case_node.data

        s = try restore_var_env(s, pre_switch_env)

        let case_body_idx = case_data.y
        if case_body_idx == ast.NULL_IDX {
            s, let _ = try generate_block(s, case_fqn)
            let merge_args = try collect_args_for_vars(s, join.var_ids)
            s = try generate_jmp_with_args(s, merge_fqn, merge_args)
            all_terminated = false
            merge_pred_count = merge_pred_count + 1
            next
        }

        var case_binding_type = scrutinee_sem_type
        var needs_narrowing = false
        if is_type_match && binding_name != intern.NULL_IDX {
            let case_types = try get_case_types_for_idx(s, case_idx, scrutinee_sem_type, is_union, default_case_idx)
            case_binding_type = try compute_binding_type(case_types, scrutinee_sem_type)
            needs_narrowing = case_binding_type != scrutinee_sem_type && len(case_types) == 1
        }

        s, let _, let case_terminated = try analyse_case_block_with_binding(
            s, case_body_idx, case_fqn, func_fqn,
            binding_name, scrutinee_ir, scrutinee_sem_type, case_binding_type, needs_narrowing
        )

        if !case_terminated {
            let merge_args = try collect_args_for_vars(s, join.var_ids)
            s = try generate_jmp_with_args(s, merge_fqn, merge_args)
            all_terminated = false
            merge_pred_count = merge_pred_count + 1
        }
    }

    if !has_default {
        s, let _ = try generate_block(s, default_fqn)
        s.ins = try append(s.ins, ir.inst{tag: ir.tag.unreachable, x: ir.NULL_IDX, y: ir.NULL_IDX})
    }

    if !all_terminated {
        if merge_pred_count >= 2 && len(join.var_ids) > 0 {
            s, let merge_idx, let arg_indices = try generate_block_with_args(s, merge_fqn, join.ir_types)
            s = try apply_block_args_to_env(s, join.var_ids, arg_indices)
            return s, merge_idx, false
        }
        s, let merge_idx = try generate_block(s, merge_fqn)
        return s, merge_idx, false
    }

    return s, ir.NULL_IDX, true
}

struct switch_case {
    value     u32
    block_fqn intern.index
}

fn extract_match_binding(s *semsis, scrutinee_idx ast.index)! *semsis, intern.index, ast.index {
    var s = s
    let node = try get(s.ast.nodes, scrutinee_idx)

    if node.tag != ast.tag.assignment {
        return s, intern.NULL_IDX, scrutinee_idx
    }

    let lhs_idx = node.data.x
    let lhs_node = try get(s.ast.nodes, lhs_idx)

    var binding_name = intern.NULL_IDX
    if lhs_node.tag == ast.tag.ident {
        let name_str = try ast.identifier(s.ast, lhs_node)
        s.ip, binding_name = try intern.intern_string(s.ip, name_str)
    } else if lhs_node.tag == ast.tag.decl_list {
        let first_decl_idx = try get(s.ast.extras, lhs_node.data.x)
        let ident_idx = try ast.identifier_index(s.ast, first_decl_idx)
        let ident_node = try get(s.ast.nodes, ident_idx)
        let name_str = try ast.identifier(s.ast, ident_node)
        s.ip, binding_name = try intern.intern_string(s.ip, name_str)
    }

    let rhs_idx = node.data.y
    let rhs_node = try get(s.ast.nodes, rhs_idx)
    var actual_idx = rhs_idx
    if rhs_node.tag == ast.tag.expr_list {
        actual_idx = try get(s.ast.extras, rhs_node.data.x)
    }

    return s, binding_name, actual_idx
}

fn check_duplicate_value(seen_values []u32, val u32) bool {
    for k = 0; k < len(seen_values); k++ {
        if try get(seen_values, k) == val {
            return true
        }
    }
    return false
}

fn collect_case_expr_values(
    s *semsis, case_expr_idx ast.index, scrutinee_type types.index,
    is_type_match, is_union bool, seen_values []u32, seen_types []types.index
)! *semsis, []u32, []types.index {
    var s = s
    var seen_values = seen_values
    var seen_types = seen_types

    let case_expr_node = try get(s.ast.nodes, case_expr_idx)

    var expr_indices = try make([]ast.index, 0, 4)
    if case_expr_node.tag == ast.tag.expr_list {
        let expr_data = case_expr_node.data
        for j = expr_data.x; j < expr_data.y; j++ {
            expr_indices = try append(expr_indices, try get(s.ast.extras, j))
        }
    } else {
        expr_indices = try append(expr_indices, case_expr_idx)
    }

    for i = 0; i < len(expr_indices); i++ {
        let expr_idx = try get(expr_indices, i)

        if is_type_match {
            s, let resolved_type, let tag_val, let valid = try evaluate_case_type(s, expr_idx, scrutinee_type, is_union)
            if !valid {
                next
            }
            if check_duplicate_value(seen_values, tag_val) {
                s = try add_error(s, match_duplicate_case{value: tag_val, pos: expr_idx})
            } else {
                seen_values = try append(seen_values, tag_val)
                seen_types = try append(seen_types, resolved_type)
            }
        } else {
            s, let val, let valid = try evaluate_case_value(s, expr_idx, scrutinee_type)
            if !valid {
                next
            }
            if check_duplicate_value(seen_values, val) {
                s = try add_error(s, match_duplicate_case{value: val, pos: expr_idx})
            } else {
                seen_values = try append(seen_values, val)
            }
        }
    }

    return s, seen_values, seen_types
}

fn build_case_switch_entries(
    s *semsis, case_expr_idx ast.index, case_fqn intern.index,
    scrutinee_type types.index, is_type_match, is_union bool, switch_cases []switch_case
)! *semsis, []switch_case {
    var s = s
    var switch_cases = switch_cases

    let case_expr_node = try get(s.ast.nodes, case_expr_idx)

    var expr_indices = try make([]ast.index, 0, 4)
    if case_expr_node.tag == ast.tag.expr_list {
        let expr_data = case_expr_node.data
        for j = expr_data.x; j < expr_data.y; j++ {
            expr_indices = try append(expr_indices, try get(s.ast.extras, j))
        }
    } else {
        expr_indices = try append(expr_indices, case_expr_idx)
    }

    for i = 0; i < len(expr_indices); i++ {
        let expr_idx = try get(expr_indices, i)

        if is_type_match {
            s, let _, let tag_val, let valid = try evaluate_case_type(s, expr_idx, scrutinee_type, is_union)
            if valid {
                switch_cases = try append(switch_cases, switch_case{value: tag_val, block_fqn: case_fqn})
            }
        } else {
            s, let val, let valid = try evaluate_case_value(s, expr_idx, scrutinee_type)
            if valid {
                switch_cases = try append(switch_cases, switch_case{value: val, block_fqn: case_fqn})
            }
        }
    }

    return s, switch_cases
}

fn analyse_case_block(s *semsis, idx ast.index, block_fqn, func_fqn intern.index)! *semsis, ir.index, bool {
    return try analyse_case_block_with_binding(s, idx, block_fqn, func_fqn, intern.NULL_IDX, ir.NULL_IDX, types.NULL_IDX, types.NULL_IDX, false)
}

fn analyse_case_block_with_binding(
    s *semsis, idx ast.index, block_fqn, func_fqn intern.index,
    binding_name intern.index, scrutinee_ir ir.index, scrutinee_type types.index, binding_type types.index, needs_narrowing bool
)! *semsis, ir.index, bool {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let data = node.data

    let saved_scope = s.current_scope

    let parent_scope = try namespace.get_scope(s.np, s.current_scope)
    s.np, let block_scope = try namespace.new_scope(s.np, parent_scope.path, types.NULL_IDX, s.current_scope)
    s = &semsis{..s, current_scope: block_scope}

    s, let block_idx = try generate_block(s, block_fqn)

    if binding_name != intern.NULL_IDX {
        var binding_ir = scrutinee_ir
        if needs_narrowing {
            s, binding_ir = try extract_typed_data_ir(s, scrutinee_ir, scrutinee_type, binding_type)
        }

        let decl = namespace.value{
            is_reassignable: false,
            name: binding_name,
            type_idx: binding_type,
            index: binding_ir
        }
        s.np = try namespace.put_private(s.np, block_scope, binding_name, namespace.entry(decl))
    }

    var terminated = false

    for i = data.x; i < data.y; i++ {
        let stmt_idx = try get(s.ast.extras, i)
        let stmt = try get(s.ast.nodes, stmt_idx)
        match stmt.tag {
        case ast.tag.assignment:
            s, let _ = try analyse_assignment(s, stmt_idx)
            terminated = false
        case ast.tag.call:
            s, let _, let _ = try analyse_call(s, stmt_idx)
            let last = try get(s.ins, len(s.ins) - 1)
            terminated = last.tag == ir.tag.unreachable
        case ast.tag.return_stmt:
            s, let _ = try analyse_return(s, stmt_idx)
            terminated = true
        case ast.tag.if_stmt:
            s, let _, let if_terminated = try analyse_if_stmt(s, stmt_idx, func_fqn)
            terminated = if_terminated
        case ast.tag.match_stmt:
            s, let _, let match_terminated = try analyse_match_stmt(s, stmt_idx, func_fqn)
            terminated = match_terminated
        case _:
            terminated = false
        }
    }

    s = &semsis{..s, current_scope: saved_scope}

    return s, block_idx, terminated
}

// is_matchable_type returns true if the type can be used as a match scrutinee.
// Floats are not allowed. Integers, bools, enums, unions, many, and errors are allowed.
fn is_matchable_type(tp *types.pool, t types.index)! bool {
    if t == types.NULL_IDX {
        return false
    } else if try types.is_float(tp, t) {
        return false
    }

    if try types.is_integer(tp, t) {
        return true
    } else if try types.is_bool(tp, t) {
        return true
    } else if try types.is_char(tp, t) {
        return true
    } else if try types.is_enum(tp, t) {
        return true
    } else if try types.is_union(tp, t) {
        return true
    } else if try types.is_many(tp, t) {
        return true
    } else if try types.is_error(tp, t) {
        return true
    }

    return false
}

// evaluate_case_value evaluates a case expression and returns its integer value.
// Returns (semsis, value, is_valid).
fn evaluate_case_value(s *semsis, case_idx ast.index, scrutinee_type types.index)! *semsis, u32, bool {
    var s = s
    let case_node = try get(s.ast.nodes, case_idx)

    if case_node.tag == ast.tag.int {
        let int_str = try ast.get_literal(s.ast, case_idx)
        let i = convert.parse_u64(int_str, 10) catch e {
            s = try add_error(s, invalid_integer{pos: case_idx})
            return s, 0, false
        }
        return s, u32(i), true
    } else if case_node.tag == ast.tag.hex {
        let hex_str = try ast.get_literal(s.ast, case_idx)
        let i = convert.parse_u64(hex_str, 0) catch e {
            s = try add_error(s, invalid_hexadecimal{pos: case_idx})
            return s, 0, false
        }
        return s, u32(i), true
    } else if case_node.tag == ast.tag.bin {
        let bin_str = try ast.get_literal(s.ast, case_idx)
        let i = convert.parse_u64(bin_str, 0) catch e {
            s = try add_error(s, invalid_binary{pos: case_idx})
            return s, 0, false
        }
        return s, u32(i), true
    } else if case_node.tag == ast.tag.true_lit {
        return s, 1, true
    } else if case_node.tag == ast.tag.false_lit {
        return s, 0, true
    } else if case_node.tag == ast.tag.char {
        let char_str = try ast.get_literal(s.ast, case_idx)
        let char_value = convert.parse_char(char_str) catch e {
            s = try add_error(s, invalid_char{pos: case_idx})
            return s, 0, false
        }
        return s, char_value, true
    }

    if case_node.tag == ast.tag.dot {
        s, let _, let case_sem_type, let _ = try analyse_dot_expression(s, case_idx)
        if case_sem_type != scrutinee_type {
            s = try add_error(s, match_case_type_mismatch{
                expected: scrutinee_type,
                got: case_sem_type,
                pos: case_idx
            })
            return s, 0, false
        }

        let rhs_idx = case_node.data.y
        let rhs_node = try get(s.ast.nodes, rhs_idx)
        let variant_name = try ast.identifier(s.ast, rhs_node)
        s.ip, let variant_name_idx = try intern.intern_string(s.ip, variant_name)

        let variant_info_opt = try types.get_enum_variant(s.tp, scrutinee_type, variant_name_idx)
        if variant_info_opt == null {
            s = try add_error(s, enum_unknown_variant{
                enum_type: scrutinee_type,
                variant: variant_name_idx,
                pos: rhs_idx
            })
            return s, 0, false
        }
        let variant_info = ?variant_info_opt
        return s, variant_info.idx, true
    }

    // TODO: here we should probably use short hand notation like ".enum_variant" not just "enum_variant"
    // Handle simple identifier (could be an enum variant without qualifier in scope)
    if case_node.tag == ast.tag.ident {
        let name = try ast.identifier(s.ast, case_node)

        if name == "_" {
            return s, 0, false
        }

        if try types.is_enum(s.tp, scrutinee_type) {
            s.ip, let name_idx = try intern.intern_string(s.ip, name)
            let variant_info_opt = try types.get_enum_variant(s.tp, scrutinee_type, name_idx)
            if variant_info_opt != null {
                let variant_info = ?variant_info_opt
                return s, variant_info.idx, true
            }
        }

        s = try add_error(s, match_case_type_mismatch{
            expected: scrutinee_type,
            got: types.NULL_IDX,
            pos: case_idx
        })
        return s, 0, false
    }

    s = try add_error(s, match_case_type_mismatch{
        expected: scrutinee_type,
        got: types.NULL_IDX,
        pos: case_idx
    })
    return s, 0, false
}

// extract_tag_ir extracts the tag from a union/many/error type via gep + load.
// The tag is at field 0 of the struct representation.
fn extract_tag_ir(s *semsis, scrutinee_ir ir.index, scrutinee_type types.index)! *semsis, ir.index {
    var s = s

    var ptr_ir = scrutinee_ir

    let is_alloca = try is_alloca(s, scrutinee_ir)
    let ir_type = try get_type(s, scrutinee_ir)
    let is_pointer = try intern.is_pointer(s.ip, ir_type)
    if !is_alloca && !is_pointer {
        s, let scrutinee_ir_type = try lower_semantic_to_ir(s, scrutinee_type)
        s, let tmp = try generate_alloca(s, scrutinee_ir_type)
        s, let _ = try generate_store(s, tmp, scrutinee_ir)
        ptr_ir = tmp
    }

    s, let tag_ptr = try generate_gep(s, ptr_ir, 0, intern.U32_TYPE_IDX)
    s, let tag_ir = try generate_load(s, tag_ptr, intern.U32_TYPE_IDX)

    return s, tag_ir
}

// check_exhaustiveness verifies that all enum variants are covered.
fn check_exhaustiveness(s *semsis, scrutinee_type types.index, seen []u32, has_default bool, pos ast.index)! *semsis {
    if has_default {
        return s
    }

    let variant_count = try types.get_enum_variant_count(s.tp, scrutinee_type)
    if u32(len(seen)) < variant_count {
        return try add_error(s, match_non_exhaustive{
            scrutinee_type: scrutinee_type,
            pos: pos
        })
    }

    return s
}

// check_type_match_exhaustiveness verifies exhaustiveness for type match.
// Union: must cover all subtypes. Any/Error: always require default.
fn check_type_match_exhaustiveness(s *semsis, scrutinee_type types.index, seen []u32, is_union, is_many, is_error bool, pos ast.index)! *semsis {
    if is_many || is_error {
        // many and error always require default (can't enumerate all types)
        return try add_error(s, match_non_exhaustive{
            scrutinee_type: scrutinee_type,
            pos: pos
        })
    }

    if is_union {
        let subtype_count = try types.get_union_subtype_count(s.tp, scrutinee_type)
        if u32(len(seen)) < subtype_count {
            return try add_error(s, match_non_exhaustive{
                scrutinee_type: scrutinee_type,
                pos: pos
            })
        }
    }

    return s
}

// evaluate_case_type resolves a case expression as a type reference for type match.
// Returns (semsis, resolved_type, tag_value, is_valid).
fn evaluate_case_type(s *semsis, case_idx ast.index, scrutinee_type types.index, is_union bool)! *semsis, types.index, u32, bool {
    var s = s
    let case_node = try get(s.ast.nodes, case_idx)

    if case_node.tag == ast.tag.ident {
        let name = try ast.identifier(s.ast, case_node)
        if name == "_" {
            return s, types.NULL_IDX, 0, false  // default case
        }
    }

    s, let resolved = try resolve_type_ref(s, s.current_scope, case_idx)
    if resolved == types.NULL_IDX {
        // resolve_type_ref returns NULL for unresolved types (error already added for ident)
        // For types it doesn't recognise, we add our own error
        s = try add_error(s, match_case_type_mismatch{
            expected: scrutinee_type,
            got: types.NULL_IDX,
            pos: case_idx
        })
        return s, types.NULL_IDX, 0, false
    }

    if is_union {
        let subtype_opt = try types.get_union_subtype_by_type(s.tp, scrutinee_type, resolved)
        if subtype_opt == null {
            s = try add_error(s, match_case_type_not_in_union{
                case_type: resolved,
                union_type: scrutinee_type,
                pos: case_idx
            })
            return s, types.NULL_IDX, 0, false
        }
        return s, resolved, (?subtype_opt).idx, true
    } else {
        // Any/Error: use type index as tag
        return s, resolved, u32(resolved), true
    }
}

// get_case_types_for_idx collects the types for a specific case in type match.
fn get_case_types_for_idx(s *semsis, case_idx ast.index, scrutinee_type types.index, is_union bool, default_case_idx ast.index)! []types.index {
    var s = s
    var case_types = try make([]types.index, 0, 4)

    if case_idx == default_case_idx {
        // Default case: binding type is scrutinee type
        return case_types
    }

    let case_node = try get(s.ast.nodes, case_idx)
    let case_data = case_node.data
    let case_expr_idx = case_data.x
    let case_expr_node = try get(s.ast.nodes, case_expr_idx)

    if case_expr_node.tag == ast.tag.expr_list {
        let expr_data = case_expr_node.data
        for j = expr_data.x; j < expr_data.y; j++ {
            let expr_idx = try get(s.ast.extras, j)
            s, let resolved_type, let _, let valid = try evaluate_case_type(s, expr_idx, scrutinee_type, is_union)
            if valid {
                case_types = try append(case_types, resolved_type)
            }
        }
    } else {
        s, let resolved_type, let _, let valid = try evaluate_case_type(s, case_expr_idx, scrutinee_type, is_union)
        if valid {
            case_types = try append(case_types, resolved_type)
        }
    }

    return case_types
}

// compute_binding_type determines the type for a binding variable.
// Single type: narrowed. Multiple types or default: scrutinee type.
fn compute_binding_type(case_types []types.index, scrutinee_type types.index)! types.index {
    if len(case_types) == 1 {
        return try get(case_types, 0)  // Single type: narrowed
    }
    return scrutinee_type  // Multi-type or default: union type
}

// extract_typed_data_ir extracts the data field from a union/many/error.
// Layout: [u32 tag, slot[u64] data]. Returns loaded/cast value of narrowed type.
fn extract_typed_data_ir(s *semsis, scrutinee_ir ir.index, scrutinee_type types.index, narrowed_type types.index)! *semsis, ir.index {
    var s = s

    var ptr_ir = scrutinee_ir
    let is_alloca_inst = try is_alloca(s, scrutinee_ir)
    let ir_type = try get_type(s, scrutinee_ir)
    let is_pointer = try intern.is_pointer(s.ip, ir_type)
    if !is_alloca_inst && !is_pointer {
        s, let scrutinee_ir_type = try lower_semantic_to_ir(s, scrutinee_type)
        s, let tmp = try generate_alloca(s, scrutinee_ir_type)
        s, let _ = try generate_store(s, tmp, scrutinee_ir)
        ptr_ir = tmp
    }

    s.ip, let slot_type = try intern.make_slot_type(s.ip, intern.U64_TYPE_IDX)
    s, let data_ptr = try generate_gep(s, ptr_ir, 1, slot_type)

    s, let narrowed_ir_type = try lower_semantic_to_ir(s, narrowed_type)

    let is_aggregate = try is_aggregate_ir_type(s, narrowed_ir_type)

    if is_aggregate {
        s.ip, let ptr_type = try intern.make_pointer_type(s.ip, narrowed_ir_type)
        s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: u32(data_ptr), y: u32(ptr_type)})
        let cast_ptr = ir.index(u32(len(s.ins)-1))
        return s, cast_ptr
    }

    s, let slot_val = try generate_load(s, data_ptr, slot_type)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: u32(slot_val), y: u32(narrowed_ir_type)})
    let cast_val = ir.index(u32(len(s.ins)-1))
    return s, cast_val
}

// generate_switch emits a switch IR instruction.
// Format: [default_fqn, default_arg_count, default_args..., case_count, val1, fqn1, arg_count1, args1..., ...]
fn generate_switch(s *semsis, tag_ir ir.index, default_fqn intern.index, cases []switch_case)! *semsis {
    var s = s

    let extra_start = u32(len(s.extra))

    s.extra = try append(s.extra, u32(default_fqn))
    s.extra = try append(s.extra, u32(0))  

    s.extra = try append(s.extra, u32(len(cases)))


    for i = 0; i < len(cases); i++ {
        let c = try get(cases, i)
        s.extra = try append(s.extra, c.value)
        s.extra = try append(s.extra, u32(c.block_fqn))
        s.extra = try append(s.extra, u32(0))  
    }

    s.ins = try append(s.ins, ir.inst{
        tag: ir.tag.switch,
        x: u32(tag_ir),
        y: extra_start
    })

    return s
}

// analyse_return handles return statements with type validation and IR generation
fn analyse_return(s *semsis, idx ast.index)! *semsis, ir.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let data = node.data

    let _, let expected_returns_sem_type = try types.get_function_signature(s.tp, s.current_fn_sem_type)
    let expected_sem_types = try types.expand_type_to_list(s.tp, expected_returns_sem_type)
    s, let fn_type_ir = try lower_semantic_to_ir(s, s.current_fn_sem_type)
    let _, let expected_ir_types_opt = try intern.get_function_signature(s.ip, fn_type_ir)
    if expected_ir_types_opt == null {
        return s, ir.NULL_IDX
    }
    let expected_ir_types = ?expected_ir_types_opt
    let expected_count = u32(len(expected_ir_types))

    if data.x == ast.NULL_IDX {
        if expected_count > 0 {
            s = try add_error(s, return_count_mismatch{expected: expected_count, found: 0, pos: idx})
            return s, ir.NULL_IDX
        }
        s = try generate_all_defer_cleanup(s)
        if s.current_fn_is_fallible {
            return try generate_success_return(s, [], expected_ir_types)
        }
        s.ins = try append(s.ins, ir.inst{tag: ir.tag.ret_1, x: ir.NULL_IDX, y: ir.NULL_IDX})
        return s, ir.index(u32(len(s.ins)-1))
    }

    let ret_count = u32(data.y - data.x)
    if ret_count != expected_count {
        s = try add_error(s, return_count_mismatch{expected: expected_count, found: ret_count, pos: idx})
        return s, ir.NULL_IDX
    }

    var ret_irs = try make([]ir.index, 0, ret_count)
    for i = data.x; i < data.y; i++ {
        let expr_idx = try get(s.ast.extras, i)
        let pos = u32(i - data.x)
        let expected_sem_type = try get(expected_sem_types, pos)

        s, var expr_ir, let expr_sem_type = try analyse_expression_with_type(s, expr_idx, expected_sem_type)
        if expr_ir == ir.NULL_IDX || expr_sem_type == types.NULL_IDX {
            return s, ir.NULL_IDX
        }

        s, let is_assignable = try rule_is_assignable_to(s, expr_ir, expr_sem_type, expected_sem_type, expr_idx)
        if !is_assignable {
            return s, ir.NULL_IDX
        }

        s, expr_ir = try apply_type_conversion(s, expr_ir, expr_sem_type, expected_sem_type)

        ret_irs = try append(ret_irs, expr_ir)
    }

    s = try generate_all_defer_cleanup(s)

    if s.current_fn_is_fallible {
        return try generate_success_return(s, ret_irs, expected_ir_types)
    }
    return try generate_return(s, ret_irs, expected_ir_types)
}

// generate_return generates the IR for returning values from a function
fn generate_return(s *semsis, ret_irs []ir.index, ret_types []intern.index)! *semsis, ir.index {
    var s = s
    let count = len(ret_irs)

    if count == 0 {
        s.ins = try append(s.ins, ir.inst{tag: ir.tag.ret_1, x: ir.NULL_IDX, y: ir.NULL_IDX})
        return s, ir.index(u32(len(s.ins)-1))
    }

    let func_fqn_str = intern.get_string(s.ip, s.current_func_fqn)
    let ret_struct_name = func_fqn_str + "$ret"
    s.ip, let ret_struct_name_idx = try intern.intern_string(s.ip, ret_struct_name)
    s.ip, let ret_struct_type = try intern.make_struct_type(s.ip, ret_struct_name_idx)
    s.ip, let _ = try intern.make_struct_fields(s.ip, ret_struct_type, ret_types)

    s, let alloca_ir = try generate_struct_literal(s, ret_struct_type, ret_irs, ret_types)

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.ret_1, x: alloca_ir, y: ir.NULL_IDX})
    return s, ir.index(u32(len(s.ins)-1))
}

fn make_error_struct_type(s *semsis)! *semsis, intern.index, intern.index {
    var s = s
    s.ip, let slot_type = try intern.make_slot_type(s.ip, intern.U64_TYPE_IDX)
    s.ip, let err_struct = try intern.make_anon_struct_type(s.ip, [intern.U64_TYPE_IDX, slot_type])
    return s, err_struct, slot_type
}

fn generate_error_struct(s *semsis, desc_ir ir.index, data_ir ir.index)! *semsis, intern.index, ir.index {
    var s = s
    s, let err_type, let slot_type = try make_error_struct_type(s)
    s, let err_ir = try generate_struct_literal(s, err_type, [desc_ir, data_ir], [intern.U64_TYPE_IDX, slot_type])
    return s, err_type, err_ir
}

// generate_success_return appends error fields (desc=0, data=poison) to a
// normal return and delegates to generate_return with the augmented arrays.
fn generate_success_return(s *semsis, ret_irs []ir.index, ret_types []intern.index)! *semsis, ir.index {
    var s = s

    s.ip, let zero_const = try intern.make_const_u64(s.ip, u64(0))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: zero_const, y: intern.U64_TYPE_IDX})
    let zero_ir = ir.index(u32(len(s.ins) - 1))

    s.ip, let slot_type = try intern.make_slot_type(s.ip, intern.U64_TYPE_IDX)
    s, let poison_data = try generate_poison(s, slot_type)

    s, let err_type, let err_ir = try generate_error_struct(s, zero_ir, poison_data)

    var aug_irs = try make([]ir.index, 0, len(ret_irs) + 1)
    for i = 0; i < len(ret_irs); i++ {
        aug_irs = try append(aug_irs, try get(ret_irs, i))
    }
    aug_irs = try append(aug_irs, err_ir)

    var aug_types = try make([]intern.index, 0, len(ret_types) + 1)
    for i = 0; i < len(ret_types); i++ {
        aug_types = try append(aug_types, try get(ret_types, i))
    }
    aug_types = try append(aug_types, err_type)

    return try generate_return(s, aug_irs, aug_types)
}

// generate_error_return builds a return struct with poisoned value fields and
// the given error descriptor + data, then emits ret_1.
// err_desc must never be zero — descriptor 0 is reserved for success.
// This is safe because error types always have semantic indices > 14
// (primitive types occupy indices 0-14 in the type pool).
fn generate_error_return(s *semsis, err_desc ir.index, err_data ir.index)! *semsis, ir.index {
    var s = s

    s, let fn_type_ir = try lower_semantic_to_ir(s, s.current_fn_sem_type)
    let _, let ret_types_opt = try intern.get_function_signature(s.ip, fn_type_ir)
    if ret_types_opt == null {
        return s, ir.NULL_IDX
    }
    let ret_types = ?ret_types_opt

    s, let err_type, let err_ir = try generate_error_struct(s, err_desc, err_data)

    var aug_irs = try make([]ir.index, 0, len(ret_types) + 1)
    var aug_types = try make([]intern.index, 0, len(ret_types) + 1)
    for i = 0; i < len(ret_types); i++ {
        let rt = try get(ret_types, i)
        s, let p = try generate_poison(s, rt)
        aug_irs = try append(aug_irs, p)
        aug_types = try append(aug_types, rt)
    }
    aug_irs = try append(aug_irs, err_ir)
    aug_types = try append(aug_types, err_type)

    return try generate_return(s, aug_irs, aug_types)
}

fn analyse_raise(s *semsis, idx ast.index)! *semsis, ir.index {
    var s = s
    let node = try get(s.ast.nodes, idx)

    if !s.current_fn_is_fallible {
        s = try add_error(s, raise_in_non_fallible{pos: idx})
        return s, ir.NULL_IDX
    }

    s, let err_ir, let err_sem_type = try analyse_expression(s, node.data.x)
    if err_sem_type == types.NULL_IDX {
        return s, ir.NULL_IDX
    }

    if !try types.is_error(s.tp, err_sem_type) {
        s = try add_error(s, compiler_error{rsn: "raise requires error type", pos: idx})
        return s, ir.NULL_IDX
    }

    s.ip, let slot_type = try intern.make_slot_type(s.ip, intern.U64_TYPE_IDX)

    if try types.is_generic_error(s.tp, err_sem_type) {
        s, let desc_ir = try generate_gep(s, err_ir, 0, intern.U64_TYPE_IDX)
        s, let desc_val = try generate_load(s, desc_ir, intern.U64_TYPE_IDX)
        s, let data_ptr = try generate_gep(s, err_ir, 1, slot_type)
        s, let data_val = try generate_load(s, data_ptr, slot_type)
        s = try generate_all_defer_cleanup(s)
        return try generate_error_return(s, desc_val, data_val)
    }

    let desc_val = u64(err_sem_type)
    s.ip, let desc_const = try intern.make_const_u64(s.ip, desc_val)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: desc_const, y: intern.U64_TYPE_IDX})
    let desc_ir = ir.index(u32(len(s.ins) - 1))

    var data_ir = ir.NULL_IDX
    if err_ir == ir.NULL_IDX {
        s, data_ir = try generate_poison(s, slot_type)
    } else {
        try assert(try is_alloca(s, err_ir), "error struct must be alloca")
        s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: err_ir, y: slot_type})
        data_ir = ir.index(u32(len(s.ins) - 1))
    }

    s = try generate_all_defer_cleanup(s)

    return try generate_error_return(s, desc_ir, data_ir)
}

fn analyse_defer(s *semsis, idx ast.index)! *semsis, ir.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let call_idx = node.data.x

    let call_node = try get(s.ast.nodes, call_idx)
    if call_node.tag != ast.tag.call && call_node.tag != ast.tag.block_stmt {
        s = try add_error(s, defer_not_call{pos: idx})
        return s, ir.NULL_IDX
    }

    if len(s.defer_stack) == 0 {
        return s, ir.NULL_IDX
    }

    let defer_id = u32(len(s.defer_registry))
    s.defer_registry = try append(s.defer_registry, call_idx)

    let top_idx = len(s.defer_stack) - 1
    let top = try get(s.defer_stack, top_idx)
    s.defer_stack = try put(s.defer_stack, top_idx, defer_block{..top, end_idx: u32(len(s.defer_registry))})

    s, let arg_irs, let arg_types = try analyse_defer_call_args(s, call_idx)
    s.defer_arg_counts = try append(s.defer_arg_counts, u32(len(arg_types)))
    for at_i = 0; at_i < len(arg_types); at_i++ {
        let at = try get(arg_types, at_i)
        s.defer_arg_types = try append(s.defer_arg_types, at)
    }

    let func_fqn_str = try intern.get_string(s.ip, s.current_func_fqn)
    let wrapper_name = func_fqn_str + "_defer$" + try convert.to_string(defer_id)
    s.ip, let wrapper_fqn = try intern.intern_string(s.ip, wrapper_name)

    s.ip, let wrapper_fn_type = try intern.make_function_type(s.ip, wrapper_fqn)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.extern_ref, x: wrapper_fqn, y: wrapper_fn_type})
    let wrapper_ref = ir.index(u32(len(s.ins) - 1))

    s.ip, let slot_u64_type = try intern.make_slot_type(s.ip, intern.U64_TYPE_IDX)

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: wrapper_ref, y: slot_u64_type})
    let wrapper_as_u64 = ir.index(u32(len(s.ins) - 1))

    var args_as_u64 = try make([]ir.index, 0, len(arg_irs))
    for i = 0; i < len(arg_irs); i++ {
        let arg_ir = try get(arg_irs, i)
        let arg_type = try get_type(s, arg_ir)
        var arg_u64 = arg_ir
        if arg_type != slot_u64_type {
            s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: arg_ir, y: slot_u64_type})
            arg_u64 = ir.index(u32(len(s.ins) - 1))
        }
        args_as_u64 = try append(args_as_u64, arg_u64)
    }

    s, let args_slice = try generate_array_literal(s, slot_u64_type, args_as_u64)

    s.ip, let register_fqn = try intern.intern_string(s.ip, "dash/internal/runtime/defer_register")
    s.ip, let register_fn_type = try intern.make_function_type(s.ip, register_fqn)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.extern_ref, x: register_fqn, y: register_fn_type})
    let register_ref = ir.index(u32(len(s.ins) - 1))

    var register_args = try make([]ir.index, 0, 2)
    register_args = try append(register_args, wrapper_as_u64)
    register_args = try append(register_args, args_slice)
    s, let _ = try generate_call(s, register_ref, register_args, intern.NULL_IDX)

    return s, ir.NULL_IDX
}

fn analyse_defer_call_args(s *semsis, call_idx ast.index)! *semsis, []ir.index, []types.index {
    var s = s
    let node = try get(s.ast.nodes, call_idx)
    let args_idx = node.data.y

    if args_idx == ast.NULL_IDX {
        return s, [], []
    }

    let args_node = try get(s.ast.nodes, args_idx)
    let args_data = args_node.data
    let arg_count = u32(args_data.y - args_data.x)

    var arg_ir_list = try make([]ir.index, 0, arg_count)
    var arg_type_list = try make([]types.index, 0, arg_count)

    for i = args_data.x; i < args_data.y; i++ {
        let arg_idx = try get(s.ast.extras, i)
        s, let arg_ir, let arg_sem_type = try analyse_expression(s, arg_idx)
        if arg_ir == ir.NULL_IDX {
            return s, [], []
        }
        arg_ir_list = try append(arg_ir_list, arg_ir)
        arg_type_list = try append(arg_type_list, arg_sem_type)
    }

    return s, arg_ir_list, arg_type_list
}

// TODO: this should query the namespace to resolve the type from runtime.ds directly
fn make_runtime_defer_node_type(ip *intern.pool)! *intern.pool, intern.index {
    var ip = ip
    ip, let fqn = try intern.intern_string(ip, "dash/internal/runtime/defer_node")
    ip, let struct_type = try intern.make_struct_type(ip, fqn)
    ip, let ptr_type = try intern.make_pointer_type(ip, struct_type)
    return ip, ptr_type
}

fn generate_defer_pop(s *semsis)! *semsis, ir.index {
    var s = s
    s.ip, let pop_fqn = try intern.intern_string(s.ip, "dash/internal/runtime/defer_pop")
    s.ip, let pop_fn_type = try intern.make_function_type(s.ip, pop_fqn)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.extern_ref, x: pop_fqn, y: pop_fn_type})
    let pop_ref = ir.index(u32(len(s.ins) - 1))
    s.ip, let node_ptr_type = try make_runtime_defer_node_type(s.ip)
    s, let node_ir = try generate_call(s, pop_ref, [], node_ptr_type)
    return s, node_ir
}

fn generate_defer_cleanup_range(s *semsis, start u32, end u32)! *semsis {
    var s = s
    let func_fqn_str = try intern.get_string(s.ip, s.current_func_fqn)
    var i = end
    for i > start {
        i = i - 1

        s, let node_ir = try generate_defer_pop(s)

        let wrapper_name = func_fqn_str + "_defer$" + try convert.to_string(i)
        s.ip, let wrapper_fqn = try intern.intern_string(s.ip, wrapper_name)
        s.ip, let wrapper_fn_type = try intern.make_function_type(s.ip, wrapper_fqn)
        s.ins = try append(s.ins, ir.inst{tag: ir.tag.extern_ref, x: wrapper_fqn, y: wrapper_fn_type})
        let wrapper_ref = ir.index(u32(len(s.ins) - 1))

        var wrapper_args = try make([]ir.index, 0, 1)
        wrapper_args = try append(wrapper_args, node_ir)
        s, let _ = try generate_call(s, wrapper_ref, wrapper_args, intern.NULL_IDX)
    }
    return s
}

fn generate_block_defer_cleanup(s *semsis, block defer_block)! *semsis {
    if block.end_idx <= block.start_idx {
        return s
    }
    return try generate_defer_cleanup_range(s, block.start_idx, block.end_idx)
}

fn generate_all_defer_cleanup(s *semsis)! *semsis {
    let top = try get(s.defer_stack, len(s.defer_stack) - 1)
    let end = top.end_idx
    if end == 0 {
        return s
    }
    return try generate_defer_cleanup_range(s, 0, end)
}

fn generate_defer_wrappers(s *semsis, func_fqn intern.index)! *semsis {
    var s = s

    var type_offset = u32(0)
    for i = 0; i < len(s.defer_registry); i++ {
        let call_idx = try get(s.defer_registry, i)
        let count = try get(s.defer_arg_counts, i)
        let arg_types = try slice(s.defer_arg_types, type_offset, type_offset + count)
        s = try generate_defer_wrapper(s, func_fqn, call_idx, u32(i), arg_types)
        type_offset = type_offset + count
    }

    return s
}

fn generate_defer_wrapper(s *semsis, func_fqn intern.index, call_idx ast.index, defer_id u32, arg_types []types.index)! *semsis {
    var s = s

    let func_fqn_str = try intern.get_string(s.ip, func_fqn)
    let wrapper_name = func_fqn_str + "_defer$" + try convert.to_string(defer_id)
    s.ip, let wrapper_fqn = try intern.intern_string(s.ip, wrapper_name)

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.func, x: wrapper_fqn, y: ir.NULL_IDX})

    s.ip, let defer_node_ptr_type = try make_runtime_defer_node_type(s.ip)
    s.ip, let node_param = try intern.intern_string(s.ip, "node")
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.arg, x: node_param, y: defer_node_ptr_type})
    let node_ptr_ir = ir.index(u32(len(s.ins) - 1))

    s, let wrapper_entry_fqn = try reserve_block(s, wrapper_fqn)
    s, let _ = try generate_block(s, wrapper_entry_fqn)

    s.ip, let slot_u64_type = try intern.make_slot_type(s.ip, intern.U64_TYPE_IDX)
    s.ip, let slot_array_type = try intern.make_array_type(s.ip, slot_u64_type)
    s, let args_slice_ptr = try generate_gep(s, node_ptr_ir, 2, slot_array_type)

    let len_field_type = intern.U64_TYPE_IDX
    s, let len_ptr = try generate_gep(s, args_slice_ptr, 0, len_field_type)
    s, let _ = try generate_load(s, len_ptr, len_field_type)
    s.ip, let ptr_slot_array_type = try intern.make_pointer_type(s.ip, slot_u64_type)
    s, let data_ptr = try generate_gep(s, args_slice_ptr, 1, ptr_slot_array_type)
    s, let array_ptr = try generate_load(s, data_ptr, ptr_slot_array_type)

    var loaded_args = try make([]ir.index, 0, len(arg_types))
    for i = 0; i < len(arg_types); i++ {
        s, let elem_ptr = try generate_gep(s, array_ptr, u32(i), slot_u64_type)
        s, let arg_slot = try generate_load(s, elem_ptr, slot_u64_type)

        let arg_type = try get(arg_types, i)
        s, let arg_ir_type = try lower_semantic_to_ir(s, arg_type)

        var arg_val = arg_slot
        if arg_ir_type != slot_u64_type {
            s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: arg_slot, y: arg_ir_type})
            arg_val = ir.index(u32(len(s.ins) - 1))
        }
        loaded_args = try append(loaded_args, arg_val)
    }

    let call_node = try get(s.ast.nodes, call_idx)
    let fn_idx = call_node.data.x
    s, let fn_ir, let _ = try analyse_expression(s, fn_idx)

    if fn_ir != ir.NULL_IDX {
        s, let _ = try generate_call(s, fn_ir, loaded_args, intern.NULL_IDX)
    }

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.ret_1, x: ir.NULL_IDX, y: ir.NULL_IDX})

    return s
}

// analyse_try_expr handles `try f()` where f is a fallible function.
// The parser guarantees try wraps exactly one function call.
// The call returns an augmented $ret struct: [values..., [u64, slot[u64]]].
// Error descriptor 0 means success — this is safe because error type indices
// are always > 14 (primitive types occupy pool indices 0-14).
fn analyse_try_expr(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let call_idx = node.data.x

    if !s.current_fn_is_fallible {
        s = try add_error(s, invalid_try_use{type_idx: types.NULL_IDX, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, let call_ir, let returns_sem_type = try analyse_call(s, call_idx)
    if call_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let return_sem_types = try types.expand_type_to_list(s.tp, returns_sem_type)
    let n = u32(len(return_sem_types))

    s, let err_struct_type, let slot_type = try make_error_struct_type(s)

    s, let err_struct_ptr = try generate_gep(s, call_ir, n, err_struct_type)
    s, let desc_ptr = try generate_gep(s, err_struct_ptr, 0, intern.U64_TYPE_IDX)
    s, let desc_val = try generate_load(s, desc_ptr, intern.U64_TYPE_IDX)

    s.ip, let zero_const = try intern.make_const_u64(s.ip, u64(0))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: zero_const, y: intern.U64_TYPE_IDX})
    let zero_ir = ir.index(u32(len(s.ins) - 1))

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.eq, x: u32(desc_val), y: u32(zero_ir)})
    let cond_ir = ir.index(u32(len(s.ins) - 1))

    let func_fqn = s.current_func_fqn
    s, let ok_fqn = try reserve_block(s, func_fqn)
    s, let err_fqn = try reserve_block(s, func_fqn)
    s = try generate_br(s, cond_ir, ok_fqn, err_fqn)

    s, let _ = try generate_block(s, err_fqn)
    s, let data_ptr = try generate_gep(s, err_struct_ptr, 1, slot_type)
    s, let data_val = try generate_load(s, data_ptr, slot_type)
    s = try generate_all_defer_cleanup(s)
    s, let _ = try generate_error_return(s, desc_val, data_val)


    s, let _ = try generate_block(s, ok_fqn)

    let call_inst = try get(s.ins, call_ir)
    if call_inst.tag == ir.tag.alloca || call_inst.tag == ir.tag.call {
        if returns_sem_type == types.NULL_IDX {
            return s, ir.NULL_IDX, returns_sem_type
        }
        s, let val_ir_type = try lower_semantic_to_ir(s, returns_sem_type)
        s, let val_ptr = try generate_gep(s, call_ir, 0, val_ir_type)
        s, let val = try generate_load(s, val_ptr, val_ir_type)
        return s, val, returns_sem_type
    }

    return s, call_ir, returns_sem_type
}

fn analyse_catch_expr(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let data = node.data

    let call_idx = try get(s.ast.extras, data.x)
    let ident_idx = try get(s.ast.extras, data.x + 1)
    let block_idx = try get(s.ast.extras, data.x + 2)

    s, let call_ir, let returns_sem_type = try analyse_call(s, call_idx)
    if call_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    if !s.last_call_was_fallible {
        s = try add_error(s, catch_on_non_fallible{pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let return_sem_types = try types.expand_type_to_list(s.tp, returns_sem_type)
    let n = u32(len(return_sem_types))

    s, let err_struct_type, let _ = try make_error_struct_type(s)

    s, let err_struct_ptr = try generate_gep(s, call_ir, n, err_struct_type)
    s, let desc_ptr = try generate_gep(s, err_struct_ptr, 0, intern.U64_TYPE_IDX)
    s, let desc_val = try generate_load(s, desc_ptr, intern.U64_TYPE_IDX)

    s.ip, let zero_const = try intern.make_const_u64(s.ip, u64(0))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: zero_const, y: intern.U64_TYPE_IDX})
    let zero_ir = ir.index(u32(len(s.ins) - 1))

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.eq, x: u32(desc_val), y: u32(zero_ir)})
    let cond_ir = ir.index(u32(len(s.ins) - 1))

    let func_fqn = s.current_func_fqn
    s, let ok_fqn = try reserve_block(s, func_fqn)
    s, let err_fqn = try reserve_block(s, func_fqn)
    s, let merge_fqn = try reserve_block(s, func_fqn)
    s = try generate_br(s, cond_ir, ok_fqn, err_fqn)

    let pre_branch_env = try snapshot_var_env(s)

    // ok block: extract value from augmented return
    s, let _ = try generate_block(s, ok_fqn)

    var ok_ir = ir.NULL_IDX
    let call_inst = try get(s.ins, call_ir)
    if call_inst.tag == ir.tag.alloca || call_inst.tag == ir.tag.call {
        if returns_sem_type != types.NULL_IDX {
            s, let val_ir_type = try lower_semantic_to_ir(s, returns_sem_type)
            s, let val_ptr = try generate_gep(s, call_ir, 0, val_ir_type)
            if try is_aggregate_ir_type(s, val_ir_type) {
                ok_ir = val_ptr
            } else {
                s, ok_ir = try generate_load(s, val_ptr, val_ir_type)
            }
        }
    } else {
        ok_ir = call_ir
    }

    if ok_ir == ir.NULL_IDX || returns_sem_type == types.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s = try generate_jmp_with_args(s, merge_fqn, [ok_ir])

    // err block: bind error ident to error struct pointer
    s = try restore_var_env(s, pre_branch_env)

    let ident_node = try get(s.ast.nodes, ident_idx)
    let ident_str = try ast.identifier(s.ast, ident_node)
    s.ip, let ident_intern = try intern.intern_string(s.ip, ident_str)

    let saved_scope = s.current_scope
    let parent_scope = try namespace.get_scope(s.np, s.current_scope)
    s.np, let catch_scope = try namespace.new_scope(s.np, parent_scope.path, types.NULL_IDX, s.current_scope)
    s = &semsis{..s, current_scope: catch_scope}

    let err_decl = namespace.value{
        is_reassignable: false,
        name: ident_intern,
        type_idx: types.ERROR_IDX,
        index: err_struct_ptr
    }
    s.np = try namespace.put_private(s.np, catch_scope, ident_intern, namespace.entry(err_decl))

    s, let catch_result_irs, let catch_result_types, let catch_has_error = try analyse_block_as_expr(s, block_idx, err_fqn, func_fqn)

    s = &semsis{..s, current_scope: saved_scope}

    if catch_has_error {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let catch_terminated = len(catch_result_irs) == 0
    if !catch_terminated {
        if len(catch_result_irs) != 1 {
            s = try add_error(s, assignment_count_mismatch{
                var_cnt: 1,
                val_cnt: u32(len(catch_result_irs)),
                pos: block_idx
            })
            return s, ir.NULL_IDX, types.NULL_IDX
        }

        let catch_result_type = try get(catch_result_types, 0)
        var catch_ir = try get(catch_result_irs, 0)

        s, let is_assignable = try rule_is_assignable_to(s, catch_ir, catch_result_type, returns_sem_type, block_idx)
        if !is_assignable {
            return s, ir.NULL_IDX, types.NULL_IDX
        }

        s, catch_ir = try apply_type_conversion(s, catch_ir, catch_result_type, returns_sem_type)
        s = try generate_jmp_with_args(s, merge_fqn, [catch_ir])
    }

    // merge block
    s, let ok_ir_type = try lower_semantic_to_ir(s, returns_sem_type)
    var merge_ir_type = ok_ir_type
    if try is_aggregate_ir_type(s, ok_ir_type) {
        s.ip, merge_ir_type = try intern.make_pointer_type(s.ip, ok_ir_type)
    }

    s, let _, let block_args = try generate_block_with_args(s, merge_fqn, [merge_ir_type])

    var result_ir = try get(block_args, 0)
    if try is_aggregate_ir_type(s, ok_ir_type) {
        s, result_ir = try generate_load(s, result_ir, ok_ir_type)
    }

    return s, result_ir, returns_sem_type
}

// TODO: add function comment
// TODO: change to return []ir.index
fn analyse_global_assignment(s *semsis, idx ast.index)! *semsis, []ir.index {
    var s = s
    let node = try get(s.ast.nodes, idx)

    let decl_list_node = try get(s.ast.nodes, node.data.x)
    let expr_list_node = try get(s.ast.nodes, node.data.y)

    var ins = try make([]ir.index, 0, 2)
    var rhs_ir_indices = try make([]ir.index, 0, 1)
    var rhs_sem_types = try make([]types.index, 0, 1)
    var rhs_has_errors = false
    for i = expr_list_node.data.x; i < expr_list_node.data.y; i++ {
        let expr_idx = try get(s.ast.extras, i)
        s, let expr_ir, let expr_sem_type = try analyse_expression_with_type(s, expr_idx, types.NULL_IDX)
        if expr_ir == ir.NULL_IDX {
            rhs_has_errors = true
            next
        }
        if expr_sem_type == types.NULL_IDX {
            s = try add_error(s, non_value_in_expression{pos: expr_idx})
            rhs_has_errors = true
            next
        }
        rhs_ir_indices = try append(rhs_ir_indices, expr_ir)
        rhs_sem_types = try append(rhs_sem_types, expr_sem_type)
    }

    if rhs_has_errors {
        s = try register_null_declarations(s, decl_list_node)
        return s, []
    }

    // TODO: validate whatever we assign to LHS matches what we produce on
    // RHS and vice versa e.g. "let x, let y = 1" but also "let x = 1, 2"
    var lhs_idx = u32(0)
    var lhs_ir_indices = try make([]ir.index, 0, 1)
    for i = decl_list_node.data.x; i < decl_list_node.data.y; i++ {
        let decl_idx = try get(s.ast.extras, i)
        let decl_node = try get(s.ast.nodes, decl_idx)

        try assert(decl_node.tag == ast.tag.let_decl, "only 'let' allowed in global scope")

        s, let value_ir, let value_sem_type = try get_rhs_value(s, rhs_ir_indices, rhs_sem_types, lhs_idx)
        if value_ir == ir.NULL_IDX {
            lhs_idx = lhs_idx + 1
            next
        }

        var is_new_instruction = false
        if i64(lhs_idx) >= len(rhs_ir_indices) {
            is_new_instruction = true
        } else if value_ir != try get(rhs_ir_indices, lhs_idx) {
            is_new_instruction = true
        }

        if is_new_instruction {

            ins = try append(ins, value_ir)
            lhs_ir_indices = try append(lhs_ir_indices, value_ir)
        }

        // for "let x = ..." we validate one rule:
        // 1. x does not shadow other declarations in current namespace
        let ident_node = try get(s.ast.nodes, decl_node.data.x)
        let name = try ast.identifier(s.ast, ident_node)
        let current_scope = try namespace.get_scope(s.np, s.current_scope)
        let fqn = try make_fqn(current_scope.path, name)
        s.ip, let fqn_idx = try intern.intern_string(s.ip, fqn)

        // check simple name for conflict, BUT we dont store it in intern pool
        // as if there is no conflict it means the identifier was never defined
        let _, let name_idx = try intern.intern_string(s.ip, name)
        let import_conflict = try namespace.lookup_local(s.np, s.current_scope, name_idx)
        if import_conflict != null {
            s = try add_error(s, identifier_redeclared{pos: decl_idx})
        }

        s, let is_unique = try rule_ident_unique(s, s.current_scope, fqn_idx, decl_idx)
        if !is_unique {
            lhs_idx = lhs_idx + 1
            next
        }

        let is_var = decl_node.tag == ast.tag.var_decl
        let is_linear_type = try types.is_linear(s.tp, value_sem_type)

        let is_pub = try ast.is_public(s.ast, decl_node)
        if is_linear_type {
            let lv = namespace.linear_value{
                is_reassignable: is_var,
                is_consumed: false,
                name: fqn_idx,
                type_idx: value_sem_type,
                index: value_ir
            }
            if is_pub {
                s.ins = try append(s.ins, ir.inst{tag: ir.tag.global_def, x: fqn_idx, y: u32(value_ir)})
                s.np = try namespace.put_public(s.np, s.current_scope, fqn_idx, namespace.entry(lv))
            } else {
                s.np = try namespace.put_private(s.np, s.current_scope, fqn_idx, namespace.entry(lv))
            }
        } else {
            let decl = namespace.value{
                is_reassignable: is_var,
                name: fqn_idx,
                type_idx: value_sem_type,
                index: value_ir
            }
            if is_pub {
                s.ins = try append(s.ins, ir.inst{tag: ir.tag.global_def, x: fqn_idx, y: u32(value_ir)})
                s.np = try namespace.put_public(s.np, s.current_scope, fqn_idx, namespace.entry(decl))
            } else {
                s.np = try namespace.put_private(s.np, s.current_scope, fqn_idx, namespace.entry(decl))
            }
        }

        lhs_idx = lhs_idx + 1
    }

    let rhs_cnt = try count_rhs_values(s, rhs_ir_indices, rhs_sem_types)
    let lhs_cnt = u32(decl_list_node.data.y - decl_list_node.data.x)

    if lhs_cnt != rhs_cnt {
        s = try add_error(s, assignment_count_mismatch{
            var_cnt: lhs_cnt,
            val_cnt: rhs_cnt,
            pos:     idx
        })
    }

    return s, ins
}

fn register_null_declarations(s *semsis, decl_list_node ast.node)! *semsis {
    var s = s
    for i = decl_list_node.data.x; i < decl_list_node.data.y; i++ {
        let decl_idx = try get(s.ast.extras, i)
        let decl_node = try get(s.ast.nodes, decl_idx)
        if decl_node.tag != ast.tag.let_decl && decl_node.tag != ast.tag.var_decl {
            next
        }
        let ident_node = try get(s.ast.nodes, decl_node.data.x)
        if ident_node.tag != ast.tag.ident {
            next
        }
        let name = try ast.identifier(s.ast, ident_node)
        s.ip, let name_idx = try intern.intern_string(s.ip, name)
        let existing = try namespace.lookup_local(s.np, s.current_scope, name_idx)
        if existing != null {
            next
        }
        let decl = namespace.value{
            is_reassignable: false,
            name: name_idx,
            type_idx: types.NULL_IDX,
            index: ir.NULL_IDX
        }
        s.np = try namespace.put_private(s.np, s.current_scope, name_idx, namespace.entry(decl))
    }
    return s
}

fn analyse_assignment(s *semsis, idx ast.index)! *semsis, []ir.index {
    var s = s
    let node = try get(s.ast.nodes, idx)

    let decl_list_node = try get(s.ast.nodes, node.data.x)
    let expr_list_node = try get(s.ast.nodes, node.data.y)

    var rhs_ir_indices = try make([]ir.index, 0, 1)
    var rhs_sem_types = try make([]types.index, 0, 1)
    var rhs_has_errors = false
    for i = expr_list_node.data.x; i < expr_list_node.data.y; i++ {
        let expr_idx = try get(s.ast.extras, i)
        // we use .._with_type and not the base function to raise an error if
        // none used without context e.g. assigning none to let/var
        s, let expr_ir, let expr_sem_type = try analyse_expression_with_type(s, expr_idx, types.NULL_IDX)
        if expr_ir == ir.NULL_IDX {
            rhs_has_errors = true
            next
        }
        if expr_sem_type == types.NULL_IDX {
            s = try add_error(s, non_value_in_expression{pos: expr_idx})
            rhs_has_errors = true
            next
        }
        rhs_ir_indices = try append(rhs_ir_indices, expr_ir)
        rhs_sem_types = try append(rhs_sem_types, expr_sem_type)
    }

    if rhs_has_errors {
        s = try register_null_declarations(s, decl_list_node)
        return s, []
    }

    var lhs_idx = u32(0)
    var lhs_ir_indices = try make([]ir.index, 0, 1)
    for i = decl_list_node.data.x; i < decl_list_node.data.y; i++ {
        let decl_idx = try get(s.ast.extras, i)
        let decl_node = try get(s.ast.nodes, decl_idx)

        s, let value_ir, var value_sem_type = try get_rhs_value(s, rhs_ir_indices, rhs_sem_types, lhs_idx)
        if value_ir == ir.NULL_IDX {
            lhs_idx = lhs_idx + 1
            next
        } else if i64(lhs_idx) > len(rhs_ir_indices)-1 {
            lhs_ir_indices = try append(lhs_ir_indices, value_ir)
        } else if value_ir != try get(rhs_ir_indices, lhs_idx) {

            lhs_ir_indices = try append(lhs_ir_indices, value_ir)
        }

        let value_type = try get_type(s, value_ir)

        match decl_node.tag {
        // for "let x = ..." and "var y = ..." we validate one rule:
        // 1. x and y do not shadow other declarations in current namespace
        // NOTE: we do allow pattern 'var s = s' if s was a function argument
        case ast.tag.let_decl, ast.tag.var_decl:
            let ident_node = try get(s.ast.nodes, decl_node.data.x)
            let name = try ast.identifier(s.ast, ident_node)
            s.ip, let name_interned = try intern.intern_string(s.ip, name)

            s, let is_unique = try rule_ident_unique(s, s.current_scope, name_interned, decl_idx)
            if !is_unique {
                lhs_idx = lhs_idx + 1
                next
            }

            let is_var = decl_node.tag == ast.tag.var_decl
            let is_linear = try types.is_linear(s.tp, value_sem_type)

            if is_linear {
                let decl = namespace.linear_value{
                    is_reassignable: is_var,
                    is_consumed: false,
                    name: name_interned,
                    type_idx: value_sem_type,
                    index: value_ir,
                }
                s.np = try namespace.put_private(s.np, s.current_scope, name_interned, namespace.entry(decl))
            } else {
                let decl = namespace.value{
                    is_reassignable: is_var,
                    name: name_interned,
                    type_idx: value_sem_type,
                    index: value_ir,
                }
                s.np = try namespace.put_private(s.np, s.current_scope, name_interned, namespace.entry(decl))
            }

            if is_var {
                s = try write_variable(s, name_interned, value_ir, value_sem_type)
            }

        // for "a = ..." we check three things:
        // 1. "a" exists in the current namespace
        // 2. value can be assigned to "a"
        // 3. "a" is a declaration that is reassignable
        case ast.tag.ident:
            let name = try ast.identifier(s.ast, decl_node)
            s.ip, let name_interned = try intern.intern_string(s.ip, name)

            let existing_idx_opt = try namespace.lookup(s.np, s.current_scope, name_interned)
            if existing_idx_opt == null {
                s = try add_error(s, identifier_not_found{pos: decl_idx})
                lhs_idx = lhs_idx + 1
                next
            }

            let existing_idx = ?existing_idx_opt
            let existing_entry = try namespace.get_entry(s.np, existing_idx)
            match existing_val = existing_entry {
            case namespace.value:
                if !existing_val.is_reassignable {
                    s = try add_error(s, not_reassignable{pos: decl_idx})
                    lhs_idx = lhs_idx + 1
                    next
                }
                s, let ok = try rule_is_assignable_to(s, value_ir, value_sem_type, existing_val.type_idx, decl_idx)
                if !ok {
                    lhs_idx = lhs_idx + 1
                    next
                }

                let updated_val = namespace.value{
                    ..existing_val,
                    index: value_ir
                }
                s.np = try namespace.update_entry(s.np, existing_idx, namespace.entry(updated_val))

                s = try write_variable(s, name_interned, value_ir, existing_val.type_idx)

            case namespace.linear_value:
                if !existing_val.is_reassignable {
                    s = try add_error(s, not_reassignable{pos: decl_idx})
                    lhs_idx = lhs_idx + 1
                    next
                }
                s, let ok = try rule_is_assignable_to(s, value_ir, value_sem_type, existing_val.type_idx, decl_idx)
                if !ok {
                    lhs_idx = lhs_idx + 1
                    next
                }

                let updated_val = namespace.linear_value{
                    ..existing_val,
                    is_consumed: false,
                    index: value_ir
                }
                s.np = try namespace.update_entry(s.np, existing_idx, namespace.entry(updated_val))

                s = try write_variable(s, name_interned, value_ir, existing_val.type_idx)

            case namespace.scope:
                // TODO: add error - cannot assign to type
                lhs_idx = lhs_idx + 1
                next
            }
        }

        lhs_idx = lhs_idx + 1
    }

    let rhs_cnt = try count_rhs_values(s, rhs_ir_indices, rhs_sem_types)
    let lhs_cnt = u32(decl_list_node.data.y - decl_list_node.data.x)

    if lhs_cnt != rhs_cnt {
        s = try add_error(s, assignment_count_mismatch{
            var_cnt: lhs_cnt,
            val_cnt: rhs_cnt,
            pos:     idx
        })
    }
    let ins = try append(rhs_ir_indices, lhs_ir_indices)
    return s, ins
}

// count_rhs_values counts the total number of values produced by a list of RHS IR indices.
// Handles function calls with return_type (which can produce 0 or more values) and regular
// expressions (which produce 1 value each).
fn count_rhs_values(s *semsis, rhs_ir_indices []ir.index, rhs_sem_types []types.index)! u32 {
    var total = u32(0)
    for i = 0; i < len(rhs_ir_indices); i++ {
        let rhs_ir = try get(rhs_ir_indices, i)
        if rhs_ir == ir.NULL_IDX {
            next
        }
        let rhs_sem = try get(rhs_sem_types, i)
        let sem_list = try types.expand_type_to_list(s.tp, rhs_sem)
        total = total + u32(len(sem_list))
    }
    return total
}

// get_rhs_value returns the IR index for the value at the given LHS position, meant
// to be used during assignment generation. It handles:
// - Single expressions (return the expression IR directly)
// - Function calls returning multiple values (generate GEP + load for field access)
fn get_rhs_value(s *semsis, rhs_ir_list []ir.index, rhs_sem_list []types.index, lhs_pos u32)! *semsis, ir.index, types.index {
    var s = s

    var accumulated = u32(0)
    for i = 0; i < len(rhs_ir_list); i++ {
        let rhs_ir = try get(rhs_ir_list, i)
        let rhs_sem = try get(rhs_sem_list, i)
        if rhs_ir == ir.NULL_IDX {
            accumulated = accumulated + 1
            next
        }

        let rhs_type = try get_type(s, rhs_ir)
        let sem_list = try types.expand_type_to_list(s.tp, rhs_sem)
        let value_count = u32(len(sem_list))

        if lhs_pos < accumulated + value_count {
            let field_idx = lhs_pos - accumulated

            if try intern.is_return_type(s.ip, rhs_type) {
                s, let extracted_ir = try generate_return_type_extract(s, rhs_ir, field_idx)
                let extracted_sem = try types.get_return_type_at(s.tp, rhs_sem, field_idx)
                return s, extracted_ir, extracted_sem
            }

            return s, rhs_ir, rhs_sem
        }

        accumulated = accumulated + value_count
    }

    return s, ir.NULL_IDX, types.NULL_IDX
}

// generate_return_type_extract extracts a specific return value from a call with return_type
fn generate_return_type_extract(s *semsis, call_ir ir.index, field_idx u32)! *semsis, ir.index {
    var s = s

    let return_type = try get_type(s, call_ir)
    let field_type = try intern.get_return_type_at(s.ip, return_type, field_idx)

    s.ip, let idx_const = try intern.make_const_u32(s.ip, field_idx)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: idx_const, y: intern.U32_TYPE_IDX})
    let idx_ir = ir.index(u32(len(s.ins)-1))

    let extra_start = u32(len(s.extra))
    s.extra = try append(s.extra, u32(call_ir))
    s.extra = try append(s.extra, u32(idx_ir))

    s.ip, let ptr_type = try intern.make_pointer_type(s.ip, field_type)

    // x points to extra [call_ir, idx_ir], y is pointer type
    s.ins = try append(s.ins, ir.inst{
        tag: ir.tag.gep,
        x: extra_start,
        y: ptr_type
    })
    let gep_ir = ir.index(u32(len(s.ins)-1))

    s, let load_ir = try generate_load(s, gep_ir, field_type)
    return s, load_ir
}

// analyse_expression_with_type analyses an expression with a known expected type
// this allows generating correctly-typed IR for literals that need type context
// (e.g. null for optionals, integer literals, anonymous structs/arrays)
fn analyse_expression_with_type(s *semsis, idx ast.index, expected_type types.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)

    if node.tag == ast.tag.none_lit {
        if try types.is_optional(s.tp, expected_type) {
            s, let ir_idx = try generate_none(s, expected_type)
            return s, ir_idx, expected_type
        }
        s = try add_error(s, none_used_with_non_optional{pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    return try analyse_expression(s, idx)
}

// analyse_expression analyses and generates relevant instructions for a specific
// AST node, returning the indices of the instructions added and a flag to indicate
// whether those indices are from new instructions generated. For example analysing
// identifier simply returns the index of an already generated instruction
fn analyse_expression(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)

    match node.tag {
    case ast.tag.int:
        return try generate_constant_integer(s, idx)
    case ast.tag.hex:
        return try generate_constant_hexadecimal(s, idx)
    case ast.tag.bin:
        return try generate_constant_binary(s, idx)
    case ast.tag.true_lit, ast.tag.false_lit:
        return try generate_constant_bool(s, idx)
    case ast.tag.none_lit:
        // null literals must appear in typed context
        // use analyse_expression_with_type
        s = try add_error(s, compiler_error{
            rsn: "null literal requires type context",
            pos: idx,
        })
        return s, ir.NULL_IDX, types.NULL_IDX
    case ast.tag.string:
        return try generate_constant_string(s, idx)
    case ast.tag.char:
        return try generate_constant_char(s, idx)
    case ast.tag.ident:
        return try analyse_identifier(s, idx)
    case ast.tag.struct_lit:
        return try analyse_struct_literal(s, idx)
    case ast.tag.array_lit:
        return try analyse_array_literal(s, idx)
    case ast.tag.call:
        return try analyse_call(s, idx)
    case ast.tag.add, ast.tag.sub, ast.tag.mul, ast.tag.div, ast.tag.mod,
         ast.tag.band, ast.tag.bor, ast.tag.xor, ast.tag.lsh, ast.tag.rsh,
         ast.tag.eq, ast.tag.neq, ast.tag.lt, ast.tag.gt, ast.tag.lte, ast.tag.gte,
         ast.tag.land, ast.tag.lor:
        return try analyse_infix_expression(s, idx)
    case ast.tag.optional_coalesce:
        return try analyse_optional_coalesce(s, idx)
    case ast.tag.bnot:
        return try analyse_bnot(s, idx)
    case ast.tag.lnot:
        return try analyse_lnot(s, idx)
    case ast.tag.negate_num:
        return try analyse_negate(s, idx)
    case ast.tag.address_of:
        return try analyse_address_of(s, idx)
    case ast.tag.value_of:
        return try analyse_value_of(s, idx)
    case ast.tag.readonly_expr:
        return try analyse_readonly_expr(s, idx)
    case ast.tag.optional_unwrap:
        return try analyse_optional_unwrap(s, idx)
    case ast.tag.if_stmt:
        return try analyse_if_expr(s, idx)
    case ast.tag.dot:
        s, let ir_idx, let sem_type, let _ = try analyse_dot_expression(s, idx)
        return s, ir_idx, sem_type

    case ast.tag.try_expr:
        return try analyse_try_expr(s, idx)
    case ast.tag.catch_expr:
        return try analyse_catch_expr(s, idx)
    case _:
        s = try add_error(s, not_an_expression{pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }
}

fn analyse_bnot(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)

    s, var rhs_ir, let sem_type = try analyse_expression(s, node.data.x)

    s, rhs_ir = try extract_single_return_value(s, rhs_ir, node.data.x)
    if rhs_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, let valid = try rule_prefix_operator_valid(s, idx, sem_type)
    if !valid {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let ir_type = try get_type(s, rhs_ir)

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.bnot, x: u32(rhs_ir), y: u32(ir_type)})
    return s, ir.index(u32(len(s.ins)-1)), sem_type
}

fn analyse_lnot(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)

    s, var rhs_ir, let sem_type = try analyse_expression(s, node.data.x)

    s, rhs_ir = try extract_single_return_value(s, rhs_ir, node.data.x)
    if rhs_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, let valid = try rule_prefix_operator_valid(s, idx, sem_type)
    if !valid {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let ir_type = try get_type(s, rhs_ir)

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.lnot, x: u32(rhs_ir), y: u32(ir_type)})
    return s, ir.index(u32(len(s.ins)-1)), sem_type
}

fn analyse_negate(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)

    // we check if operand is an integer literal for min_i64 constant folding
    let rhs_node = try get(s.ast.nodes, node.data.x)
    if rhs_node.tag == ast.tag.int {
        let int_str = try ast.get_literal(s.ast, node.data.x)
        let i = convert.parse_u64(int_str, 10) catch e {
            s = try add_error(s, invalid_integer{pos: node.data.x})
            return s, ir.NULL_IDX, types.NULL_IDX
        }
        // 9223372036854775808 = 2^63 = max_i64 + 1, only valid as negated min_i64
        if i == 9223372036854775808 {
            let _, let type_idx = try intern.make_primitive_type(s.ip, intern.tag.i64_type)
            s.ip, let int_idx = try intern.make_const_u64(s.ip, i)
            s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: int_idx, y: type_idx})
            return s, ir.index(u32(len(s.ins)-1)), types.I64_IDX
        }
        if i > 9223372036854775808 {
            s = try add_error(s, invalid_integer{pos: node.data.x})
            return s, ir.NULL_IDX, types.NULL_IDX
        }
        // for values <= max_i64, fall through to normal path
    }

    s, var rhs_ir, let sem_type = try analyse_expression(s, node.data.x)

    s, rhs_ir = try extract_single_return_value(s, rhs_ir, node.data.x)
    if rhs_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, let valid = try rule_prefix_operator_valid(s, idx, sem_type)
    if !valid {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let ir_type = try get_type(s, rhs_ir)

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.neg, x: u32(rhs_ir), y: u32(ir_type)})
    return s, ir.index(u32(len(s.ins)-1)), sem_type
}

fn analyse_address_of(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)

    s, var rhs_ir, let sem_type = try analyse_expression(s, node.data.x)
    s, rhs_ir = try extract_single_return_value(s, rhs_ir, node.data.x)
    if rhs_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, let valid = try rule_prefix_operator_valid(s, idx, sem_type)
    if !valid {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s.tp, let ptr_sem_type = try types.make_pointer(s.tp, sem_type)

    // if value already has address semantics no alloca needed
    // - IR type is explicitly a pointer (e.g. string params)
    // - Operand is an alloca instruction (e.g. struct literals)
    let ir_type = try get_type(s, rhs_ir)
    let is_alloca = try is_alloca(s, rhs_ir)
    let is_pointer = try intern.is_pointer(s.ip, ir_type)
    if is_pointer || is_alloca {
        return s, rhs_ir, ptr_sem_type
    }

    // for primitives we alloca + store
    s, let alloca_idx = try generate_alloca(s, ir_type)
    s, let _ = try generate_store(s, alloca_idx, rhs_ir)

    return s, alloca_idx, ptr_sem_type
}

fn analyse_readonly_expr(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)

    s, var rhs_ir, let sem_type = try analyse_expression(s, node.data.x)
    s, rhs_ir = try extract_single_return_value(s, rhs_ir, node.data.x)
    if rhs_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, let valid = try rule_prefix_operator_valid(s, idx, sem_type)
    if !valid {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    return s, rhs_ir, sem_type
}

fn analyse_value_of(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)

    s, var rhs_ir, let sem_type = try analyse_expression(s, node.data.x)
    s, rhs_ir = try extract_single_return_value(s, rhs_ir, node.data.x)
    if rhs_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, let valid = try rule_prefix_operator_valid(s, idx, sem_type)
    if !valid {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let inner_sem_type = try types.get_pointer_inner(s.tp, sem_type)
    s, let inner_ir_type = try lower_semantic_to_ir(s, inner_sem_type)

    // for aggregates keep pointer, update semantic type only
    if try is_aggregate_ir_type(s, inner_ir_type) {
        return s, rhs_ir, inner_sem_type
    }

    // for scalar types emit load instruction
    s, let load_idx = try generate_load(s, rhs_ir, inner_ir_type)
    return s, load_idx, inner_sem_type
}

// analyse_dot_expression recursively resolves dot expressions left-to-right.
// Returns the IR index, semantic type, and optionally the resolved scope (for chained access).
fn analyse_dot_expression(s *semsis, idx ast.index)! *semsis, ir.index, types.index, ?namespace.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let lhs_idx = node.data.x
    let rhs_idx = node.data.y
    let lhs_node = try get(s.ast.nodes, lhs_idx)

    var lhs_scope_idx = namespace.NULL_IDX
    var lhs_ir = ir.NULL_IDX
    var lhs_sem_type = types.NULL_IDX
    // resolve lhs either recursively for nested dots or lookup for identifiers
    if lhs_node.tag == ast.tag.dot {
        s, let nested_ir, let nested_sem_type, let scope_opt = try analyse_dot_expression(s, lhs_idx)
        if scope_opt != null {
            lhs_scope_idx = ?scope_opt
        } else {
            // if nested dot was a struct field access, we need to keep the IR and type
            lhs_ir = nested_ir
            lhs_sem_type = nested_sem_type
        }
    } else if lhs_node.tag == ast.tag.ident {
        let name = try ast.identifier(s.ast, lhs_node)
        s.ip, let name_idx = try intern.intern_string(s.ip, name)

        // as we use simple names for variables and fqn for global variables, functions and types
        // we first try simple name lookup and then FQN lookup if not found
        var entry_opt = try namespace.lookup(s.np, s.current_scope, name_idx)
        if entry_opt == null {
            let current_scope = try namespace.get_scope(s.np, s.current_scope)
            let fqn = try make_fqn(current_scope.path, name)
            s.ip, let fqn_idx = try intern.intern_string(s.ip, fqn)
            entry_opt = try namespace.lookup(s.np, s.current_scope, fqn_idx)
        }

        if entry_opt != null {
            let entry = try namespace.get_entry(s.np, ?entry_opt)
            match e = entry {
            case namespace.scope:
                lhs_scope_idx = ?entry_opt
            case _:
            }
        }
    }

    // TODO: if we dont have scope index we can just check if its a struct type
    // if LHS didn't resolve to a scope, it's a value so we do struct field access
    if lhs_scope_idx == namespace.NULL_IDX {
        // use pre-computed LHS IR if available 
        if lhs_ir != ir.NULL_IDX {
            s, let ir_idx, let sem_type = try analyse_struct_field_access_with_lhs(s, idx, lhs_ir, lhs_sem_type)
            return s, ir_idx, sem_type, null
        }
        s, let ir_idx, let sem_type = try analyse_struct_field_access(s, idx)
        return s, ir_idx, sem_type, null
    }

    let lhs_scope = try namespace.get_scope(s.np, lhs_scope_idx)

    if try types.is_enum(s.tp, lhs_scope.owner) {
        s, let ir_idx = try analyse_enum_variant_access(s, idx, lhs_scope.owner)
        return s, ir_idx, lhs_scope.owner, null
    }

    let rhs_node = try get(s.ast.nodes, rhs_idx)
    let rhs_name = try ast.identifier(s.ast, rhs_node)

    s.ip, let rhs_name_idx = try intern.intern_string(s.ip, rhs_name)
    let fqn = try make_fqn(lhs_scope.path, rhs_name)
    s.ip, let fqn_idx = try intern.intern_string(s.ip, fqn)

    // for library scopes (when doing cross-library access), only look at public
    // declarations
    let is_lib_scope = try namespace.is_library_scope(s.np, lhs_scope_idx)
    var entry_idx = namespace.NULL_IDX
    if is_lib_scope {
        let entry_opt = try namespace.lookup_public(s.np, lhs_scope_idx, rhs_name_idx)
        if entry_opt != null {
            entry_idx = ?entry_opt
        } else {
            let fqn_entry_opt = try namespace.lookup_public(s.np, lhs_scope_idx, fqn_idx)
            if fqn_entry_opt != null {
                entry_idx = ?fqn_entry_opt
            }
        }
    } else {
        let entry_opt = try namespace.lookup(s.np, lhs_scope_idx, rhs_name_idx)
        if entry_opt != null {
            entry_idx = ?entry_opt
        } else {
            let fqn_entry_opt = try namespace.lookup(s.np, lhs_scope_idx, fqn_idx)
            if fqn_entry_opt != null {
                entry_idx = ?fqn_entry_opt
            }
        }
    }

    if entry_idx == namespace.NULL_IDX {
        s = try add_error(s, identifier_not_found{pos: rhs_idx})
        return s, ir.NULL_IDX, types.NULL_IDX, null
    }

    let entry = try namespace.get_entry(s.np, entry_idx)
    match e = entry {
    case namespace.scope:
        if try types.is_function(s.tp, e.owner) {
            s, let fn_ref = try generate_extern_ref(s, fqn_idx, e.owner)
            return s, fn_ref, e.owner, entry_idx
        }
        // we return scope for further chaining 
        return s, ir.NULL_IDX, e.owner, entry_idx
    case namespace.value:
        s, let ir_idx = try generate_library_variable_access(s, idx, fqn_idx, e)
        return s, ir_idx, e.type_idx, null
    case namespace.linear_value:
        let as_val = namespace.value{
            is_reassignable: e.is_reassignable,
            name: e.name,
            type_idx: e.type_idx,
            index: e.index,
        }
        s, let ir_idx = try generate_library_variable_access(s, idx, fqn_idx, as_val)
        return s, ir_idx, e.type_idx, null
    }
}

// generate_library_variable_access handles accessing a global variable from an imported library.
// For aggregate types (structs, arrays), returns the pointer directly.
// For scalar types, generates a load instruction.
fn generate_library_variable_access(s *semsis, idx ast.index, fqn_idx intern.index, v namespace.value)! *semsis, ir.index {
    var s = s
    s, let var_ir_type = try lower_semantic_to_ir(s, v.type_idx)

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.extern_ref, x: fqn_idx, y: var_ir_type})
    let ref_idx = ir.index(u32(len(s.ins) - 1))

    // for aggregates we return extern_ref directly as pointer
    if try is_aggregate_ir_type(s, var_ir_type) {
        return s, ref_idx
    }

    // for scalar types we load value from extern_ref pointer
    s, let load_idx = try generate_load(s, ref_idx, var_ir_type)
    return s, load_idx
}

// analyse_enum_variant_access handles E.Variant for enum value access
// generate_enum_variant generates IR for an enum variant constant
fn generate_enum_variant(s *semsis, enum_type types.index, variant_index u32)! *semsis, ir.index {
    var s = s

    s, let ir_type = try lower_semantic_to_ir(s, enum_type)

    s.ip, let const_idx = try intern.make_const_u64(s.ip, u64(variant_index))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: const_idx, y: ir_type})
    let result_idx = ir.index(u32(len(s.ins) - 1))

    return s, result_idx
}

fn analyse_enum_variant_access(s *semsis, idx ast.index, enum_sem_type types.index)! *semsis, ir.index {
    var s = s

    let node = try get(s.ast.nodes, idx)
    let rhs_idx = node.data.y

    let rhs_node = try get(s.ast.nodes, rhs_idx)
    let variant_name = try ast.identifier(s.ast, rhs_node)
    s.ip, let variant_name_idx = try intern.intern_string(s.ip, variant_name)

    let variant_info_opt = try types.get_enum_variant(s.tp, enum_sem_type, variant_name_idx)
    if variant_info_opt == null {
        s = try add_error(s, enum_unknown_variant{
            enum_type: enum_sem_type,
            variant:   variant_name_idx,
            pos:       rhs_idx
        })
        return s, ir.NULL_IDX
    }
    let variant_info = ?variant_info_opt
    let variant_index = variant_info.idx

    s, let ir_type = try lower_semantic_to_ir(s, enum_sem_type)

    s.ip, let const_idx = try intern.make_const_u64(s.ip, u64(variant_index))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: const_idx, y: ir_type})
    let result_idx = ir.index(u32(len(s.ins) - 1))

    return s, result_idx
}

// analyse_struct_field_access handles s.field for struct field access
// Returns the IR index and the semantic type of the accessed field
fn analyse_struct_field_access(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s

    let node = try get(s.ast.nodes, idx)
    let lhs_idx = node.data.x
    let rhs_idx = node.data.y

    s, let lhs_ir, let lhs_sem_type = try analyse_expression(s, lhs_idx)
    if lhs_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    // unwrap pointer if needed (as struct parameters are passed as pointers)
    var struct_sem_type = lhs_sem_type
    var lhs_is_pointer = try types.is_pointer(s.tp, lhs_sem_type)
    if lhs_is_pointer {
        struct_sem_type = try types.get_pointer_inner(s.tp, lhs_sem_type)
    }

    let is_struct = try types.is_struct(s.tp, struct_sem_type)
    let is_custom_error = try types.is_custom_error(s.tp, struct_sem_type)
    if !is_struct && !is_custom_error {
        s = try add_error(s, not_projectable{type_idx: struct_sem_type, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let rhs_node = try get(s.ast.nodes, rhs_idx)
    let field_name = try ast.identifier(s.ast, rhs_node)
    s.ip, let field_name_idx = try intern.intern_string(s.ip, field_name)

    let field_info_opt = try types.get_struct_field(s.tp, struct_sem_type, field_name_idx)
    if field_info_opt == null {
        s = try add_error(s, struct_unknown_field{
            typ:        struct_sem_type,
            field_name: field_name_idx,
            pos:        rhs_idx
        })
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    let field_info = ?field_info_opt
    let field_index = field_info.idx
    let field_sem_type = field_info.type_idx

    s, let field_ir_type = try lower_semantic_to_ir(s, field_sem_type)

    var struct_ptr = lhs_ir
    if !try is_alloca(s, lhs_ir) {
        // Check if IR type is already a pointer (function params, GEP results from nested dots)
        let ir_type = try get_type(s, lhs_ir)
        if !try intern.is_pointer(s.ip, ir_type) {
            // Not a pointer — need temp alloca + store
            s, let lhs_ir_type = try lower_semantic_to_ir(s, lhs_sem_type)
            s, let tmp = try generate_alloca(s, lhs_ir_type)
            s, let _ = try generate_store(s, tmp, lhs_ir)
            struct_ptr = tmp
        }
    }

    s, let gep_ir = try generate_gep(s, struct_ptr, field_index, field_ir_type)

    if try is_aggregate_ir_type(s, field_ir_type) {
        return s, gep_ir, field_sem_type
    }

    s, let load_ir = try generate_load(s, gep_ir, field_ir_type)
    return s, load_ir, field_sem_type
}

// analyse_struct_field_access_with_lhs handles s.field with pre-computed LHS IR and type
// Used for nested dot expressions to avoid re-analysing the LHS
// Returns the IR index and the semantic type of the accessed field
fn analyse_struct_field_access_with_lhs(s *semsis, idx ast.index, lhs_ir ir.index, lhs_sem_type types.index)! *semsis, ir.index, types.index {
    var s = s

    let node = try get(s.ast.nodes, idx)
    let rhs_idx = node.data.y

    // unwrap pointer if needed (as struct parameters are passed as pointers)
    var struct_sem_type = lhs_sem_type
    var lhs_is_pointer = try types.is_pointer(s.tp, lhs_sem_type)
    if lhs_is_pointer {
        struct_sem_type = try types.get_pointer_inner(s.tp, lhs_sem_type)
    }

    let is_struct = try types.is_struct(s.tp, struct_sem_type)
    let is_custom_error = try types.is_custom_error(s.tp, struct_sem_type)
    if !is_struct && !is_custom_error {
        s = try add_error(s, not_projectable{type_idx: struct_sem_type, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let rhs_node = try get(s.ast.nodes, rhs_idx)
    let field_name = try ast.identifier(s.ast, rhs_node)
    s.ip, let field_name_idx = try intern.intern_string(s.ip, field_name)

    let field_info_opt = try types.get_struct_field(s.tp, struct_sem_type, field_name_idx)
    if field_info_opt == null {
        s = try add_error(s, struct_unknown_field{
            typ:        struct_sem_type,
            field_name: field_name_idx,
            pos:        rhs_idx
        })
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    let field_info = ?field_info_opt
    let field_index = field_info.idx
    let field_sem_type = field_info.type_idx

    s, let field_ir_type = try lower_semantic_to_ir(s, field_sem_type)

    var struct_ptr = lhs_ir
    if !try is_alloca(s, lhs_ir) {
        // Check if IR type is already a pointer (function params, GEP results from nested dots)
        let ir_type = try get_type(s, lhs_ir)
        if !try intern.is_pointer(s.ip, ir_type) {
            // Not a pointer — need temp alloca + store
            s, let lhs_ir_type = try lower_semantic_to_ir(s, lhs_sem_type)
            s, let tmp = try generate_alloca(s, lhs_ir_type)
            s, let _ = try generate_store(s, tmp, lhs_ir)
            struct_ptr = tmp
        }
    }

    s, let gep_ir = try generate_gep(s, struct_ptr, field_index, field_ir_type)

    if try is_aggregate_ir_type(s, field_ir_type) {
        return s, gep_ir, field_sem_type
    }

    s, let load_ir = try generate_load(s, gep_ir, field_ir_type)
    return s, load_ir, field_sem_type
}

// TODO: refactor so rules defined in functions called rule_...
fn instantiate_generic_struct(s *semsis, type_params_idx ast.index)! *semsis, types.index {
    var s = s
    let tp_node = try get(s.ast.nodes, type_params_idx)
    let inner_idx = tp_node.data.x
    let type_args_idx = tp_node.data.y

    s, let _, let generic_sem_type = try analyse_expression(s, inner_idx)
    if generic_sem_type == types.NULL_IDX {
        return s, types.NULL_IDX
    }

    if !try types.is_generic_struct(s.tp, generic_sem_type) {
        s = try add_error(s, not_a_struct{type_idx: generic_sem_type, pos: inner_idx})
        return s, types.NULL_IDX
    }

    let generic_st = try types.lookup(s.tp, generic_sem_type)
    let generic_fqn = intern.index(generic_st.x)

    let type_args_node = try get(s.ast.nodes, type_args_idx)
    var concrete_types = try make([]types.index, 0, 4)
    if type_args_node.tag == ast.tag.expr_list {
        let ta_data = type_args_node.data
        for i = ta_data.x; i < ta_data.y; i++ {
            let ta_idx = try get(s.ast.extras, i)
            s, let resolved = try resolve_type_ref(s, s.current_scope, ta_idx)
            if resolved == types.NULL_IDX {
                return s, types.NULL_IDX
            }
            concrete_types = try append(concrete_types, resolved)
        }
    } else {
        s, let resolved = try resolve_type_ref(s, s.current_scope, type_args_idx)
        if resolved == types.NULL_IDX {
            return s, types.NULL_IDX
        }
        concrete_types = try append(concrete_types, resolved)
    }

    s, let mono_fqn = try make_mono_fqn(s, generic_fqn, concrete_types)

    let gdef_opt = try lookup_generic(s.generic_defs, generic_fqn)
    if gdef_opt == null {
        s = try add_error(s, compiler_error{rsn: "generic struct definition not found", pos: type_params_idx})
        return s, types.NULL_IDX
    }
    let gdef = ?gdef_opt

    let existing_scope = try namespace.lookup(s.np, gdef.source_scope, mono_fqn)
    if existing_scope != null {
        let scope = try namespace.get_scope(s.np, ?existing_scope)
        return s, scope.owner
    }

    let mono_fqn_str = intern.get_string(s.ip, mono_fqn)
    s.tp, let mono_sem_type = try types.make_struct(s.tp, mono_fqn)
    let mono_scope_entry = namespace.scope{
        path:       mono_fqn_str,
        owner:      mono_sem_type,
        parent_idx: gdef.source_scope,
        pub_decl:   map.new[intern.index, namespace.index](),
        priv_decl:  map.new[intern.index, namespace.index](),
    }
    s.np, let mono_scope_idx = try namespace.add_entry(s.np, namespace.entry(mono_scope_entry))
    s.np = try namespace.link_private(s.np, gdef.source_scope, mono_fqn, mono_scope_idx)

    let source_node = try get(gdef.source_ast.nodes, gdef.ast_node_idx)
    let source_data = source_node.data
    let gen_params_ast_idx = try get(gdef.source_ast.extras, source_data.x + 1)
    let gen_params_node = try get(gdef.source_ast.nodes, gen_params_ast_idx)
    let gp_data = gen_params_node.data
    let expected_count = u16((gp_data.y - gp_data.x) / 2)
    if u16(len(concrete_types)) != expected_count {
        s = try add_error(s, type_parameter_count_mismatch{expected: expected_count, found: u16(len(concrete_types)), pos: type_params_idx})
        return s, types.NULL_IDX
    }
    let mono_scope = try namespace.get_scope(s.np, mono_scope_idx)
    let mono_scope_path = mono_scope.path
    var param_i = u32(0)
    for i = gp_data.x; i < gp_data.y; i = i + 2 {
        let param_name_idx = try get(gdef.source_ast.extras, i)
        let param_name_node = try get(gdef.source_ast.nodes, param_name_idx)
        let param_name = try ast.identifier(gdef.source_ast, param_name_node)

        let type_param_fqn = try make_fqn(mono_scope_path, param_name)
        s.ip, let type_param_fqn_idx = try intern.intern_string(s.ip, type_param_fqn)

        let concrete_type = try get(concrete_types, param_i)
        let type_scope_entry = namespace.scope{
            path:       mono_scope_path,
            owner:      concrete_type,
            parent_idx: mono_scope_idx,
            pub_decl:   map.new[intern.index, namespace.index](),
            priv_decl:  map.new[intern.index, namespace.index](),
        }
        s.np = try namespace.put_public(s.np, mono_scope_idx, type_param_fqn_idx, namespace.entry(type_scope_entry))
        param_i = param_i + 1
    }

    let saved_ast = s.ast
    s = &semsis{..s, ast: gdef.source_ast}

    let fields_ast_idx = try get(gdef.source_ast.extras, source_data.x + 2)
    let fields_node = try get(gdef.source_ast.nodes, fields_ast_idx)
    let fields_data = fields_node.data
    let field_count = (fields_data.y - fields_data.x) / 2
    var field_data = try make([]u32, 0, field_count * 2)
    var field_ir_types = try make([]intern.index, 0, field_count)

    for j = fields_data.x; j < fields_data.y; j = j + 2 {
        let field_name_idx = try get(gdef.source_ast.extras, j)
        let field_type_idx = try get(gdef.source_ast.extras, j + 1)

        let field_name_node = try get(gdef.source_ast.nodes, field_name_idx)
        let field_name = try ast.identifier(gdef.source_ast, field_name_node)
        s.ip, let field_name_interned = try intern.intern_string(s.ip, field_name)

        s, let resolved_type = try resolve_type_ref(s, mono_scope_idx, field_type_idx)
        s, let ir_type = try lower_semantic_to_ir(s, resolved_type)
        field_ir_types = try append(field_ir_types, ir_type)

        field_data = try append(field_data, u32(field_name_interned))
        field_data = try append(field_data, u32(resolved_type))
    }

    s = &semsis{..s, ast: saved_ast}

    s.tp = try types.set_struct_fields(s.tp, mono_sem_type, field_data)
    s, let struct_ir_type = try lower_semantic_to_ir(s, mono_sem_type)
    s.ip, let _ = try intern.make_struct_fields(s.ip, struct_ir_type, field_ir_types)

    return s, mono_sem_type
}

fn analyse_struct_literal(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s

    // struct_lit: data.x = type identifier, data.y = anon_struct_lit
    let node = try get(s.ast.nodes, idx)
    let type_ident_idx = node.data.x
    let fields_idx = node.data.y

    let type_ident_node = try get(s.ast.nodes, type_ident_idx)
    var struct_sem_type = types.NULL_IDX
    if type_ident_node.tag == ast.tag.type_params {
        s, struct_sem_type = try instantiate_generic_struct(s, type_ident_idx)
    } else {
        s, let _, let resolved = try analyse_expression(s, type_ident_idx)
        struct_sem_type = resolved
    }
    if struct_sem_type == types.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let is_struct = try types.is_struct(s.tp, struct_sem_type)
    let is_error = try types.is_error(s.tp, struct_sem_type)
    if !is_struct && !is_error {
        s = try add_error(s, not_a_struct{type_idx: struct_sem_type, pos: type_ident_idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let fields_node = try get(s.ast.nodes, fields_idx)
    let fields_data = fields_node.data

    let field_count = try types.get_struct_field_count(s.tp, struct_sem_type)

    var field_irs = try make([]ir.index, 0, field_count)
    var field_types = try make([]intern.index, 0, field_count)
    for i = u32(0); i < field_count; i++ {
        field_irs = try append(field_irs, ir.NULL_IDX)
        field_types = try append(field_types, intern.NULL_IDX)
    }

    var has_error = false
    // Process each field assignment (iterate in pairs)
    // this loop performs multiple actions;
    // 1) verifies field in struct literal exists in definition
    // 2) verifies no duplicate fields within struct literal
    // 3) verifies field expression can be assigned to field
    // 4) generates IR of the field expression
    var field_map = map.new[intern.index, bool]()
    for i = fields_data.x; i < fields_data.y; i = i + 2 {
        let field_name_idx = try get(s.ast.extras, i)
        let field_value_idx = try get(s.ast.extras, i + 1)

        let field_name_node = try get(s.ast.nodes, field_name_idx)
        let field_name = try ast.identifier(s.ast, field_name_node)
        s.ip, let field_name_interned = try intern.intern_string(s.ip, field_name)

        // rule: no duplicate fields allowed
        let existing = try map.get_val(field_map, field_name_interned)
        if existing != null {
            s = try add_error(s, struct_duplicate_field{
                field_name: field_name_interned,
                pos: field_name_idx
            })
            has_error = true
            next
        }
        field_map = try map.insert(field_map, field_name_interned, true)

        // rule: field must exist in struct definition (use type pool)
        let field_info_opt = try types.get_struct_field(s.tp, struct_sem_type, field_name_interned)
        if field_info_opt == null {
            s = try add_error(s, struct_unknown_field{
                typ: struct_sem_type,
                field_name: field_name_interned,
                pos: field_name_idx
            })
            has_error = true
            next
        }
        let field_info = ?field_info_opt

        // TODO: use analyse_expression_with_type once semantic types are tracked
        s, var value_ir_idx, let value_sem_type = try analyse_expression(s, field_value_idx)
        if value_ir_idx == ir.NULL_IDX {
            has_error = true
            next
        }

        s, let is_assignable = try rule_is_assignable_to(s, value_ir_idx, value_sem_type, field_info.type_idx, field_value_idx)
        if !is_assignable {
            has_error = true
            next
        }

        s, value_ir_idx = try apply_type_conversion(s, value_ir_idx, value_sem_type, field_info.type_idx)

        s, let field_ir_type = try lower_semantic_to_ir(s, field_info.type_idx)
        field_irs = try put(field_irs, field_info.idx, value_ir_idx)
        field_types = try put(field_types, field_info.idx, field_ir_type)
    }

    // rule: all required non-optional fields were provided
    for i = u32(0); i < field_count; i++ {
        let field_info_opt = try types.get_struct_field_by_index(s.tp, struct_sem_type, i)
        if field_info_opt == null {
            next
        }
        let field_info = ?field_info_opt

        let was_provided = try map.get_val(field_map, field_info.name)
        if was_provided == null {
            // only optional fields can be skipped but we generate a null value
            let is_opt = try types.is_optional(s.tp, field_info.type_idx)
            if is_opt {
                s, let null_ir = try generate_none(s, field_info.type_idx)
                s, let field_ir_type = try lower_semantic_to_ir(s, field_info.type_idx)
                field_irs = try put(field_irs, field_info.idx, null_ir)
                field_types = try put(field_types, field_info.idx, field_ir_type)
            } else {
                s = try add_error(s, struct_missing_field{
                    typ: struct_sem_type,
                    field_name: field_info.name,
                    pos: type_ident_idx
                })
                has_error = true
            }
        }
    }

    if has_error {
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    s, let struct_type_ir = try lower_semantic_to_ir(s, struct_sem_type)
    s, let struct_ir = try generate_struct_literal(s, struct_type_ir, field_irs, field_types)

    return s, struct_ir, struct_sem_type
}

fn analyse_array_literal(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let data = node.data

    // TODO: if we analyse_expression_with_type then empty array literal
    // could be used if it was passed as fn argument, returned, or assigned
    // to struct. but this requires some refactoring
    if data.x == data.y {
        s = try add_error(s, empty_array_literal{pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let elem_count = data.y - data.x
    var elem_irs = try make([]ir.index, 0, elem_count)
    var elem_type = intern.NULL_IDX
    var elem_sem_type = types.NULL_IDX
    var has_error = false

    for i = data.x; i < data.y; i++ {
        let elem_idx = try get(s.ast.extras, i)
        s, var elem_ir, let this_sem_type = try analyse_expression(s, elem_idx)
        if elem_ir == ir.NULL_IDX {
            has_error = true
            next
        }

        let this_type = try get_type(s, elem_ir)

        if elem_type == intern.NULL_IDX {
            elem_type = this_type
            elem_sem_type = this_sem_type
        } else {
            // rule: all elements must have compatible semantic types
            s, let ok = try rule_array_element_type(s, elem_ir, this_sem_type, elem_sem_type, elem_idx)
            if !ok {
                has_error = true
                next
            }
        }

        s, elem_ir = try apply_type_conversion(s, elem_ir, this_sem_type, elem_sem_type)
        elem_irs = try append(elem_irs, elem_ir)
    }

    if has_error {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, let array_ir = try generate_array_literal(s, elem_type, elem_irs)
    s.tp, let array_sem_type = try types.make_array(s.tp, elem_sem_type)
    return s, array_ir, array_sem_type
}

// rule_array_element_type validates that an array element has the expected semantic type.
// Uses semantic types for proper type distinction.
fn rule_array_element_type(s *semsis, elem_ir ir.index, elem_sem_type, expected_sem_type types.index, pos ast.index)! *semsis, bool {
    var s = s

    if elem_sem_type == expected_sem_type {
        return s, true
    }

    if try is_const(s, elem_ir) {
        if try can_coerce_constant(s, elem_ir, elem_sem_type, expected_sem_type) {
            return s, true
        }
    }

    s = try add_error(s, array_element_type_mismatch{
        expected: expected_sem_type,
        got: elem_sem_type,
        pos: pos,
    })
    return s, false
}

// analyse_call determines whether call expression is a type cast or a function call.
// Handles identifier callees specially (for type casts and named functions), and
// any other expression callee (dot, index, call) by evaluating it and calling if
// the result is a function.
fn analyse_call(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let callee_idx = node.data.x

    let callee = try get(s.ast.nodes, callee_idx)

    if callee.tag == ast.tag.type_params {
        return try analyse_generic_call(s, idx)
    }

    if callee.tag == ast.tag.ident {
        let ident = try ast.identifier(s.ast, callee)
        s.ip, let ident_idx = try intern.intern_string(s.ip, ident)
        if ident_idx == intern.BUILTIN_PANIC_IDX {
            return try analyse_builtin_panic(s, idx)
        } else if ident_idx == intern.BUILTIN_LEN_IDX {
            return try analyse_builtin_len(s, idx)
        } else if ident_idx == intern.BUILTIN_ASSERT_IDX {
            return try analyse_builtin_assert(s, idx)
        } else if ident_idx == intern.BUILTIN_PRINTLN_IDX {
            return try analyse_builtin_println(s, idx)
        } else if ident_idx == intern.BUILTIN_GET_IDX {
            return try analyse_builtin_get(s, idx)
        } else if ident_idx == intern.BUILTIN_SLICE_IDX {
            return try analyse_builtin_slice(s, idx)
        } else if ident_idx == intern.BUILTIN_SIZE_IDX {
            return try analyse_builtin_size(s, idx)
        } else if ident_idx == intern.BUILTIN_PUT_IDX {
            return try analyse_builtin_put(s, idx)
        } else if ident_idx == intern.BUILTIN_APPEND_IDX {
            return try analyse_builtin_append(s, idx)
        } else if ident_idx == intern.BUILTIN_MAKE_IDX {
            return try analyse_builtin_make(s, idx)
        } else if ident_idx == intern.BUILTIN_CAP_IDX {
            return try analyse_builtin_cap(s, idx)
        }
    }

    if ast.is_primitive_type(callee.tag) {
        let target_sem_type = ast_primitive_tag_to_semantic_type(callee.tag)
        return try analyse_type_cast(s, idx, target_sem_type)
    }

    s, let callee_ir, let callee_type = try analyse_expression(s, callee_idx)

    if callee_type != types.NULL_IDX {
        let is_union = try types.is_union(s.tp, callee_type)
        let is_struct = try types.is_struct(s.tp, callee_type)
        let is_type_def = try types.is_type_def(s.tp, callee_type)
        if is_union || is_struct || is_type_def {
            return try analyse_type_cast(s, idx, callee_type)
        }

        // Function call with resolved extern_ref
        if try types.is_function(s.tp, callee_type) {
            return try analyse_function_call(s, idx, callee_ir, callee_type)
        }

        if try types.is_generic_function(s.tp, callee_type) {
            s = try add_error(s, compiler_error{rsn: "explicit type parameters required for generic call", pos: callee_idx})
            return s, ir.NULL_IDX, types.NULL_IDX
        }

        s = try add_error(s, calling_non_function{pos: callee_idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    if callee_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    // if we reach here, callee_type was NULL_IDX. this shouldn't happen for valid function calls
    s = try add_error(s, calling_non_function{pos: callee_idx})
    return s, ir.NULL_IDX, types.NULL_IDX
}

fn resolve_mono_signature(s *semsis, gdef generic_def, mono_fqn intern.index, concrete_types []types.index)! *semsis, types.index {
    var s = s
    let source_node = try get(gdef.source_ast.nodes, gdef.ast_node_idx)
    let source_data = source_node.data
    let is_fallible = source_node.tag == ast.tag.fn_gen_err_def

    var mono_sem_type = types.NULL_IDX
    if is_fallible {
        s.tp, mono_sem_type = try types.make_function_fallible(s.tp, mono_fqn)
    } else {
        s.tp, mono_sem_type = try types.make_function(s.tp, mono_fqn)
    }

    let mono_scope_entry = namespace.scope{
        path:       intern.get_string(s.ip, mono_fqn),
        owner:      mono_sem_type,
        parent_idx: gdef.source_scope,
        pub_decl:   map.new[intern.index, namespace.index](),
        priv_decl:  map.new[intern.index, namespace.index](),
    }
    s.np, let mono_scope_idx = try namespace.add_entry(s.np, namespace.entry(mono_scope_entry))
    s.np = try namespace.link_private(s.np, gdef.source_scope, mono_fqn, mono_scope_idx)

    let gen_params_ast_idx = try get(gdef.source_ast.extras, source_data.x + 1)
    let gen_params_node = try get(gdef.source_ast.nodes, gen_params_ast_idx)
    let gp_data = gen_params_node.data
    let mono_scope = try namespace.get_scope(s.np, mono_scope_idx)
    let mono_scope_path = mono_scope.path
    var param_i = u32(0)
    for i = gp_data.x; i < gp_data.y; i = i + 2 {
        let param_name_idx = try get(gdef.source_ast.extras, i)
        let param_name_node = try get(gdef.source_ast.nodes, param_name_idx)
        let param_name = try ast.identifier(gdef.source_ast, param_name_node)

        let type_param_fqn = try make_fqn(mono_scope_path, param_name)
        s.ip, let type_param_fqn_idx = try intern.intern_string(s.ip, type_param_fqn)

        let concrete_type = try get(concrete_types, param_i)
        let type_scope_entry = namespace.scope{
            path:       mono_scope_path,
            owner:      concrete_type,
            parent_idx: mono_scope_idx,
            pub_decl:   map.new[intern.index, namespace.index](),
            priv_decl:  map.new[intern.index, namespace.index](),
        }
        s.np = try namespace.put_public(s.np, mono_scope_idx, type_param_fqn_idx, namespace.entry(type_scope_entry))
        param_i = param_i + 1
    }

    var saved_ast = s.ast
    var saved_scope = s.current_scope
    s = &semsis{..s, ast: gdef.source_ast, current_scope: mono_scope_idx}

    let args_ast_idx = try get(gdef.source_ast.extras, source_data.x + 2)
    s, let param_ir_types, let param_sem_types = try resolve_function_argument_types(s, mono_scope_idx, args_ast_idx)
    let rets_ast_idx = try get(gdef.source_ast.extras, source_data.x + 3)
    s, let ret_ir_types, let ret_sem_types = try resolve_function_return_types(s, mono_scope_idx, rets_ast_idx)

    s = &semsis{..s, ast: saved_ast, current_scope: saved_scope}

    s, let fn_type_ir = try lower_semantic_to_ir(s, mono_sem_type)
    s.ip, let _ = try intern.make_function_signature(s.ip, fn_type_ir, param_ir_types, ret_ir_types)
    s.tp = try types.make_function_signature(s.tp, mono_sem_type, param_sem_types, ret_sem_types)

    return s, mono_sem_type
}

fn analyse_generic_call(s *semsis, call_idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let call_node = try get(s.ast.nodes, call_idx)
    let type_params_idx = call_node.data.x
    let type_params_node = try get(s.ast.nodes, type_params_idx)
    let inner_callee_idx = type_params_node.data.x
    let type_args_idx = type_params_node.data.y

    s, let _, let callee_type = try analyse_expression(s, inner_callee_idx)
    if callee_type == types.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    if !try types.is_generic_function(s.tp, callee_type) {
        s = try add_error(s, not_a_generic_function{pos: inner_callee_idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let callee_st = try types.lookup(s.tp, callee_type)
    let generic_fqn = intern.index(callee_st.x)

    let type_args_node = try get(s.ast.nodes, type_args_idx)
    var concrete_types = try make([]types.index, 0, 4)
    if type_args_node.tag == ast.tag.expr_list {
        let ta_data = type_args_node.data
        for i = ta_data.x; i < ta_data.y; i++ {
            let ta_idx = try get(s.ast.extras, i)
            s, let resolved = try resolve_type_ref(s, s.current_scope, ta_idx)
            if resolved == types.NULL_IDX {
                return s, ir.NULL_IDX, types.NULL_IDX
            }
            concrete_types = try append(concrete_types, resolved)
        }
    } else {
        s, let resolved = try resolve_type_ref(s, s.current_scope, type_args_idx)
        if resolved == types.NULL_IDX {
            return s, ir.NULL_IDX, types.NULL_IDX
        }
        concrete_types = try append(concrete_types, resolved)
    }

    let gdef_opt = try lookup_generic(s.generic_defs, generic_fqn)
    if gdef_opt == null {
        s = try add_error(s, compiler_error{rsn: "generic definition not found", pos: call_idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    let gdef = ?gdef_opt

    let source_node = try get(gdef.source_ast.nodes, gdef.ast_node_idx)
    let source_data = source_node.data
    let gen_params_ast_idx = try get(gdef.source_ast.extras, source_data.x + 1)
    let gen_params_node = try get(gdef.source_ast.nodes, gen_params_ast_idx)
    let expected_count = u16((gen_params_node.data.y - gen_params_node.data.x) / 2)
    if u16(len(concrete_types)) != expected_count {
        s = try add_error(s, type_parameter_count_mismatch{
            expected: expected_count,
            found: u16(len(concrete_types)),
            pos: type_params_idx,
        })
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, let mono_fqn = try make_mono_fqn(s, generic_fqn, concrete_types)

    let cached = try map.get_val(s.mono_cache, mono_fqn)
    if cached != null {
        let mono_scope_idx_opt = try namespace.lookup(s.np, gdef.source_scope, mono_fqn)
        if mono_scope_idx_opt == null {
            s = try add_error(s, compiler_error{rsn: "mono function scope not found in cache path", pos: call_idx})
            return s, ir.NULL_IDX, types.NULL_IDX
        }
        let mono_scope = try namespace.get_scope(s.np, ?mono_scope_idx_opt)
        let mono_sem_type = mono_scope.owner
        s, let fn_ref = try generate_extern_ref(s, mono_fqn, mono_sem_type)
        return try analyse_function_call(s, call_idx, fn_ref, mono_sem_type)
    }

    s, let mono_sem_type = try resolve_mono_signature(s, gdef, mono_fqn, concrete_types)
    if mono_sem_type == types.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s.mono_cache = try map.insert(s.mono_cache, mono_fqn, ir.NULL_IDX)

    s.mono_queue = try append(s.mono_queue, mono_job{
        generic_fqn: generic_fqn,
        mono_fqn: mono_fqn,
        concrete_types: concrete_types,
        call_pos: call_idx,
    })

    s, let fn_ref = try generate_extern_ref(s, mono_fqn, mono_sem_type)
    return try analyse_function_call(s, call_idx, fn_ref, mono_sem_type)
}

// ast_primitive_tag_to_semantic_type maps AST primitive type tags to semantic type indices
fn ast_primitive_tag_to_semantic_type(tag ast.tag) types.index {
    return match tag {
        case ast.tag.u8_type:     types.U8_IDX
        case ast.tag.u16_type:    types.U16_IDX
        case ast.tag.u32_type:    types.U32_IDX
        case ast.tag.u64_type:    types.U64_IDX
        case ast.tag.i8_type:     types.I8_IDX
        case ast.tag.i16_type:    types.I16_IDX
        case ast.tag.i32_type:    types.I32_IDX
        case ast.tag.i64_type:    types.I64_IDX
        case ast.tag.int_type:    types.I64_IDX
        case ast.tag.f32_type:    types.F32_IDX
        case ast.tag.f64_type:    types.F64_IDX
        case ast.tag.float_type:  types.F64_IDX
        case ast.tag.char_type:   types.CHAR_IDX
        case ast.tag.bool_type:   types.BOOL_IDX
        case ast.tag.string_type: types.STRING_IDX
        case ast.tag.many_type:    types.MANY_IDX
        case _: types.NULL_IDX
    }
}

// analyse_type_cast handles all type casts and selections:
// - T(x) → primitive cast (if castable)
// - many(x) → many construction
// - T(many_val) → many selection (returns ?T)
// - Union(x) → union construction (if x is variant)
// - T(union_val) → union selection (returns ?T)
fn analyse_type_cast(s *semsis, idx ast.index, target_sem_type types.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let args_idx = node.data.y

    s, let is_valid = try rule_one_argument_in_cast(s, args_idx, idx)
    if !is_valid {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let args_node = try get(s.ast.nodes, args_idx)
    let arg_idx = try get(s.ast.extras, args_node.data.x)
    s, let arg_ir, let arg_sem_type = try analyse_expression(s, arg_idx)
    if arg_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    // memory[T] cannot be cast to any other type
    let arg_is_memory = try types.is_memory(s.tp, arg_sem_type)
    if arg_is_memory {
        s = try add_error(s, cannot_assign_to_type{got: arg_sem_type, want: target_sem_type, pos: arg_idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    // many(x) -> many construction
    let target_is_many = try types.is_many(s.tp, target_sem_type)
    let arg_is_many = try types.is_many(s.tp, arg_sem_type)
    if target_is_many {
        if arg_is_many {
            return s, arg_ir, types.MANY_IDX  // noop
        }
        return try generate_many_construction(s, arg_ir, arg_sem_type)
    }

    // type_def(x) → type definition construction (checked before any/union selection)
    let target_is_type_def = try types.is_type_def(s.tp, target_sem_type)
    if target_is_type_def {
        return try analyse_type_def_construction(s, arg_ir, arg_sem_type, target_sem_type, idx)
    }

    // T(many_val) -> many selection (returns ?T)
    if arg_is_many {
        return try generate_many_selection(s, arg_ir, target_sem_type)
    }

    // union(x) -> union construction or union -> union: error
    let target_is_union = try types.is_union(s.tp, target_sem_type)
    let arg_is_union = try types.is_union(s.tp, arg_sem_type)
    if target_is_union {
        if arg_is_union {
            s = try add_error(s, illegal_union_to_union{pos: idx, from: arg_sem_type, to: target_sem_type})
            return s, ir.NULL_IDX, types.NULL_IDX
        }
        return try analyse_union_construction(s, arg_ir, arg_sem_type, target_sem_type, idx)
    }

    // T(union_val) → union selection (returns ?T)
    if arg_is_union {
        return try analyse_union_selection(s, arg_ir, arg_sem_type, target_sem_type, idx)
    }

    // primitive cast: T(x) where both are primitives
    if !try rule_is_castable_to(s, arg_sem_type, target_sem_type, idx) {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let arg_ir_type = try get_type(s, arg_ir)
    s, let target_ir_type = try lower_semantic_to_ir(s, target_sem_type)

    // avoid cast if semantic types match
    if arg_sem_type == target_sem_type {
        return s, arg_ir, target_sem_type
    }

    s, let result_ir = try generate_cast(s, arg_ir, target_ir_type)
    return s, result_ir, target_sem_type
}

// analyse_union_construction handles T → Union construction
// Checks if T is a variant of the union, handles constant coercion for ambiguity detection
fn analyse_union_construction(s *semsis, arg_ir ir.index, arg_sem_type types.index, union_sem_type types.index, idx ast.index)! *semsis, ir.index, types.index {
    var s = s

    var match_count = u32(0)
    var field_idx = u32(0)
    var target_sem_type = arg_sem_type

    let is_const = try is_const(s, arg_ir)
    let subtype_count = try types.get_union_subtype_count(s.tp, union_sem_type)

    for i = u32(0); i < subtype_count; i++ {
        let subtype_info_opt = try types.get_union_subtype_by_index(s.tp, union_sem_type, i)
        if subtype_info_opt == null {
            next
        }
        let subtype_info = ?subtype_info_opt

        let matches = if is_const {
            try can_coerce_constant(s, arg_ir, arg_sem_type, subtype_info.type_idx)
        } else {
            arg_sem_type == subtype_info.type_idx
        }
        if matches {
            match_count = match_count + 1
            field_idx = subtype_info.idx
            target_sem_type = subtype_info.type_idx
        }
    }

    if match_count == 0 {
        s = try add_error(s, type_not_in_union{
            pos: idx,
            type_idx: arg_sem_type,
            union_type_idx: union_sem_type,
        })
        return s, ir.NULL_IDX, types.NULL_IDX
    } else if match_count > 1 {
        s = try add_error(s, ambiguous_union_construction{
            pos: idx,
            from_type: arg_sem_type,
            union_type: union_sem_type,
            match_count: match_count,
        })
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    var value_ir = arg_ir
    if target_sem_type != arg_sem_type {
        s, let target_ir_type = try lower_semantic_to_ir(s, target_sem_type)
        s, value_ir = try generate_cast(s, arg_ir, target_ir_type)
    }
    s, let result_ir = try generate_union_construction(s, value_ir, target_sem_type, union_sem_type, field_idx)
    return s, result_ir, union_sem_type
}

// analyse_type_selection handles T(x) where T is a type and x is a polymorphic container.
// Currently supports: Union -> T (returns ?T)
// Future: many -> T, error -> ConcreteError
fn analyse_type_selection(s *semsis, scope_idx namespace.index, idx ast.index, target_sem_type types.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let args_idx = node.data.y

    s, let is_valid = try rule_one_argument_in_cast(s, args_idx, idx)
    if !is_valid {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let args_node = try get(s.ast.nodes, args_idx)
    let arg_idx = try get(s.ast.extras, args_node.data.x)

    s, let arg_ir, let arg_sem_type = try analyse_expression(s, arg_idx)
    if arg_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    if try types.is_union(s.tp, arg_sem_type) {
        return try analyse_union_selection(s, arg_ir, arg_sem_type, target_sem_type, idx)
    }

    if try types.is_many(s.tp, arg_sem_type) {
        // many -> many is a noop
        if try types.is_many(s.tp, target_sem_type) {
            return s, arg_ir, types.MANY_IDX
        }
        return try generate_many_selection(s, arg_ir, target_sem_type)
    }

    // TODO: Check if argument is 'error' - delegate to error extraction

    // not a valid source for type selection
    s = try add_error(s, cannot_assign_to_type{
        got: arg_sem_type,
        want: target_sem_type,
        pos: idx,
    })
    return s, ir.NULL_IDX, types.NULL_IDX
}

// analyse_union_selection handles Union -> T selection.
// Checks at runtime if union's tag matches T and returns ?T.
fn analyse_union_selection(s *semsis, union_ir ir.index, union_sem_type types.index, target_sem_type types.index, pos ast.index)! *semsis, ir.index, types.index {
    var s = s

    let match_count, let expected_tag = try count_union_matches(s, target_sem_type, union_sem_type)

    if match_count == 0 {
        s = try add_error(s, type_not_in_union{
            pos: pos,
            type_idx: target_sem_type,
            union_type_idx: union_sem_type,
        })
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    return try generate_union_selection(s, union_ir, target_sem_type, expected_tag)
}

// analyse_type_def_construction handles TypeDef(value) construction
// Validates that value type matches or can be coerced to the underlying type
fn analyse_type_def_construction(s *semsis, arg_ir ir.index, arg_sem_type types.index, type_def_sem_type types.index, pos ast.index)! *semsis, ir.index, types.index {
    var s = s

    let underlying_type = try types.get_type_def_underlying(s.tp, type_def_sem_type)
    if underlying_type == types.NULL_IDX {
        s = try add_error(s, compiler_error{
            rsn: "type_def has no underlying type",
            pos: pos,
        })
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    // recursively unwrap chained type_defs to get underlying type
    let effective_underlying = try get_effective_type_for_operators(s, underlying_type)

    let effective_is_many = try types.is_many(s.tp, effective_underlying)
    if effective_is_many {
        let arg_is_many = try types.is_many(s.tp, arg_sem_type)
        if arg_is_many {
            return s, arg_ir, type_def_sem_type
        }
        s, let many_ir, let _ = try generate_many_construction(s, arg_ir, arg_sem_type)
        return s, many_ir, type_def_sem_type
    }

    let effective_is_union = try types.is_union(s.tp, effective_underlying)
    if effective_is_union && arg_sem_type != effective_underlying {
        s, let union_ir, let _ = try analyse_union_construction(s, arg_ir, arg_sem_type, effective_underlying, pos)
        return s, union_ir, type_def_sem_type
    }

    let is_const = try is_const(s, arg_ir)
    let can_cast = if is_const {
        try can_coerce_constant(s, arg_ir, arg_sem_type, underlying_type)
    } else if arg_sem_type == underlying_type {
        true
    } else {
        try rule_is_castable_to(s, arg_sem_type, underlying_type, pos)
    }

    if !can_cast {
        s = try add_error(s, cannot_cast_to_type_def{
            type_def_type: type_def_sem_type,
            from_type: arg_sem_type,
            pos: pos,
        })
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    // generate cast to underlying IR type if needed
    let arg_ir_type = try get_type(s, arg_ir)
    s, let underlying_ir_type = try lower_semantic_to_ir(s, underlying_type)

    var result_ir = arg_ir
    if arg_ir_type != underlying_ir_type {
        s, result_ir = try generate_cast(s, arg_ir, underlying_ir_type)
    }

    return s, result_ir, type_def_sem_type
}

// analyse_many_cast handles many(value) explicit casting to many type
fn analyse_many_cast(s *semsis, scope_idx namespace.index, idx ast.index)! *semsis, ir.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let args_idx = node.data.y

    s, let is_valid = try rule_one_argument_in_cast(s, args_idx, idx)
    if !is_valid {
        return s, ir.NULL_IDX
    }

    let args_node = try get(s.ast.nodes, args_idx)
    let arg_idx = try get(s.ast.extras, args_node.data.x)

    s, let arg_ir, let arg_sem_type = try analyse_expression(s, arg_idx)
    if arg_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX
    }

    s, let result_ir, let _ = try generate_many_construction(s, arg_ir, arg_sem_type)
    return s, result_ir
}

// analyse_function_call validates function arguments and generates call instruction
// fn_ref is the IR index of the function reference, fn_sem_type is its semantic type
fn analyse_function_call(s *semsis, call_idx ast.index, fn_ref ir.index, fn_sem_type types.index)! *semsis, ir.index, types.index {
    var s = s
    s.last_call_was_fallible = try types.is_fallible(s.tp, fn_sem_type)
    let node = try get(s.ast.nodes, call_idx)
    let args_idx = node.data.y

    let params_sem_type, let returns_sem_type = try types.get_function_signature(s.tp, fn_sem_type)
    let param_sem_types = try types.expand_type_to_list(s.tp, params_sem_type)

    s, let fn_type_ir = try lower_semantic_to_ir(s, fn_sem_type)
    let ir_params_opt, let ir_returns_opt = try intern.get_function_signature(s.ip, fn_type_ir)
    if ir_params_opt == null || ir_returns_opt == null {
        s = try add_error(s, compiler_error{rsn: "function signature not found", pos: call_idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    let param_ir_types = ?ir_params_opt
    let return_ir_types = ?ir_returns_opt

    if args_idx == ast.NULL_IDX {
        if len(param_ir_types) > 0 {
            s = try add_error(s, too_few_arguments{
                expected: u16(len(param_ir_types)),
                found: 0,
                pos: call_idx
            })
            return s, ir.NULL_IDX, types.NULL_IDX
        }

        let is_fallible = try types.is_fallible(s.tp, fn_sem_type)
        if is_fallible {
            s, let err_struct_type, let _ = try make_error_struct_type(s)
            var aug_types = try make([]intern.index, 0, len(return_ir_types) + 1)
            for i = 0; i < len(return_ir_types); i++ {
                aug_types = try append(aug_types, try get(return_ir_types, i))
            }
            aug_types = try append(aug_types, err_struct_type)
            s.ip, let return_type = try intern.make_return_type(s.ip, aug_types)
            s, let call_ir = try generate_call(s, fn_ref, [], return_type)
            return s, call_ir, returns_sem_type
        }

        var return_type = intern.NULL_IDX
        if len(return_ir_types) > 0 {
            s.ip, return_type = try intern.make_return_type(s.ip, return_ir_types)
        }

        s, let call_ir = try generate_call(s, fn_ref, [], return_type)
        return s, call_ir, returns_sem_type
    }

    let args_node = try get(s.ast.nodes, args_idx)
    let args_data = args_node.data
    let arg_count = u32(args_data.y - args_data.x)

    if arg_count > u32(len(param_ir_types)) {
        s = try add_error(s, too_many_arguments{
            expected: u16(len(param_ir_types)),
            found:    u16(arg_count),
            pos:      call_idx
        })
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    // TODO: we have to improve this check as we might
    // pass a function as a parameter with multiple return
    // values where arg_count is 1 while expected params
    // is greater than 1
    if arg_count < u32(len(param_ir_types)) {
        s = try add_error(s, too_few_arguments{
            expected: u16(len(param_ir_types)),
            found:    u16(arg_count),
            pos:      call_idx
        })
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    var has_error = false
    var arg_ir_list = try make([]ir.index, 0, arg_count)
    // TODO: if function call passed as argument with multiple
    // return values we need to assign each to its own parameter
    // slot
    for i = args_data.x; i < args_data.y; i++ {
        let arg_idx = try get(s.ast.extras, i)
        let param_idx = u32(i - args_data.x)
        let expected_sem_type = try get(param_sem_types, param_idx)

        s, var arg_ir, let arg_sem_type = try analyse_expression_with_type(s, arg_idx, expected_sem_type)
        if arg_ir == ir.NULL_IDX {
            has_error = true
            next
        }

        s, arg_ir = try extract_single_return_value(s, arg_ir, arg_idx)
        if arg_ir == ir.NULL_IDX {
            has_error = true
            next
        }

        s, let is_assignable = try rule_is_assignable_to(s, arg_ir, arg_sem_type, expected_sem_type, arg_idx)
        if !is_assignable {
            has_error = true
            next
        }

        s, arg_ir = try apply_type_conversion(s, arg_ir, arg_sem_type, expected_sem_type)

        // mark linear values as consumed when passed to functions
        let arg_node = try get(s.ast.nodes, arg_idx)
        if arg_node.tag == ast.tag.ident {
            s = try mark_consumed_if_linear(s, arg_idx)
        }

        arg_ir_list = try append(arg_ir_list, arg_ir)
    }
    if has_error {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let is_fallible = try types.is_fallible(s.tp, fn_sem_type)
    if is_fallible {
        s, let err_struct_type, let _ = try make_error_struct_type(s)
        var aug_types = try make([]intern.index, 0, len(return_ir_types) + 1)
        for i = 0; i < len(return_ir_types); i++ {
            aug_types = try append(aug_types, try get(return_ir_types, i))
        }
        aug_types = try append(aug_types, err_struct_type)
        s.ip, let return_type = try intern.make_return_type(s.ip, aug_types)
        s, let call_ir = try generate_call(s, fn_ref, arg_ir_list, return_type)
        return s, call_ir, returns_sem_type
    }

    var return_type = intern.NULL_IDX
    if len(return_ir_types) > 0 {
        s.ip, return_type = try intern.make_return_type(s.ip, return_ir_types)
    }

    s, let call_ir = try generate_call(s, fn_ref, arg_ir_list, return_type)
    return s, call_ir, returns_sem_type
}

fn analyse_function_call_with_args(s *semsis, fn_ref ir.index, fn_sem_type types.index, arg_ir_list []ir.index)! *semsis, ir.index, types.index {
    var s = s
    s.last_call_was_fallible = try types.is_fallible(s.tp, fn_sem_type)

    let _, let returns_sem_type = try types.get_function_signature(s.tp, fn_sem_type)

    s, let fn_type_ir = try lower_semantic_to_ir(s, fn_sem_type)
    let _, let ir_returns_opt = try intern.get_function_signature(s.ip, fn_type_ir)
    if ir_returns_opt == null {
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    let return_ir_types = ?ir_returns_opt

    let is_fallible = try types.is_fallible(s.tp, fn_sem_type)
    if is_fallible {
        s, let err_struct_type, let _ = try make_error_struct_type(s)
        var aug_types = try make([]intern.index, 0, len(return_ir_types) + 1)
        for i = 0; i < len(return_ir_types); i++ {
            aug_types = try append(aug_types, try get(return_ir_types, i))
        }
        aug_types = try append(aug_types, err_struct_type)
        s.ip, let return_type = try intern.make_return_type(s.ip, aug_types)
        s, let call_ir = try generate_call(s, fn_ref, arg_ir_list, return_type)
        return s, call_ir, returns_sem_type
    }

    var return_type = intern.NULL_IDX
    if len(return_ir_types) > 0 {
        s.ip, return_type = try intern.make_return_type(s.ip, return_ir_types)
    }

    s, let call_ir = try generate_call(s, fn_ref, arg_ir_list, return_type)
    return s, call_ir, returns_sem_type
}

// generate_call generates the call instruction with arguments
fn generate_call(s *semsis, fn_ref ir.index, args []ir.index, return_type intern.index)! *semsis, ir.index {
    var s = s


    let extra_start = u32(len(s.extra))
    s.extra = try append(s.extra, u32(fn_ref))
    s.extra = try append(s.extra, u32(len(args)))
    for i = 0; i < len(args); i++ {
        let arg_ir = try get(args, i)
        s.extra = try append(s.extra, u32(arg_ir))
    }

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.call, x: extra_start, y: return_type})
    return s, ir.index(u32(len(s.ins)-1))
}

fn analyse_infix_expression(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    let node = try get(s.ast.nodes, idx)
    let data = node.data

    var s = s
    s, var lhs_ir, let lhs_sem_type = try analyse_expression(s, data.x)
    if lhs_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    s, var rhs_ir, let rhs_sem_type = try analyse_expression(s, data.y)
    if rhs_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, lhs_ir = try extract_single_return_value(s, lhs_ir, data.x)
    if lhs_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    s, rhs_ir = try extract_single_return_value(s, rhs_ir, data.y)
    if rhs_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let lhs_ir_type = try get_type(s, lhs_ir)
    let rhs_ir_type = try get_type(s, rhs_ir)

    let lhs_is_const = try is_const(s, lhs_ir)
    let rhs_is_const = try is_const(s, rhs_ir)

    if lhs_is_const && rhs_is_const {
        let r_to_l = try can_coerce_constant(s, lhs_ir, lhs_sem_type, rhs_sem_type)
        let l_to_r = try can_coerce_constant(s, rhs_ir, rhs_sem_type, lhs_sem_type)
        if !r_to_l && !l_to_r {
            s = add_error(s, cannot_assign_to_type{
                got: rhs_sem_type,
                want: lhs_sem_type,
                pos: idx,
            })
            return s, ir.NULL_IDX, types.NULL_IDX
        }
    } else if lhs_is_const {
        if !try can_coerce_constant(s, lhs_ir, lhs_sem_type, rhs_sem_type) {
            s = add_error(s, cannot_assign_to_type{
                got: lhs_sem_type,
                want: rhs_sem_type,
                pos: idx,
            })
            return s, ir.NULL_IDX, types.NULL_IDX
        }
    } else if rhs_is_const {
        if !try can_coerce_constant(s, rhs_ir, rhs_sem_type, lhs_sem_type) {
            s = add_error(s, cannot_assign_to_type{
                got: rhs_sem_type,
                want: lhs_sem_type,
                pos: idx,
            })
            return s, ir.NULL_IDX, types.NULL_IDX
        }
    } else {
        if lhs_sem_type != rhs_sem_type {
            s = add_error(s, type_mismatch{got: rhs_sem_type, want: lhs_sem_type, pos: idx})
            return s, ir.NULL_IDX, types.NULL_IDX
        }
    }

    let res_sem_type = if lhs_is_const && rhs_is_const {
        try find_common_type_constants(s, lhs_sem_type, rhs_sem_type)
    } else if lhs_is_const {
        rhs_sem_type
    } else if rhs_is_const {
        lhs_sem_type
    } else {
        lhs_sem_type
    }

    s, let ok = try rule_infix_operator_valid(s, idx, res_sem_type)
    if !ok {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, let res_ir_type = try lower_semantic_to_ir(s, res_sem_type)

    // apply coercions only to constants
    if lhs_is_const && lhs_ir_type != res_ir_type {
        s, lhs_ir = try generate_cast(s, lhs_ir, res_ir_type)
    }
    if rhs_is_const && rhs_ir_type != res_ir_type {
        s, rhs_ir = try generate_cast(s, rhs_ir, res_ir_type)
    }

    if try types.is_string(s.tp, lhs_sem_type) {
        return try generate_infix_string(s, idx, lhs_ir, rhs_ir)
    }

    s, let result_ir = try generate_infix(s, idx, lhs_ir, rhs_ir)

    // TODO: there has to be a better way than doing this?
    // comparisons return bool, others preserve operand type
    let is_comparison = node.tag == ast.tag.lt || node.tag == ast.tag.gt ||
                        node.tag == ast.tag.lte || node.tag == ast.tag.gte ||
                        node.tag == ast.tag.eq || node.tag == ast.tag.neq
    let result_sem_type = if is_comparison { types.BOOL_IDX } else { res_sem_type }

    return s, result_ir, result_sem_type
}

// analyse_optional_coalesce handles the null coalescing operator (a ?? b)
// returns b if a is null, otherwise unwraps and returns a's value
fn analyse_optional_coalesce(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let lhs_idx = node.data.x
    let rhs_idx = node.data.y

    let lhs_node = try get(s.ast.nodes, lhs_idx)
    if lhs_node.tag == ast.tag.none_lit {
        s = try add_error(s, none_used_in_coalesce{pos: lhs_idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let rhs_node = try get(s.ast.nodes, rhs_idx)
    if rhs_node.tag == ast.tag.none_lit {
        s = try add_error(s, none_used_in_coalesce{pos: rhs_idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, let lhs_ir, let lhs_sem_type = try analyse_expression(s, lhs_idx)
    if lhs_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    if lhs_sem_type == types.NULL_IDX || !try types.is_optional(s.tp, lhs_sem_type) {
        s = try add_error(s, none_used_with_non_optional{pos: lhs_idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let inner_sem_type = try types.get_optional_inner(s.tp, lhs_sem_type)
    s, let inner_ir_type = try lower_semantic_to_ir(s, inner_sem_type)

    let func_fqn = s.current_func_fqn

    s, let has_value_fqn = try reserve_block(s, func_fqn)
    s, let no_value_fqn = try reserve_block(s, func_fqn)
    s, let merge_fqn = try reserve_block(s, func_fqn)

    s, let is_valid_ptr = try generate_gep(s, lhs_ir, 0, intern.BOOL_TYPE_IDX)
    s, let is_valid_ir = try generate_load(s, is_valid_ptr, intern.BOOL_TYPE_IDX)

    s = try generate_br(s, is_valid_ir, has_value_fqn, no_value_fqn)

    let is_aggregate = try is_aggregate_ir_type(s, inner_ir_type)

    s, let _ = try generate_block(s, has_value_fqn)
    s, let value_ptr = try generate_gep(s, lhs_ir, 1, inner_ir_type)
    let lhs_result = if is_aggregate {
        value_ptr
    } else {
        s, let loaded = try generate_load(s, value_ptr, inner_ir_type)
        loaded
    }
    s = try generate_jmp_with_args(s, merge_fqn, [lhs_result])

    s, let _ = try generate_block(s, no_value_fqn)

    s, let rhs_ir, let rhs_sem_type = try analyse_expression(s, rhs_idx)
    if rhs_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    if try types.is_optional(s.tp, rhs_sem_type) {
        s = try add_error(s, optional_coalesce_rhs_optional{pos: rhs_idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, let is_assignable = try rule_is_assignable_to(s, rhs_ir, rhs_sem_type, inner_sem_type, rhs_idx)
    if !is_assignable {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s = try generate_jmp_with_args(s, merge_fqn, [rhs_ir])

    var block_arg_type = inner_ir_type
    if is_aggregate {
        s.ip, block_arg_type = try intern.make_pointer_type(s.ip, inner_ir_type)
    }
    s, let _, let block_arg_indices = try generate_block_with_args(s, merge_fqn, [block_arg_type])
    let result_ir = try get(block_arg_indices, 0)

    return s, result_ir, inner_sem_type
}

// analyse_optional_unwrap handles force unwrap operator (?expr)
// unwraps optional value or raises error if null
fn analyse_optional_unwrap(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let operand_idx = node.data.x  // The expression being unwrapped

    s, let operand_ir, let operand_sem_type = try analyse_expression(s, operand_idx)
    if operand_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    if operand_sem_type == types.NULL_IDX || !try types.is_optional(s.tp, operand_sem_type) {
        s = try add_error(s, illegal_force_unwrap{pos: operand_idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let inner_sem_type = try types.get_optional_inner(s.tp, operand_sem_type)
    s, let inner_ir_type = try lower_semantic_to_ir(s, inner_sem_type)
    s, let result_ir = try generate_force_unwrap(s, operand_ir, inner_ir_type)

    return s, result_ir, inner_sem_type
}

// generate_force_unwrap generates IR for force unwrap operator
// checks if optional has value, panics if null
// result type is inner_type (non-optional)
fn generate_force_unwrap(s *semsis, value_ir ir.index, result_type intern.index)! *semsis, ir.index {
    var s = s
    let func_fqn = s.current_func_fqn

    s, let has_value_fqn = try reserve_block(s, func_fqn)
    s, let panic_fqn = try reserve_block(s, func_fqn)

    s, let is_valid_ptr = try generate_gep(s, value_ir, 0, intern.BOOL_TYPE_IDX)
    s, let is_valid_ir = try generate_load(s, is_valid_ptr, intern.BOOL_TYPE_IDX)

    s = try generate_br(s, is_valid_ir, has_value_fqn, panic_fqn)

    s, let _ = try generate_block(s, panic_fqn)
    s = try generate_panic_string(s, "force unwrap of null optional")
    s.ins = try append(s.ins, ir.inst{
        tag: ir.tag.unreachable,
        x: u32(ir.NULL_IDX),
        y: u32(ir.NULL_IDX)
    })

    s, let _ = try generate_block(s, has_value_fqn)
    s, let value_ptr = try generate_gep(s, value_ir, 1, result_type)
    s, let loaded = try generate_load(s, value_ptr, result_type)

    return s, loaded
}

fn generate_panic_string(s *semsis, message string)! *semsis {
    var s = s

    let str_len = u64(len(message))
    s.ip, let len_const_idx = try intern.make_const_u64(s.ip, str_len)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: len_const_idx, y: intern.U64_TYPE_IDX})
    let len_ir = ir.index(u32(len(s.ins)-1))

    s.ip, let u8_arr_type = try intern.make_array_type(s.ip, intern.U8_TYPE_IDX)
    s.ip, let u8_arr_ptr_type = try intern.make_pointer_type(s.ip, u8_arr_type)
    s.ip, let str_idx = try intern.intern_string(s.ip, message)
    s.ip, let align_const = try intern.make_const_u32(s.ip, 1)
    let extra_start = u32(len(s.extra))
    s.extra = try append(s.extra, u32(str_idx))
    s.extra = try append(s.extra, u32(align_const))
    s.ins = try append(s.ins, ir.inst{
        tag: ir.tag.const_array,
        x: extra_start,
        y: u32(u8_arr_ptr_type)
    })
    let data_ir = ir.index(u32(len(s.ins)-1))

    s, let header_struct_type = try create_string_type(s)
    s, let string_ir = try generate_struct_literal(
        s,
        header_struct_type,
        [len_ir, data_ir],
        [intern.U64_TYPE_IDX, u8_arr_ptr_type]
    )

    let fqn = try make_fqn("dash/internal/runtime", "panic")
    s.ip, let fqn_idx = try intern.intern_string(s.ip, fqn)
    s.ip, let fn_type_idx = try intern.make_function_type(s.ip, fqn_idx)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.extern_ref, x: fqn_idx, y: fn_type_idx})
    let fn_ref = ir.index(u32(len(s.ins)-1))

    s, let _ = try generate_call(s, fn_ref, [string_ir], intern.NULL_IDX)

    return s
}

// verifies whether 'from' can be assigned to 'to'. if from is a constant
// it checks whether 'from' can be coerced to the type of 'to'
// Uses semantic types for proper type distinction (T -> ?T, none -> ?T)
fn rule_is_assignable_to(s *semsis, from ir.index, from_sem_type, to_sem_type types.index, pos ast.index)! *semsis, bool {
    var s = s

    // if two semantic types are equal assignment is valid
    if from_sem_type == to_sem_type {
        return s, true
    }

    let from_is_error = try types.is_error(s.tp, from_sem_type)
    let to_is_error = try types.is_error(s.tp, to_sem_type)
    if from_is_error && to_is_error {
        // T -> T was already checked so 'error' -> 'error' ok and
        // custom error -> same custom error ok
        // this checks:
        // - custom error -> 'error': ok
        // - custom error -> different custom error: not ok
        // - 'error' -> custom error: not ok

        if to_sem_type == types.ERROR_IDX {
            return s, true
        }
        s = try add_error(s, cannot_assign_to_type{
            got: from_sem_type,
            want: to_sem_type,
            pos: pos,
        })
        return s, false
    } else if from_is_error || to_is_error {
        s = try add_error(s, cannot_assign_to_type{
            got: from_sem_type,
            want: to_sem_type,
            pos: pos,
        })
        return s, false
    }

    let from_is_union = try types.is_union(s.tp, from_sem_type)
    let to_is_union = try types.is_union(s.tp, to_sem_type)
    let is_const = try is_const(s, from)
    if from_is_union && to_is_union {
        // union -> union: not allowed (different types, same type caught above)
        s = try add_error(s, illegal_union_to_union{
            pos: pos,
            from: from_sem_type,
            to: to_sem_type,
        })
        return s, false
    } else if from_is_union {
        // union -> T: must use selection T(x) which returns ?T
        s = try add_error(s, illegal_union_extraction{
            pos: pos,
            union_type: from_sem_type,
            member: to_sem_type,
        })
        return s, false
    } else if to_is_union {
        // T -> union: allowed for constants if T is exactly one variant
        if !is_const {
            s = try add_error(s, cannot_assign_to_type{
                got: from_sem_type,
                want: to_sem_type,
                pos: pos,
            })
            return s, false
        }
        // check if constant can be assigned to union. we only allow
        // one match to avoid ambiguity
        let match_count, let _ = try count_union_matches(s, from_sem_type, to_sem_type)
        if match_count == 0 {
            s = try add_error(s, cannot_assign_to_type{
                got: from_sem_type,
                want: to_sem_type,
                pos: pos,
            })
            return s, false
        } else if match_count > 1 {
            s = try add_error(s, ambiguous_union_construction{
                pos: pos,
                from_type: from_sem_type,
                union_type: to_sem_type,
                match_count: match_count,
            })
            return s, false
        }
        return s, true
    }

    let to_is_many = try types.is_many(s.tp, to_sem_type)
    let from_is_many = try types.is_many(s.tp, from_sem_type)
    if from_is_many && to_is_many {
        // many -> many: already handled by equality check above
        return s, true
    } else if from_is_many {
        // many -> T: NOT ALLOWED (must use cast T(many_val) which returns ?T)
        s = try add_error(s, cannot_assign_to_type{
            got: from_sem_type,
            want: to_sem_type,
            pos: pos,
        })
        return s, false
    } else if to_is_many {
        // T -> many: ALLOWED for all types (will wrap with type descriptor)
        return s, true
    }

    // validate pattern T -> ?T, if T is constant we check if coercion possible
    if try types.is_optional(s.tp, to_sem_type) {
        let inner_sem_type = try types.get_optional_inner(s.tp, to_sem_type)
        if from_sem_type == inner_sem_type {
            return s, true
        }
        if is_const && try can_coerce_constant(s, from, from_sem_type, inner_sem_type) {
            return s, true
        }
    }

    if is_const {
        if try can_coerce_constant(s, from, from_sem_type, to_sem_type) {
            return s, true
        }
    }

    s = try add_error(s, cannot_assign_to_type{
        got: from_sem_type,
        want: to_sem_type,
        pos: pos,
    })
    return s, false
}

// rule_infix_operator_valid ensures that the operator used on rhs and lhs
// is valid. Uses semantic types for proper type distinction.
// For type_def types, uses the underlying type for validation.
fn rule_infix_operator_valid(s *semsis, idx ast.index, sem_type types.index)! *semsis, bool {
    var s = s
    let node = try get(s.ast.nodes, idx)

    let effective_type = try get_effective_type_for_operators(s, sem_type)

    match node.tag {
    case ast.tag.add:
        // add supports integer, char and string types
        if (!try types.is_integer(s.tp, effective_type)) &&
           (!try types.is_char(s.tp, effective_type)) &&
           (!try types.is_string(s.tp, effective_type)) {
            s = add_error(s, illegal_operator_use{type_idx: sem_type, pos: idx})
            return s, false
        }
    case ast.tag.sub, ast.tag.mul, ast.tag.div,
        ast.tag.mod, ast.tag.band, ast.tag.bor,
        ast.tag.lsh, ast.tag.rsh,
        ast.tag.xor:
        if (!try types.is_integer(s.tp, effective_type)) &&
           (!try types.is_char(s.tp, effective_type)) {
            s = add_error(s, illegal_operator_use{type_idx: sem_type, pos: idx})
            return s, false
        }
    case ast.tag.lt, ast.tag.gt, ast.tag.lte,
        ast.tag.gte:
        if (!try types.is_integer(s.tp, effective_type)) &&
           (!try types.is_char(s.tp, effective_type)) &&
           (!try types.is_float(s.tp, effective_type)) &&
           (!try types.is_enum(s.tp, effective_type)) {
            s = add_error(s, illegal_operator_use{type_idx: sem_type, pos: idx})
            return s, false
        }
    case ast.tag.lnot, ast.tag.land, ast.tag.lor:
        if !try types.is_bool(s.tp, effective_type) {
            s = add_error(s, illegal_operator_use{type_idx: sem_type, pos: idx})
            return s, false
        }
    case ast.tag.optional_coalesce:
        // optional_coalesce requires optional type
        if !try types.is_optional(s.tp, effective_type) {
            s = add_error(s, illegal_operator_use{type_idx: sem_type, pos: idx})
            return s, false
        }
    case ast.tag.eq, ast.tag.neq:
        // defined for integers, floats, bools, strings, arrays, pointers, optionals,
        // structs, errors, unions, enums, many and generics. Hence all types allowed
    case ast.tag.dot:
        // we ignore as this is validated in analyse_dot_expression
    case _:
        s = add_error(s, invalid_infix_operator{pos: idx})
        return s, false
    }
    return s, true
}

// rule_prefix_operator_valid ensures that the prefix operator used on the operand
// is valid. Uses semantic types for proper type distinction.
// For type_def types, uses the underlying type for validation.
fn rule_prefix_operator_valid(s *semsis, idx ast.index, sem_type types.index)! *semsis, bool {
    var s = s
    let node = try get(s.ast.nodes, idx)

    let effective_type = try get_effective_type_for_operators(s, sem_type)

    match node.tag {
    case ast.tag.bnot:
        if (!try types.is_integer(s.tp, effective_type)) &&
           (!try types.is_char(s.tp, effective_type)) {
            s = add_error(s, illegal_operator_use{type_idx: sem_type, pos: idx})
            return s, false
        }
    case ast.tag.lnot:
        if !try types.is_bool(s.tp, effective_type) {
            s = add_error(s, illegal_operator_use{type_idx: sem_type, pos: idx})
            return s, false
        }
    case ast.tag.negate_num:
        if !try types.is_signed_integer(s.tp, effective_type) && !try types.is_float(s.tp, effective_type) {
            s = add_error(s, illegal_operator_use{type_idx: sem_type, pos: idx})
            return s, false
        }
    case ast.tag.address_of:
        if try types.is_pointer(s.tp, effective_type) {
            s = add_error(s, illegal_operator_use{type_idx: sem_type, pos: idx})
            return s, false
        }
    case ast.tag.value_of:
        if !try types.is_pointer(s.tp, effective_type) {
            s = add_error(s, illegal_operator_use{type_idx: sem_type, pos: idx})
            return s, false
        }
    case ast.tag.readonly_expr:
        let is_lin = try types.is_linear(s.tp, effective_type)
        if !is_lin {
            s = add_error(s, readonly_non_linear{type_idx: sem_type, pos: idx})
            return s, false
        }
    case _:
        s = add_error(s, invalid_prefix_operator{pos: idx})
        return s, false
    }
    return s, true
}

fn generate_infix(s *semsis, idx ast.index, lhs_idx, rhs_idx ir.index)! *semsis, ir.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let ir_tag = match node.tag {
        case ast.tag.add: ir.tag.add
        case ast.tag.sub: ir.tag.sub
        case ast.tag.mul: ir.tag.mul
        case ast.tag.div: ir.tag.div
        case ast.tag.mod: ir.tag.mod
        case ast.tag.band: ir.tag.band
        case ast.tag.bor: ir.tag.bor
        case ast.tag.xor: ir.tag.xor
        case ast.tag.lsh: ir.tag.lsh
        case ast.tag.rsh: ir.tag.rsh
        case ast.tag.eq: ir.tag.eq
        case ast.tag.neq: ir.tag.neq
        case ast.tag.lt: ir.tag.lt
        case ast.tag.gt: ir.tag.gt
        case ast.tag.lte: ir.tag.lte
        case ast.tag.gte: ir.tag.gte
        case ast.tag.land: ir.tag.land
        case ast.tag.lor: ir.tag.lor
        case _:
            s = add_error(s, compiler_error{rsn: "invalid infix should have been caught", pos: idx})
            return s, ir.NULL_IDX
    }

    s.ins = try append(s.ins, ir.inst{tag: ir_tag, x: lhs_idx, y: rhs_idx})
    let result_idx = ir.index(u32(len(s.ins)-1))

    return s, result_idx
}

fn generate_infix_string(s *semsis, idx ast.index, lhs_idx, rhs_idx ir.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)

    match node.tag {
    case ast.tag.add:
        s, let result_ir = try generate_strings_concat(s, lhs_idx, rhs_idx)
        return s, result_ir, types.STRING_IDX
    case ast.tag.eq:
        s, let result_ir = try generate_strings_equal(s, lhs_idx, rhs_idx)
        return s, result_ir, types.BOOL_IDX
    case ast.tag.neq:
        s, let eq_idx = try generate_strings_equal(s, lhs_idx, rhs_idx)
        s.ins = try append(s.ins, ir.inst{tag: ir.tag.lnot, x: eq_idx, y: intern.BOOL_TYPE_IDX})
        return s, ir.index(u32(len(s.ins)-1)), types.BOOL_IDX
    case _:
        s = add_error(s, compiler_error{rsn: "invalid string infix operator", pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }
}

fn analyse_builtin_panic(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let args_idx = node.data.y

    if args_idx == ast.NULL_IDX {
        s = try add_error(s, too_few_arguments{expected: 1, found: 0, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let args_node = try get(s.ast.nodes, args_idx)
    let args_data = args_node.data
    let arg_count = u16(args_data.y - args_data.x)

    if arg_count > 1 {
        s = try add_error(s, too_many_arguments{expected: 1, found: arg_count, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    if arg_count < 1 {
        s = try add_error(s, too_few_arguments{expected: 1, found: 0, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let arg_ast_idx = try get(s.ast.extras, args_data.x)
    s, let arg_ir, let arg_sem_type = try analyse_expression(s, arg_ast_idx)
    if arg_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, let ok = try rule_is_assignable_to(s, arg_ir, arg_sem_type, types.STRING_IDX, arg_ast_idx)
    if !ok {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let fqn = try make_fqn("dash/internal/runtime", "panic")
    s.ip, let fqn_idx = try intern.intern_string(s.ip, fqn)
    s.ip, let fn_type_idx = try intern.make_function_type(s.ip, fqn_idx)

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.extern_ref, x: fqn_idx, y: fn_type_idx})
    let fn_ref = ir.index(u32(len(s.ins)-1))

    s, let call_ir = try generate_call(s, fn_ref, [arg_ir], intern.NULL_IDX)

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.unreachable, x: u32(ir.NULL_IDX), y: u32(ir.NULL_IDX)})

    return s, ir.NULL_IDX, types.NULL_IDX
}

fn analyse_builtin_len(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let args_idx = node.data.y

    if args_idx == ast.NULL_IDX {
        s = try add_error(s, too_few_arguments{expected: 1, found: 0, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let args_node = try get(s.ast.nodes, args_idx)
    let args_data = args_node.data
    let arg_count = u16(args_data.y - args_data.x)

    if arg_count > 1 {
        s = try add_error(s, too_many_arguments{expected: 1, found: arg_count, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    if arg_count < 1 {
        s = try add_error(s, too_few_arguments{expected: 1, found: 0, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let arg_ast_idx = try get(s.ast.extras, args_data.x)
    s, let arg_ir, let arg_sem_type = try analyse_expression(s, arg_ast_idx)
    if arg_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let is_array = try types.is_array(s.tp, arg_sem_type)
    let is_string = try types.is_string(s.tp, arg_sem_type)

    if !is_array && !is_string {
        s = try add_error(s, type_mismatch{got: arg_sem_type, want: types.NULL_IDX, pos: arg_ast_idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    // arrays and strings are both lowered to [u64, *[]T] -- field 0 is length
    s, let len_ptr = try generate_gep(s, arg_ir, 0, intern.U64_TYPE_IDX)
    s, let len_u64 = try generate_load(s, len_ptr, intern.U64_TYPE_IDX)
    s, let len_val = try generate_cast(s, len_u64, intern.I64_TYPE_IDX)
    return s, len_val, types.I64_IDX
}

fn analyse_builtin_get(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let args_idx = node.data.y

    if args_idx == ast.NULL_IDX {
        s = try add_error(s, too_few_arguments{expected: 2, found: 0, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let args_node = try get(s.ast.nodes, args_idx)
    let args_data = args_node.data
    let arg_count = u16(args_data.y - args_data.x)

    if arg_count > 2 {
        s = try add_error(s, too_many_arguments{expected: 2, found: arg_count, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    if arg_count < 2 {
        s = try add_error(s, too_few_arguments{expected: 2, found: arg_count, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }


    let arr_ast_idx = try get(s.ast.extras, args_data.x)
    s, let arr_ir, let arr_sem_type = try analyse_expression(s, arr_ast_idx)
    if arr_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    // unwrap memory if needed
    var actual_arr_sem_type = arr_sem_type
    if try types.is_memory(s.tp, arr_sem_type) {
        actual_arr_sem_type = try types.get_memory_inner(s.tp, arr_sem_type)
    }

    let is_array = try types.is_array(s.tp, actual_arr_sem_type)
    let is_string = try types.is_string(s.tp, actual_arr_sem_type)

    if !is_array && !is_string {
        s = try add_error(s, type_mismatch{got: arr_sem_type, want: types.NULL_IDX, pos: arr_ast_idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    // determine element semantic type and IR type
    var elem_sem_type = types.U8_IDX
    if is_array {
        elem_sem_type = try types.get_array_inner(s.tp, actual_arr_sem_type)
    }
    s, let elem_ir_type = try lower_semantic_to_ir(s, elem_sem_type)


    let idx_ast_idx = try get(s.ast.extras, args_data.x + 1)
    s, let idx_ir, let idx_sem_type = try analyse_expression(s, idx_ast_idx)
    if idx_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    // validate index is assignable to i64
    s, let idx_ok = try rule_is_assignable_to(s, idx_ir, idx_sem_type, types.I64_IDX, idx_ast_idx)
    if !idx_ok {
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    s, var coerced_idx = try apply_type_conversion(s, idx_ir, idx_sem_type, types.I64_IDX)

    // build augmented return type: [elem_type, u32(err_desc), slot[u64](err_data)]
    s.ip, let slot_type = try intern.make_slot_type(s.ip, intern.U64_TYPE_IDX)
    let aug_field_types = [elem_ir_type, intern.U32_TYPE_IDX, slot_type]
    s.ip, let _ = try intern.make_return_type(s.ip, aug_field_types)

    // alloca for the result struct (before the branch so both paths can write to it)
    s.ip, let aug_struct_type = try intern.make_anon_struct_type(s.ip, aug_field_types)
    s, let result_alloca = try generate_alloca(s, aug_struct_type)


    s, let len_ptr = try generate_gep(s, arr_ir, 0, intern.U64_TYPE_IDX)
    s, let len_val = try generate_load(s, len_ptr, intern.U64_TYPE_IDX)

    // normalise negative index: select(idx < 0, idx + i64(len), idx)
    s.ip, let zero_i64_const = try intern.make_const_u64(s.ip, 0)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: zero_i64_const, y: intern.I64_TYPE_IDX})
    let zero_i64_ir = ir.index(u32(len(s.ins) - 1))

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.lt, x: u32(coerced_idx), y: u32(zero_i64_ir)})
    let is_neg = ir.index(u32(len(s.ins) - 1))

    s, let len_as_i64 = try generate_cast(s, len_val, intern.I64_TYPE_IDX)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.add, x: u32(coerced_idx), y: u32(len_as_i64)})
    let normalised = ir.index(u32(len(s.ins) - 1))

    s, let final_idx = try generate_select(s, is_neg, normalised, coerced_idx)

    // cast normalised index to u64 for unsigned bounds check
    s, let idx_u64 = try generate_cast(s, final_idx, intern.U64_TYPE_IDX)

    // bounds check: u64(idx) >= len means out of bounds
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.gte, x: u32(idx_u64), y: u32(len_val)})
    let oob_cond = ir.index(u32(len(s.ins) - 1))

    // branch: oob -> fail, in-bounds -> ok
    s, let ok_fqn = try reserve_block(s, s.current_func_fqn)
    s, let fail_fqn = try reserve_block(s, s.current_func_fqn)
    s, let merge_fqn = try reserve_block(s, s.current_func_fqn)
    s = try generate_br(s, oob_cond, fail_fqn, ok_fqn)


    s, let _ = try generate_block(s, fail_fqn)

    s, let poison_val = try generate_poison(s, elem_ir_type)
    s, let fail_elem_ptr = try generate_gep(s, result_alloca, 0, elem_ir_type)
    s, let _ = try generate_store(s, fail_elem_ptr, poison_val)

    let err_fqn = try make_fqn("dash/internal/runtime", "index_out_of_bounds")
    s.ip, let err_fqn_idx = try intern.intern_string(s.ip, err_fqn)
    s.tp, let err_type_idx = try types.make_error(s.tp, err_fqn_idx)
    s.ip, let err_desc_const = try intern.make_const_u32(s.ip, u32(err_type_idx))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: err_desc_const, y: intern.U32_TYPE_IDX})
    let err_desc_ir = ir.index(u32(len(s.ins)-1))
    s, let fail_desc_ptr = try generate_gep(s, result_alloca, 1, intern.U32_TYPE_IDX)
    s, let _ = try generate_store(s, fail_desc_ptr, err_desc_ir)

    s, let poison_slot = try generate_poison(s, slot_type)
    s, let fail_data_ptr = try generate_gep(s, result_alloca, 2, slot_type)
    s, let _ = try generate_store(s, fail_data_ptr, poison_slot)

    s = try generate_jmp(s, merge_fqn)


    s, let _ = try generate_block(s, ok_fqn)


    s.ip, let data_arr_type = try intern.make_array_type(s.ip, elem_ir_type)
    s.ip, let data_ptr_type = try intern.make_pointer_type(s.ip, data_arr_type)
    s, let data_ptr_field = try generate_gep(s, arr_ir, 1, data_ptr_type)
    s, let data_ptr = try generate_load(s, data_ptr_field, data_ptr_type)

    // GEP into data array at index + load element
    s, let elem_ptr = try generate_gep_dynamic(s, data_ptr, idx_u64, elem_ir_type)
    s, let elem_val = try generate_load(s, elem_ptr, elem_ir_type)


    s, let ok_elem_ptr = try generate_gep(s, result_alloca, 0, elem_ir_type)
    s, let _ = try generate_store(s, ok_elem_ptr, elem_val)


    s.ip, let zero_const = try intern.make_const_u32(s.ip, 0)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: zero_const, y: intern.U32_TYPE_IDX})
    let zero_ir = ir.index(u32(len(s.ins)-1))
    s, let ok_desc_ptr = try generate_gep(s, result_alloca, 1, intern.U32_TYPE_IDX)
    s, let _ = try generate_store(s, ok_desc_ptr, zero_ir)

    // poison for error data (success path)
    s, let ok_poison_slot = try generate_poison(s, slot_type)
    s, let ok_data_ptr = try generate_gep(s, result_alloca, 2, slot_type)
    s, let _ = try generate_store(s, ok_data_ptr, ok_poison_slot)

    s = try generate_jmp(s, merge_fqn)

    // merge block: result_alloca has the right data
    s, let _ = try generate_block(s, merge_fqn)

    return s, result_alloca, elem_sem_type
}

fn analyse_builtin_slice(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let args_idx = node.data.y

    if args_idx == ast.NULL_IDX {
        s = try add_error(s, too_few_arguments{expected: 3, found: 0, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let args_node = try get(s.ast.nodes, args_idx)
    let args_data = args_node.data
    let arg_count = u16(args_data.y - args_data.x)

    if arg_count > 3 {
        s = try add_error(s, too_many_arguments{expected: 3, found: arg_count, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    if arg_count < 3 {
        s = try add_error(s, too_few_arguments{expected: 3, found: arg_count, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let arr_ast_idx = try get(s.ast.extras, args_data.x)
    s, let arr_ir, let arr_sem_type = try analyse_expression(s, arr_ast_idx)
    if arr_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    var actual_arr_sem_type = arr_sem_type
    if try types.is_memory(s.tp, arr_sem_type) {
        actual_arr_sem_type = try types.get_memory_inner(s.tp, arr_sem_type)
    }

    let is_array = try types.is_array(s.tp, actual_arr_sem_type)
    let is_string = try types.is_string(s.tp, actual_arr_sem_type)

    if !is_array && !is_string {
        s = try add_error(s, type_mismatch{got: arr_sem_type, want: types.NULL_IDX, pos: arr_ast_idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    var elem_sem_type = types.U8_IDX
    if is_array {
        elem_sem_type = try types.get_array_inner(s.tp, actual_arr_sem_type)
    }
    s, let elem_ir_type = try lower_semantic_to_ir(s, elem_sem_type)

    let start_ast_idx = try get(s.ast.extras, args_data.x + 1)
    s, let start_ir, let start_sem_type = try analyse_expression(s, start_ast_idx)
    if start_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    s, let start_ok = try rule_is_assignable_to(s, start_ir, start_sem_type, types.I64_IDX, start_ast_idx)
    if !start_ok {
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    s, let coerced_start = try apply_type_conversion(s, start_ir, start_sem_type, types.I64_IDX)

    let end_ast_idx = try get(s.ast.extras, args_data.x + 2)
    s, let end_ir, let end_sem_type = try analyse_expression(s, end_ast_idx)
    if end_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    s, let end_ok = try rule_is_assignable_to(s, end_ir, end_sem_type, types.I64_IDX, end_ast_idx)
    if !end_ok {
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    s, let coerced_end = try apply_type_conversion(s, end_ir, end_sem_type, types.I64_IDX)

    s, let len_ptr = try generate_gep(s, arr_ir, 0, intern.U64_TYPE_IDX)
    s, let len_val = try generate_load(s, len_ptr, intern.U64_TYPE_IDX)

    // normalise negative start: select(start < 0, start + i64(len), start)
    s.ip, let zero_start_const = try intern.make_const_u64(s.ip, 0)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: zero_start_const, y: intern.I64_TYPE_IDX})
    let zero_start_ir = ir.index(u32(len(s.ins) - 1))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.lt, x: u32(coerced_start), y: u32(zero_start_ir)})
    let start_is_neg = ir.index(u32(len(s.ins) - 1))
    s, let len_as_i64_for_start = try generate_cast(s, len_val, intern.I64_TYPE_IDX)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.add, x: u32(coerced_start), y: u32(len_as_i64_for_start)})
    let start_normalised = ir.index(u32(len(s.ins) - 1))
    s, let final_start = try generate_select(s, start_is_neg, start_normalised, coerced_start)

    // normalise negative end: select(end < 0, end + i64(len), end)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.lt, x: u32(coerced_end), y: u32(zero_start_ir)})
    let end_is_neg = ir.index(u32(len(s.ins) - 1))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.add, x: u32(coerced_end), y: u32(len_as_i64_for_start)})
    let end_normalised = ir.index(u32(len(s.ins) - 1))
    s, let final_end = try generate_select(s, end_is_neg, end_normalised, coerced_end)

    s, let start_u64 = try generate_cast(s, final_start, intern.U64_TYPE_IDX)
    s, let end_u64 = try generate_cast(s, final_end, intern.U64_TYPE_IDX)

    // bounds check: end > len || start > end
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.gt, x: u32(end_u64), y: u32(len_val)})
    let end_oob = ir.index(u32(len(s.ins) - 1))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.gt, x: u32(start_u64), y: u32(end_u64)})
    let start_oob = ir.index(u32(len(s.ins) - 1))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.lor, x: u32(end_oob), y: u32(start_oob)})
    let oob_cond = ir.index(u32(len(s.ins) - 1))

    s, let arr_ir_type = try lower_semantic_to_ir(s, actual_arr_sem_type)
    s.ip, let slot_type = try intern.make_slot_type(s.ip, intern.U64_TYPE_IDX)
    s.ip, let ret_struct_type = try intern.make_anon_struct_type(s.ip, [arr_ir_type, intern.U32_TYPE_IDX, slot_type])
    s, let result_alloca = try generate_alloca(s, ret_struct_type)

    let func_fqn = s.current_func_fqn
    s, let ok_fqn = try reserve_block(s, func_fqn)
    s, let err_fqn = try reserve_block(s, func_fqn)
    s, let cont_fqn = try reserve_block(s, func_fqn)
    s = try generate_br(s, oob_cond, err_fqn, ok_fqn)

    // error block: raise runtime.index_out_of_bounds
    s, let _ = try generate_block(s, err_fqn)
    s, let poison_arr = try generate_poison(s, arr_ir_type)
    s, let err_elem_ptr = try generate_gep(s, result_alloca, 0, arr_ir_type)
    s, let _ = try generate_store(s, err_elem_ptr, poison_arr)

    let oob_err_fqn = try make_fqn("dash/internal/runtime", "index_out_of_bounds")
    s.ip, let oob_err_fqn_idx = try intern.intern_string(s.ip, oob_err_fqn)
    s.tp, let oob_err_type_idx = try types.make_error(s.tp, oob_err_fqn_idx)
    s.ip, let err_desc_const = try intern.make_const_u32(s.ip, u32(oob_err_type_idx))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: err_desc_const, y: intern.U32_TYPE_IDX})
    let err_desc_ir = ir.index(u32(len(s.ins) - 1))
    s, let err_desc_ptr = try generate_gep(s, result_alloca, 1, intern.U32_TYPE_IDX)
    s, let _ = try generate_store(s, err_desc_ptr, err_desc_ir)

    s, let err_data_poison = try generate_poison(s, slot_type)
    s, let err_data_ptr = try generate_gep(s, result_alloca, 2, slot_type)
    s, let _ = try generate_store(s, err_data_ptr, err_data_poison)
    s = try generate_jmp(s, cont_fqn)


    s, let _ = try generate_block(s, ok_fqn)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.sub, x: u32(end_u64), y: u32(start_u64)})
    let new_len = ir.index(u32(len(s.ins) - 1))

    s.ip, let data_arr_type = try intern.make_array_type(s.ip, elem_ir_type)
    s.ip, let data_ptr_type = try intern.make_pointer_type(s.ip, data_arr_type)
    s, let data_ptr_ptr = try generate_gep(s, arr_ir, 1, data_ptr_type)
    s, let data_ptr = try generate_load(s, data_ptr_ptr, data_ptr_type)

    s, let offset_ptr = try generate_gep_dynamic(s, data_ptr, start_u64, elem_ir_type)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: u32(offset_ptr), y: data_ptr_type})
    let offset_data_ptr = ir.index(u32(len(s.ins) - 1))

    s, let new_header = try generate_alloca(s, arr_ir_type)
    s, let new_len_ptr = try generate_gep(s, new_header, 0, intern.U64_TYPE_IDX)
    s, let _ = try generate_store(s, new_len_ptr, new_len)
    s, let new_data_ptr = try generate_gep(s, new_header, 1, data_ptr_type)
    s, let _ = try generate_store(s, new_data_ptr, offset_data_ptr)

    s, let ok_val_ptr = try generate_gep(s, result_alloca, 0, arr_ir_type)
    s, let _ = try generate_store(s, ok_val_ptr, new_header)

    s.ip, let zero_desc_const = try intern.make_const_u32(s.ip, 0)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: zero_desc_const, y: intern.U32_TYPE_IDX})
    let zero_desc_ir = ir.index(u32(len(s.ins) - 1))
    s, let ok_desc_ptr = try generate_gep(s, result_alloca, 1, intern.U32_TYPE_IDX)
    s, let _ = try generate_store(s, ok_desc_ptr, zero_desc_ir)

    s, let ok_data_poison = try generate_poison(s, slot_type)
    s, let ok_data_ptr = try generate_gep(s, result_alloca, 2, slot_type)
    s, let _ = try generate_store(s, ok_data_ptr, ok_data_poison)
    s = try generate_jmp(s, cont_fqn)

    // continuation block
    s, let _ = try generate_block(s, cont_fqn)

    return s, result_alloca, actual_arr_sem_type
}

fn analyse_builtin_put(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let args_idx = node.data.y

    if args_idx == ast.NULL_IDX {
        s = try add_error(s, too_few_arguments{expected: 3, found: 0, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let args_node = try get(s.ast.nodes, args_idx)
    let args_data = args_node.data
    let arg_count = u16(args_data.y - args_data.x)

    if arg_count > 3 {
        s = try add_error(s, too_many_arguments{expected: 3, found: arg_count, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    if arg_count < 3 {
        s = try add_error(s, too_few_arguments{expected: 3, found: arg_count, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }


    let arr_ast_idx = try get(s.ast.extras, args_data.x)
    s, let arr_ir, let arr_sem_type = try analyse_expression(s, arr_ast_idx)
    if arr_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    var actual_arr_sem_type = arr_sem_type
    if try types.is_memory(s.tp, arr_sem_type) {
        actual_arr_sem_type = try types.get_memory_inner(s.tp, arr_sem_type)
    }

    let is_array = try types.is_array(s.tp, actual_arr_sem_type)
    if !is_array {
        s = try add_error(s, type_mismatch{got: arr_sem_type, want: types.NULL_IDX, pos: arr_ast_idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let elem_sem_type = try types.get_array_inner(s.tp, actual_arr_sem_type)
    s, let elem_ir_type = try lower_semantic_to_ir(s, elem_sem_type)


    let idx_ast_idx = try get(s.ast.extras, args_data.x + 1)
    s, let idx_ir, let idx_sem_type = try analyse_expression(s, idx_ast_idx)
    if idx_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, let idx_ok = try rule_is_assignable_to(s, idx_ir, idx_sem_type, types.I64_IDX, idx_ast_idx)
    if !idx_ok {
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    s, var coerced_idx = try apply_type_conversion(s, idx_ir, idx_sem_type, types.I64_IDX)


    let val_ast_idx = try get(s.ast.extras, args_data.x + 2)
    s, let val_ir, let val_sem_type = try analyse_expression(s, val_ast_idx)
    if val_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, let val_ok = try rule_is_assignable_to(s, val_ir, val_sem_type, elem_sem_type, val_ast_idx)
    if !val_ok {
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    s, let coerced_val = try apply_type_conversion(s, val_ir, val_sem_type, elem_sem_type)

    // build augmented return type: [arr_type, u32(err_desc), slot[u64](err_data)]
    s, let arr_ir_type = try lower_semantic_to_ir(s, actual_arr_sem_type)
    s.ip, let slot_type = try intern.make_slot_type(s.ip, intern.U64_TYPE_IDX)
    let aug_field_types = [arr_ir_type, intern.U32_TYPE_IDX, slot_type]
    s.ip, let _ = try intern.make_return_type(s.ip, aug_field_types)

    s.ip, let aug_struct_type = try intern.make_anon_struct_type(s.ip, aug_field_types)
    s, let result_alloca = try generate_alloca(s, aug_struct_type)


    s, let len_ptr = try generate_gep(s, arr_ir, 0, intern.U64_TYPE_IDX)
    s, let len_val = try generate_load(s, len_ptr, intern.U64_TYPE_IDX)

    // normalise negative index: select(idx < 0, idx + i64(len), idx)
    s.ip, let zero_i64_const = try intern.make_const_u64(s.ip, 0)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: zero_i64_const, y: intern.I64_TYPE_IDX})
    let zero_i64_ir = ir.index(u32(len(s.ins) - 1))

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.lt, x: u32(coerced_idx), y: u32(zero_i64_ir)})
    let is_neg = ir.index(u32(len(s.ins) - 1))

    s, let len_as_i64 = try generate_cast(s, len_val, intern.I64_TYPE_IDX)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.add, x: u32(coerced_idx), y: u32(len_as_i64)})
    let normalised = ir.index(u32(len(s.ins) - 1))

    s, let final_idx = try generate_select(s, is_neg, normalised, coerced_idx)

    // cast normalised index to u64 for unsigned bounds check
    s, let idx_u64 = try generate_cast(s, final_idx, intern.U64_TYPE_IDX)

    // bounds check: u64(idx) >= len means out of bounds
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.gte, x: u32(idx_u64), y: u32(len_val)})
    let oob_cond = ir.index(u32(len(s.ins) - 1))

    // branch: oob -> fail, in-bounds -> ok
    let func_fqn = s.current_func_fqn
    s, let ok_fqn = try reserve_block(s, func_fqn)
    s, let fail_fqn = try reserve_block(s, func_fqn)
    s, let cont_fqn = try reserve_block(s, func_fqn)
    s = try generate_br(s, oob_cond, fail_fqn, ok_fqn)


    s, let _ = try generate_block(s, fail_fqn)

    s, let poison_arr = try generate_poison(s, arr_ir_type)
    s, let fail_elem_ptr = try generate_gep(s, result_alloca, 0, arr_ir_type)
    s, let _ = try generate_store(s, fail_elem_ptr, poison_arr)

    let err_fqn = try make_fqn("dash/internal/runtime", "index_out_of_bounds")
    s.ip, let err_fqn_idx = try intern.intern_string(s.ip, err_fqn)
    s.tp, let err_type_idx = try types.make_error(s.tp, err_fqn_idx)
    s.ip, let err_desc_const = try intern.make_const_u32(s.ip, u32(err_type_idx))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: err_desc_const, y: intern.U32_TYPE_IDX})
    let err_desc_ir = ir.index(u32(len(s.ins) - 1))
    s, let fail_desc_ptr = try generate_gep(s, result_alloca, 1, intern.U32_TYPE_IDX)
    s, let _ = try generate_store(s, fail_desc_ptr, err_desc_ir)

    s, let err_data_poison = try generate_poison(s, slot_type)
    s, let fail_data_ptr = try generate_gep(s, result_alloca, 2, slot_type)
    s, let _ = try generate_store(s, fail_data_ptr, err_data_poison)
    s = try generate_jmp(s, cont_fqn)


    s, let _ = try generate_block(s, ok_fqn)

    // compute elem_size as compile-time constant
    s, let elem_byte_size = try compute_type_byte_size(s, elem_sem_type)
    s.ip, let elem_size_const = try intern.make_const_u64(s.ip, elem_byte_size)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: elem_size_const, y: intern.U64_TYPE_IDX})
    let elem_size_ir = ir.index(u32(len(s.ins) - 1))

    // malloc(elem_size, len) -> *u8
    let malloc_fqn = try make_fqn("dash/internal/runtime", "malloc")
    s.ip, let malloc_fqn_idx = try intern.intern_string(s.ip, malloc_fqn)
    s.ip, let malloc_fn_type = try intern.make_function_error_type(s.ip, malloc_fqn_idx)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.extern_ref, x: malloc_fqn_idx, y: malloc_fn_type})
    let malloc_ref = ir.index(u32(len(s.ins) - 1))

    s.ip, let u8_ptr_type = try intern.make_pointer_type(s.ip, intern.U8_TYPE_IDX)
    s, let malloc_result = try generate_call(s, malloc_ref, [elem_size_ir, len_val], u8_ptr_type)

    s = try generate_malloc_null_check(s, malloc_result, result_alloca, arr_ir_type, slot_type, cont_fqn)



    // mcopy(new_ptr, old_data_ptr, len * elem_size)
    s.ip, let data_arr_type = try intern.make_array_type(s.ip, elem_ir_type)
    s.ip, let data_ptr_type = try intern.make_pointer_type(s.ip, data_arr_type)
    s, let old_data_ptr_ptr = try generate_gep(s, arr_ir, 1, data_ptr_type)
    s, let old_data_ptr = try generate_load(s, old_data_ptr_ptr, data_ptr_type)

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.mul, x: u32(len_val), y: u32(elem_size_ir)})
    let byte_count = ir.index(u32(len(s.ins) - 1))

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: u32(old_data_ptr), y: u8_ptr_type})
    let old_as_u8 = ir.index(u32(len(s.ins) - 1))

    let mcopy_fqn = try make_fqn("dash/internal/runtime", "mcopy")
    s.ip, let mcopy_fqn_idx = try intern.intern_string(s.ip, mcopy_fqn)
    s.ip, let mcopy_fn_type = try intern.make_function_type(s.ip, mcopy_fqn_idx)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.extern_ref, x: mcopy_fqn_idx, y: mcopy_fn_type})
    let mcopy_ref = ir.index(u32(len(s.ins) - 1))

    s, let _ = try generate_call(s, mcopy_ref, [malloc_result, old_as_u8, byte_count], intern.NULL_IDX)


    s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: u32(malloc_result), y: data_ptr_type})
    let new_data_ptr = ir.index(u32(len(s.ins) - 1))

    s, let elem_ptr = try generate_gep_dynamic(s, new_data_ptr, idx_u64, elem_ir_type)
    s, let _ = try generate_store(s, elem_ptr, coerced_val)


    s, let new_header = try generate_alloca(s, arr_ir_type)
    s, let new_len_ptr = try generate_gep(s, new_header, 0, intern.U64_TYPE_IDX)
    s, let _ = try generate_store(s, new_len_ptr, len_val)
    s, let new_data_field = try generate_gep(s, new_header, 1, data_ptr_type)
    s, let _ = try generate_store(s, new_data_field, new_data_ptr)


    s, let ok_val_ptr = try generate_gep(s, result_alloca, 0, arr_ir_type)
    s, let _ = try generate_store(s, ok_val_ptr, new_header)


    s.ip, let zero_desc_const = try intern.make_const_u32(s.ip, 0)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: zero_desc_const, y: intern.U32_TYPE_IDX})
    let zero_desc_ir = ir.index(u32(len(s.ins) - 1))
    s, let ok_desc_ptr = try generate_gep(s, result_alloca, 1, intern.U32_TYPE_IDX)
    s, let _ = try generate_store(s, ok_desc_ptr, zero_desc_ir)

    // poison for error data (success path)
    s, let ok_data_poison = try generate_poison(s, slot_type)
    s, let ok_data_ptr = try generate_gep(s, result_alloca, 2, slot_type)
    s, let _ = try generate_store(s, ok_data_ptr, ok_data_poison)
    s = try generate_jmp(s, cont_fqn)

    // continuation block
    s, let _ = try generate_block(s, cont_fqn)

    return s, result_alloca, actual_arr_sem_type
}

fn analyse_builtin_append(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let args_idx = node.data.y

    if args_idx == ast.NULL_IDX {
        s = try add_error(s, too_few_arguments{expected: 2, found: 0, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let args_node = try get(s.ast.nodes, args_idx)
    let args_data = args_node.data
    let arg_count = u16(args_data.y - args_data.x)

    if arg_count > 2 {
        s = try add_error(s, too_many_arguments{expected: 2, found: arg_count, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    if arg_count < 2 {
        s = try add_error(s, too_few_arguments{expected: 2, found: arg_count, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }


    let arr_ast_idx = try get(s.ast.extras, args_data.x)
    s, let arr_ir, let arr_sem_type = try analyse_expression(s, arr_ast_idx)
    if arr_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    var actual_arr_sem_type = arr_sem_type
    if try types.is_memory(s.tp, arr_sem_type) {
        actual_arr_sem_type = try types.get_memory_inner(s.tp, arr_sem_type)
    }

    let is_array = try types.is_array(s.tp, actual_arr_sem_type)
    if !is_array {
        s = try add_error(s, type_mismatch{got: arr_sem_type, want: types.NULL_IDX, pos: arr_ast_idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let elem_sem_type = try types.get_array_inner(s.tp, actual_arr_sem_type)
    s, let elem_ir_type = try lower_semantic_to_ir(s, elem_sem_type)


    let rhs_ast_idx = try get(s.ast.extras, args_data.x + 1)
    s, let rhs_ir, let rhs_sem_type = try analyse_expression(s, rhs_ast_idx)
    if rhs_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    var actual_rhs_sem_type = rhs_sem_type
    if try types.is_memory(s.tp, rhs_sem_type) {
        actual_rhs_sem_type = try types.get_memory_inner(s.tp, rhs_sem_type)
    }

    let rhs_is_array = try types.is_array(s.tp, actual_rhs_sem_type)

    if rhs_is_array {
        let rhs_elem_sem = try types.get_array_inner(s.tp, actual_rhs_sem_type)
        if rhs_elem_sem != elem_sem_type {
            s = try add_error(s, type_mismatch{got: rhs_sem_type, want: actual_arr_sem_type, pos: rhs_ast_idx})
            return s, ir.NULL_IDX, types.NULL_IDX
        }
        return try generate_append_array(s, arr_ir, rhs_ir, actual_arr_sem_type, elem_sem_type, elem_ir_type)
    }

    s, let ok = try rule_is_assignable_to(s, rhs_ir, rhs_sem_type, elem_sem_type, rhs_ast_idx)
    if !ok {
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    return try generate_append_elem(s, arr_ir, rhs_ir, actual_arr_sem_type, elem_sem_type, elem_ir_type)
}

fn generate_append_elem(s *semsis, arr_ir ir.index, val_ir ir.index, actual_arr_sem_type types.index, elem_sem_type types.index, elem_ir_type intern.index)! *semsis, ir.index, types.index {
    var s = s

    s, let arr_ir_type = try lower_semantic_to_ir(s, actual_arr_sem_type)
    s.ip, let slot_type = try intern.make_slot_type(s.ip, intern.U64_TYPE_IDX)
    let aug_field_types = [arr_ir_type, intern.U32_TYPE_IDX, slot_type]
    s.ip, let _ = try intern.make_return_type(s.ip, aug_field_types)

    s.ip, let aug_struct_type = try intern.make_anon_struct_type(s.ip, aug_field_types)
    s, let result_alloca = try generate_alloca(s, aug_struct_type)


    s, let len_ptr = try generate_gep(s, arr_ir, 0, intern.U64_TYPE_IDX)
    s, let len_val = try generate_load(s, len_ptr, intern.U64_TYPE_IDX)

    // new_len = arr_len + 1
    s.ip, let one_const = try intern.make_const_u64(s.ip, 1)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: one_const, y: intern.U64_TYPE_IDX})
    let one_ir = ir.index(u32(len(s.ins) - 1))

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.add, x: u32(len_val), y: u32(one_ir)})
    let new_len = ir.index(u32(len(s.ins) - 1))


    s, let elem_byte_size = try compute_type_byte_size(s, elem_sem_type)
    s.ip, let elem_size_const = try intern.make_const_u64(s.ip, elem_byte_size)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: elem_size_const, y: intern.U64_TYPE_IDX})
    let elem_size_ir = ir.index(u32(len(s.ins) - 1))

    // malloc(elem_size, new_len)
    let malloc_fqn = try make_fqn("dash/internal/runtime", "malloc")
    s.ip, let malloc_fqn_idx = try intern.intern_string(s.ip, malloc_fqn)
    s.ip, let malloc_fn_type = try intern.make_function_error_type(s.ip, malloc_fqn_idx)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.extern_ref, x: malloc_fqn_idx, y: malloc_fn_type})
    let malloc_ref = ir.index(u32(len(s.ins) - 1))

    s.ip, let u8_ptr_type = try intern.make_pointer_type(s.ip, intern.U8_TYPE_IDX)
    s, let malloc_result = try generate_call(s, malloc_ref, [elem_size_ir, new_len], u8_ptr_type)

    s, let merge_fqn = try reserve_block(s, s.current_func_fqn)
    s = try generate_malloc_null_check(s, malloc_result, result_alloca, arr_ir_type, slot_type, merge_fqn)



    // mcopy(new_ptr, old_data_ptr, arr_len * elem_size)
    s.ip, let data_arr_type = try intern.make_array_type(s.ip, elem_ir_type)
    s.ip, let data_ptr_type = try intern.make_pointer_type(s.ip, data_arr_type)
    s, let old_data_ptr_ptr = try generate_gep(s, arr_ir, 1, data_ptr_type)
    s, let old_data_ptr = try generate_load(s, old_data_ptr_ptr, data_ptr_type)

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.mul, x: u32(len_val), y: u32(elem_size_ir)})
    let byte_count = ir.index(u32(len(s.ins) - 1))

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: u32(old_data_ptr), y: u8_ptr_type})
    let old_as_u8 = ir.index(u32(len(s.ins) - 1))

    let mcopy_fqn = try make_fqn("dash/internal/runtime", "mcopy")
    s.ip, let mcopy_fqn_idx = try intern.intern_string(s.ip, mcopy_fqn)
    s.ip, let mcopy_fn_type = try intern.make_function_type(s.ip, mcopy_fqn_idx)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.extern_ref, x: mcopy_fqn_idx, y: mcopy_fn_type})
    let mcopy_ref = ir.index(u32(len(s.ins) - 1))

    s, let _ = try generate_call(s, mcopy_ref, [malloc_result, old_as_u8, byte_count], intern.NULL_IDX)


    s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: u32(malloc_result), y: data_ptr_type})
    let new_data_ptr = ir.index(u32(len(s.ins) - 1))

    s, let elem_ptr = try generate_gep_dynamic(s, new_data_ptr, len_val, elem_ir_type)
    s, let _ = try generate_store(s, elem_ptr, val_ir)


    s, let new_header = try generate_alloca(s, arr_ir_type)
    s, let new_len_ptr = try generate_gep(s, new_header, 0, intern.U64_TYPE_IDX)
    s, let _ = try generate_store(s, new_len_ptr, new_len)
    s, let new_data_field = try generate_gep(s, new_header, 1, data_ptr_type)
    s, let _ = try generate_store(s, new_data_field, new_data_ptr)


    s, let ok_val_ptr = try generate_gep(s, result_alloca, 0, arr_ir_type)
    s, let _ = try generate_store(s, ok_val_ptr, new_header)

    s.ip, let zero_desc_const = try intern.make_const_u32(s.ip, 0)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: zero_desc_const, y: intern.U32_TYPE_IDX})
    let zero_desc_ir = ir.index(u32(len(s.ins) - 1))
    s, let ok_desc_ptr = try generate_gep(s, result_alloca, 1, intern.U32_TYPE_IDX)
    s, let _ = try generate_store(s, ok_desc_ptr, zero_desc_ir)

    s, let ok_data_poison = try generate_poison(s, slot_type)
    s, let ok_data_ptr = try generate_gep(s, result_alloca, 2, slot_type)
    s, let _ = try generate_store(s, ok_data_ptr, ok_data_poison)

    s = try generate_jmp(s, merge_fqn)

    // merge block
    s, let _ = try generate_block(s, merge_fqn)

    return s, result_alloca, actual_arr_sem_type
}

fn generate_append_array(s *semsis, arr_ir ir.index, rhs_ir ir.index, actual_arr_sem_type types.index, elem_sem_type types.index, elem_ir_type intern.index)! *semsis, ir.index, types.index {
    var s = s

    s, let arr_ir_type = try lower_semantic_to_ir(s, actual_arr_sem_type)
    s.ip, let slot_type = try intern.make_slot_type(s.ip, intern.U64_TYPE_IDX)
    let aug_field_types = [arr_ir_type, intern.U32_TYPE_IDX, slot_type]
    s.ip, let _ = try intern.make_return_type(s.ip, aug_field_types)

    s.ip, let aug_struct_type = try intern.make_anon_struct_type(s.ip, aug_field_types)
    s, let result_alloca = try generate_alloca(s, aug_struct_type)


    s, let lhs_len_ptr = try generate_gep(s, arr_ir, 0, intern.U64_TYPE_IDX)
    s, let lhs_len = try generate_load(s, lhs_len_ptr, intern.U64_TYPE_IDX)


    s, let rhs_len_ptr = try generate_gep(s, rhs_ir, 0, intern.U64_TYPE_IDX)
    s, let rhs_len = try generate_load(s, rhs_len_ptr, intern.U64_TYPE_IDX)

    // new_len = lhs_len + rhs_len
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.add, x: u32(lhs_len), y: u32(rhs_len)})
    let new_len = ir.index(u32(len(s.ins) - 1))


    s, let elem_byte_size = try compute_type_byte_size(s, elem_sem_type)
    s.ip, let elem_size_const = try intern.make_const_u64(s.ip, elem_byte_size)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: elem_size_const, y: intern.U64_TYPE_IDX})
    let elem_size_ir = ir.index(u32(len(s.ins) - 1))

    // malloc(elem_size, new_len)
    let malloc_fqn = try make_fqn("dash/internal/runtime", "malloc")
    s.ip, let malloc_fqn_idx = try intern.intern_string(s.ip, malloc_fqn)
    s.ip, let malloc_fn_type = try intern.make_function_error_type(s.ip, malloc_fqn_idx)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.extern_ref, x: malloc_fqn_idx, y: malloc_fn_type})
    let malloc_ref = ir.index(u32(len(s.ins) - 1))

    s.ip, let u8_ptr_type = try intern.make_pointer_type(s.ip, intern.U8_TYPE_IDX)
    s, let malloc_result = try generate_call(s, malloc_ref, [elem_size_ir, new_len], u8_ptr_type)

    s, let merge_fqn = try reserve_block(s, s.current_func_fqn)
    s = try generate_malloc_null_check(s, malloc_result, result_alloca, arr_ir_type, slot_type, merge_fqn)



    // mcopy lhs: mcopy(new_ptr, lhs_data, lhs_len * elem_size)
    s.ip, let data_arr_type = try intern.make_array_type(s.ip, elem_ir_type)
    s.ip, let data_ptr_type = try intern.make_pointer_type(s.ip, data_arr_type)
    s, let lhs_data_ptr_ptr = try generate_gep(s, arr_ir, 1, data_ptr_type)
    s, let lhs_data_ptr = try generate_load(s, lhs_data_ptr_ptr, data_ptr_type)

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.mul, x: u32(lhs_len), y: u32(elem_size_ir)})
    let lhs_byte_count = ir.index(u32(len(s.ins) - 1))

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: u32(lhs_data_ptr), y: u8_ptr_type})
    let lhs_as_u8 = ir.index(u32(len(s.ins) - 1))

    let mcopy_fqn = try make_fqn("dash/internal/runtime", "mcopy")
    s.ip, let mcopy_fqn_idx = try intern.intern_string(s.ip, mcopy_fqn)
    s.ip, let mcopy_fn_type = try intern.make_function_type(s.ip, mcopy_fqn_idx)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.extern_ref, x: mcopy_fqn_idx, y: mcopy_fn_type})
    let mcopy_ref = ir.index(u32(len(s.ins) - 1))

    s, let _ = try generate_call(s, mcopy_ref, [malloc_result, lhs_as_u8, lhs_byte_count], intern.NULL_IDX)

    // mcopy rhs: dst = new_ptr offset by lhs_len elements
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: u32(malloc_result), y: data_ptr_type})
    let new_data_ptr = ir.index(u32(len(s.ins) - 1))

    s, let rhs_dst = try generate_gep_dynamic(s, new_data_ptr, lhs_len, elem_ir_type)

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: u32(rhs_dst), y: u8_ptr_type})
    let rhs_dst_u8 = ir.index(u32(len(s.ins) - 1))

    s, let rhs_data_ptr_ptr = try generate_gep(s, rhs_ir, 1, data_ptr_type)
    s, let rhs_data_ptr = try generate_load(s, rhs_data_ptr_ptr, data_ptr_type)

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.mul, x: u32(rhs_len), y: u32(elem_size_ir)})
    let rhs_byte_count = ir.index(u32(len(s.ins) - 1))

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: u32(rhs_data_ptr), y: u8_ptr_type})
    let rhs_as_u8 = ir.index(u32(len(s.ins) - 1))

    s, let _ = try generate_call(s, mcopy_ref, [rhs_dst_u8, rhs_as_u8, rhs_byte_count], intern.NULL_IDX)


    s, let new_header = try generate_alloca(s, arr_ir_type)
    s, let new_len_ptr = try generate_gep(s, new_header, 0, intern.U64_TYPE_IDX)
    s, let _ = try generate_store(s, new_len_ptr, new_len)
    s, let new_data_field = try generate_gep(s, new_header, 1, data_ptr_type)
    s, let _ = try generate_store(s, new_data_field, new_data_ptr)


    s, let ok_val_ptr = try generate_gep(s, result_alloca, 0, arr_ir_type)
    s, let _ = try generate_store(s, ok_val_ptr, new_header)

    s.ip, let zero_desc_const = try intern.make_const_u32(s.ip, 0)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: zero_desc_const, y: intern.U32_TYPE_IDX})
    let zero_desc_ir = ir.index(u32(len(s.ins) - 1))
    s, let ok_desc_ptr = try generate_gep(s, result_alloca, 1, intern.U32_TYPE_IDX)
    s, let _ = try generate_store(s, ok_desc_ptr, zero_desc_ir)

    s, let ok_data_poison = try generate_poison(s, slot_type)
    s, let ok_data_ptr = try generate_gep(s, result_alloca, 2, slot_type)
    s, let _ = try generate_store(s, ok_data_ptr, ok_data_poison)

    s = try generate_jmp(s, merge_fqn)

    // merge block
    s, let _ = try generate_block(s, merge_fqn)

    return s, result_alloca, actual_arr_sem_type
}

fn analyse_builtin_assert(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let args_idx = node.data.y

    if args_idx == ast.NULL_IDX {
        s = try add_error(s, too_few_arguments{expected: 2, found: 0, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let args_node = try get(s.ast.nodes, args_idx)
    let args_data = args_node.data
    let arg_count = u16(args_data.y - args_data.x)

    if arg_count > 2 {
        s = try add_error(s, too_many_arguments{expected: 2, found: arg_count, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    if arg_count < 2 {
        s = try add_error(s, too_few_arguments{expected: 2, found: arg_count, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }


    let cond_ast_idx = try get(s.ast.extras, args_data.x)
    s, let cond_ir, let cond_sem_type = try analyse_expression(s, cond_ast_idx)
    if cond_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, let cond_ok = try rule_is_assignable_to(s, cond_ir, cond_sem_type, types.BOOL_IDX, cond_ast_idx)
    if !cond_ok {
        return s, ir.NULL_IDX, types.NULL_IDX
    }


    let msg_ast_idx = try get(s.ast.extras, args_data.x + 1)
    s, let msg_ir, let msg_sem_type = try analyse_expression(s, msg_ast_idx)
    if msg_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, let msg_ok = try rule_is_assignable_to(s, msg_ir, msg_sem_type, types.STRING_IDX, msg_ast_idx)
    if !msg_ok {
        return s, ir.NULL_IDX, types.NULL_IDX
    }


    s, let ok_fqn = try reserve_block(s, s.current_func_fqn)
    s, let fail_fqn = try reserve_block(s, s.current_func_fqn)
    s = try generate_br(s, cond_ir, ok_fqn, fail_fqn)


    s, let _ = try generate_block(s, fail_fqn)

    let fqn = try make_fqn("dash/internal/runtime", "panic")
    s.ip, let fqn_idx = try intern.intern_string(s.ip, fqn)
    s.ip, let fn_type_idx = try intern.make_function_type(s.ip, fqn_idx)

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.extern_ref, x: fqn_idx, y: fn_type_idx})
    let fn_ref = ir.index(u32(len(s.ins)-1))

    s, let _ = try generate_call(s, fn_ref, [msg_ir], intern.NULL_IDX)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.unreachable, x: u32(ir.NULL_IDX), y: u32(ir.NULL_IDX)})


    s, let _ = try generate_block(s, ok_fqn)

    return s, ir.NULL_IDX, types.NULL_IDX
}

fn analyse_builtin_println(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let args_idx = node.data.y

    if args_idx == ast.NULL_IDX {
        s = try add_error(s, too_few_arguments{expected: 1, found: 0, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let args_node = try get(s.ast.nodes, args_idx)
    let args_data = args_node.data
    let arg_count = u16(args_data.y - args_data.x)

    if arg_count > 1 {
        s = try add_error(s, too_many_arguments{expected: 1, found: arg_count, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    if arg_count < 1 {
        s = try add_error(s, too_few_arguments{expected: 1, found: 0, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let arg_ast_idx = try get(s.ast.extras, args_data.x)
    s, let arg_ir, let arg_sem_type = try analyse_expression(s, arg_ast_idx)
    if arg_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let fqn = try make_fqn("dash/internal/runtime", "println")
    s.ip, let fqn_idx = try intern.intern_string(s.ip, fqn)
    s.ip, let fn_type_idx = try intern.make_function_type(s.ip, fqn_idx)

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.extern_ref, x: fqn_idx, y: fn_type_idx})
    let fn_ref = ir.index(u32(len(s.ins)-1))

    s, let _ = try generate_call(s, fn_ref, [arg_ir], intern.NULL_IDX)

    return s, ir.NULL_IDX, types.NULL_IDX
}

fn analyse_builtin_size(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let args_idx = node.data.y

    if args_idx == ast.NULL_IDX {
        s = try add_error(s, too_few_arguments{expected: 1, found: 0, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let args_node = try get(s.ast.nodes, args_idx)
    let args_data = args_node.data
    let arg_count = u16(args_data.y - args_data.x)

    if arg_count > 1 {
        s = try add_error(s, too_many_arguments{expected: 1, found: arg_count, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    if arg_count < 1 {
        s = try add_error(s, too_few_arguments{expected: 1, found: 0, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let arg_ast_idx = try get(s.ast.extras, args_data.x)
    s, let _, let arg_sem_type = try analyse_expression(s, arg_ast_idx)

    if arg_sem_type == types.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, let byte_size = try compute_type_byte_size(s, arg_sem_type)

    s.ip, let size_const = try intern.make_const_u64(s.ip, byte_size)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: size_const, y: intern.U64_TYPE_IDX})
    return s, ir.index(u32(len(s.ins)-1)), types.U64_IDX
}

// analyse_builtin_make generates IR for make([]T, len) and make([]T, len, cap).
// Returns memory[[]T] — a linear type, no refcount overhead.
//
// Calls alloc_eav(elem_size * capacity) which is fallible — OOM
// propagates via the standard try/error mechanism. On success,
// bitcasts the *u8 to a typed data pointer and constructs the
// array header {len, data_ptr}.
fn analyse_builtin_make(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let args_idx = node.data.y

    if args_idx == ast.NULL_IDX {
        s = try add_error(s, too_few_arguments{expected: 2, found: 0, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let args_node = try get(s.ast.nodes, args_idx)
    let args_data = args_node.data
    let arg_count = u16(args_data.y - args_data.x)

    if arg_count < 2 {
        s = try add_error(s, too_few_arguments{expected: 2, found: arg_count, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    if arg_count > 3 {
        s = try add_error(s, too_many_arguments{expected: 3, found: arg_count, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let type_ast_idx = try get(s.ast.extras, args_data.x)
    let type_node = try get(s.ast.nodes, type_ast_idx)
    if type_node.tag != ast.tag.array_type {
        s = try add_error(s, make_invalid_type_argument{pos: type_ast_idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    s, let arr_sem_type = try resolve_type_ref(s, s.current_scope, type_ast_idx)
    if arr_sem_type == types.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let len_ast_idx = try get(s.ast.extras, args_data.x + 1)
    s, let len_ir, let len_sem_type = try analyse_expression(s, len_ast_idx)
    if len_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    let len_is_int = try types.is_integer(s.tp, len_sem_type)
    if !len_is_int {
        s = try add_error(s, make_invalid_size_argument{pos: len_ast_idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    var cap_ir = len_ir
    if arg_count == 3 {
        let cap_ast_idx = try get(s.ast.extras, args_data.x + 2)
        s, let cap_val, let cap_sem_type = try analyse_expression(s, cap_ast_idx)
        if cap_val == ir.NULL_IDX {
            return s, ir.NULL_IDX, types.NULL_IDX
        }
        let cap_is_int = try types.is_integer(s.tp, cap_sem_type)
        if !cap_is_int {
            s = try add_error(s, make_invalid_size_argument{pos: cap_ast_idx})
            return s, ir.NULL_IDX, types.NULL_IDX
        }
        cap_ir = cap_val
    }

    let elem_sem_type = try types.get_array_inner(s.tp, arr_sem_type)
    s, let elem_ir_type = try lower_semantic_to_ir(s, elem_sem_type)
    s, let arr_ir_type = try lower_semantic_to_ir(s, arr_sem_type)

    // cast len and cap to u64 for consistent arithmetic
    s, let len_u64 = try generate_cast(s, len_ir, intern.U64_TYPE_IDX)
    s, let cap_u64 = try generate_cast(s, cap_ir, intern.U64_TYPE_IDX)

    // runtime cap >= len check (3-arg form only)
    if arg_count == 3 {
        s.ins = try append(s.ins, ir.inst{tag: ir.tag.lt, x: u32(cap_u64), y: u32(len_u64)})
        let cap_lt_len = ir.index(u32(len(s.ins) - 1))
        s, let cap_ok_fqn = try reserve_block(s, s.current_func_fqn)
        s, let cap_panic_fqn = try reserve_block(s, s.current_func_fqn)
        s = try generate_br(s, cap_lt_len, cap_panic_fqn, cap_ok_fqn)

        s, let _ = try generate_block(s, cap_panic_fqn)
        s = try generate_panic_string(s, "make: capacity less than length")
        s.ins = try append(s.ins, ir.inst{tag: ir.tag.unreachable, x: u32(ir.NULL_IDX), y: u32(ir.NULL_IDX)})

        s, let _ = try generate_block(s, cap_ok_fqn)
    }

    // total_size = elem_byte_size * capacity (skip mul when elem_size is 1)
    s, let elem_byte_size = try compute_type_byte_size(s, elem_sem_type)
    var total_size = cap_u64
    if elem_byte_size > 1 {
        s.ip, let elem_size_const = try intern.make_const_u64(s.ip, elem_byte_size)
        s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: elem_size_const, y: intern.U64_TYPE_IDX})
        let elem_size_ir = ir.index(u32(len(s.ins) - 1))

        s.ins = try append(s.ins, ir.inst{tag: ir.tag.mul, x: u32(cap_u64), y: u32(elem_size_ir)})
        total_size = ir.index(u32(len(s.ins) - 1))
    }

    // alloc_eav(total_size) -> *u8 (fallible, raises out_of_memory on OOM)
    let alloc_fqn = try make_fqn("dash/internal/runtime", "alloc_eav")
    s.ip, let alloc_fqn_idx = try intern.intern_string(s.ip, alloc_fqn)
    s.ip, let alloc_fn_type = try intern.make_function_error_type(s.ip, alloc_fqn_idx)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.extern_ref, x: alloc_fqn_idx, y: alloc_fn_type})
    let alloc_ref = ir.index(u32(len(s.ins) - 1))

    s.ip, let u8_ptr_type = try intern.make_pointer_type(s.ip, intern.U8_TYPE_IDX)
    s, let alloc_call = try generate_call(s, alloc_ref, [total_size], u8_ptr_type)

    // alloc_eav returns augmented [*u8, u32(err_desc), slot(err_data)].
    // Extract err_desc and propagate if non-zero.
    s.ip, let slot_type = try intern.make_slot_type(s.ip, intern.U64_TYPE_IDX)

    s, let desc_ptr = try generate_gep(s, alloc_call, 1, intern.U32_TYPE_IDX)
    s, let desc_val = try generate_load(s, desc_ptr, intern.U32_TYPE_IDX)

    s.ip, let zero_const = try intern.make_const_u32(s.ip, 0)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: zero_const, y: intern.U32_TYPE_IDX})
    let zero_ir = ir.index(u32(len(s.ins) - 1))

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.eq, x: u32(desc_val), y: u32(zero_ir)})
    let is_ok = ir.index(u32(len(s.ins) - 1))

    s, let ok_fqn = try reserve_block(s, s.current_func_fqn)
    s, let fail_fqn = try reserve_block(s, s.current_func_fqn)
    s, let merge_fqn = try reserve_block(s, s.current_func_fqn)

    // result alloca before the branch (not after)
    let aug_field_types = [arr_ir_type, intern.U32_TYPE_IDX, slot_type]
    s.ip, let _ = try intern.make_return_type(s.ip, aug_field_types)
    s.ip, let aug_struct_type = try intern.make_anon_struct_type(s.ip, aug_field_types)
    s, let result_alloca = try generate_alloca(s, aug_struct_type)

    s = try generate_br(s, is_ok, ok_fqn, fail_fqn)

    // fail path: propagate alloc_eav's error descriptor and data
    s, let _ = try generate_block(s, fail_fqn)

    s, let poison_val = try generate_poison(s, arr_ir_type)
    s, let fail_val_ptr = try generate_gep(s, result_alloca, 0, arr_ir_type)
    s, let _ = try generate_store(s, fail_val_ptr, poison_val)

    s, let fail_desc_ptr = try generate_gep(s, result_alloca, 1, intern.U32_TYPE_IDX)
    s, let _ = try generate_store(s, fail_desc_ptr, desc_val)

    s, let alloc_data_ptr = try generate_gep(s, alloc_call, 2, slot_type)
    s, let alloc_data_val = try generate_load(s, alloc_data_ptr, slot_type)
    s, let fail_data_ptr = try generate_gep(s, result_alloca, 2, slot_type)
    s, let _ = try generate_store(s, fail_data_ptr, alloc_data_val)

    s = try generate_jmp(s, merge_fqn)

    // ok path: extract *u8, bitcast, build array header
    s, let _ = try generate_block(s, ok_fqn)

    s, let raw_ptr_ptr = try generate_gep(s, alloc_call, 0, u8_ptr_type)
    s, let raw_ptr = try generate_load(s, raw_ptr_ptr, u8_ptr_type)

    s.ip, let data_arr_type = try intern.make_array_type(s.ip, elem_ir_type)
    s.ip, let data_ptr_type = try intern.make_pointer_type(s.ip, data_arr_type)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: u32(raw_ptr), y: data_ptr_type})
    let data_ptr = ir.index(u32(len(s.ins) - 1))

    // array header {len, data_ptr}
    s, let header = try generate_alloca(s, arr_ir_type)
    s, let len_field = try generate_gep(s, header, 0, intern.U64_TYPE_IDX)
    s, let _ = try generate_store(s, len_field, len_u64)
    s, let data_field = try generate_gep(s, header, 1, data_ptr_type)
    s, let _ = try generate_store(s, data_field, data_ptr)

    s, let ok_val_ptr = try generate_gep(s, result_alloca, 0, arr_ir_type)
    s, let _ = try generate_store(s, ok_val_ptr, header)

    s, let ok_desc_ptr = try generate_gep(s, result_alloca, 1, intern.U32_TYPE_IDX)
    s, let _ = try generate_store(s, ok_desc_ptr, zero_ir)

    s, let ok_data_poison = try generate_poison(s, slot_type)
    s, let ok_data_ptr = try generate_gep(s, result_alloca, 2, slot_type)
    s, let _ = try generate_store(s, ok_data_ptr, ok_data_poison)

    s = try generate_jmp(s, merge_fqn)

    // merge: load result
    s, let _ = try generate_block(s, merge_fqn)
    s, let final_result = try generate_load(s, result_alloca, aug_struct_type)

    s.tp, let mem_sem_type = try types.make_memory(s.tp, arr_sem_type)
    return s, final_result, mem_sem_type
}

fn analyse_builtin_cap(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let args_idx = node.data.y

    if args_idx == ast.NULL_IDX {
        s = try add_error(s, too_few_arguments{expected: 1, found: 0, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let args_node = try get(s.ast.nodes, args_idx)
    let args_data = args_node.data
    let arg_count = u16(args_data.y - args_data.x)

    if arg_count > 1 {
        s = try add_error(s, too_many_arguments{expected: 1, found: arg_count, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    if arg_count < 1 {
        s = try add_error(s, too_few_arguments{expected: 1, found: arg_count, pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let arg_ast_idx = try get(s.ast.extras, args_data.x)
    s, let arg_ir, let arg_sem_type = try analyse_expression(s, arg_ast_idx)
    if arg_ir == ir.NULL_IDX {
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let is_mem = try types.is_memory(s.tp, arg_sem_type)
    if !is_mem {
        s = try add_error(s, type_mismatch{got: arg_sem_type, want: types.NULL_IDX, pos: arg_ast_idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    return s, ir.NULL_IDX, types.I64_IDX
}

// generate_malloc_null_check emits a null pointer check after a malloc call.
// If malloc returned null, fills result_alloca with an out_of_memory error
// and jumps to fail_target. Otherwise, falls through to the ok block.
// The caller must jump to fail_target at the end of its success path too,
// so both paths converge.
fn generate_malloc_null_check(
    s *semsis,
    malloc_result ir.index,
    result_alloca ir.index,
    value_ir_type intern.index,
    slot_type intern.index,
    fail_target intern.index,
)! *semsis {
    var s = s

    s.ip, let u8_ptr_type = try intern.make_pointer_type(s.ip, intern.U8_TYPE_IDX)
    s.ip, let null_const = try intern.make_const_null(s.ip)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: null_const, y: u8_ptr_type})
    let null_ir = ir.index(u32(len(s.ins) - 1))

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.eq, x: u32(malloc_result), y: u32(null_ir)})
    let is_null = ir.index(u32(len(s.ins) - 1))

    s, let malloc_fail_fqn = try reserve_block(s, s.current_func_fqn)
    s, let malloc_ok_fqn = try reserve_block(s, s.current_func_fqn)
    s = try generate_br(s, is_null, malloc_fail_fqn, malloc_ok_fqn)


    s, let _ = try generate_block(s, malloc_fail_fqn)

    s, let poison_val = try generate_poison(s, value_ir_type)
    s, let fail_val_ptr = try generate_gep(s, result_alloca, 0, value_ir_type)
    s, let _ = try generate_store(s, fail_val_ptr, poison_val)

    let err_fqn = try make_fqn("dash/internal/runtime", "out_of_memory")
    s.ip, let err_fqn_idx = try intern.intern_string(s.ip, err_fqn)
    s.tp, let err_type_idx = try types.make_error(s.tp, err_fqn_idx)
    s.ip, let err_desc_const = try intern.make_const_u32(s.ip, u32(err_type_idx))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: err_desc_const, y: intern.U32_TYPE_IDX})
    let err_desc_ir = ir.index(u32(len(s.ins) - 1))
    s, let fail_desc_ptr = try generate_gep(s, result_alloca, 1, intern.U32_TYPE_IDX)
    s, let _ = try generate_store(s, fail_desc_ptr, err_desc_ir)

    s, let poison_slot = try generate_poison(s, slot_type)
    s, let fail_data_ptr = try generate_gep(s, result_alloca, 2, slot_type)
    s, let _ = try generate_store(s, fail_data_ptr, poison_slot)

    s = try generate_jmp(s, fail_target)


    s, let _ = try generate_block(s, malloc_ok_fqn)

    return s
}

fn compute_type_byte_size(s *semsis, sem_type types.index)! *semsis, u64 {
    var s = s
    let st = try types.lookup(s.tp, sem_type)

    match st.tag {
    case types.tag.u8_type, types.tag.i8_type, types.tag.bool_type:
        return s, 1
    case types.tag.u16_type, types.tag.i16_type:
        return s, 2
    case types.tag.u32_type, types.tag.i32_type, types.tag.f32_type, types.tag.char_type:
        return s, 4
    case types.tag.u64_type, types.tag.i64_type, types.tag.f64_type, types.tag.pointer_type:
        return s, 8
    case types.tag.string_type:
        return s, 16
    case types.tag.array_type:
        return s, 16
    case types.tag.memory_type:
        let inner = types.index(st.x)
        return try compute_type_byte_size(s, inner)
    case types.tag.optional_type:
        let inner = types.index(st.x)
        s, let inner_size = try compute_type_byte_size(s, inner)
        return s, 1 + inner_size
    case types.tag.many_type:
        return s, 16
    case types.tag.enum_type:
        let variant_count = try types.get_enum_variant_count(s.tp, sem_type)
        if variant_count <= 255 {
            return s, 1
        } else if variant_count <= 65535 {
            return s, 2
        } else if variant_count <= 4294967295 {
            return s, 4
        }
        return s, 8
    case types.tag.union_type:
        return s, 16
    case types.tag.error_generic_type:
        return s, 16
    case types.tag.error_custom_type:
        let field_count = try types.get_struct_field_count(s.tp, sem_type)
        var total = u64(0)
        var i = u32(0)
        for i < field_count {
            let field = try types.get_struct_field_by_index(s.tp, sem_type, i)
            if field != null {
                let f = ?field
                s, let field_size = try compute_type_byte_size(s, f.type_idx)
                total = total + field_size
            }
            i = i + 1
        }
        return s, total
    case types.tag.type_def_type:
        let underlying = try types.get_type_def_underlying(s.tp, sem_type)
        if underlying == types.NULL_IDX {
            return s, 0
        }
        return try compute_type_byte_size(s, underlying)
    case types.tag.struct_type:
        let field_count = try types.get_struct_field_count(s.tp, sem_type)
        var total = u64(0)
        var i = u32(0)
        for i < field_count {
            let field = try types.get_struct_field_by_index(s.tp, sem_type, i)
            if field != null {
                let f = ?field
                s, let field_size = try compute_type_byte_size(s, f.type_idx)
                total = total + field_size
            }
            i = i + 1
        }
        return s, total
    }

    return s, 0
}

fn generate_strings_concat(s *semsis, lhs_idx, rhs_idx ir.index)! *semsis, ir.index {
    var s = s

    let fqn = try make_fqn("dash/internal/runtime", "string_concat")
    s.ip, let fqn_idx = try intern.intern_string(s.ip, fqn)
    s.ip, let fn_type_idx = try intern.make_function_error_type(s.ip, fqn_idx)

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.extern_ref, x: fqn_idx, y: fn_type_idx})
    let fn_ref = ir.index(u32(len(s.ins)-1))

    s, let str_type = try create_string_type(s)
    s.ip, let return_type = try intern.make_return_type(s.ip, [str_type])

    s, let call_ir = try generate_call(s, fn_ref, [lhs_idx, rhs_idx], return_type)
    s, let result_ir = try generate_return_type_extract(s, call_ir, 0)
    return s, result_ir
}

fn generate_strings_equal(s *semsis, lhs_idx, rhs_idx ir.index)! *semsis, ir.index {
    var s = s

    let fqn = try make_fqn("dash/internal/runtime", "string_compare")
    s.ip, let fqn_idx = try intern.intern_string(s.ip, fqn)
    s.ip, let fn_type_idx = try intern.make_function_error_type(s.ip, fqn_idx)

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.extern_ref, x: fqn_idx, y: fn_type_idx})
    let fn_ref = ir.index(u32(len(s.ins)-1))

    s.ip, let return_type = try intern.make_return_type(s.ip, [intern.BOOL_TYPE_IDX])

    s, let call_ir = try generate_call(s, fn_ref, [lhs_idx, rhs_idx], return_type)
    s, let result_ir = try generate_return_type_extract(s, call_ir, 0)
    return s, result_ir
}

// can_coerce_constant checks if a constant value can be coerced from one semantic type to another.
// Uses semantic types for proper type distinction (e.g., Optional[T] vs struct {bool, T}).
fn can_coerce_constant(s *semsis, from_ir ir.index, from_sem_type, to_sem_type types.index)! bool {
    if from_sem_type == to_sem_type {
        return true
    }

    // T -> ?T coercion: constant can be wrapped in optional
    if try types.is_optional(s.tp, to_sem_type) {
        let inner_sem_type = try types.get_optional_inner(s.tp, to_sem_type)
        // ??T not allowed
        try assert(!try types.is_optional(s.tp, inner_sem_type), "nested optionals not supported")
        if from_sem_type == inner_sem_type {
            return true
        }
        // check if inner type can be coerced e.g. assigning 43 to ?u32
        return try can_coerce_constant(s, from_ir, from_sem_type, inner_sem_type)
    }

    // T -> type_def coercion: constant can be coerced if it fits the underlying type
    if try types.is_type_def(s.tp, to_sem_type) {
        let underlying_type = try types.get_type_def_underlying(s.tp, to_sem_type)
        if underlying_type != types.NULL_IDX {
            return try can_coerce_constant(s, from_ir, from_sem_type, underlying_type)
        }
    }

    let from_is_int = try types.is_integer(s.tp, from_sem_type)
    let to_is_int = try types.is_integer(s.tp, to_sem_type)
    if from_is_int && to_is_int {
        let inst = try get(s.ins, from_ir)
        if inst.tag != ir.tag.const {
            raise compiler_error{rsn: "expected const instruction", pos: ast.NULL_IDX}
        }

        let const_idx = intern.index(inst.x)
        let const_item = try intern.lookup(s.ip, const_idx)

        let value = match const_item.tag {
            case intern.tag.const_u32:
                u64(try intern.get_u32(s.ip, const_idx))
            case intern.tag.const_u64:
                try intern.get_u64(s.ip, const_idx)
            case _:
                raise compiler_error{rsn: "expected u32 or u64 constant", pos: ast.NULL_IDX}
        }

        let to_st = try types.lookup(s.tp, to_sem_type)
        let fits = match to_st.tag {
            case types.tag.u8_type:
                value <= 255
            case types.tag.u16_type:
                value <= 65_535
            case types.tag.u32_type:
                value <= 4_294_967_295
            case types.tag.u64_type:
                true  
            case types.tag.i8_type:
                value <= 127  
            case types.tag.i16_type:
                value <= 32_767
            case types.tag.i32_type:
                value <= 2_147_483_647
            case types.tag.i64_type:
                value <= 9_223_372_036_854_775_807
            case _:
                raise compiler_error{rsn: "unexpected integer type in can_coerce_constant", pos: ast.NULL_IDX}
        }

        return fits
    }

    // char <-> integer coercion
    let from_is_char = try types.is_char(s.tp, from_sem_type)
    let to_is_char = try types.is_char(s.tp, to_sem_type)

    if (from_is_char && to_is_int) || (from_is_int && to_is_char) || (from_is_char && to_is_char) {
        let inst = try get(s.ins, from_ir)
        if inst.tag != ir.tag.const {
            raise compiler_error{rsn: "expected const instruction", pos: ast.NULL_IDX}
        }
        let const_idx = intern.index(inst.x)
        let const_item = try intern.lookup(s.ip, const_idx)

        let value = match const_item.tag {
            case intern.tag.const_u32:
                u64(try intern.get_u32(s.ip, const_idx))
            case intern.tag.const_u64:
                try intern.get_u64(s.ip, const_idx)
            case intern.tag.const_char:
                u64(const_item.x)
            case _:
                raise compiler_error{rsn: "expected numeric constant", pos: ast.NULL_IDX}
        }

        if to_is_char {
            // char is u32 under the hood
            return value <= 4_294_967_295
        }

        let to_st = try types.lookup(s.tp, to_sem_type)
        return match to_st.tag {
            case types.tag.u8_type:  value <= 255
            case types.tag.u16_type: value <= 65_535
            case types.tag.u32_type: value <= 4_294_967_295
            case types.tag.u64_type: true
            case types.tag.i8_type:  value <= 127
            case types.tag.i16_type: value <= 32_767
            case types.tag.i32_type: value <= 2_147_483_647
            case types.tag.i64_type: value <= 9_223_372_036_854_775_807
            case _: false
        }
    }

    // TODO: for f32 allowed if can be represented the same in f64 and vice versa
    // TODO: for string allowed to []u8
    // TODO: always allow if to is any

    return false
}

// find_common_type_constants finds the common semantic type for two constant values.
// Returns the appropriate widened type for mixed-type constant operations.
fn find_common_type_constants(s *semsis, lhs_sem_type, rhs_sem_type types.index)! types.index {

    if lhs_sem_type == rhs_sem_type {
        return lhs_sem_type
    }

    let lhs_is_type_def = try types.is_type_def(s.tp, lhs_sem_type)
    let rhs_is_type_def = try types.is_type_def(s.tp, rhs_sem_type)
    if lhs_is_type_def || rhs_is_type_def {
        var lhs_effective = lhs_sem_type
        if lhs_is_type_def {
            lhs_effective = try types.get_type_def_underlying(s.tp, lhs_sem_type)
        }
        var rhs_effective = rhs_sem_type
        if rhs_is_type_def {
            rhs_effective = try types.get_type_def_underlying(s.tp, rhs_sem_type)
        }

        let common = try find_common_type_constants(s, lhs_effective, rhs_effective)
        if common == types.NULL_IDX {
            return types.NULL_IDX
        }

        // if type_def and common matches its underlying, preserve type_def
        if lhs_is_type_def && common == lhs_effective {
            return lhs_sem_type
        }
        if rhs_is_type_def && common == rhs_effective {
            return rhs_sem_type
        }
        return common
    }

    if try types.is_integer(s.tp, lhs_sem_type) {
        if try types.is_integer(s.tp, rhs_sem_type) {
            return types.I64_IDX
        } else if try types.is_char(s.tp, rhs_sem_type) {
            return types.I64_IDX
        } else if try types.is_float(s.tp, rhs_sem_type) {
            return types.F64_IDX
        }
    } else if try types.is_char(s.tp, lhs_sem_type) {
        if try types.is_char(s.tp, rhs_sem_type) {
            return types.U32_IDX
        } else if try types.is_integer(s.tp, rhs_sem_type) {
            return types.I64_IDX
        } else if try types.is_float(s.tp, rhs_sem_type) {
            return types.F64_IDX
        }
    } else if try types.is_float(s.tp, lhs_sem_type) {
        if try types.is_float(s.tp, rhs_sem_type) {
            return types.F64_IDX
        } else if try types.is_integer(s.tp, rhs_sem_type) {
            return types.F64_IDX
        } else if try types.is_char(s.tp, rhs_sem_type) {
            return types.F64_IDX
        }
    } else if try types.is_string(s.tp, lhs_sem_type) {
        if try types.is_string(s.tp, rhs_sem_type) {
            return lhs_sem_type
        }
    } else if try types.is_bool(s.tp, lhs_sem_type) {
        if try types.is_bool(s.tp, rhs_sem_type) {
            return lhs_sem_type
        }
    }
    return types.NULL_IDX
}

// generate_extern_ref generates an extern_ref instruction for a function
fn generate_extern_ref(s *semsis, fqn_idx intern.index, fn_type types.index)! *semsis, ir.index {
    var s = s
    s, let fn_type_ir = try lower_semantic_to_ir(s, fn_type)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.extern_ref, x: fqn_idx, y: fn_type_ir})
    let fn_ref = ir.index(u32(len(s.ins) - 1))
    return s, fn_ref
}

// analyse_identifier looks up the identifier from namespace and returns
// its IR instruction index and optional scope for type/function references.
// For SSA-tracked mutable variables, uses SSA's read_variable.
fn analyse_identifier(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let ident = try ast.identifier(s.ast, node)
    s.ip, let ident_idx = try intern.intern_string(s.ip, ident)

    // first try local lookup (parameters, local variables) and if not found
    // try FQN lookup
    var entry_idx_opt = try namespace.lookup(s.np, s.current_scope, ident_idx)
    if entry_idx_opt == null {
        let current_scope = try namespace.get_scope(s.np, s.current_scope)
        let fqn = try make_fqn(current_scope.path, ident)
        s.ip, let fqn_idx = try intern.intern_string(s.ip, fqn)
        entry_idx_opt = try namespace.lookup(s.np, s.current_scope, fqn_idx)

        if entry_idx_opt == null {
            var parent_idx = current_scope.parent_idx
            for parent_idx != namespace.NULL_IDX {
                let parent_scope = try namespace.get_scope(s.np, parent_idx)
                let parent_fqn = try make_fqn(parent_scope.path, ident)
                s.ip, let parent_fqn_idx = try intern.intern_string(s.ip, parent_fqn)
                entry_idx_opt = try namespace.lookup(s.np, s.current_scope, parent_fqn_idx)
                if entry_idx_opt != null {
                    break
                }
                parent_idx = parent_scope.parent_idx
            }
        }
    }

    if entry_idx_opt == null {
        s = try add_error(s, identifier_not_found{pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let entry_idx = ?entry_idx_opt
    let entry = try namespace.get_entry(s.np, entry_idx)
    match e = entry {
    case namespace.value:
        // for reassignable local variables, use SSA lookup. this handles variables
        // that may have been redefined in control flow
        if e.is_reassignable {
            s, let ssa_val = try read_variable(s, ident_idx)
            if ssa_val != ir.NULL_IDX {
                return s, ssa_val, e.type_idx
            }
        }
        // fall back to namespace value for immutable variables (let)
        return s, e.index, e.type_idx
    case namespace.linear_value:
        if e.is_consumed {
            s = try add_error(s, linear_consumed_already{name: e.name, pos: idx})
            return s, ir.NULL_IDX, e.type_idx
        }
        if e.is_reassignable {
            s, let ssa_val = try read_variable(s, ident_idx)
            if ssa_val != ir.NULL_IDX {
                return s, ssa_val, e.type_idx
            }
        }
        return s, e.index, e.type_idx
    case namespace.scope:
        if try types.is_function(s.tp, e.owner) {
            let current_scope = try namespace.get_scope(s.np, s.current_scope)
            let fqn = try make_fqn(current_scope.path, ident)
            s.ip, let fqn_idx = try intern.intern_string(s.ip, fqn)
            s, let fn_ref = try generate_extern_ref(s, fqn_idx, e.owner)
            return s, fn_ref, e.owner
        }
        return s, ir.NULL_IDX, e.owner
    }
}

// mark_consumed_if_linear looks up the identifier at `idx` and, if it
// is a linear_value in the current scope, sets is_consumed = true.
// Called when a linear value is passed as an argument to a function.
fn mark_consumed_if_linear(s *semsis, idx ast.index)! *semsis {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let ident = try ast.identifier(s.ast, node)
    s.ip, let ident_idx = try intern.intern_string(s.ip, ident)

    let entry_idx_opt = try namespace.lookup(s.np, s.current_scope, ident_idx)
    if entry_idx_opt == null {
        return s
    }
    let entry_idx = ?entry_idx_opt
    let entry = try namespace.get_entry(s.np, entry_idx)
    match e = entry {
    case namespace.linear_value:
        let consumed = namespace.linear_value{
            ..e,
            is_consumed: true,
        }
        s.np = try namespace.update_entry(s.np, entry_idx, namespace.entry(consumed))
    case _:
    }
    return s
}

fn generate_constant_binary(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let bin_str = try ast.get_literal(s.ast, idx)
    let i = convert.parse_u64(bin_str, 0) catch e {
        s = try add_error(s, invalid_binary{pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    s.ip, let type_idx = try intern.make_primitive_type(s.ip, intern.tag.u64_type)
    let sem_type = types.U64_IDX
    s.ip, let int_idx = try intern.make_const_u64(s.ip, i)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: int_idx, y: type_idx})
    return s, ir.index(u32(len(s.ins)-1)), sem_type
}

// generate_constant_integer determines the appropriate type for an integer literal
// and generates the corresponding IR instruction
fn generate_constant_integer(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let int_str = try ast.get_literal(s.ast, idx)
    let i = convert.parse_u64(int_str, 10) catch e {
        s = try add_error(s, invalid_integer{pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    // determine if the integer fits in i64 or needs u64
    var type_idx = intern.NULL_IDX
    var sem_type = types.NULL_IDX
    if i <= 9223372036854775807 {
        s.ip, type_idx = try intern.make_primitive_type(s.ip, intern.tag.i64_type)
        sem_type = types.I64_IDX
    } else {
        s.ip, type_idx = try intern.make_primitive_type(s.ip, intern.tag.u64_type)
        sem_type = types.U64_IDX
    }

    s.ip, let int_idx = try intern.make_const_u64(s.ip, i)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: int_idx, y: type_idx})
    return s, ir.index(u32(len(s.ins)-1)), sem_type
}

fn generate_constant_hexadecimal(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let hex_str = try ast.get_literal(s.ast, idx)
    let i = convert.parse_u64(hex_str, 0) catch e {
        s = try add_error(s, invalid_hexadecimal{pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }
    s.ip, let type_idx = try intern.make_primitive_type(s.ip, intern.tag.u64_type)
    let sem_type = types.U64_IDX
    s.ip, let int_idx = try intern.make_const_u64(s.ip, i)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: int_idx, y: type_idx})
    return s, ir.index(u32(len(s.ins)-1)), sem_type
}

fn generate_constant_char(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let char_str = try ast.get_literal(s.ast, idx)
    let char_value = convert.parse_char(char_str) catch e {
        s = try add_error(s, invalid_char{pos: idx})
        return s, ir.NULL_IDX, types.NULL_IDX
    }

    let type_idx = intern.CHAR_TYPE_IDX
    s.ip, let char_idx = try intern.make_const_char(s.ip, char(char_value))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: char_idx, y: type_idx})
    let ins_idx = ir.index(u32(len(s.ins)-1))
    return s, ins_idx, types.CHAR_IDX
}

fn generate_constant_bool(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let b = node.tag == ast.tag.true_lit
    let type_idx = intern.BOOL_TYPE_IDX
    s.ip, let bool_idx = try intern.make_const_bool(s.ip, b)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: bool_idx, y: type_idx})
    return s, ir.index(u32(len(s.ins)-1)), types.BOOL_IDX
}

fn generate_constant_string(s *semsis, idx ast.index)! *semsis, ir.index, types.index {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let str_literal = try ast.get_string_literal(s.ast, node)


    let str_len = u64(len(str_literal))
    s.ip, let len_const_idx = try intern.make_const_u64(s.ip, str_len)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: len_const_idx, y: intern.U64_TYPE_IDX})
    let len_ir = ir.index(u32(len(s.ins)-1))


    s.ip, let u8_arr_type = try intern.make_array_type(s.ip, intern.U8_TYPE_IDX)
    s.ip, let u8_arr_ptr_type = try intern.make_pointer_type(s.ip, u8_arr_type)
    s.ip, let str_idx = try intern.intern_string(s.ip, str_literal)
    s.ip, let align_const = try intern.make_const_u32(s.ip, 1)  // byte alignment
    let extra_start = u32(len(s.extra))
    s.extra = try append(s.extra, u32(str_idx))
    s.extra = try append(s.extra, u32(align_const))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const_array, x: extra_start, y: u32(u8_arr_ptr_type)})
    let data_ir = ir.index(u32(len(s.ins)-1))


    s, let header_struct_type = try create_string_type(s)
    s, let header_ir = try generate_struct_literal(s, header_struct_type, [len_ir, data_ir], [intern.U64_TYPE_IDX, u8_arr_ptr_type])

    return s, header_ir, types.STRING_IDX
}

// create_string_type lowers the high-level "string" type to its IR representation.
// String is represented as an anonymous struct: {len: u64, data: *[]u8}
fn create_string_type(s *semsis)! *semsis, intern.index {
    var s = s


    s.ip, let raw_arr_type = try intern.make_array_type(s.ip, intern.U8_TYPE_IDX)
    s.ip, let arr_ptr_type = try intern.make_pointer_type(s.ip, raw_arr_type)
    s.ip, let header_type = try intern.make_anon_struct_type(s.ip, [intern.U64_TYPE_IDX, arr_ptr_type])
    return s, header_type
}

// create_array_type lowers a high-level array type []T to its IR representation.
// Array is represented as an anonymous struct: {len: u64, data: *[]T}
fn create_array_type(s *semsis, elem_type intern.index)! *semsis, intern.index {
    var s = s


    s.ip, let raw_arr_type = try intern.make_array_type(s.ip, elem_type)
    s.ip, let arr_ptr_type = try intern.make_pointer_type(s.ip, raw_arr_type)
    s.ip, let header_type = try intern.make_anon_struct_type(s.ip, [intern.U64_TYPE_IDX, arr_ptr_type])
    return s, header_type
}

// generate_alloca generates an alloca instruction for single element allocation
// alloca(type, alignment) - x is type, y is alignment
// returns the alloca instruction index, which can be used as "pointer" to
// memory allocation
fn generate_alloca(s *semsis, type_idx intern.index)! *semsis, ir.index {
    var s = s

    // TODO: alignment should be based on type
    s.ip, let align_const = try intern.make_const_u32(s.ip, 8)

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.alloca, x: u32(type_idx), y: u32(align_const)})
    return s, ir.index(u32(len(s.ins)-1))
}

// generate_alloca_array generates an alloca_array instruction for array allocation
// alloca_array uses extras: [array_type, element_count, alignment]
// count_idx is an ir.index pointing to an instruction that computes the count
// returns the alloca instruction index, which can be used as "pointer" to
// memory allocation
fn generate_alloca_array(s *semsis, elem_type intern.index, count_idx ir.index)! *semsis, ir.index {
    var s = s

    s.ip, let array_type = try intern.make_array_type(s.ip, elem_type)

    // TODO: alignment should be based on type
    s.ip, let align_const = try intern.make_const_u32(s.ip, 8)

    let extra_start = u32(len(s.extra))
    s.extra = try append(s.extra, u32(array_type))
    s.extra = try append(s.extra, u32(count_idx))
    s.extra = try append(s.extra, u32(align_const))
    let extra_end = u32(len(s.extra))

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.alloca_array, x: extra_start, y: extra_end})
    return s, ir.index(u32(len(s.ins)-1))
}

// generate_struct_literal creates IR instructions for struct allocation and initialisation
// using pattern: alloca -> gep + store for each field
fn generate_struct_literal(s *semsis, struct_type intern.index, field_irs []ir.index, field_types []intern.index)! *semsis, ir.index {
    var s = s

    s, let alloca_ir = try generate_alloca(s, struct_type)

    for i = u32(0); i < u32(len(field_irs)); i++ {
        let field_ir = try get(field_irs, i)
        let field_type = try get(field_types, i)

        let is_struct = try is_struct_type(s, field_type)
        let is_alloca_inst = try is_alloca(s, field_ir)

        var value_ir = field_ir
        if is_struct && is_alloca_inst {
            // load the struct value before storing
            s, value_ir = try generate_load(s, field_ir, field_type)
        }

        s, let gep_idx = try generate_gep(s, alloca_ir, i, field_type)
        s, let store_idx = try generate_store(s, gep_idx, value_ir)
    }

    return s, alloca_ir
}

// fits_in_slot checks if a semantic type fits within a slot of the given IR type.
// The slot_type must be a slot[T] where T is an unsigned integer type.
fn fits_in_slot(s *semsis, slot_type intern.index, sem_type types.index)! bool {
    let slot_item = try intern.lookup(s.ip, slot_type)
    try assert(slot_item.tag == intern.tag.slot_type, "expected slot_type")

    let inner_type = intern.index(slot_item.x)

    // TODO: support different slot sizes based on inner_type
    try assert(inner_type == intern.U64_TYPE_IDX, "only u64 slots supported")

    // determine which types fit in 8 bytes
    let st = try types.lookup(s.tp, sem_type)
    match st.tag {
    case types.tag.u8_type, types.tag.u16_type, types.tag.u32_type, types.tag.u64_type,
         types.tag.i8_type, types.tag.i16_type, types.tag.i32_type, types.tag.i64_type,
         types.tag.f32_type, types.tag.f64_type, types.tag.bool_type, types.tag.char_type:
        return true
    case types.tag.pointer_type:
        return true
    // enums are at most u32
    case types.tag.enum_type:
        return true
    case types.tag.many_type:
        return false
    case _:
        return false
    }
}

// generate_union_construction creates IR for wrapping a value in a union type.
// Union layout: struct { tag: u32, data: u64 }
// If value fits in pointer size, stored directly; otherwise data is a pointer.
fn generate_union_construction(s *semsis, value_ir ir.index, value_sem_type types.index, union_sem_type types.index, tag_value u32)! *semsis, ir.index {
    var s = s

    s, let union_ir_type = try lower_semantic_to_ir(s, union_sem_type)
    s, let union_ptr = try generate_alloca(s, union_ir_type)

    s.ip, let tag_const = try intern.make_const_u32(s.ip, tag_value)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: tag_const, y: intern.U32_TYPE_IDX})
    let tag_ir = ir.index(u32(len(s.ins)-1))

    s, let tag_gep = try generate_gep(s, union_ptr, 0, intern.U32_TYPE_IDX)
    s, let _ = try generate_store(s, tag_gep, tag_ir)

    s.ip, let slot_u64_type = try intern.make_slot_type(s.ip, intern.U64_TYPE_IDX)
    s, let data_gep = try generate_gep(s, union_ptr, 1, slot_u64_type)

    if try fits_in_slot(s, slot_u64_type, value_sem_type) {
        s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: value_ir, y: slot_u64_type})
        let data_val = ir.index(u32(len(s.ins)-1))
        s, let _ = try generate_store(s, data_gep, data_val)
    } else {
        // get pointer to value and store as slot[u64]
        var value_ptr = value_ir
        if !try is_alloca(s, value_ir) {
            // Allocate space and store the value
            s, let value_ir_type = try lower_semantic_to_ir(s, value_sem_type)
            s, value_ptr = try generate_alloca(s, value_ir_type)
            s, let _ = try generate_store(s, value_ptr, value_ir)
        }
        s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: value_ptr, y: slot_u64_type})
        let data_ptr = ir.index(u32(len(s.ins)-1))
        s, let _ = try generate_store(s, data_gep, data_ptr)
    }

    return s, union_ptr
}

// generate_select generates a select instruction: cond ? true_val : false_val
fn generate_select(s *semsis, cond_ir ir.index, true_ir ir.index, false_ir ir.index)! *semsis, ir.index {
    var s = s
    let extra_start = u32(len(s.extra))
    s.extra = try append(s.extra, u32(true_ir))
    s.extra = try append(s.extra, u32(false_ir))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.select, x: u32(cond_ir), y: extra_start})
    return s, ir.index(u32(len(s.ins)-1))
}

// generate_union_selection generates IR for Union -> ?T selection.
// Checks if union.tag == expected_tag, returns some(value) or none.
// Uses lazy branching to avoid loading data when tag doesn't match.
fn generate_union_selection(s *semsis, union_ir ir.index, target_sem_type types.index, expected_tag u32)! *semsis, ir.index, types.index {
    var s = s

    s, let target_ir_type = try lower_semantic_to_ir(s, target_sem_type)

    s.tp, let optional_sem_type = try types.make_optional(s.tp, target_sem_type)
    s.ip, let optional_ir_type = try intern.make_anon_struct_type(s.ip, [intern.BOOL_TYPE_IDX, target_ir_type])

    s, let tag_gep = try generate_gep(s, union_ir, 0, intern.U32_TYPE_IDX)
    s, let tag_val = try generate_load(s, tag_gep, intern.U32_TYPE_IDX)

    s.ip, let expected_tag_const = try intern.make_const_u32(s.ip, expected_tag)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: expected_tag_const, y: intern.U32_TYPE_IDX})
    let expected_tag_ir = ir.index(u32(len(s.ins)-1))

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.eq, x: u32(tag_val), y: u32(expected_tag_ir)})
    let cond_ir = ir.index(u32(len(s.ins)-1))

    let func_fqn = s.current_func_fqn

    s, let match_fqn = try reserve_block(s, func_fqn)
    s, let mismatch_fqn = try reserve_block(s, func_fqn)
    s, let merge_fqn = try reserve_block(s, func_fqn)

    s = try generate_br(s, cond_ir, match_fqn, mismatch_fqn)

    s.ip, let slot_u64_type = try intern.make_slot_type(s.ip, intern.U64_TYPE_IDX)

    s, let _ = try generate_block(s, match_fqn)

    s, let data_gep = try generate_gep(s, union_ir, 1, slot_u64_type)
    s, let data_slot = try generate_load(s, data_gep, slot_u64_type)

    var value_ir = ir.NULL_IDX
    if try fits_in_slot(s, slot_u64_type, target_sem_type) {
        s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: u32(data_slot), y: u32(target_ir_type)})
        value_ir = ir.index(u32(len(s.ins)-1))
    } else {
        s.ip, let ptr_target_type = try intern.make_pointer_type(s.ip, target_ir_type)
        s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: u32(data_slot), y: u32(ptr_target_type)})
        let typed_ptr = ir.index(u32(len(s.ins)-1))
        s, value_ir = try generate_load(s, typed_ptr, target_ir_type)
    }
    s = try generate_jmp_with_args(s, merge_fqn, [value_ir])

    s, let _ = try generate_block(s, mismatch_fqn)
    s, let poison_ir = try generate_poison(s, target_ir_type)
    s = try generate_jmp_with_args(s, merge_fqn, [poison_ir])

    s, let _, let block_arg_indices = try generate_block_with_args(s, merge_fqn, [target_ir_type])
    let selected_value = try get(block_arg_indices, 0)

    s, let result_ptr = try generate_alloca(s, optional_ir_type)

    s, let field0_gep = try generate_gep(s, result_ptr, 0, intern.BOOL_TYPE_IDX)
    s, let _ = try generate_store(s, field0_gep, cond_ir)

    s, let field1_gep = try generate_gep(s, result_ptr, 1, target_ir_type)
    s, let _ = try generate_store(s, field1_gep, selected_value)

    return s, result_ptr, optional_sem_type
}

// generate_many_construction creates IR for wrapping a value in a 'many' type.
// Many layout: struct { type_desc: u32, data: slot[u64] }
fn generate_many_construction(s *semsis, value_ir ir.index, value_sem_type types.index)! *semsis, ir.index, types.index {
    var s = s

    // don't double-wrap any
    if try types.is_many(s.tp, value_sem_type) {
        return s, value_ir, types.MANY_IDX
    }

    s, let many_ir_type = try lower_semantic_to_ir(s, types.MANY_IDX)

    s, let many_ptr = try generate_alloca(s, many_ir_type)

    let value_ir_type = try get_type(s, value_ir)
    s.ip, let type_desc_const = try intern.make_const_u32(s.ip, u32(value_sem_type))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: type_desc_const, y: intern.U32_TYPE_IDX})
    let type_desc_ir = ir.index(u32(len(s.ins)-1))

    s, let desc_gep = try generate_gep(s, many_ptr, 0, intern.U32_TYPE_IDX)
    s, let _ = try generate_store(s, desc_gep, type_desc_ir)

    s.ip, let slot_u64_type = try intern.make_slot_type(s.ip, intern.U64_TYPE_IDX)
    s, let data_gep = try generate_gep(s, many_ptr, 1, slot_u64_type)

    if try fits_in_slot(s, slot_u64_type, value_sem_type) {
        s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: value_ir, y: slot_u64_type})
        let data_val = ir.index(u32(len(s.ins)-1))
        s, let _ = try generate_store(s, data_gep, data_val)
    } else {
        var value_ptr = value_ir
        let value_ir_type = try get_type(s, value_ir)
        let is_already_ptr = try intern.is_pointer(s.ip, value_ir_type)
        let is_al = try is_alloca(s, value_ir)
        if !is_al && !is_already_ptr {
            // allocate space and store the value when not already pointer
            s, let lowered_type = try lower_semantic_to_ir(s, value_sem_type)
            s, value_ptr = try generate_alloca(s, lowered_type)
            s, let _ = try generate_store(s, value_ptr, value_ir)
        }
        s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: value_ptr, y: slot_u64_type})
        let data_ptr = ir.index(u32(len(s.ins)-1))
        s, let _ = try generate_store(s, data_gep, data_ptr)
    }

    return s, many_ptr, types.MANY_IDX
}

// generate_many_selection generates IR for many -> ?T extraction.
// Checks if many.type_desc == expected_type_desc, returns some(value) or none.
// Uses lazy branching to avoid loading data when type doesn't match.
fn generate_many_selection(s *semsis, many_ir ir.index, target_sem_type types.index)! *semsis, ir.index, types.index {
    var s = s

    s, let target_ir_type = try lower_semantic_to_ir(s, target_sem_type)

    s.tp, let optional_sem_type = try types.make_optional(s.tp, target_sem_type)
    s.ip, let optional_ir_type = try intern.make_anon_struct_type(s.ip, [intern.BOOL_TYPE_IDX, target_ir_type])

    s, let desc_gep = try generate_gep(s, many_ir, 0, intern.U32_TYPE_IDX)
    s, let desc_val = try generate_load(s, desc_gep, intern.U32_TYPE_IDX)

    s.ip, let expected_desc_const = try intern.make_const_u32(s.ip, u32(target_sem_type))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: expected_desc_const, y: intern.U32_TYPE_IDX})
    let expected_desc_ir = ir.index(u32(len(s.ins)-1))

    s.ins = try append(s.ins, ir.inst{tag: ir.tag.eq, x: u32(desc_val), y: u32(expected_desc_ir)})
    let cond_ir = ir.index(u32(len(s.ins)-1))

    let func_fqn = s.current_func_fqn

    s, let match_fqn = try reserve_block(s, func_fqn)
    s, let mismatch_fqn = try reserve_block(s, func_fqn)
    s, let merge_fqn = try reserve_block(s, func_fqn)

    s = try generate_br(s, cond_ir, match_fqn, mismatch_fqn)

    s.ip, let slot_u64_type = try intern.make_slot_type(s.ip, intern.U64_TYPE_IDX)

    s, let _ = try generate_block(s, match_fqn)

    s, let data_gep = try generate_gep(s, many_ir, 1, slot_u64_type)
    s, let data_slot = try generate_load(s, data_gep, slot_u64_type)

    var value_ir = ir.NULL_IDX
    if try fits_in_slot(s, slot_u64_type, target_sem_type) {
        s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: u32(data_slot), y: u32(target_ir_type)})
        value_ir = ir.index(u32(len(s.ins)-1))
    } else {
        s.ip, let ptr_target_type = try intern.make_pointer_type(s.ip, target_ir_type)
        s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: u32(data_slot), y: u32(ptr_target_type)})
        let typed_ptr = ir.index(u32(len(s.ins)-1))
        s, value_ir = try generate_load(s, typed_ptr, target_ir_type)
    }
    s = try generate_jmp_with_args(s, merge_fqn, [value_ir])

    s, let _ = try generate_block(s, mismatch_fqn)
    s, let poison_ir = try generate_poison(s, target_ir_type)
    s = try generate_jmp_with_args(s, merge_fqn, [poison_ir])

    s, let _, let block_arg_indices = try generate_block_with_args(s, merge_fqn, [target_ir_type])
    let selected_value = try get(block_arg_indices, 0)

    s, let result_ptr = try generate_alloca(s, optional_ir_type)

    s, let field0_gep = try generate_gep(s, result_ptr, 0, intern.BOOL_TYPE_IDX)
    s, let _ = try generate_store(s, field0_gep, cond_ir)

    s, let field1_gep = try generate_gep(s, result_ptr, 1, target_ir_type)
    s, let _ = try generate_store(s, field1_gep, selected_value)

    return s, result_ptr, optional_sem_type
}

// generate_array_literal creates IR instructions for array allocation and initialisation
// Returns a pointer to a header struct [u64, *[]T] containing length and array pointer
fn generate_array_literal(s *semsis, elem_type intern.index, elem_irs []ir.index)! *semsis, ir.index {
    var s = s

    s.ip, let count_const = try intern.make_const_u64(s.ip, u64(len(elem_irs)))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: count_const, y: intern.U64_TYPE_IDX})
    let count_idx = ir.index(u32(len(s.ins)-1))

    s, let array_ptr = try generate_alloca_array(s, elem_type, count_idx)

    for i = u32(0); i < u32(len(elem_irs)); i++ {
        let elem_ir = try get(elem_irs, i)

        let is_struct = try is_struct_type(s, elem_type)
        let is_alloca_inst = try is_alloca(s, elem_ir)

        var value_ir = elem_ir
        if is_struct && is_alloca_inst {
            // load the struct value before storing
            s, value_ir = try generate_load(s, elem_ir, elem_type)
        }

        s, let gep_idx = try generate_gep(s, array_ptr, i, elem_type)
        s, let _ = try generate_store(s, gep_idx, value_ir)
    }

    s, let header_struct_type = try create_array_type(s, elem_type)

    s.ip, let raw_array_type = try intern.make_array_type(s.ip, elem_type)
    s.ip, let ptr_type = try intern.make_pointer_type(s.ip, raw_array_type)

    s, let header_ptr = try generate_alloca(s, header_struct_type)

    s, let len_gep = try generate_gep(s, header_ptr, 0, intern.U64_TYPE_IDX)
    s, let _ = try generate_store(s, len_gep, count_idx)

    s, let ptr_gep = try generate_gep(s, header_ptr, 1, ptr_type)
    s, let _ = try generate_store(s, ptr_gep, array_ptr)

    return s, header_ptr
}

// generate_gep creates a GEP (get element pointer) instruction for structs or arrays
fn generate_gep(s *semsis, agg_ptr ir.index, agg_idx u32, elem_type intern.index)! *semsis, ir.index {
    var s = s

    s.ip, let idx_const = try intern.make_const_u32(s.ip, agg_idx)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: idx_const, y: intern.U32_TYPE_IDX})
    let idx_ir = ir.index(u32(len(s.ins)-1))

    let extra_start = u32(len(s.extra))
    s.extra = try append(s.extra, u32(agg_ptr))
    s.extra = try append(s.extra, u32(idx_ir))

    s.ip, let ptr_type = try intern.make_pointer_type(s.ip, elem_type)

    // x points to extras [agg_ptr, agg_idx]
    // y is pointer to element type
    s.ins = try append(s.ins, ir.inst{
        tag: ir.tag.gep,
        x: extra_start,
        y: ptr_type
    })

    return s, ir.index(u32(len(s.ins)-1))
}

fn generate_gep_dynamic(s *semsis, agg_ptr ir.index, idx_ir ir.index, elem_type intern.index)! *semsis, ir.index {
    var s = s

    let extra_start = u32(len(s.extra))
    s.extra = try append(s.extra, u32(agg_ptr))
    s.extra = try append(s.extra, u32(idx_ir))

    s.ip, let ptr_type = try intern.make_pointer_type(s.ip, elem_type)

    s.ins = try append(s.ins, ir.inst{
        tag: ir.tag.gep,
        x: extra_start,
        y: ptr_type
    })

    return s, ir.index(u32(len(s.ins)-1))
}

// generate_store creates a store instruction
fn generate_store(s *semsis, ptr ir.index, value ir.index)! *semsis, ir.index {
    var s = s
    s.ins = try append(s.ins, ir.inst{
        tag: ir.tag.store,
        x: ptr,
        y: value
    })
    return s, ir.index(u32(len(s.ins)-1))
}

// generate_load creates a load instruction
fn generate_load(s *semsis, ptr ir.index, value_type intern.index)! *semsis, ir.index {
    var s = s
    s.ins = try append(s.ins, ir.inst{
        tag: ir.tag.load,
        x: ptr,
        y: value_type
    })
    return s, ir.index(u32(len(s.ins)-1))
}

// is_alloca checks if an IR instruction is an alloca instruction
fn is_alloca(s *semsis, idx ir.index)! bool {
    let inst = try get(s.ins, idx)
    return inst.tag == ir.tag.alloca
}

// is_struct_type checks if a type is a struct type (includes nested structs)
fn is_struct_type(s *semsis, type_idx intern.index)! bool {
    let item = try intern.lookup(s.ip, type_idx)
    return match item.tag {
        case intern.tag.struct_type,
             intern.tag.struct_generic_type,
             intern.tag.anon_struct_type:
            true
        case _: false
    }
}

// is_aggregate_ir_type checks if an IR type is an aggregate (struct/array, not primitive or pointer)
fn is_aggregate_ir_type(s *semsis, type_idx intern.index)! bool {
    let item = try intern.lookup(s.ip, type_idx)
    return match item.tag {
        case intern.tag.struct_type,
             intern.tag.struct_generic_type,
             intern.tag.anon_struct_type,
             intern.tag.array_type:
            true
        case _: false
    }
}

// rule_one_argument_in_cast validates that exactly one argument is provided for type cast
fn rule_one_argument_in_cast(s *semsis, args_idx ast.index, pos ast.index)! *semsis, bool {
    var s = s
    if args_idx == ast.NULL_IDX {
        s = try add_error(s, too_few_arguments{
            expected: 1,
            found: 0,
            pos: pos,
        })
        return s, false
    }

    let args_node = try get(s.ast.nodes, args_idx)
    let arg_count = u16(args_node.data.y - args_node.data.x)

    if arg_count != 1 {
        s = try add_error(s, too_many_arguments{
            expected: 1,
            found: arg_count,
            pos: pos,
        })
        return s, false
    }

    return s, true
}

// rule_is_castable_to validates that a cast between two semantic types is legal.
// Uses semantic types for proper type distinction.
fn rule_is_castable_to(s *semsis, from_sem_type, to_sem_type types.index, pos ast.index)! bool {
    let from_is_int = try types.is_integer(s.tp, from_sem_type)
    let from_is_float = try types.is_float(s.tp, from_sem_type)
    let from_is_bool = try types.is_bool(s.tp, from_sem_type)
    let from_is_char = try types.is_char(s.tp, from_sem_type)

    let to_is_int = try types.is_integer(s.tp, to_sem_type)
    let to_is_float = try types.is_float(s.tp, to_sem_type)
    let to_is_char = try types.is_char(s.tp, to_sem_type)

    // int <-> int: allowed
    // int <-> float: allowed
    // int <-> char: allowed
    // float <-> float: allowed
    // bool -> int: allowed
    // bool -> float: allowed
    // char <-> int: allowed

    if from_is_int && (to_is_int || to_is_float || to_is_char) {
        return true
    }

    if from_is_float && (to_is_int || to_is_float) {
        return true
    }

    if from_is_bool && (to_is_int || to_is_float) {
        return true
    }

    if from_is_char && (to_is_int || to_is_char) {
        return true
    }
    return false
}

// generate_cast generates a cast instruction
fn generate_cast(s *semsis, value_ir ir.index, target_type intern.index)! *semsis, ir.index {
    var s = s
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.cast, x: value_ir, y: target_type})
    return s, ir.index(u32(len(s.ins)-1))
}

// apply_type_conversion applies necessary type conversions to make value_ir match expected_type
// handles: T -> ?T wrapping, constant coercion, and combinations
// should be called after rule_is_assignable_to succeeds
fn apply_type_conversion(s *semsis, value_ir ir.index, value_sem_type, expected_sem_type types.index)! *semsis, ir.index {
    var s = s

    // types already match - no conversion needed
    if value_sem_type == expected_sem_type {
        return s, value_ir
    }

    // T -> ?T wrapping using semantic types
    if try types.is_optional(s.tp, expected_sem_type) {
        let inner_sem_type = try types.get_optional_inner(s.tp, expected_sem_type)
        if value_sem_type == inner_sem_type {
            // direct wrap: T -> ?T
            return try generate_optional_wrap(s, value_ir, expected_sem_type)
        } else if try is_const(s, value_ir) {
            // cast then wrap: const T1 -> T2 -> ?T2
            s, let inner_ir_type = try lower_semantic_to_ir(s, inner_sem_type)
            s, let casted_ir = try generate_cast(s, value_ir, inner_ir_type)
            return try generate_optional_wrap(s, casted_ir, expected_sem_type)
        }
    }

    // custom_error → generic error wrapping
    let value_is_error = try types.is_error(s.tp, value_sem_type)
    if value_is_error && expected_sem_type == types.ERROR_IDX {
        return try generate_generic_error_literal(s, value_ir, value_sem_type)
    }

    // T -> any wrapping
    let to_is_many = try types.is_many(s.tp, expected_sem_type)
    if to_is_many && !try types.is_many(s.tp, value_sem_type) {
        s, let many_ir, let _ = try generate_many_construction(s, value_ir, value_sem_type)
        return s, many_ir
    }

    // constant coercion for non-optional types
    if try is_const(s, value_ir) {
        s, let expected_ir_type = try lower_semantic_to_ir(s, expected_sem_type)
        let value_ir_type = try get_type(s, value_ir)
        if value_ir_type == expected_ir_type {
            return s, value_ir
        }
        return try generate_cast(s, value_ir, expected_ir_type)
    }

    // no conversion possible, should not reach here if rule_is_assignable_to succeeded
    return s, value_ir
}

// generate_optional_wrap wraps a value into an optional type using semantic types
// creates anonymous struct { is_valid: bool, value: T } with is_valid=true
fn generate_optional_wrap(s *semsis, value_ir ir.index, optional_sem_type types.index)! *semsis, ir.index {
    var s = s

    let inner_sem_type = try types.get_optional_inner(s.tp, optional_sem_type)
    s, let inner_ir_type = try lower_semantic_to_ir(s, inner_sem_type)


    s.ip, let struct_ir_type = try intern.make_anon_struct_type(s.ip, [intern.BOOL_TYPE_IDX, inner_ir_type])

    s.ip, let true_idx = try intern.make_const_bool(s.ip, true)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: true_idx, y: intern.BOOL_TYPE_IDX})
    let is_valid_ir = ir.index(u32(len(s.ins)-1))

    s, let result_ir = try generate_struct_literal(s, struct_ir_type, [is_valid_ir, value_ir], [intern.BOOL_TYPE_IDX, inner_ir_type])

    return s, result_ir
}

// generate_generic_error_literal wraps a custom error into a generic error struct
// creates struct { type_desc: u32, data: slot[u64] } where:
// - type_desc is the types.index of the custom error type
// - data is the custom error pointer cast to slot[u64]
fn generate_generic_error_literal(s *semsis, value_ir ir.index, custom_error_sem_type types.index)! *semsis, ir.index {
    var s = s

    let value_ir_type = try get_type(s, value_ir)
    try assert(try intern.is_pointer(s.ip, value_ir_type), "bitcast requires pointer type")

    s.ip, let type_desc_const = try intern.make_const_u32(s.ip, u32(custom_error_sem_type))
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: type_desc_const, y: intern.U32_TYPE_IDX})
    let type_desc_ir = ir.index(u32(len(s.ins)-1))

    s.ip, let slot_u64_type = try intern.make_slot_type(s.ip, intern.U64_TYPE_IDX)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.bitcast, x: value_ir, y: slot_u64_type})
    let data_ir = ir.index(u32(len(s.ins)-1))

    s.ip, let error_struct_type = try intern.make_anon_struct_type(s.ip, [intern.U32_TYPE_IDX, slot_u64_type])

    return try generate_struct_literal(
        s,
        error_struct_type,
        [type_desc_ir, data_ir],
        [intern.U32_TYPE_IDX, slot_u64_type]
    )
}

// get_scope_idx looks up a type by FQN and returns its scope index
pub fn get_scope_idx(s *semsis, scope_idx namespace.index, fqn string)! ?namespace.index {
    let _, let idx = try intern.intern_string(s.ip, fqn)
    let entry_idx_opt = try namespace.lookup(s.np, scope_idx, idx)
    if entry_idx_opt == null {
        return null
    }

    let entry = try namespace.get_entry(s.np, ?entry_idx_opt)
    match e = entry {
    case namespace.scope:
        return ?entry_idx_opt
    case _:
        return null
    }
}

// get_value looks up a value by name in a scope
// can be used to find variables, function parameters
pub fn get_value(s *semsis, scope_idx namespace.index, name string)! ?namespace.value {
    let _, let idx = try intern.intern_string(s.ip, name)
    let entry_idx_opt = try namespace.lookup(s.np, scope_idx, idx)
    if entry_idx_opt == null {
        return null
    }
    let entry = try namespace.get_entry(s.np, ?entry_idx_opt)
    match e = entry {
    case namespace.value:
        return e
    case namespace.linear_value:
        return namespace.value{
            is_reassignable: e.is_reassignable,
            name: e.name,
            type_idx: e.type_idx,
            index: e.index,
        }
    case _:
        return null
    }
}

// get_type_idx looks up a type by FQN and returns its type index
pub fn get_type_idx(s *semsis, scope_idx namespace.index, fqn string)! ?types.index {
    let _, let idx = try intern.intern_string(s.ip, fqn)
    let entry_idx_opt = try namespace.lookup(s.np, scope_idx, idx)
    if entry_idx_opt == null {
        return null
    }
    let entry = try namespace.get_entry(s.np, ?entry_idx_opt)
    let sem_type = namespace.get_type_idx(entry)
    if sem_type == types.NULL_IDX {
        return null
    }
    return sem_type
}

// get_type_scope looks up a type's namespace scope index from the parent namespace
fn get_type_scope(ip *intern.pool, np *namespace.pool, current_idx namespace.index, fqn string)! intern.index, ?namespace.index {
    let _, let name_idx = try intern.intern_string(ip, fqn)
    let entry_idx_opt = try namespace.lookup(np, current_idx, name_idx)
    if entry_idx_opt == null {
        return name_idx, null
    }

    let entry = try namespace.get_entry(np, ?entry_idx_opt)
    match e = entry {
    case namespace.scope:
        return name_idx, ?entry_idx_opt
    case _:
        return name_idx, null
    }
}

// get_effective_type_for_operators returns the type to use for operator validation.
// For type_def types, returns the underlying type (recursively unwrapped).
// For other types, returns the type unchanged.
fn get_effective_type_for_operators(s *semsis, sem_type types.index)! types.index {
    if try types.is_type_def(s.tp, sem_type) {
        let underlying = try types.get_type_def_underlying(s.tp, sem_type)
        if underlying == types.NULL_IDX {
            return sem_type
        }
        return try get_effective_type_for_operators(s, underlying)
    }
    return sem_type
}

fn get_type(s *semsis, idx ir.index)! intern.index {
    let tmp_ir = &ir.ir{
        ins:    s.ins,
        extra:  s.extra,
        errs:   []
    }
    return try ir.get_type(tmp_ir, idx)
}

// extract_single_return_value extracts value from single-return function calls
// Returns error if a multi-value return type is used in an expression context
// expr_pos should point to the expression that produced the return type (e.g., the function call)
fn extract_single_return_value(s *semsis, ir_idx ir.index, expr_pos ast.index)! *semsis, ir.index {
    var s = s

    let typ = try get_type(s, ir_idx)
    if !try intern.is_return_type(s.ip, typ) {
        return s, ir_idx
    }

    let count = try intern.get_return_type_count(s.ip, typ)
    if count == 1 {
        return try generate_return_type_extract(s, ir_idx, 0)
    }

    s = try add_error(s, multi_value_in_expression{pos: expr_pos})
    return s, ir.NULL_IDX
}

fn is_const(s *semsis, idx ir.index)! bool {
    let tmp_ir = &ir.ir{
        ins:    s.ins,
        extra:  s.extra,
        errs:   []
    }
    return try ir.is_const(tmp_ir, idx)
}

// generate_poison creates a poison value of the given IR type
// it's illegal to read this value and will get propagated during optimisations
fn generate_poison(s *semsis, ir_type intern.index)! *semsis, ir.index {
    var s = s
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.poison, x: ir_type, y: ir.NULL_IDX})
    return s, ir.index(u32(len(s.ins)-1))
}

// generate_none creates a null optional value as a struct { is_valid: false, value: poison(T) }
// Takes semantic optional type and generates the struct literal with is_valid=false
fn generate_none(s *semsis, optional_sem_type types.index)! *semsis, ir.index {
    var s = s

    let inner_sem_type = try types.get_optional_inner(s.tp, optional_sem_type)
    s, let inner_ir_type = try lower_semantic_to_ir(s, inner_sem_type)

    s.ip, let struct_ir_type = try intern.make_anon_struct_type(s.ip, [intern.BOOL_TYPE_IDX, inner_ir_type])

    s.ip, let false_idx = try intern.make_const_bool(s.ip, false)
    s.ins = try append(s.ins, ir.inst{tag: ir.tag.const, x: false_idx, y: intern.BOOL_TYPE_IDX})
    let is_valid_ir = ir.index(u32(len(s.ins)-1))

    s, let value_ir = try generate_poison(s, inner_ir_type)

    return try generate_struct_literal(
        s,
        struct_ir_type,
        [is_valid_ir, value_ir],
        [intern.BOOL_TYPE_IDX, inner_ir_type]
    )
}

// make_fqn builds a fully qualified name from lib_path and identifier
fn make_fqn(lib_path string, ident string)! string {
    var fqn = try append(lib_path, "/")
    return try append(fqn, ident)
}

fn make_mono_fqn(s *semsis, base_fqn intern.index, concrete_types []types.index)! *semsis, intern.index {
    var s = s
    var name = intern.get_string(s.ip, base_fqn)
    for i = 0; i < len(concrete_types); i++ {
        let t = try get(concrete_types, i)
        let type_str = try types.to_string(s.tp, s.ip, t)
        name = try append(name, "$")
        name = try append(name, type_str)
    }
    if s.mode == mode.release {
        let base = intern.get_string(s.ip, base_fqn)
        let hash = try rapidhash.nano([]u8(name), u64(0))
        let hex = try u64_to_hex(hash)
        name = try append(base, "$")
        name = try append(name, hex)
    }
    s.ip, let fqn_idx = try intern.intern_string(s.ip, name)
    return s, fqn_idx
}

fn u64_to_hex(v u64)! string {
    var v = v
    let hex_chars = "0123456789abcdef"
    var buf = try make([]byte, 16, 16)
    for i = 15; i >= 0; i-- {
        let nibble = v & u64(0xf)
        buf = try put(buf, i, try get(hex_chars, nibble))
        v = v >> 4
    }
    return string(buf)
}

// reserve_block creates and interns a block FQN for the current function
fn reserve_block(s *semsis, func_fqn intern.index)! *semsis, intern.index {
    var s = s
    let func_name = try intern.get_string(s.ip, func_fqn)
    let block_num = try convert.to_string(s.block_counter)
    var block_fqn = try append(func_name, "/")
    block_fqn = try append(block_fqn, block_num)

    s.ip, let fqn_idx = try intern.intern_string(s.ip, block_fqn)

    return &semsis{..s, block_counter: s.block_counter + 1}, fqn_idx
}

fn generate_jmp(s *semsis, target_fqn intern.index)! *semsis {
    var s = s
    s.ins = try append(s.ins, ir.inst{
        tag: ir.tag.jmp,
        x: u32(target_fqn),
        y: ir.NULL_IDX
    })
    return s
}

// generate_jmp_with_args creates an unconditional jump with block arguments
fn generate_jmp_with_args(s *semsis, target_fqn intern.index, args []ir.index)! *semsis {
    var s = s
    if len(args) == 0 {
        return try generate_jmp(s, target_fqn)
    }
    let extra_start = u32(len(s.extra))
    // format: [count, arg1, arg2, ...]
    s.extra = try append(s.extra, u32(len(args)))
    for i = 0; i < len(args); i++ {
        let arg = try get(args, i)
        s.extra = try append(s.extra, u32(arg))
    }
    s.ins = try append(s.ins, ir.inst{
        tag: ir.tag.jmp,
        x: u32(target_fqn),
        y: extra_start
    })
    return s
}

fn generate_br(s *semsis, cond_ir ir.index, then_fqn, else_fqn intern.index)! *semsis {
    return try generate_br_with_args(s, cond_ir, then_fqn, [], else_fqn, [])
}

// generate_br_with_args creates a conditional branch with block arguments
// cond_ir: instruction producing bool value
// then_fqn: block to jump to if true
// then_args: values to pass to then block
// else_fqn: block to jump to if false
// else_args: values to pass to else block
fn generate_br_with_args(s *semsis, cond_ir ir.index,
                         then_fqn intern.index, then_args []ir.index,
                         else_fqn intern.index, else_args []ir.index)! *semsis {
    var s = s
    let extra_start = u32(len(s.extra))
    // format: [then_fqn, then_count, then_args..., else_fqn, else_count, else_args...]
    s.extra = try append(s.extra, u32(then_fqn))
    s.extra = try append(s.extra, u32(len(then_args)))
    for i = 0; i < len(then_args); i++ {
        let arg = try get(then_args, i)
        s.extra = try append(s.extra, u32(arg))
    }
    s.extra = try append(s.extra, u32(else_fqn))
    s.extra = try append(s.extra, u32(len(else_args)))
    for i = 0; i < len(else_args); i++ {
        let arg = try get(else_args, i)
        s.extra = try append(s.extra, u32(arg))
    }
    s.ins = try append(s.ins, ir.inst{
        tag: ir.tag.br,
        x: u32(cond_ir),
        y: extra_start
    })
    return s
}

// lower_semantic_to_ir converts a semantic type to its IR representation
// Primitives map 1:1, optionals become anon structs {bool, inner},
// arrays become {len: u64, elements: *[]T}
fn lower_semantic_to_ir(s *semsis, sem_type types.index)! *semsis, intern.index {
    var s = s

    if sem_type == types.NULL_IDX {
        return s, intern.NULL_IDX
    }

    let st = try types.lookup(s.tp, sem_type)

    match st.tag {
    // primitives
    case types.tag.u8_type:
        return s, intern.U8_TYPE_IDX
    case types.tag.u16_type:
        return s, intern.U16_TYPE_IDX
    case types.tag.u32_type:
        return s, intern.U32_TYPE_IDX
    case types.tag.u64_type:
        return s, intern.U64_TYPE_IDX
    case types.tag.i8_type:
        return s, intern.I8_TYPE_IDX
    case types.tag.i16_type:
        return s, intern.I16_TYPE_IDX
    case types.tag.i32_type:
        return s, intern.I32_TYPE_IDX
    case types.tag.i64_type:
        return s, intern.I64_TYPE_IDX
    case types.tag.f32_type:
        return s, intern.F32_TYPE_IDX
    case types.tag.f64_type:
        return s, intern.F64_TYPE_IDX
    case types.tag.bool_type:
        return s, intern.BOOL_TYPE_IDX
    case types.tag.char_type:
        return s, intern.U32_TYPE_IDX  
    // optional [bool, T]
    case types.tag.optional_type:
        let inner_sem_type = types.index(st.x)
        s, let inner_ir_type = try lower_semantic_to_ir(s, inner_sem_type)
        s.ip, let struct_type = try intern.make_anon_struct_type(s.ip, [intern.BOOL_TYPE_IDX, inner_ir_type])
        return s, struct_type
    case types.tag.pointer_type:
        let inner_sem_type = types.index(st.x)
        s, let inner_ir_type = try lower_semantic_to_ir(s, inner_sem_type)
        s.ip, let ptr_type = try intern.make_pointer_type(s.ip, inner_ir_type)
        return s, ptr_type
    // array [u64, *[]T]  (len, data_ptr)
    case types.tag.array_type:
        let inner_sem_type = types.index(st.x)
        s, let inner_ir_type = try lower_semantic_to_ir(s, inner_sem_type)
        s.ip, let arr_type = try intern.make_array_type(s.ip, inner_ir_type)
        s.ip, let ptr_type = try intern.make_pointer_type(s.ip, arr_type)
        s.ip, let struct_type = try intern.make_anon_struct_type(s.ip, [intern.U64_TYPE_IDX, ptr_type])
        return s, struct_type
    // string [u64, *[]u8]
    case types.tag.string_type:
        s, let str_type = try create_string_type(s)
        return s, str_type
    // any [u32, slot[u64]]
    case types.tag.many_type:
        s.ip, let any_slot_type = try intern.make_slot_type(s.ip, intern.U64_TYPE_IDX)
        s.ip, let any_struct = try intern.make_anon_struct_type(s.ip, [intern.U32_TYPE_IDX, any_slot_type])
        return s, any_struct
    case types.tag.memory_type:
        let inner_sem_type = types.index(st.x)
        return try lower_semantic_to_ir(s, inner_sem_type)
    case types.tag.type_def_type:
        let underlying = try types.get_type_def_underlying(s.tp, sem_type)
        if underlying == types.NULL_IDX {
            return s, intern.NULL_IDX
        }
        return try lower_semantic_to_ir(s, underlying)
    case types.tag.struct_type:
        // x contains FQN intern.index
        let fqn_idx = intern.index(st.x)
        s.ip, let ir_type = try intern.make_struct_type(s.ip, fqn_idx)
        return s, ir_type
    // enum
    case types.tag.enum_type:
        let variant_count = try types.get_enum_variant_count(s.tp, sem_type)
        if variant_count <= 255 {
            return s, intern.U8_TYPE_IDX
        } else if variant_count <= 65535 {
            return s, intern.U16_TYPE_IDX
        } else if variant_count <= 4294967295 {
            return s, intern.U32_TYPE_IDX
        }
        return s, intern.U64_TYPE_IDX
    // union [u32, slot[u64]]
    case types.tag.union_type:
        s.ip, let slot_type = try intern.make_slot_type(s.ip, intern.U64_TYPE_IDX)
        s.ip, let union_struct = try intern.make_anon_struct_type(s.ip, [intern.U32_TYPE_IDX, slot_type])
        return s, union_struct
    case types.tag.error_generic_type:
        s, let error_struct, let _ = try make_error_struct_type(s)
        return s, error_struct
    case types.tag.error_custom_type:
        // lowered like structs by their FQN
        let fqn_idx = intern.index(st.x)
        s.ip, let ir_type = try intern.make_struct_type(s.ip, fqn_idx)
        return s, ir_type
    case types.tag.function_type:
        let fqn_idx = intern.index(st.x)
        s.ip, let ir_type = try intern.make_function_type(s.ip, fqn_idx)
        return s, ir_type
    case types.tag.function_fallible_type:
        let fqn_idx = intern.index(st.x)
        s.ip, let ir_type = try intern.make_function_type(s.ip, fqn_idx)
        return s, ir_type
    case types.tag.function_generic_type:
        return s, intern.NULL_IDX
    case types.tag.function_generic_fallible_type:
        return s, intern.NULL_IDX
    case types.tag.struct_generic_type:
        return s, intern.NULL_IDX
    case _:
        return s, intern.NULL_IDX
    }
}

// lower_fn_param_type_to_ir converts a semantic type to an IR type for function parameters.
// Aggregate types (structs, arrays) are automatically converted to pointer types
// since they are passed by reference in the ABI.
fn lower_fn_param_type_to_ir(s *semsis, sem_type types.index)! *semsis, intern.index {
    var s = s
    s, var ir_type = try lower_semantic_to_ir(s, sem_type)

    if try is_aggregate_ir_type(s, ir_type) {
        s.ip, ir_type = try intern.make_pointer_type(s.ip, ir_type)
    }

    return s, ir_type
}

// count_union_matches counts how many union variants the source type can be assigned to.
// Returns the count and the matching variant's field index (if exactly one match).
// Used for ambiguity detection during union construction.
fn count_union_matches(s *semsis, from_type types.index, union_sem_type types.index)! u32, u32 {
    let subtype_count = try types.get_union_subtype_count(s.tp, union_sem_type)
    var count = u32(0)
    var matching_field_idx = u32(0)

    for i = u32(0); i < subtype_count; i++ {
        let subtype_info_opt = try types.get_union_subtype_by_index(s.tp, union_sem_type, i)
        if subtype_info_opt == null {
            next
        }
        let subtype_info = ?subtype_info_opt

        if from_type == subtype_info.type_idx {
            count = count + 1
            matching_field_idx = subtype_info.idx
        }
    }

    return count, matching_field_idx
}

fn add_error(s *semsis, err error)! *semsis {
    let errs = try append(s.errs, err)
    return &semsis{..s, errs: errs}
}

fn analyse_break(s *semsis, idx ast.index, is_last bool)! *semsis, bool {
    var s = s
    if s.loop_ctx == null {
        s = try add_error(s, break_outside_loop{pos: idx})
        return s, false
    }
    if !is_last {
        s = try add_error(s, keyword_not_last_instruction{pos: idx})
        return s, false
    }
    let ctx = ?s.loop_ctx

    let defer_top = try get(s.defer_stack, len(s.defer_stack) - 1)
    let defer_end = defer_top.end_idx
    if defer_end > ctx.defer_start_idx {
        s = try generate_defer_cleanup_range(s, ctx.defer_start_idx, defer_end)
    }

    let exit_args = try collect_args_for_vars(s, ctx.exit_join.var_ids)
    s = try generate_jmp_with_args(s, ctx.exit_fqn, exit_args)
    return s, true
}

fn analyse_next(s *semsis, idx ast.index, is_last bool)! *semsis, bool {
    var s = s
    if s.loop_ctx == null {
        s = try add_error(s, next_outside_loop{pos: idx})
        return s, false
    }
    if !is_last {
        s = try add_error(s, keyword_not_last_instruction{pos: idx})
        return s, false
    }
    let ctx = ?s.loop_ctx

    let defer_top = try get(s.defer_stack, len(s.defer_stack) - 1)
    let defer_end = defer_top.end_idx
    if defer_end > ctx.defer_start_idx {
        s = try generate_defer_cleanup_range(s, ctx.defer_start_idx, defer_end)
    }

    if ctx.incr_idx != ast.NULL_IDX {
        s, let _ = try analyse_assignment(s, ctx.incr_idx)
    }

    let header_args = try collect_args_for_vars(s, ctx.header_join.var_ids)
    s = try generate_jmp_with_args(s, ctx.continue_fqn, header_args)
    return s, true
}

fn analyse_for_stmt(s *semsis, idx ast.index, func_fqn intern.index)! *semsis, ir.index, bool {
    let node = try get(s.ast.nodes, idx)
    match node.tag {
    case ast.tag.for_infinite:
        return try analyse_for_infinite(s, idx, func_fqn)
    case ast.tag.for_bool:
        return try analyse_for_bool(s, idx, func_fqn)
    case ast.tag.for_classic:
        return try analyse_for_classic(s, idx, func_fqn)
    case ast.tag.for_range:
        return try analyse_for_range(s, idx, func_fqn)
    case _:
        return s, ir.NULL_IDX, false
    }
}

// analyse_for_infinite handles `for { body }` loops
// Structure: 2 blocks (header, exit)
//   current -> header <--+
//               |        |
//               +--------+ (back-edge from body end or next)
//               v (break)
//             exit
fn analyse_for_infinite(s *semsis, idx ast.index, func_fqn intern.index)! *semsis, ir.index, bool {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let body_idx = node.data.x

    // forward scan body
    s, let scan = try collect_assignments(s, body_idx)
    s, let join = try compute_join_info(s, scan.assigned)

    // exit only needs block_args when body can break
    var exit_join = join_info{var_ids: [], ir_types: []}
    if scan.has_break {
        exit_join = join
    }

    s, let header_fqn = try reserve_block(s, func_fqn)
    s, let exit_fqn = try reserve_block(s, func_fqn)

    let entry_args = try collect_args_for_vars(s, join.var_ids)
    s = try generate_jmp_with_args(s, header_fqn, entry_args)

    // generate header block with block_args
    if len(join.var_ids) > 0 {
        s, let _, let arg_indices = try generate_block_with_args(s, header_fqn, join.ir_types)
        s = try apply_block_args_to_env(s, join.var_ids, arg_indices)
    } else {
        s, let _ = try generate_block(s, header_fqn)
    }

    let saved_loop_ctx = s.loop_ctx
    s = &semsis{..s, loop_ctx: loop_context{
        exit_fqn:        exit_fqn,
        continue_fqn:    header_fqn,
        incr_idx:        ast.NULL_IDX,
        header_join:     join,
        exit_join:       exit_join,
        defer_start_idx: u32(len(s.defer_registry)),
    }}

    let header_env = try snapshot_var_env(s)

    s, let _, let body_terminated = try analyse_block_inline(s, body_idx, func_fqn)

    if !body_terminated {
        let back_args = try collect_args_for_vars(s, join.var_ids)
        s = try generate_jmp_with_args(s, header_fqn, back_args)
    }

    s = &semsis{..s, loop_ctx: saved_loop_ctx}

    // exit block
    s = try restore_var_env(s, header_env)
    if len(exit_join.var_ids) > 0 {
        s, let exit_ir, let exit_arg_indices = try generate_block_with_args(s, exit_fqn, exit_join.ir_types)
        s = try apply_block_args_to_env(s, exit_join.var_ids, exit_arg_indices)
        return s, exit_ir, false
    }
    s, let exit_ir = try generate_block(s, exit_fqn)
    return s, exit_ir, false
}

// analyse_for_bool handles `for condition { body }` loops
// Structure: 3 blocks (cond, body, exit)
//   current -> cond <--------+
//               |            |
//        +------+------+     |
//        v             v     |
//      body          exit    |
//        |                   |
//        +-------------------+ (back-edge)
fn analyse_for_bool(s *semsis, idx ast.index, func_fqn intern.index)! *semsis, ir.index, bool {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let cond_idx = node.data.x
    let body_idx = node.data.y

    // forward scan body
    s, let scan = try collect_assignments(s, body_idx)
    s, let join = try compute_join_info(s, scan.assigned)

    // exit only needs block_args when body can break (multiple predecessors)
    var exit_join = join_info{var_ids: [], ir_types: []}
    if scan.has_break {
        exit_join = join
    }

    s, let cond_fqn = try reserve_block(s, func_fqn)
    s, let body_fqn = try reserve_block(s, func_fqn)
    s, let exit_fqn = try reserve_block(s, func_fqn)

    // jump from entry to cond with initial values
    let entry_args = try collect_args_for_vars(s, join.var_ids)
    s = try generate_jmp_with_args(s, cond_fqn, entry_args)

    // generate cond block with block_args
    if len(join.var_ids) > 0 {
        s, let _, let cond_arg_indices = try generate_block_with_args(s, cond_fqn, join.ir_types)
        s = try apply_block_args_to_env(s, join.var_ids, cond_arg_indices)
    } else {
        s, let _ = try generate_block(s, cond_fqn)
    }

    let cond_env = try snapshot_var_env(s)

    let body_args = try collect_args_for_vars(s, join.var_ids)
    let exit_args = try collect_args_for_vars(s, exit_join.var_ids)

    s = try analyse_condition(s, cond_idx, func_fqn,
        body_fqn, body_args, exit_fqn, exit_args)

    let saved_loop_ctx = s.loop_ctx
    s = &semsis{..s, loop_ctx: loop_context{
        exit_fqn:        exit_fqn,
        continue_fqn:    cond_fqn,
        incr_idx:        ast.NULL_IDX,
        header_join:     join,
        exit_join:       exit_join,
        defer_start_idx: u32(len(s.defer_registry)),
    }}

    // generate body block with block_args
    if len(join.var_ids) > 0 {
        s, let _, let body_arg_indices = try generate_block_with_args(s, body_fqn, join.ir_types)
        s = try apply_block_args_to_env(s, join.var_ids, body_arg_indices)
    } else {
        s, let _ = try generate_block(s, body_fqn)
    }

    s, let _, let body_terminated = try analyse_block_inline(s, body_idx, func_fqn)

    if !body_terminated {
        let back_args = try collect_args_for_vars(s, join.var_ids)
        s = try generate_jmp_with_args(s, cond_fqn, back_args)
    }

    s = &semsis{..s, loop_ctx: saved_loop_ctx}

    // generate exit block — cond dominates exit, so no block_args needed unless break
    s = try restore_var_env(s, cond_env)
    if len(exit_join.var_ids) > 0 {
        s, let exit_ir, let exit_arg_indices = try generate_block_with_args(s, exit_fqn, exit_join.ir_types)
        s = try apply_block_args_to_env(s, exit_join.var_ids, exit_arg_indices)
        return s, exit_ir, false
    }
    s, let exit_ir = try generate_block(s, exit_fqn)
    return s, exit_ir, false
}

// analyse_var_init handles implicit variable creation for for loop init.
// Parses `i = expr` and creates variable `i` with inferred type from expr.
fn analyse_var_init(s *semsis, idx ast.index)! *semsis {
    var s = s
    let node = try get(s.ast.nodes, idx)

    let decl_list_node = try get(s.ast.nodes, node.data.x)
    let expr_list_node = try get(s.ast.nodes, node.data.y)


    let decl_idx = try get(s.ast.extras, decl_list_node.data.x)
    let decl_node = try get(s.ast.nodes, decl_idx)

    if decl_node.tag != ast.tag.ident {
        return s
    }


    let expr_idx = try get(s.ast.extras, expr_list_node.data.x)
    s, let value_ir, let value_sem_type = try analyse_expression_with_type(s, expr_idx, types.NULL_IDX)
    if value_ir == ir.NULL_IDX {
        return s
    }


    let name = try ast.identifier(s.ast, decl_node)
    s.ip, let name_interned = try intern.intern_string(s.ip, name)

    let decl = namespace.value{
        is_reassignable: true,
        name: name_interned,
        type_idx: value_sem_type,
        index: value_ir
    }
    s.np = try namespace.put_private(s.np, s.current_scope, name_interned, namespace.entry(decl))
    s = try write_variable(s, name_interned, value_ir, value_sem_type)

    return s
}

// analyse_for_classic handles `for init; cond; incr { body }` loops
// Structure: 3 blocks (cond, body, exit)
//   current -> [init] -> cond <----+
//                         |        |
//                  +------+------+ |
//                  v             v |
//                body          exit|
//                  |               |
//                  +-->[incr]------+ (back-edge)
fn analyse_for_classic(s *semsis, idx ast.index, func_fqn intern.index)! *semsis, ir.index, bool {
    var s = s
    let node = try get(s.ast.nodes, idx)
    let cond_node_idx = node.data.x
    let body_idx = node.data.y

    let cond_node = try get(s.ast.nodes, cond_node_idx)
    let cond_data = cond_node.data
    let init_idx = try get(s.ast.extras, cond_data.x)
    let bool_cond_idx = try get(s.ast.extras, cond_data.x + 1)
    let incr_idx = try get(s.ast.extras, cond_data.x + 2)

    let saved_scope = s.current_scope
    let parent_scope = try namespace.get_scope(s.np, s.current_scope)
    s.np, let loop_scope = try namespace.new_scope(s.np, parent_scope.path, types.NULL_IDX, s.current_scope)
    s = &semsis{..s, current_scope: loop_scope}

    let pre_init_env = try snapshot_var_env(s)

    if init_idx != ast.NULL_IDX {
        s = try analyse_var_init(s, init_idx)
    }

    // forward scan body + increment
    s, let body_scan = try collect_assignments(s, body_idx)
    var scan = body_scan
    if incr_idx != ast.NULL_IDX {
        s, let incr_scan = try collect_assignments(s, incr_idx)
        scan = try merge_scan_results(scan, incr_scan)
    }
    s, let join = try compute_join_info(s, scan.assigned)

    // exit join: only outer-scope vars, only when body has break
    var exit_join = join_info{var_ids: [], ir_types: []}
    if scan.has_break {
        var exit_assigned = try make([]intern.index, 0, len(scan.assigned))
        for i = 0; i < len(scan.assigned); i++ {
            let vid = try get(scan.assigned, i)
            var in_outer = false
            for j = 0; j < len(pre_init_env); j++ {
                let def = try get(pre_init_env, j)
                if def.var_id == vid {
                    in_outer = true
                    break
                }
            }
            if in_outer {
                exit_assigned = try append(exit_assigned, vid)
            }
        }
        s, exit_join = try compute_join_info(s, exit_assigned)
    }

    s, let cond_fqn = try reserve_block(s, func_fqn)
    s, let body_fqn = try reserve_block(s, func_fqn)
    s, let exit_fqn = try reserve_block(s, func_fqn)

    let entry_args = try collect_args_for_vars(s, join.var_ids)
    s = try generate_jmp_with_args(s, cond_fqn, entry_args)

    // generate cond block with block_args
    if len(join.var_ids) > 0 {
        s, let _, let cond_arg_indices = try generate_block_with_args(s, cond_fqn, join.ir_types)
        s = try apply_block_args_to_env(s, join.var_ids, cond_arg_indices)
    } else {
        s, let _ = try generate_block(s, cond_fqn)
    }

    let cond_env = try snapshot_var_env(s)

    let body_args = try collect_args_for_vars(s, join.var_ids)
    let exit_args = try collect_args_for_vars(s, exit_join.var_ids)

    s = try analyse_condition(s, bool_cond_idx, func_fqn,
        body_fqn, body_args, exit_fqn, exit_args)

    let saved_loop_ctx = s.loop_ctx
    s = &semsis{..s, loop_ctx: loop_context{
        exit_fqn:        exit_fqn,
        continue_fqn:    cond_fqn,
        incr_idx:        incr_idx,
        header_join:     join,
        exit_join:       exit_join,
        defer_start_idx: u32(len(s.defer_registry)),
    }}

    // generate body block with block_args
    if len(join.var_ids) > 0 {
        s, let _, let body_arg_indices = try generate_block_with_args(s, body_fqn, join.ir_types)
        s = try apply_block_args_to_env(s, join.var_ids, body_arg_indices)
    } else {
        s, let _ = try generate_block(s, body_fqn)
    }

    s, let _, let body_terminated = try analyse_block_inline(s, body_idx, func_fqn)

    if !body_terminated {
        if incr_idx != ast.NULL_IDX {
            s, let _ = try analyse_assignment(s, incr_idx)
        }
        let back_args = try collect_args_for_vars(s, join.var_ids)
        s = try generate_jmp_with_args(s, cond_fqn, back_args)
    }

    s = &semsis{..s, loop_ctx: saved_loop_ctx, current_scope: saved_scope}

    // generate exit block — cond dominates exit, no block_args needed unless break
    s = try restore_var_env(s, cond_env)
    if len(exit_join.var_ids) > 0 {
        s, let exit_ir, let exit_arg_indices = try generate_block_with_args(s, exit_fqn, exit_join.ir_types)
        s = try apply_block_args_to_env(s, exit_join.var_ids, exit_arg_indices)
        return s, exit_ir, false
    }
    s, let exit_ir = try generate_block(s, exit_fqn)
    return s, exit_ir, false
}

// analyse_for_range handles `for el in arr` and `for i, el in arr` loops
// Structure: desugared to classic loop with hidden index
// NOTE: This requires array indexing and len() which are not yet implemented
// in the self-hosted compiler. For now, return a stub.
fn analyse_for_range(s *semsis, idx ast.index, func_fqn intern.index)! *semsis, ir.index, bool {
    // TODO: implement once array indexing and len() are available
    // The desugaring would be:
    //   for el in arr { body }
    // becomes:
    //   %arr = <iterable>
    //   %len = len(%arr)
    //   %idx = 0
    //   cond:
    //       %cond = lt(%idx, %len)
    //       br(%cond, body, exit)
    //   body:
    //       %el = arr[%idx]
    //       <body>
    //       %idx = add(%idx, 1)
    //       jmp(cond)
    //   exit:
    return s, ir.NULL_IDX, false
}

