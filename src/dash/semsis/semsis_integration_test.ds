@test
fn test_cross_library_function_multiple_returns()! {
    try assert_gen_multi(
        `lib a
        pub fn divmod(n, d i64) i64, i64 {
            return n / d, n % d
        }`,
        `lib b
        use "path/a"
        fn test() {
            let q, let r = a.divmod(10, 3)
        }`,
        `fn path/b/test:
            jmp(path/b/test/0)
          path/b/test/0:
            %4 = extern_ref("path/a/divmod",path/a/divmod)
            %5 = const(10,i64)
            %6 = const(3,i64)
            %7 = call(%4,%5,%6,[i64,i64])
            %8 = const(0,u32)
            %9 = gep(%7,%8,*i64)
            %10 = load(%9,i64)
            %11 = const(1,u32)
            %12 = gep(%7,%11,*i64)
            %13 = load(%12,i64)`
    )
}

@test
fn test_cross_library_too_many_arguments()! {
    try assert_error_multi(
        `lib a
        pub fn add(x, y i64) i64 { return x + y }`,
        `lib b
        use "path/a"
        fn test() i64 { return a.add(1, 2, 3) }`,
        [too_many_arguments{pos: ast.index(13), expected: 2, found: 3}]
    )
}

@test
fn test_cross_library_too_few_arguments()! {
