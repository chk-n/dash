lib semsis

use "dash/ast"
use "dash/parser"
use "dash/intern"
use "dash/ir"
use "dash/map"
use "dash/semsis/namespace"
use "dash/types"
use "dash/strings"

// NOTE: all tests use a hypothetical library path named "path" so for
// imports do `use "path/xyz"`

@test
fn test_cross_library_function_call()! {
    try assert_gen_multi(
        `lib a
        pub fn add(x, y i64) i64 { return x + y }`,
        `lib b
        use "path/a"
        fn test() i64 { return a.add(1, 2) }`,
        `fn path/b/test:
            jmp(path/b/test/0)
          path/b/test/0:
            %4 = extern_ref("path/a/add",path/a/add)
            %5 = const(1,i64)
            %6 = const(2,i64)
            %7 = call(%4,%5,%6,[i64])`
    )
}

@test
fn test_cross_library_global_variable()! {
    try assert_gen_multi(
        `lib a
        pub let PI = 3`,
        `lib b
        use "path/a"
        fn test() i64 { return a.PI }`,
        `fn path/b/test:
            jmp(path/b/test/0)
          path/b/test/0:
            %4 = extern_ref("path/a/PI",i64)
            %5 = load(%4,i64)`
    )
}

@test
fn test_cross_library_member_not_found()! {
    try assert_error_multi(
        `lib a
        pub fn add(x, y i64) i64 { return x + y }`,
        `lib b
        use "path/a"
        fn test() i64 { return a.subtract(1, 2) }`,
        [identifier_not_found{pos: ast.index(7)}]
    )
}

@test
fn test_cross_library_struct_type_in_declaration()! {
    try assert_gen_multi(
        `lib a
        pub struct point { x i64 y i64 }`,
        `lib b
        use "path/a"
        struct line { start a.point end a.point }
        fn test() line {
            return line{start: a.point{x: 0, y: 0}, end: a.point{x: 1, y: 1}}
        }`,
        `fn path/b/test:
            jmp(path/b/test/0)
          path/b/test/0:
            %4 = const(0,i64)
            %5 = const(0,i64)
            %6 = alloca([i64,i64],8)
            %7 = const(0,u32)
            %8 = gep(%6,%7,*i64)
            store(%8,%4)
            %10 = const(1,u32)
            %11 = gep(%6,%10,*i64)
            store(%11,%5)`
    )
}

@test
fn test_cross_library_struct_literal()! {
    try assert_gen_multi(
        `lib a
        pub struct point { x i64 y i64 }`,
        `lib b
        use "path/a"
        fn test() a.point {
            return a.point{x: 10, y: 20}
        }`,
        `fn path/b/test:
            jmp(path/b/test/0)
          path/b/test/0:
            %4 = const(10,i64)
            %5 = const(20,i64)
            %6 = alloca([i64,i64],8)
            %7 = const(0,u32)
            %8 = gep(%6,%7,*i64)
            store(%8,%4)
            %10 = const(1,u32)
            %11 = gep(%6,%10,*i64)
            store(%11,%5)`
    )
}

@test
fn test_cross_library_enum_variant_access()! {
    try assert_gen_multi(
        `lib a
        pub enum color { red green blue }`,
        `lib b
        use "path/a"
        fn test() a.color {
            return a.color.red
        }`,
        `fn path/b/test:
            jmp(path/b/test/0)
