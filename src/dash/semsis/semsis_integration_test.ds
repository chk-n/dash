@test
fn test_cross_library_aliased_import()! {
    try assert_gen_multi(
        `lib a
        pub fn add(x, y i64) i64 { return x + y }`,
        `lib b
        use lib_a "path/a"
        fn test() i64 { return lib_a.add(1, 2) }`,
        `fn path/b/test:
            jmp(path/b/test/0)
          path/b/test/0:
            %4 = extern_ref("path/a/add",path/a/add)
            %5 = const(1,i64)
            %6 = const(2,i64)
            %7 = call(%4,%5,%6,[i64])`
    )
}

@test
fn test_cross_library_aliased_import_type()! {
    try assert_gen_multi(
        `lib a
        pub struct point { x i64 y i64 }`,
        `lib b
        use lib_a "path/a"
        fn test() lib_a.point {
            return lib_a.point{x: 5, y: 10}
        }`,
        `fn path/b/test:
            jmp(path/b/test/0)
          path/b/test/0:
            %4 = const(5,i64)
            %5 = const(10,i64)
            %6 = alloca([i64,i64],8)
            %7 = const(0,u32)
            %8 = gep(%6,%7,*i64)
            store(%8,%4)
            %10 = const(1,u32)
            %11 = gep(%6,%10,*i64)
            store(%11,%5)`
    )
}

@test
fn test_cross_library_union_type_usage()! {
    try assert_gen_multi(
        `lib a
        pub union val { i64 bool }`,
        `lib b
        use "path/a"
        fn test() a.val {
            return a.val(42)
        }`,
        `fn path/b/test:
            jmp(path/b/test/0)
          path/b/test/0:
            %4 = const(42,i64)
            %5 = alloca([u32,slot[u64]],8)
            %6 = const(0,u32)
            %7 = const(0,u32)
            %8 = gep(%5,%7,*u32)
            store(%8,%6)
            %10 = const(1,u32)
            %11 = gep(%5,%10,*slot[u64])
            %12 = bitcast(%4,slot[u64])
            store(%11,%12)`
    )
}

@test
fn test_cross_library_error_type_usage()! {
    try assert_gen_multi(
        `lib a
        pub error my_error { code i32 }`,
        `lib b
        use "path/a"
        fn make_error() a.my_error {
            return a.my_error{code: 42}
        }`,
        `fn path/b/make_error:
            jmp(path/b/make_error/0)
          path/b/make_error/0:
            %4 = const(42,i64)
            %5 = cast(%4,i32)
            %6 = alloca([i32],8)
            %7 = const(0,u32)
            %8 = gep(%6,%7,*i32)
            store(%8,%5)`
    )
}

