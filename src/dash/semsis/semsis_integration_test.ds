        `lib b
        use "path/a"
        fn get_x(p a.point) i64 {
            return p.x
        }`,
        `fn path/b/get_x:
            %2 = arg(p,*[i64,i64])
            jmp(path/b/get_x/0)
          path/b/get_x/0:
            %5 = const(0,u32)
            %6 = gep(%2,%5,*i64)
