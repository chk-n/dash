@test
fn test_cross_library_function_with_imported_types()! {
    try assert_gen_multi(
        `lib a
        pub struct point { x i64 y i64 }`,
        `lib b
        use "path/a"
        fn add_points(p1 a.point, p2 a.point) a.point {
            return a.point{x: p1.x + p2.x, y: p1.y + p2.y}
        }`,
        `fn path/b/add_points:
            %2 = arg(p1,*[i64,i64])
            %3 = arg(p2,*[i64,i64])`
    )
}

