        `lib a
        pub fn add(x, y i64) i64 { return x + y }`,
        `lib b
        use "path/a"
        fn test() i64 { return a.add(1) }`,
        [too_few_arguments{expected: 2, found: 1, pos: ast.index(11)}]
    )
}

@test
fn test_cross_library_wrong_argument_type()! {
    try assert_error_multi(
