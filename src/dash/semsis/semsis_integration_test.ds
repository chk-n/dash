@test
fn test_cross_library_array_of_imported_type()! {
    try assert_gen_multi(
        `lib a
        pub struct point { x i64 y i64 }`,
        `lib b
        use "path/a"
        fn test() []a.point {
            return [a.point{x: 1, y: 2}, a.point{x: 3, y: 4}]
        }`,
        `fn path/b/test:
            jmp(path/b/test/0)
          path/b/test/0:
            %4 = const(1,i64)
            %5 = const(2,i64)
            %6 = alloca([i64,i64],8)
            %7 = const(0,u32)
            %8 = gep(%6,%7,*i64)
            store(%8,%4)
            %10 = const(1,u32)
            %11 = gep(%6,%10,*i64)
            store(%11,%5)
            %13 = const(3,i64)
            %14 = const(4,i64)
            %15 = alloca([i64,i64],8)
            %16 = const(0,u32)
            %17 = gep(%15,%16,*i64)
            store(%17,%13)
            %19 = const(1,u32)
            %20 = gep(%15,%19,*i64)
            store(%20,%14)
            %22 = const(2,u64)
            %23 = alloca_array([][i64,i64],%22,8)
            %24 = load(%6,[i64,i64])
            %25 = const(0,u32)
            %26 = gep(%23,%25,*[i64,i64])
            store(%26,%24)
            %28 = load(%15,[i64,i64])
            %29 = const(1,u32)
            %30 = gep(%23,%29,*[i64,i64])
            store(%30,%28)
            %32 = alloca([u64,*[][i64,i64]],8)
            %33 = const(0,u32)
            %34 = gep(%32,%33,*u64)
            store(%34,%22)
            %36 = const(1,u32)
            %37 = gep(%32,%36,**[][i64,i64])
            store(%37,%23)
            %39 = alloca([[u64,*[][i64,i64]]],8)
            %40 = load(%32,[u64,*[][i64,i64]])
            %41 = const(0,u32)
            %42 = gep(%39,%41,*[u64,*[][i64,i64]])
            store(%42,%40)
            ret_1(%39)`
    )
}

@test
fn test_cross_library_pointer_to_imported_type()! {
    try assert_gen_multi(
        `lib a
        pub struct point { x i64 y i64 }`,
        `lib b
        use "path/a"
        fn test(p *a.point) i64 {
            return p.x
        }`,
        `fn path/b/test:
            %2 = arg(p,*[i64,i64])
            jmp(path/b/test/0)
          path/b/test/0:
            %5 = const(0,u32)
            %6 = gep(%2,%5,*i64)
            %7 = load(%6,i64)
            %8 = alloca([i64],8)
            %9 = const(0,u32)
            %10 = gep(%8,%9,*i64)
            store(%10,%7)
            ret_1(%8)`
    )
}

@test
fn test_cross_library_nested_struct_field_access()! {
    try assert_gen_multi(
        `lib a
        pub struct inner { value i64 }
        pub struct outer { nested inner }`,
        `lib b
        use "path/a"
        fn test(o a.outer) i64 {
            return o.nested.value
        }`,
        `fn path/b/test:
            %2 = arg(o,*[[i64]])
            jmp(path/b/test/0)
          path/b/test/0:
            %5 = const(0,u32)
            %6 = gep(%2,%5,*[i64])
            %7 = const(0,u32)
            %8 = gep(%6,%7,*i64)
            %9 = load(%8,i64)
            %10 = alloca([i64],8)
            %11 = const(0,u32)
            %12 = gep(%10,%11,*i64)
            store(%12,%9)
            ret_1(%10)`
    )
}

@test
fn test_cross_library_union_containing_imported_type()! {
    try assert_gen_multi(
        `lib a
        pub struct point { x i64 y i64 }`,
        `lib b
        use "path/a"
        union mixed { a.point bool }
        fn test() mixed {
            return mixed(a.point{x: 1, y: 2})
        }`,
        `fn path/b/test:
            jmp(path/b/test/0)
          path/b/test/0:
            %4 = const(1,i64)
            %5 = const(2,i64)
            %6 = alloca([i64,i64],8)
            %7 = const(0,u32)
            %8 = gep(%6,%7,*i64)
            store(%8,%4)
            %10 = const(1,u32)
            %11 = gep(%6,%10,*i64)
            store(%11,%5)
            %13 = alloca([u32,slot[u64]],8)
            %14 = const(0,u32)
            %15 = const(0,u32)
            %16 = gep(%13,%15,*u32)
            store(%16,%14)
            %18 = const(1,u32)
            %19 = gep(%13,%18,*slot[u64])
            %20 = bitcast(%6,slot[u64])
            store(%19,%20)
            %22 = alloca([[u32,slot[u64]]],8)
            %23 = load(%13,[u32,slot[u64]])
            %24 = const(0,u32)
            %25 = gep(%22,%24,*[u32,slot[u64]])
            store(%25,%23)
            ret_1(%22)`
    )
}

