lib intern

@test
fn test_defaults_initialised()! {
    let p = new()

    try assert(len(p.items) != 0, "pool should be initialised with default items")

    let first = try get(p.items, 0)
    try assert(first.tag == tag.u8_type, "first item should be u8_type")
    try assert(index(first.x) == NULL_IDX, "first item should have NULL_IDX")
}

@test
fn test_make_primitive_type()! {
    let p = new()

    let p2, let idx = try make_primitive_type(p, tag.u32_type)

    try assert(idx != NULL_IDX, "index should not be NULL_IDX")

    let item = try get(p2.items, idx)
    try assert(item.tag == tag.u32_type, "item should be u32_type")
    try assert(index(item.x) == NULL_IDX, "item should have NULL_IDX")
}

@test
fn test_primitive_type_deduplication()! {
    let p = new()

    let p2, let idx1 = try make_primitive_type(p, tag.i64_type)
    let p3, let idx2 = try make_primitive_type(p2, tag.i64_type)

    try assert(idx1 == idx2, "duplicate primitive types should return same index")
    try assert(len(p3.items) == len(p2.items), "pool should not grow for duplicates")
}

@test
fn test_primitive_types_already_duplicated()! {
    let p = new()
    let initial_len = len(p.items)

    let p2, let idx = try make_primitive_type(p, tag.u8_type)

    try assert(idx == 0, "u8_type should be at index 0")
    try assert(len(p2.items) == initial_len, "pool should not grow for default items")
}

@test
fn test_make_pointer_type()! {
    let p = new()

    let p2, let inner_idx = try make_primitive_type(p, tag.i32_type)
    let p3, let ptr_idx = try make_pointer_type(p2, inner_idx)

    let item = try get(p3.items, ptr_idx)
    try assert(item.tag == tag.pointer_type, "should be pointer_type")
    try assert(index(item.x) == inner_idx, "should reference inner type")
}

@test
fn test_make_array_type()! {
    let p = new()

    let p2, let elem_idx = try make_primitive_type(p, tag.f64_type)
    let p3, let arr_idx = try make_array_type(p2, elem_idx)

    let item = try get(p3.items, arr_idx)
    try assert(item.tag == tag.array_type, "should be array_type")
    try assert(index(item.x) == elem_idx, "should reference element type")
}

