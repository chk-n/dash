lib lexer

@test
fn test_next_token()! {
    let tests = [
        {"", tag.EOF},
        // operators
        {"+", tag.ADD},
        {"-", tag.SUB},
        {"*", tag.MUL},
        {"/", tag.DIV},
        {"%", tag.MOD},   
        // compound operators
        {"==", tag.EQ},
        {"!=", tag.NEQ},
        {"=", tag.ASSGN},
        {">", tag.GT},
        {">=", tag.GTE},
        {"<", tag.LT},
        {"<=", tag.LTE},
        {">>", tag.RSH},
        {"<<", tag.LSH},
        {"&", tag.AND},
        {"|", tag.OR},
        {"^", tag.XOR},
        {"~", tag.NOT},
        {"&&", tag.LAND},
        {"||", tag.LOR},
        {"!", tag.LNOT},
        {"|>", tag.PIPE},
        {"&^", tag.ANDNOT},
        {"?", tag.QMARK},
        {"??", tag.QQMARK},
        // delimiters
        {"{", tag.LBRACE},
        {"}", tag.RBRACE},
        {"(", tag.LPAREN},
        {")", tag.RPAREN},
        {"[", tag.LBRACK},
        {"]", tag.RBRACK},
        {",", tag.COMMA},
        {".", tag.DOT},
        {":", tag.COLON},
        {";", tag.SEMICOLON},
        {"@", tag.AT},
        // identifiers
        {"abc", tag.IDENT},
        {"ifelse", tag.IDENT},
        // type literals
        {"u8", tag.U8_TYPE},
        {"u16", tag.U16_TYPE},
        {"u32", tag.U32_TYPE},
        {"u64", tag.U64_TYPE},
        {"i8", tag.I8_TYPE},
        {"i16", tag.I16_TYPE},
        {"i32", tag.I32_TYPE},
        {"i64", tag.I64_TYPE},
        {"int", tag.INT_TYPE},
        {"f32", tag.F32_TYPE},
        {"f64", tag.F64_TYPE},
        {"float", tag.FLOAT_TYPE},
        {"byte", tag.BYTE_TYPE},
        {"char", tag.CHAR_TYPE},
        {"string", tag.STRING_TYPE},
        {"bool", tag.BOOL_TYPE},
        {"error", tag.ERROR},
        // keywords
        {"pub", tag.PUB},
        {"lib", tag.LIB},
        {"use", tag.USE},
        {"struct", tag.STRUCT},
        {"type", tag.TYPE},
        {"alias", tag.ALIAS},
        {"enum", tag.ENUM},
        {"union", tag.UNION},
        {"gen", tag.GEN},
        {"error", tag.ERROR},
        {"fn", tag.FN},
        {"let", tag.LET},
        {"var", tag.VAR},
        {"if", tag.IF},
        {"else", tag.ELSE},
        {"for", tag.FOR},
        {"in", tag.IN},
        {"next", tag.NEXT},
        {"break", tag.BREAK},
        {"match", tag.MATCH},
        {"case", tag.CASE},
        {"try", tag.TRY},
        {"catch", tag.CATCH},
        {"defer", tag.DEFER},
        {"return", tag.RETURN},
        {"raise", tag.RAISE},
    ]

    for i = 0; i < len(tests); i++ {
        let tc = tests[i]
        let l = new([]byte(tc.0), 0)
        let l, let tkn = next_tkn(l)

        try assert(tkn.tag == tc.1, "token type mismatch")

        let lit = get_literal(l, tkn)
        try assert(lit == tc.0, "literal mismatch")
    }
}

@test
fn test_string()! {
    let tests = [
        {`""`, tag.STRING},                   
        {`"hello world"`, tag.STRING},        
        {`"hello\nworld"`, tag.STRING},       
        {`"`, tag.ILLEGAL},                   
        {`"a`, tag.ILLEGAL},                   
        {`"a/`, tag.ILLEGAL},                   
        {`"a/b`, tag.ILLEGAL},                   
    ]
    
    for i = 0; i < len(tests); i++ {
        let tc = tests[i]
        let l = new([]byte(tc.0), 0)
        let l, let tkn = next_tkn(l)
        
        try assert(tkn.tag == tc.1, "token type mismatch")

        let lit = get_literal(l, tkn)
        try assert(lit == tc.0, "literal mismatch")
    }
}

@test
fn test_number()! {
    let tests = [
        {"0", tag.INT, "0"},                      
        {"123_456", tag.INT, "123_456"},                
        {"_123", tag.IDENT, "_123"},                 
        {"0.5", tag.FLOAT, "0.5"},                  
        {"123.456", tag.FLOAT, "123.456"},              
        {"123.", tag.FLOAT, "123."},                 
        {".123", tag.DOT, "."},               
        {"123.456.789", tag.ILLEGAL, "123.456."},        
        {"123_", tag.ILLEGAL, "123_"},        
        {"123__", tag.ILLEGAL, "123__"},        
        {"0..", tag.ILLEGAL, "0.."},
    ]
    
    for i = 0; i < len(tests); i++ {
        let tc = tests[i]
        let l = new([]byte(tc.0), 0)
        let l, let tkn = next_tkn(l)

        try assert(tkn.tag == tc.1, "token type mismatch")

        let lit = get_literal(l, tkn)
        try assert(lit == tc.2, "literal mismatch")
    }
}

@test
fn test_comment()! {
    let tests = [
        {"// normal comment", tag.COMMENT},
        {`
        // comment at end of file
        `, tag.COMMENT},
        {"/* block comment */", tag.COMMENT},
        // NOTE: string literals are not interpreted yet so \n is just
        // character '\' and character 'n'
        {"/* multi\nline\ncomment */", tag.COMMENT},
        {"/**/", tag.COMMENT},                
        {"/*", tag.ILLEGAL},
]
    
    for i = 0; i < len(tests); i++ {
        let tc = tests[i]
        let l = new([]byte(tc.0), 0)
        let l, let tkn = next_tkn(l)
        
        try assert(tkn.tag == tc.1, "token type mismatch")
    }
}

@test
fn test_whitespace()! {
    let tests = [
        {"  abc", tag.IDENT, "abc"},
        {` 
        abc`, tag.IDENT, "abc"},
        {`    abc`, tag.IDENT, "abc"},
    ]
    
    for i = 0; i < len(tests); i++ {
        let tc = tests[i]
        let l = new([]byte(tc.0), 0)
        let l, let tkn = next_tkn(l)
       
        try assert(tkn.tag == tc.1, "token type mismatch")

        let lit = get_literal(l, tkn)
        try assert(lit == tc.2, "literal mismatch")
    }
}


@test
fn test_sequential()! {
    let tests = [
        {`a("b")`, [tag.IDENT, tag.LPAREN, tag.STRING, tag.RPAREN]},       
        {"a+b", [tag.IDENT, tag.ADD, tag.IDENT]},
        {"if x>10 {return}", [tag.IF, tag.IDENT, tag.GT, tag.INT, tag.LBRACE, tag.RETURN, tag.RBRACE]},
        {"let x = 123 + 456", [tag.LET, tag.IDENT, tag.ASSGN, tag.INT, tag.ADD, tag.INT]},
    ]
    
    for i = 0; i < len(tests); i++ {
        let tc = tests[i]
        let l = new([]byte(tc.0), 0)
        
        var count = 0
        for {
            let l, let tkn = next_tkn(l)
            let lit = get_literal(l, tkn)
            if tkn.tag == tag.EOF {
                break
            }
            try assert(tkn.tag == tc.1[count], "token type mismatch")
            count = count + 1
        }
    }
}

