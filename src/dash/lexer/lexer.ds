lib lexer

pub struct lexer {
    buf []byte
    idx i64
}

pub fn new(buf []byte, idx i64) *lexer {
     return &lexer{buf: buf, idx: idx}   
}

pub fn next_tkn(l *lexer) *lexer, token {
    var tkn = token{tag: tag.EOF, start: 0, end: 0}
    
    var l = skip_whitespace(l)

    if l.idx >= len(l.buf) {
        return l, tkn
    }

    let ch = l.buf[l.idx]
    match ch {
    case '*': tkn = token{tag: tag.MUL,       start: l.idx, end: l.idx}
    case '%': tkn = token{tag: tag.MOD,       start: l.idx, end: l.idx}
    case ':': tkn = token{tag: tag.COLON,     start: l.idx, end: l.idx}
    case ';': tkn = token{tag: tag.SEMICOLON, start: l.idx, end: l.idx}
    case '^': tkn = token{tag: tag.XOR,       start: l.idx, end: l.idx}
    case '~': tkn = token{tag: tag.NOT,       start: l.idx, end: l.idx}
    case '{': tkn = token{tag: tag.LBRACE,    start: l.idx, end: l.idx}
    case '}': tkn = token{tag: tag.RBRACE,    start: l.idx, end: l.idx}
    case '(': tkn = token{tag: tag.LPAREN,    start: l.idx, end: l.idx}
    case ')': tkn = token{tag: tag.RPAREN,    start: l.idx, end: l.idx}
    case '[': tkn = token{tag: tag.LBRACK,    start: l.idx, end: l.idx}
    case ']': tkn = token{tag: tag.RBRACK,    start: l.idx, end: l.idx}
    case ',': tkn = token{tag: tag.COMMA,     start: l.idx, end: l.idx}
    case '@': tkn = token{tag: tag.AT,        start: l.idx, end: l.idx}
    case '.': tkn = token{tag: tag.DOT,       start: l.idx, end: l.idx}
    case '"': return read_string(l)
    case '+':
        if peek_ch(l) == '+' {
            tkn = token{tag: tag.ADDADD, start: l.idx, end: l.idx+1}
        } else {
            tkn = token{tag: tag.ADD, start: l.idx, end: l.idx}
        }
    case '-':
        if peek_ch(l) == '-' {
            tkn = token{tag: tag.SUBSUB, start: l.idx, end: l.idx+1}
        } else {
            tkn = token{tag: tag.SUB, start: l.idx, end: l.idx}
        }
    case '|':
        if peek_ch(l) == '|' {
            tkn = token{tag: tag.LOR, start: l.idx, end: l.idx+1}
        } else if peek_ch(l) == '>' {
            tkn = token{tag: tag.PIPE, start: l.idx, end: l.idx+1}
        } else {
            tkn = token{tag: tag.OR, start: l.idx, end: l.idx}
        }
    case '!':
        if peek_ch(l) == '=' {
            tkn = token{tag: tag.NEQ, start: l.idx, end: l.idx+1}
        } else {
            tkn = token{tag: tag.LNOT, start: l.idx, end: l.idx}
        }
    case '=':
        if peek_ch(l) == '=' {
            tkn = token{tag: tag.EQ, start: l.idx, end: l.idx+1}
        } else {
            tkn = token{tag: tag.ASSGN, start: l.idx, end: l.idx}
        }
    case '>':
        if peek_ch(l) == '>' {
            tkn = token{tag: tag.RSH, start: l.idx, end: l.idx+1}
        } else if peek_ch(l) == '=' {
            tkn = token{tag: tag.GTE, start: l.idx, end: l.idx+1}
        } else {
            tkn = token{tag: tag.GT, start: l.idx, end: l.idx}
        }
    case '<':
        if peek_ch(l) == '<' {
            tkn = token{tag: tag.LSH, start: l.idx, end: l.idx+1}
        } else if peek_ch(l) == '=' {
            tkn = token{tag: tag.LTE, start: l.idx, end: l.idx+1}
        }  else {
            tkn = token{tag: tag.LT, start: l.idx, end: l.idx}
        }
    case '&':
        if peek_ch(l) == '&' {
            tkn = token{tag: tag.LAND, start: l.idx, end: l.idx+1}
        } else if peek_ch(l) == '^' {
            tkn = token{tag: tag.ANDNOT, start: l.idx, end: l.idx+1}
        } else {
            tkn = token{tag: tag.AND, start: l.idx, end: l.idx}
        }
    case '/': 
        if peek_ch(l) == '/' || peek_ch(l) == '*' {
            return read_comment(l)
        } else {      
            tkn = token{tag: tag.DIV, start: l.idx, end: l.idx}
        }
    case '?':
        if peek_ch(l) == '?' {
            tkn = token{tag: tag.QQMARK, start: l.idx, end: l.idx+1}        
        } else {
            tkn = token{tag: tag.QMARK, start: l.idx, end: l.idx}
        } 
    case _:
        if is_letter(ch) {      
            let l, let tkn = read_identifier(l)
            let typ = get_tag_by_keyword(string(l.buf[tkn.start:tkn.end+1]))
            return l, token{tag: typ, start: tkn.start, end: tkn.end}
        } else if is_digit(ch) {
            return read_number(l)    
        }
    }
    l = &lexer{buf: l.buf, idx: tkn.end+1}
    return l, tkn
}

fn next_ch(l *lexer) *lexer {
    return &lexer{buf: l.buf, idx: l.idx+1}
}

fn skip_whitespace(l *lexer) *lexer {
    var idx = l.idx
    for idx < len(l.buf) {
        let ch = l.buf[idx]        
        if ch != ' ' && ch != '\t' && ch != '\n' && ch != '\r' {
            break
        }
        idx = idx + 1
    }
    return &lexer{buf: l.buf, idx: idx}
}

fn peek_ch(l *lexer) byte {
	if l.idx+1 < len(l.buf) {
		return l.buf[l.idx+1]
	}
	return 0
}

fn is_letter(ch byte) bool {
    return 'a' <= ch && ch <= 'z' ||
		'A' <= ch && ch <= 'Z' ||
		ch == '_' 
}

fn read_string(l *lexer) *lexer, token {
    var l = l
    let idx = l.idx

    for l.idx < len(l.buf) {
        l = next_ch(l)

        if l.idx >= len(l.buf) {
            return l, token{tag: tag.ILLEGAL, start: idx, end: l.idx-1}
        }

        let ch = l.buf[l.idx]
        if ch == '"' {
            l = next_ch(l)
            break
        }
    }
    return l, token{tag: tag.STRING, start: idx, end: l.idx-1}
}

fn read_multi_string(l *lexer) *lexer, token {
    // TODO:
    return l, token{tag: tag.ILLEGAL, start: l.idx, end: l.idx}
}

fn read_comment(l *lexer) *lexer, token {
    var l = l
    let idx = l.idx

    var cnt = 0
    // case: single line comment
    if l.buf[l.idx+1] == '/' {
        cnt = 1
     	for l.idx < len(l.buf) {
            let ch = l.buf[l.idx]   
            if ch == '\n' {
                break
            }
            l = next_ch(l)
        }
    // case: multi line comment
    } else { 
	    for l.idx < len(l.buf) {
            let ch1 = l.buf[l.idx]
            let ch2 = peek_ch(l)   
            if ch1 == '*' && ch2 == '/' {
                cnt = cnt + 1
                l = next_ch(l)
                break
            }
            l = next_ch(l)
        }   
    }
    
    let typ = if cnt == 1 { tag.COMMENT } else { tag.ILLEGAL }
  	return l, token{tag: typ, start: idx, end: l.idx-1}
}

fn read_identifier(l *lexer) *lexer, token {
    var l = l
    let idx = l.idx
  	for l.idx < len(l.buf) {
        let ch = l.buf[l.idx]     
        if !is_letter(ch) && !is_digit(ch) { break }
		l = next_ch(l)
	}
   return l, token{tag: tag.IDENT, start: idx, end: l.idx-1} 
}
 
fn is_digit(ch byte) bool {
    return ch == '_' || ('0' <= ch && ch <= '9')
}

fn read_number(l *lexer) *lexer, token {
    var l = l
    let idx = l.idx
    var typ = tag.INT

    l = next_ch(l)
    var cnt = 0
    for l.idx < len(l.buf) && cnt <= 1 {
        let ch = l.buf[l.idx]    
        
        if is_digit(ch) {
            l = next_ch(l)
        } else if ch == '.' {
            cnt = cnt + 1
            typ = tag.FLOAT
            l = next_ch(l)
        } else {
            break
        }
    }
    if cnt > 1 {
        typ = tag.ILLEGAL
    } else if l.buf[l.idx-1] == '_' {
        typ = tag.ILLEGAL
    }
    
    let tkn = token{tag: typ, start: idx, end: l.idx-1}
    return l, tkn
}
