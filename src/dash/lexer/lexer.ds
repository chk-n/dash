lib lexer

pub struct lexer {
    buf []byte
    idx u32
    skip_comments bool
    // required to emit EOL
    prev_tag tag           
    saw_newline bool       
}

pub fn new(buf []byte, idx u32, skip_comments bool) *lexer {
     return &lexer{buf: buf, idx: idx, skip_comments: skip_comments, prev_tag: tag.EOF, saw_newline: false}
}

pub fn next_tkn(l *lexer)! *lexer, token {
    var tkn = token{tag: tag.EOF, start: 0, end: 0}

    var l = try skip_whitespace(l)

    // emit special token to help disambiguate empty array literals
    // followed by a function call on newline
    if l.prev_tag == tag.RBRACK && l.saw_newline {
        let eol_tkn = token{tag: tag.EOL, start: l.idx, end: l.idx}
        return &lexer{..l, prev_tag: tag.EOL, saw_newline: false}, eol_tkn
    }

    if l.idx >= len_src(l) {
        return &lexer{..l, prev_tag: tag.EOF}, tkn
    }

    let ch = cur_ch(l)
    match ch {
    case '*': tkn = token{tag: tag.MUL,       start: l.idx, end: l.idx}
    case '%': tkn = token{tag: tag.MOD,       start: l.idx, end: l.idx}
    case ':': tkn = token{tag: tag.COLON,     start: l.idx, end: l.idx}
    case ';': tkn = token{tag: tag.SEMICOLON, start: l.idx, end: l.idx}
    case '^': tkn = token{tag: tag.XOR,       start: l.idx, end: l.idx}
    case '~': tkn = token{tag: tag.NOT,       start: l.idx, end: l.idx}
    case '{': tkn = token{tag: tag.LBRACE,    start: l.idx, end: l.idx}
    case '}': tkn = token{tag: tag.RBRACE,    start: l.idx, end: l.idx}
    case '(': tkn = token{tag: tag.LPAREN,    start: l.idx, end: l.idx}
    case ')': tkn = token{tag: tag.RPAREN,    start: l.idx, end: l.idx}
    case '[': tkn = token{tag: tag.LBRACK,    start: l.idx, end: l.idx}
    case ']': tkn = token{tag: tag.RBRACK,    start: l.idx, end: l.idx}
    case ',': tkn = token{tag: tag.COMMA,     start: l.idx, end: l.idx}
    case '@': tkn = token{tag: tag.AT,        start: l.idx, end: l.idx}
    case '.': tkn = token{tag: tag.DOT,       start: l.idx, end: l.idx}
    case '+':
        if try peek_ch(l) == '+' {
            tkn = token{tag: tag.ADDADD, start: l.idx, end: l.idx+1}
        } else {
            tkn = token{tag: tag.ADD, start: l.idx, end: l.idx}
        }
    case '-':
        if try peek_ch(l) == '-' {
            tkn = token{tag: tag.SUBSUB, start: l.idx, end: l.idx+1}
        } else {
            tkn = token{tag: tag.SUB, start: l.idx, end: l.idx}
        }
    case '|':
        if try peek_ch(l) == '|' {
            tkn = token{tag: tag.LOR, start: l.idx, end: l.idx+1}
        } else if try peek_ch(l) == '>' {
            tkn = token{tag: tag.PIPE, start: l.idx, end: l.idx+1}
        } else {
            tkn = token{tag: tag.OR, start: l.idx, end: l.idx}
        }
    case '!':
        if try peek_ch(l) == '=' {
            tkn = token{tag: tag.NEQ, start: l.idx, end: l.idx+1}
        } else {
            tkn = token{tag: tag.LNOT, start: l.idx, end: l.idx}
        }
    case '=':
        if try peek_ch(l) == '=' {
            tkn = token{tag: tag.EQ, start: l.idx, end: l.idx+1}
        } else {
            tkn = token{tag: tag.ASSGN, start: l.idx, end: l.idx}
        }
    case '>':
        if try peek_ch(l) == '>' {
            tkn = token{tag: tag.RSH, start: l.idx, end: l.idx+1}
        } else if try peek_ch(l) == '=' {
            tkn = token{tag: tag.GTE, start: l.idx, end: l.idx+1}
        } else {
            tkn = token{tag: tag.GT, start: l.idx, end: l.idx}
        }
    case '<':
        if try peek_ch(l) == '<' {
            tkn = token{tag: tag.LSH, start: l.idx, end: l.idx+1}
        } else if try peek_ch(l) == '=' {
            tkn = token{tag: tag.LTE, start: l.idx, end: l.idx+1}
        }  else {
            tkn = token{tag: tag.LT, start: l.idx, end: l.idx}
        }
    case '&':
        if try peek_ch(l) == '&' {
            tkn = token{tag: tag.LAND, start: l.idx, end: l.idx+1}
        } else if try peek_ch(l) == '^' {
            tkn = token{tag: tag.ANDNOT, start: l.idx, end: l.idx+1}
        } else {
            tkn = token{tag: tag.AND, start: l.idx, end: l.idx}
        }
    case '/':
        if try peek_ch(l) == '/' || try peek_ch(l) == '*' {
            if l.skip_comments {
                l = try skip_comment(l)
                return try next_tkn(l)
            } else {
                return try read_comment(l)
            }
        } else {
            tkn = token{tag: tag.DIV, start: l.idx, end: l.idx}
        }
    case '?':
        if try peek_ch(l) == '?' {
            tkn = token{tag: tag.QQMARK, start: l.idx, end: l.idx+1}
        } else {
            tkn = token{tag: tag.QMARK, start: l.idx, end: l.idx}
        }
    case '"': return try read_string(l)
    case '\'': return try read_char(l)
    case _:
        if is_letter(ch) {
            let l, let tkn = try read_identifier(l)
            let typ = try get_tag_by_keyword(string(try slice(l.buf, tkn.start, tkn.end+1)))
            return l, token{tag: typ, start: tkn.start, end: tkn.end}
        } else if is_digit(ch) {
            return try read_number(l)
        }
    }
    l = &lexer{..l, idx: tkn.end+1, prev_tag: tkn.tag}
    return l, tkn
}

fn len_src(l *lexer) u32 {
    return u32(len(l.buf))
}

fn next_ch(l *lexer) *lexer {
    if l.idx >= len_src(l) {
        return l
    }
    return &lexer{..l, idx: l.idx+1}
}

fn skip_whitespace(l *lexer)! *lexer {
    var idx = l.idx
    var saw_nl = false
    for idx < len_src(l) {
        let ch = try get(l.buf, idx)
        if ch == '\n' {
            saw_nl = true
        }
        if ch != ' ' && ch != '\t' && ch != '\n' && ch != '\r' {
            break
        }
        idx = idx + 1
    }
    return &lexer{..l, idx: idx, saw_newline: saw_nl}
}

fn prev_ch(l *lexer)! byte {
    if l.idx-1 < 0 {
        return 0
    }
    return try get(l.buf, l.idx-1)
}

fn cur_ch(l *lexer)! byte {
	if l.idx > len_src(l)-1 {
    	return 0
	}
	return try get(l.buf, l.idx)
}

fn peek_ch(l *lexer)! byte {
	if l.idx >= len_src(l)-1 {
    	return 0
	}
	return try get(l.buf, l.idx+1)
}

fn is_letter(ch byte) bool {
    return 'a' <= ch && ch <= 'z' ||
		'A' <= ch && ch <= 'Z' ||
		ch == '_' 
}

fn read_string(l *lexer)! *lexer, token {
    var l = l
    let idx = l.idx

    for l.idx < len_src(l) {
        l = next_ch(l)

        if l.idx >= len_src(l) {
            return l, token{tag: tag.ILLEGAL, start: idx, end: l.idx-1}
        }

        let ch = try cur_ch(l)
        if ch == '"' {
            l = next_ch(l)
            break
        }
    }
    let tkn = token{tag: tag.STRING, start: idx, end: l.idx-1}
    return &lexer{..l, prev_tag: tkn.tag}, tkn
}

fn read_multi_string(l *lexer) *lexer, token {
    // TODO:
    return l, token{tag: tag.ILLEGAL, start: l.idx, end: l.idx}
}

fn read_char(l *lexer)! *lexer, token {
    var l = l
    let idx = l.idx

    // consume '
    l = try next_ch(l)
    if try cur_ch(l) == '\\' {
        l = next_ch(l)
    }

    // TODO: handle unicode code point
    // if l.buf[l.idx] == 'u' {
        // l = next_ch(l)
    // }

    // consume character
    l = next_ch(l)
    if try cur_ch(l) != '\'' {
        return l, token{tag: tag.ILLEGAL, start: idx, end: l.idx-1}
    }
    // consume '
    l = next_ch(l)

    let tkn = token{tag: tag.CHAR, start: idx, end: l.idx-1}
    return &lexer{..l, prev_tag: tkn.tag}, tkn
}
   
fn skip_comment(l *lexer)! *lexer {
    var l = l

    // case: single line comment 
    if try peek_ch(l) == '/' {
     	for l.idx < len_src(l) {
            let ch = try cur_ch(l)
            if ch == '\n' {
                l = &lexer{..l, saw_newline: true}
                break
            }
            l = next_ch(l)
        }
    // case: multi line comment (we dont set saw_newline here)
    } else {
	    for l.idx < len_src(l) {
            let ch1 = try cur_ch(l)
            let ch2 = try peek_ch(l)
            if ch1 == '*' && ch2 == '/' {
                l = next_ch(l)
                l = next_ch(l)
                break
            }
            l = next_ch(l)
        }
    }

  	return l
}

fn read_comment(l *lexer)! *lexer, token {
    var l = l
    let idx = l.idx

    var cnt = 0
    // case: single line comment
    if try peek_ch(l) == '/' {
        cnt = 1
     	for l.idx < len_src(l) {
            let ch = try cur_ch(l)
            if ch == '\n' {
                break
            }
            l = next_ch(l)
        }
    // case: multi line comment
    } else {
	    for l.idx < len_src(l) {
            let ch1 = try cur_ch(l)
            let ch2 = try peek_ch(l)
            if ch1 == '*' && ch2 == '/' {
                cnt = cnt + 1
                l = next_ch(l)
                break
            }
            l = next_ch(l)
        }
    }

    let typ = if cnt == 1 { tag.COMMENT } else { tag.ILLEGAL }
    let tkn = token{tag: typ, start: idx, end: l.idx-1}
    return &lexer{..l, prev_tag: tkn.tag}, tkn
}

fn read_identifier(l *lexer)! *lexer, token {
    var l = l
    let idx = l.idx
    for l.idx < len_src(l) {
        let ch = try cur_ch(l)
        if !is_letter(ch) && !is_digit(ch) {
            break
        }
    	l = next_ch(l)
    }
    let tkn = token{tag: tag.IDENT, start: idx, end: l.idx-1}
    return &lexer{..l, prev_tag: tkn.tag}, tkn

}
 
fn is_digit(ch byte) bool {
    return ch == '_' || ('0' <= ch && ch <= '9')
}

fn read_number(l *lexer)! *lexer, token {
    var l = l
    let idx = l.idx
    var typ = tag.INT

    l = next_ch(l)
    var cnt = 0
    for l.idx < len_src(l) && cnt <= 1 {
        let ch = try cur_ch(l)

        if is_digit(ch) {
            l = next_ch(l)
        } else if ch == '.' {
            cnt = cnt + 1
            typ = tag.FLOAT
            l = next_ch(l)
        } else {
            break
        }
    }
    if cnt > 1 {
        typ = tag.ILLEGAL
    } else if try prev_ch(l) == '_' {
        typ = tag.ILLEGAL
    }

    let tkn = token{tag: typ, start: idx, end: l.idx-1}
    return &lexer{..l, prev_tag: tkn.tag}, tkn
}
