lib lexer

pub struct token {
    tag   tag
    start u32
    end   u32
}

pub enum tag {
    ILLEGAL
    EOF
    COMMENT    
       
    // single character tokens
    COLON      // :
    SEMICOLON  // ;
    XOR        // ^
    NOT        // ~
    LNOT       // !
    LBRACE     // {
    RBRACE     // }
    LPAREN     // (
    RPAREN     // )
    LBRACK     // [
    RBRACK     // ]
    COMMA      // ,
    AT         // @
    DOT        // .
    
    
    // compound operators
    ADD        // + 
    SUB        // - 
    MUL        // * 
    MOD        // % 
    OR         // |
    LOR        // ||
    PIPE       // |>
    LNOT       // !
    NEQ        // !=
    EQ         // ==
    ASSGN      // =
    RSH        // >>
    GTE        // >=
    GT         // >
    LSH        // <<
    LTE        // <=
    LT         // <
    LAND       // &&
    AND        // &
    ANDNOT     // &^
    DIV        // /
    QMARK      // ?
    QQMARK     // ??
    ADDADD     // ++
    SUBSUB     // --
    
    // literals
    INT        // 123
    FLOAT      // 0.314
    STRING       // "abc"
    MULTI_STRING // `xyz`
    TRUE       // true
    FALSE      // false
    CHAR

    // type literals
    U8_TYPE
    U16_TYPE
    U32_TYPE
    U64_TYPE
    I8_TYPE
    I16_TYPE
    I32_TYPE
    I64_TYPE
    INT_TYPE
    F32_TYPE
    F64_TYPE
    FLOAT_TYPE
    CHAR_TYPE
    STRING_TYPE
    BOOL_TYPE
    MUT_TYPE
    ANY_TYPE
    
    // keywords
    PUB
    LIB
    USE
    STRUCT
    TYPE
    ALIAS
    ENUM
    UNION
    GEN
    ERROR
    FN
    LET
    VAR
    IF
    ELSE
    FOR
    IN
    NEXT
    BREAK
    MATCH
    CASE
    TRY
    CATCH
    RAISE
    DEFER
    RETURN
    BREAK
    
    IDENT
}

pub fn get_literal(l *lexer, tkn token)! string {
    if len(l.buf) == 0 { 
        return "" 
    }
    let buf = try slice(l.buf, tkn.start, tkn.end+1)
    return string(buf)
}

let keywords = [
    {"pub", tag.PUB},
    {"lib", tag.LIB},
    {"use", tag.USE},
    {"struct", tag.STRUCT},
    {"type", tag.TYPE},
    {"alias", tag.ALIAS},
    {"enum", tag.ENUM},
    {"union", tag.UNION},
    {"gen", tag.GEN},
    {"error", tag.ERROR},
    {"fn", tag.FN},
    {"let", tag.LET},
    {"var", tag.VAR},
    {"if", tag.IF},
    {"else", tag.ELSE},
    {"for", tag.FOR},
    {"in", tag.IN},
    {"next", tag.NEXT},
    {"break", tag.BREAK},
    {"match", tag.MATCH},
    {"case", tag.CASE},
    {"try", tag.TRY},
    {"catch", tag.CATCH},
    {"defer", tag.DEFER},
    {"return", tag.RETURN},
    {"raise", tag.RAISE},
    {"u8", tag.U8_TYPE},
    {"u16", tag.U16_TYPE},
    {"u32", tag.U32_TYPE},
    {"u64", tag.U64_TYPE},
    {"i8", tag.I8_TYPE},
    {"i16", tag.I16_TYPE},
    {"i32", tag.I32_TYPE},
    {"i64", tag.I64_TYPE},
    {"int", tag.INT_TYPE},
    {"f32", tag.F32_TYPE},
    {"f64", tag.F64_TYPE},
    {"float", tag.FLOAT_TYPE},
    {"char", tag.CHAR_TYPE},
    {"string", tag.STRING_TYPE},
    {"bool", tag.BOOL_TYPE},
    {"mut", tag.MUT_TYPE},
    {"any", tag.ANY_TYPE},
    {"error", tag.ERROR},
    {"true", tag.TRUE},
    {"false", tag.FALSE}
]

pub fn get_tag_by_keyword(k string) tag {
    for i = 0; i < len(keywords); i++ {
        let kw = try get(keywords, i)
        if kw.0 == k {
            return kw.1
        }
    }
    return tag.IDENT
}
