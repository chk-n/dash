// contains the code to represent dash source as an AST
// and helper functions such as converting AST to string
lib ast

use "dash/lexer"

pub let NULL_IDX = index(4_294_967_295)
pub let NULL_DATA = data{x: NULL_IDX, y: NULL_IDX}
// should be used when token not needed e.g. when
// adding nodes that dont have a defining token
// such as lib_stmts, struct/enum/union fields etc.
pub let NULL_TKN = token_index(4_294_967_295)

// TODO: replace with column list
pub struct ast {
    src    []byte
    tkns   []token
    nodes  []node
    errs   []error
    extras []index
}

// index used to access nodes in the AST e.g. ast.nodes
pub type index u32
// index used to access lexed tokens e.g ast.tkns
pub type token_index u32
// index used to access bytes in raw source e.g. ast.src
pub type source_index u32 

pub struct token {
    tag   lexer.tag
    start source_index
}

// represents AST node, used for all
// statements and expressions
pub struct node {
    tag   tag
    token token_index
    data  data
}

// data represents two indices
// that can either point to nodes
// e.g. in the case of infix operations
// or to a range of nodes in extra
// array. If it points to nodes in
// extra array then the range is
// exclusive i.e. y points to valid
// node in nodes array
pub struct data {
    // can also refer to lhs
    x index
    // can als orefer to rhs
    y index
}

pub enum tag {
    library
    lib_stmts
    use_def
    type_def
    struct_def
    struct_gen_def
    struct_fields
    error_def
    enum_def
    enum_fields
    union_def
    union_types
    attribute
    fn_def
    fn_gen_def
    fn_err_def
    fn_gen_err_def
    param_list
    fn_ret_list
    block_stmt
    assignment
    decl_list
    let_decl
    var_decl
    if_stmt
    for_infinite
    for_bool
    for_classic
    for_classic_cond
    for_range
    for_range_cond
    for_range2_cond
    return_stmt
    break_stmt
    next_stmt
    raise_stmt
    defer_stmt
    match_stmt
    match_block
    case_stmt
    case_block_stmt

    dot
    call
    expr_list
    type_params
    ident
    int
    float
    string
    bool
    char
    struct_lit
    anon_struct_lit
    array_lit
    null_unwrap
    address_of
    value_of
    // number ops
    negate_num
    add
    sub
    mul
    div
    mod
    incr_decr
    // binary ops
    negate_byte
    or
    xor
    and
    andnot
    lsh
    rsh
    lor
    land
    // boolean ops
    negate_bool
    eq
    neq
    gt
    gte
    lt
    lte
    // optional ops
    null_coalesce
    
    try_expr
    catch_expr

    any_type
    u8_type
    u16_type
    u32_type
    u64_type
    i8_type
    i16_type
    i32_type
    i64_type
    int_type
    f32_type
    f64_type
    float_type
    char_type
    string_type
    bool_type
    error_type
    array_type
    column_type
    optional_type
    mutable_type
    pointer_type

    // only for usage within 'ast' lib
    pub
}

pub fn literal_to_tag(t lexer.tag)! tag {
    return match t {
        case lexer.tag.IDENT: tag.ident
        case lexer.tag.INT:   tag.int
        case lexer.tag.FLOAT: tag.float
        case lexer.tag.STRING: tag.string
        case lexer.tag.BOOL: tag.bool
        case lexer.tag.CHAR: tag.char
        case lexer.tag.ANY_TYPE: tag.any_type
        case lexer.tag.U8_TYPE: tag.u8_type
        case lexer.tag.U16_TYPE: tag.u16_type
        case lexer.tag.U32_TYPE: tag.u32_type
        case lexer.tag.U64_TYPE: tag.u64_type
        case lexer.tag.I8_TYPE: tag.i8_type
        case lexer.tag.I16_TYPE: tag.i16_type
        case lexer.tag.I32_TYPE: tag.i32_type
        case lexer.tag.I64_TYPE: tag.i64_type
        case lexer.tag.INT_TYPE: tag.int_type
        case lexer.tag.F32_TYPE: tag.f32_type
        case lexer.tag.F64_TYPE: tag.f64_type
        case lexer.tag.FLOAT_TYPE: tag.float_type
        case lexer.tag.CHAR_TYPE: tag.char_type
        case lexer.tag.STRING_TYPE: tag.string_type
        case lexer.tag.BOOL_TYPE: tag.bool_type
        case lexer.tag.ERROR: tag.error_type
        case _: raise unexpected_tag
    }
}

pub fn prefix_to_tag(t lexer.tag)! tag {
    return match t {
        case lexer.tag.SUB: tag.negate_num
        case lexer.tag.LNOT: tag.negate_bool
        case lexer.tag.NOT: tag.negate_byte
        case lexer.tag.QMARK: tag.null_unwrap
        case lexer.tag.AND: tag.address_of
        case lexer.tag.MUL: tag.value_of
        case _: raise unexpected_tag
    }
}

pub fn infix_to_tag(t lexer.tag)! tag {
    return match t {
        case lexer.tag.ADD: tag.add
        case lexer.tag.SUB: tag.sub
        case lexer.tag.MUL: tag.mul
        case lexer.tag.DIV: tag.div
        case lexer.tag.MOD: tag.mod
        case lexer.tag.OR: tag.or
        case lexer.tag.LOR: tag.lor
        case lexer.tag.LAND: tag.land
        case lexer.tag.XOR: tag.xor
        case lexer.tag.AND: tag.and
        case lexer.tag.ANDNOT: tag.andnot
        case lexer.tag.LSH: tag.lsh
        case lexer.tag.RSH: tag.rsh
        case lexer.tag.LT:  tag.lt
        case lexer.tag.GT:  tag.gt
        case lexer.tag.GTE: tag.gte
        case lexer.tag.LTE: tag.lte
        case lexer.tag.EQ:  tag.eq
        case lexer.tag.NEQ: tag.neq
        case lexer.tag.DOT: tag.dot
        case lexer.tag.ASSGN: tag.assignment
        case lexer.tag.QQMARK: tag.null_coalesce
        case _: raise unexpected_tag
    }
}

pub fn decl_to_tag(t lexer.tag)! tag {
    return match t {
        case lexer.tag.LET: tag.let_decl
        case lexer.tag.VAR: tag.var_decl
        case _: raise unexpected_tag
    }
}

pub fn keyword_to_tag(t lexer.tag)! tag {
    return match t {
        case lexer.tag.BREAK: tag.break_stmt
        case lexer.tag.NEXT: tag.next_stmt
        case _: raise unexpected_tag
    }
}

// to_string converts ast to a linear unformatted string
pub fn to_string(a *ast, idx index, buf []byte)! []byte {
    if idx == NULL_IDX {
        return buf
    }    
    // TODO: if len(nodes)-1 == NULL_IDX raise error

    var buf = buf
    let node = try get(a.nodes, idx)
    let data = node.data

    match node.tag {
    case tag.library, tag.type_def,
         tag.struct_def, tag.error_def,
         tag.enum_def, tag.union_def:

        buf = add_pub(a, idx, buf)
        let src_idx = try get(a.tkns, node.token).start
        let kw = try get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = append(buf, ' ')
        buf = try to_string(a, data.x, buf)
        buf = append(buf, ' ')
        buf = try to_string(a, data.y, buf)

    case tag.struct_gen_def:
        buf = add_pub(a, idx, buf)
        let src_idx = try get(a.tkns, node.token).start
        let kw = try get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = append(buf, ' ')
        let ident = try get(a.extras, data.x)
        buf = try to_string(a, ident, buf)

        buf = append(buf, '[')
        let gen_params = try get(a.extras, data.x+1)
        buf = try to_string(a, gen_params, buf)
        buf = append(buf, ']')

        buf = append(buf, ' ')
        let fields = try get(a.extras, data.x+2)
        buf = try to_string(a, fields, buf)

    case tag.lib_stmts:
        for i = data.x; i < data.y; i++ {
            let idx = try get(a.extras, i)
            buf = try to_string(a, idx, buf)
            if i != data.y-1 {
                buf = append(buf, ' ')
            }
        }

    case tag.use_def:
        // TODO: once we can parse import alias then
        // data.x will contain idx of that node
        let src_idx = try get(a.tkns, node.token).start
        let kw = try get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        if data.x != NULL_IDX {
            buf = append(buf, ' ')
            buf = try to_string(a, data.x, buf)
        }
        buf = append(buf, ' ')
        buf = try to_string(a, data.y, buf)

    case tag.attribute:
        let src_idx = try get(a.tkns, node.token).start
        let kw = try get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = try to_string(a, data.x, buf)
        if data.y != NULL_IDX {
            buf = append(buf, '(')
            buf = try to_string(a, data.y, buf)
            buf = append(buf, ')')
        }
    

    case tag.struct_fields:
        buf = append(buf, '{')
        for i = data.x; i < data.y; i = i+2 {
            let idx = try get(a.extras, i)
            buf = try to_string(a, idx, buf)
            buf = append(buf,' ')
            let idx = try get(a.extras, i+1)
            buf = try to_string(a, idx, buf)
            if i != data.y-2 {
                buf = append(buf,' ')
            }
        }
        buf = append(buf, '}')
        
    case tag.enum_fields, tag.union_types,
         tag.block_stmt:
        buf = append(buf, '{')
        for i = data.x; i < data.y; i++ {
            let idx = try get(a.extras, i)
            buf = try to_string(a, idx, buf)
            if i != data.y-1 {
                buf = append(buf,' ')
            }
        }
        buf = append(buf, '}')
    
    case tag.fn_def, tag.fn_err_def:
        buf = add_pub(a, idx, buf)
        let src_idx = try get(a.tkns, node.token).start
        let kw = try get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = append(buf, ' ')
        let ident = try get(a.extras, data.x)
        buf = try to_string(a, ident, buf)

        buf = append(buf, '(')
        let args = try get(a.extras, data.x+1)
        if args != NULL_IDX {
            buf = try to_string(a, args, buf)
        }
        buf = append(buf, ')')

        if node.tag == tag.fn_err_def {
            buf = append(buf, '!')
        }

        let rets = try get(a.extras, data.x+2)
        if rets != NULL_IDX {
            buf = append(buf, ' ')
            buf = try to_string(a, rets, buf)
        }

        let body = try get(a.extras, data.x+3)
        if body != NULL_IDX {
            buf = append(buf, ' ')
            buf = try to_string(a, body, buf)
        }

    case tag.fn_gen_def, tag.fn_gen_err_def:
        buf = add_pub(a, idx, buf)
        let src_idx = try get(a.tkns, node.token).start
        let kw = try get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = append(buf, ' ')
        let ident = try get(a.extras, data.x)
        buf = try to_string(a, ident, buf)

        buf = append(buf, '[')
        let gen_params = try get(a.extras, data.x+1)
        if gen_params != NULL_IDX {
            buf = try to_string(a, gen_params, buf)
        }
        buf = append(buf, ']')

        buf = append(buf, '(')
        let args = try get(a.extras, data.x+2)
        if args != NULL_IDX {
            buf = try to_string(a, args, buf)
        }
        buf = append(buf, ')')

        if node.tag == tag.fn_gen_err_def {
            buf = append(buf, '!')
        }

        let rets = try get(a.extras, data.x+3)
        if rets != NULL_IDX {
            buf = append(buf, ' ')
            buf = try to_string(a, rets, buf)
        }

        let body = try get(a.extras, data.x+4)
        if body != NULL_IDX {
            buf = append(buf, ' ')
            buf = try to_string(a, body, buf)
        }
        
    case tag.param_list:
        for i = data.x; i < data.y; i = i+2 {
            let ident = try get(a.extras, i)
            buf = try to_string(a, ident, buf)
            let typ = try get(a.extras, i+1)
            if typ != NULL_IDX {
                buf = append(buf, ' ')
                buf = try to_string(a, typ, buf)
            }
            if i != data.y-2 {
                buf = append(buf,',')
            }
        }

    case tag.fn_ret_list:
        for i = data.x; i < data.y; i++ {
            let idx = try get(a.extras, i)
            buf = try to_string(a, idx, buf)
            if i != data.y-1 {
                buf = append(buf,',')
            }
        }
        
    case tag.assignment:
        buf = try to_string(a, data.x, buf)
        buf = append(buf, ' ')
        buf = append(buf, '=')
        buf = append(buf, ' ')
        buf = try to_string(a, data.y, buf)
        
    case tag.if_stmt:
        let src_idx = try get(a.tkns, node.token).start
        let kw = try get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = append(buf, ' ')
        let n = data.y - data.x
        for i = data.x; i+1 < data.y; i = i+2 {
            if i != data.x && n > 2 {
                 buf = append(buf, []byte(" else if "))
            }
            let idx = try get(a.extras, i)
            buf = try to_string(a, idx, buf)
            buf = append(buf, ' ')
            let idx = try get(a.extras, i+1)
            buf = try to_string(a, idx, buf)
       }
       if n%2 != 0 {
            buf = append(buf, []byte(" else "))
            let idx = try get(a.extras, data.y-1)
            buf = try to_string(a, idx, buf)
        }

    case tag.for_bool, tag.for_classic, tag.for_range:
        let src_idx = try get(a.tkns, node.token).start
        let kw = try get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = append(buf, ' ')
        buf = try to_string(a, data.x, buf)
        buf = append(buf, ' ')
        buf = try to_string(a, data.y, buf)

    case tag.for_classic_cond:
        let assign = try get(a.extras, data.x)
        if assign != NULL_IDX {
            buf = try to_string(a, assign, buf)
            buf = append(buf, ';')
        }
        let cond = try get(a.extras, data.x+1)
        if cond != NULL_IDX {
            buf = try to_string(a, cond, buf)
            buf = append(buf, ';')
        }
        let incr = try get(a.extras, data.x+2)
        if incr != NULL_IDX {
            buf = try to_string(a, incr, buf)
        }
    case tag.match_stmt:
        let src_idx = try get(a.tkns, node.token).start
        let kw = try get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = append(buf, ' ')
        buf = try to_string(a, data.x, buf)
        buf = append(buf, ' ')
        buf = try to_string(a, data.y, buf)

    case tag.match_block:
        buf = append(buf, '{')
        for i = data.x; i < data.y; i++ {
            let idx = try get(a.extras, i)
            buf = try to_string(a, idx, buf)
            if i != data.y-1 {
                buf = append(buf,' ')
            }
        }
        buf = append(buf, '}')

    case tag.case_stmt:
        let src_idx = try get(a.tkns, node.token).start
        let kw = try get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = append(buf, ' ')
        buf = try to_string(a, data.x, buf)
        buf = append(buf, ':')
        if data.y != NULL_IDX {
            buf = append(buf, ' ')
            buf = try to_string(a, data.y, buf)
        }
    
    case tag.case_block_stmt:
        for i = data.x; i < data.y; i++ {
            let idx = try get(a.extras, i)
            buf = try to_string(a, idx, buf)
            if i != data.y-1 {
                buf = append(buf,' ')
            }
        }
        
    case tag.decl_list:
        for i = data.x; i < data.y; i++ {
            let idx = try get(a.extras, i)
            buf = try to_string(a, idx, buf)
            if i != data.y-1 {
                buf = append(buf,',')
            }
        }

    case tag.let_decl, tag.var_decl:
        buf = add_pub(a, idx, buf)
        let src_idx = try get(a.tkns, node.token).start
        let kw = try get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = append(buf, ' ')
        buf = try to_string(a, data.x, buf)

    case tag.for_infinite,
         tag.try_expr, tag.raise_stmt,
         tag.defer_stmt:
        let src_idx = try get(a.tkns, node.token).start
        let kw = try get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = append(buf, ' ')
        buf = try to_string(a, data.x, buf)

    case tag.ident, tag.int, tag.float,
         tag.string, tag.bool, tag.char:
        let src_idx = try get(a.tkns, node.token).start
        let lit = try get_variable_token(a.src, src_idx)
        buf = append(buf, lit)

    case tag.struct_lit:
        buf = try to_string(a, data.x, buf)
        buf = try to_string(a, data.y, buf)
        
    case tag.anon_struct_lit:
        buf = append(buf, '{')
        for i = data.x; i < data.y; i = i+2 {
            var ident_idx = try get(a.extras, i)
            buf = try to_string(a, ident_idx, buf)
            buf = append(buf, ':')
            var exp_idx = try get(a.extras, i+1)
            buf = try to_string(a, exp_idx, buf)
            if i != data.y-2 {
                buf = append(buf, ',')
            }
        }
        buf = append(buf, '}')

    case tag.array_lit:
        buf = append(buf, '[')
        for i = data.x; i < data.y; i++ {
            var ident_idx = try get(a.extras, i)
            buf = try to_string(a, ident_idx, buf)
            if i != data.y-1 {
                buf = append(buf, ',')
            }
        }
        buf = append(buf, ']')

    case tag.negate_num, tag.negate_bool,
        tag.negate_byte, tag.null_unwrap,
        tag.address_of, tag.value_of:
        let src_idx = try get(a.tkns, node.token).start
        let op = try get(a.src, src_idx)
        buf = append(buf, op)        
        buf = try to_string(a, data.x, buf)

    case tag.add, tag.sub, tag.mul,
        tag.div, tag.mod, tag.or, tag.lor, tag.land,
        tag.xor, tag.and, tag.andnot, tag.lsh, tag.rsh,
        tag.lt, tag.gt, tag.lte, tag.gte, tag.eq, tag.neq,
        tag.null_coalesce:
        buf = append(buf, '(')

        buf = try to_string(a, data.x, buf)

        buf = append(buf, ' ')
        let src_idx = try get(a.tkns, node.token).start
        let op = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, op)
        buf = append(buf, ' ')

        buf = try to_string(a, data.y, buf)
        buf = append(buf, ')')

    case tag.dot:
        buf = try to_string(a, data.x, buf)
        let src_idx = try get(a.tkns, node.token).start
        let op = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, op)
        buf = try to_string(a, data.y, buf)

    case tag.call:
        buf = try to_string(a, data.x, buf)   
        buf = append(buf, '(')
        if data.y != NULL_IDX {
            buf = try to_string(a, data.y, buf)
        } 
        buf = append(buf, ')')

    case tag.expr_list:
        for i = data.x; i < data.y; i++ {
            let idx = try get(a.extras, i)
            buf = try to_string(a, idx, buf)
            if i != data.y-1 {
                buf = append(buf,',')
            }
        }

    case tag.type_params:
        buf = try to_string(a, data.x, buf)   
        buf = append(buf, '[')
        buf = try to_string(a, data.y, buf)
        buf = append(buf, ']')

    case tag.incr_decr:
        buf = try to_string(a, data.x, buf)
        let src_idx = try get(a.tkns, node.token).start
        let op = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, op)
        
    case tag.catch_expr:
        let call = try get(a.extras, data.x)
        buf = try to_string(a, call, buf)
        buf = append(buf, ' ')
        let src_idx = try get(a.tkns, node.token).start
        let kw = try get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = append(buf, ' ')
        let ident = try get(a.extras, data.x+1)
        buf = try to_string(a, ident, buf)
        buf = append(buf, ' ')
        let block = try get(a.extras, data.x+2)
        buf = try to_string(a, block, buf)

    case tag.any_type, tag.u8_type, tag.u16_type, tag.u32_type, tag.u64_type,
         tag.i8_type, tag.i16_type, tag.i32_type, tag.i64_type,
         tag.int_type, tag.f32_type, tag.f64_type, tag.float_type,
         tag.char_type, tag.string_type, tag.bool_type,
         tag.error_type:
        let src_idx = try get(a.tkns, node.token).start
        let kw = try get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)

    case tag.array_type:
        buf = append(buf, '[')
        buf = append(buf, ']')
        buf = try to_string(a, data.x, buf)

    case tag.column_type:
        buf = append(buf, '{')
        buf = append(buf, '}')
        buf = try to_string(a, data.x, buf)

    case tag.optional_type:
        let src_idx = try get(a.tkns, node.token).start
        let op = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, op)
        buf = try to_string(a, data.x, buf)
        
    case tag.mutable_type:
        let src_idx = try get(a.tkns, node.token).start
        let op = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, op)
        buf = append(buf, '<')
        buf = try to_string(a, data.x, buf)
        buf = append(buf, '>')

    case tag.pointer_type:
        buf = append(buf, '*')
        buf = try to_string(a, data.x, buf)

    case tag.return_stmt:
        let src_idx = try get(a.tkns, node.token).start
        let kw = try get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        if data.x != NULL_IDX {
            buf = append(buf, ' ')
            for i = data.x; i < data.y; i++ {
                let idx = try get(a.extras, i)
                buf = try to_string(a, idx, buf)
                if i != data.y-1 {
                    buf = append(buf,',')
                }
            }
        }

    case tag.break_stmt, tag.next_stmt:
        let src_idx = try get(a.tkns, node.token).start
        let kw = try get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)

    case _: raise unexpected_tag
    }
    return buf
}

fn get_variable_token(src []byte, idx source_index)! []byte {
    var l = lexer.new(src, u32(idx))
    l, let tkn = lexer.next_tkn(l)
    return try slice(src, tkn.start, tkn.end+1)
}

fn get_fixed_token(src []byte, idx source_index, t tag)! []byte {
    let size = match t {
        case tag.struct_def, tag.struct_gen_def, tag.return_stmt, tag.string_type: 6
        case tag.union_def, tag.break_stmt,
             tag.catch_expr, tag.raise_stmt,
             tag.defer_stmt, tag.match_stmt,
             tag.float_type, tag.error_type,
             tag.error_def: 5
        case tag.enum_def, tag.type_def, tag.next_stmt,
             tag.case_stmt, tag.char_type, tag.bool_type: 4
        case tag.pub, tag.let_decl, tag.var_decl,
             tag.library, tag.use_def,
             tag.for_infinite, tag.for_bool,
             tag.for_classic, tag.for_range,
             tag.try_expr, tag.mutable_type,
             tag.any_type, tag.u16_type, tag.u32_type, tag.u64_type,
             tag.i16_type, tag.i32_type, tag.i64_type,
             tag.int_type, tag.f32_type, tag.f64_type: 3
        case tag.if_stmt, tag.incr_decr,
             tag.null_coalesce, tag.u8_type, tag.i8_type: 2
        case tag.fn_def, tag.fn_err_def, tag.fn_gen_def, tag.fn_gen_err_def,
             tag.lor, tag.land, tag.andnot,
             tag.lsh, tag.rsh,
             tag.lte, tag.gte,
             tag.eq, tag.neq: 2
        case _: 1
    }
    let i = i64(idx)
    return try slice(src, i, i+size)
}

// optionally adds the 'pub' keyword to buf should be called
// when at a token that could have 'pub' BEFORE it e.g. 'fn'
fn add_pub(a *ast, idx index, buf []byte)! []byte  {
    let node = try get(a.nodes, idx)
    if node.token == 0 || node.token == NULL_TKN {
        return buf
    }
    var buf = buf

    // we assume parser handles invalid 'pub'
    // keywords and dont add them to a.nodes list
    let prev_tkn = try get(a.tkns, node.token-1)
    if prev_tkn.tag == lexer.tag.PUB {
        let src_idx = try get(a.tkns, node.token).start
        let kw = try get_fixed_token(a.src, src_idx-4, tag.pub)
        buf = append(buf, kw)
        buf = append(buf, ' ')
    }
    return buf
}
