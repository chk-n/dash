// contains the code to represent dash source as an AST
// and helper functions such as converting AST to string
lib ast

use "dash/lexer"

pub let NULL_DATA = data{x: 0, y: 0}

// TODO: replace with column list
pub struct ast {
    src    []byte
    tkns   []token
    nodes  []node
    errs   []error
    extras []index
}

// index used to access nodes in the AST e.g. ast.nodes
pub type index u32
// index used to access lexed tokens e.g ast.tkns
pub type token_index u32
// index used to access bytes in raw source e.g. ast.src
pub type source_index u32 

pub struct token {
    tag   lexer.tag
    start source_index
}

// represents AST node, used for all
// statements and expressions
pub struct node {
    tag   tag
    token token_index
    data  data
}

// data represents two indices
// that can either point to nodes
// e.g. in the case of infix operations
// or to a range of nodes in extra
// array. If it points to nodes in
// extra array then the range is
// inclusive i.e. y points to valid
// node in nodes array
pub struct data {
    // can also refer to lhs
    x index
    // can als orefer to rhs
    y index
}

pub enum tag {
    library
    lib_stmts
    use_def
    type_def
    struct_def
    struct_fields
    enum_def
    enum_fields
    union_def
    union_types
    attribute
    fn_def
    fn_err_def
    fn_arg_list
    fn_ret_list
    block_stmt
    assignment
    decl_list
    let_decl
    var_decl
    if_stmt
    for_infinite
    for_bool
    for_classic
    for_classic_cond
    for_range
    for_range_cond
    for_range2_cond
    return_stmt
    break_stmt
    next_stmt
    raise_stmt
    defer_stmt
    match_stmt
    match_block
    case_stmt
    case_block_stmt

    dot
    call
    expr_list
    index
    slice
    slice_idxs
    ident
    int
    float
    string
    bool
    char
    struct_lit
    anon_struct_lit
    array_lit
    null_unwrap
    address_of
    value_of
    // number ops
    negate_num
    add
    sub
    mul
    div
    mod
    incr_decr
    // binary ops
    negate_byte
    or
    xor
    and
    andnot
    lsh
    rsh
    lor
    land
    // boolean ops
    negate_bool
    eq
    neq
    gt
    gte
    lt
    lte
    // optional ops
    null_coalesce
    
    try_expr
    catch_expr

    type_lit
    array_type
    column_type
    optional_type
    mutable_type
}

pub fn literal_to_tag(t lexer.tag)! tag {
    return match t {
        case lexer.tag.IDENT: tag.ident
        case lexer.tag.INT:   tag.int
        case lexer.tag.FLOAT: tag.float
        case lexer.tag.STRING: tag.string
        case lexer.tag.BOOL: tag.bool
        case lexer.tag.CHAR: tag.char
        case lexer.tag.U8_TYPE, lexer.tag.U16_TYPE, lexer.tag.U32_TYPE, lexer.tag.U64_TYPE,
             lexer.tag.I8_TYPE, lexer.tag.I16_TYPE, lexer.tag.I32_TYPE, lexer.tag.I64_TYPE,
             lexer.tag.INT_TYPE, lexer.tag.FLOAT_TYPE,
             lexer.tag.F32_TYPE, lexer.tag.F64_TYPE,
             lexer.tag.BYTE_TYPE, lexer.tag.CHAR_TYPE,
             lexer.tag.STRING_TYPE, lexer.tag.BOOL_TYPE, lexer.tag.ERROR:
            tag.type_lit
        case _:
            raise unexpected_tag
    }
}

pub fn prefix_to_tag(t lexer.tag)! tag {
    return match t {
        case lexer.tag.SUB: tag.negate_num
        case lexer.tag.LNOT: tag.negate_bool
        case lexer.tag.NOT: tag.negate_byte
        case lexer.tag.QMARK: tag.null_unwrap
        case lexer.tag.AND: tag.address_of
        case lexer.tag.MUL: tag.value_of
        case _: raise unexpected_tag
    }
}

pub fn infix_to_tag(t lexer.tag)! tag {
    return match t {
        case lexer.tag.ADD: tag.add
        case lexer.tag.SUB: tag.sub
        case lexer.tag.MUL: tag.mul
        case lexer.tag.DIV: tag.div
        case lexer.tag.MOD: tag.mod
        case lexer.tag.OR: tag.or
        case lexer.tag.LOR: tag.lor
        case lexer.tag.LAND: tag.land
        case lexer.tag.XOR: tag.xor
        case lexer.tag.AND: tag.and
        case lexer.tag.ANDNOT: tag.andnot
        case lexer.tag.LSH: tag.lsh
        case lexer.tag.RSH: tag.rsh
        case lexer.tag.LT:  tag.lt
        case lexer.tag.GT:  tag.gt
        case lexer.tag.GTE: tag.gte
        case lexer.tag.LTE: tag.lte
        case lexer.tag.EQ:  tag.eq
        case lexer.tag.NEQ: tag.neq
        case lexer.tag.DOT: tag.dot
        case lexer.tag.ASSGN: tag.assignment
        case lexer.tag.QQMARK: tag.null_coalesce
        case _: raise unexpected_tag
    }
}

pub fn decl_to_tag(t lexer.tag) tag {
    return match t {
        case lexer.tag.LET: tag.let_decl
        case lexer.tag.VAR: tag.var_decl
        case _: raise unexpected_tag
    }
}

pub fn keyword_to_tag(t lexer.tag) tag {
    return match t {
        case lexer.tag.BREAK: tag.break_stmt
        case lexer.tag.NEXT: tag.next_stmt
        case _: raise unexpected_tag
    }
}

pub fn to_string(a ast, idx index, buf []byte)! []byte {
    if idx == -1 {
        return []
    }

    var buf = buf
    let node = a.nodes[idx]
    let data = node.data
    match node.tag {
    case tag.library, tag.type_def,
         tag.struct_def, tag.enum_def,
         tag.union_def:
        let src_idx = a.tkns[node.token].start
        let kw = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = append(buf, ' ')
        buf = to_string(a, data.x, buf)
        buf = append(buf, ' ')
        buf = to_string(a, data.y, buf)

    case tag.lib_stmts:
        for i = data.x; i <= data.y; i++ {
            let idx = a.extras[i]
            buf = to_string(a, idx, buf)
            if i != data.y {
                buf = append(buf, ' ')
            }
        }

    case tag.use_def:
        // TODO: once we can parse import alias then
        // data.x will contain idx of that node
        let src_idx = a.tkns[node.token].start
        let kw = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        if data.x != -1 {
            buf = append(buf, ' ')
            buf = to_string(a, data.x, buf)
        }
        buf = append(buf, ' ')
        buf = to_string(a, data.y, buf)

    case tag.attribute:
        let src_idx = a.tkns[node.token].start
        let kw = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = to_string(a, data.x, buf)
        if data.y != -1 {
            buf = append(buf, '(')
            buf = to_string(a, data.y, buf)
            buf = append(buf, ')')
        }
    

    case tag.struct_fields:
        buf = append(buf, '{')
        for i = data.x; i <= data.y; i = i+2 {
            let idx = a.extras[i]
            buf = to_string(a, idx, buf)
            buf = append(buf,' ')
            let idx = a.extras[i+1]
            buf = to_string(a, idx, buf)
            if i != data.y-1 {
                buf = append(buf,' ')
            }
        }
        buf = append(buf, '}')
        
    case tag.enum_fields, tag.union_types,
         tag.block_stmt:
        buf = append(buf, '{')
        for i = data.x; i <= data.y; i++ {
            let idx = a.extras[i]
            buf = to_string(a, idx, buf)
            if i != data.y {
                buf = append(buf,' ')
            }
        }
        buf = append(buf, '}')
    
    case tag.fn_def, tag.fn_err_def:
        let src_idx = a.tkns[node.token].start
        let kw = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = append(buf, ' ')
        let ident = a.extras[data.x]
        buf = to_string(a, ident, buf)
        
        buf = append(buf, '(')
        let args = a.extras[data.x+1]
        if args != -1 {
            buf = to_string(a, args, buf)
        }
        buf = append(buf, ')')

        if node.tag == tag.fn_err_def {
            buf = append(buf, '!')
        }
        
        let rets = a.extras[data.x+2]
        if rets != -1 {
            buf = append(buf, ' ')
            buf = to_string(a, rets, buf)
        }
        
        let body = a.extras[data.x+3]
        if body != -1 {
            buf = append(buf, ' ')
            buf = to_string(a, body, buf)
        }
        
    case tag.fn_arg_list:
        for i = data.x; i <= data.y; i = i+2 {
            let ident = a.extras[i]
            buf = to_string(a, ident, buf)
            let typ = a.extras[i+1]
            if typ != -1 {              
                buf = append(buf, ' ')
                buf = to_string(a, typ, buf)
            }
            if i != data.y-1 {
                buf = append(buf,',')
            }
        }

    case tag.fn_ret_list:
        for i = data.x; i <= data.y; i++ {
            let idx = a.extras[i]
            buf = to_string(a, idx, buf)
            if i != data.y {
                buf = append(buf,',')
            }
        }
        
    case tag.assignment:
        buf = to_string(a, data.x, buf)
        buf = append(buf, ' ')
        buf = append(buf, '=')
        buf = append(buf, ' ')
        buf = to_string(a, data.y, buf)
        
    case tag.if_stmt:
        let src_idx = a.tkns[node.token].start
        let kw = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = append(buf, ' ')
        let n = (data.y - data.x)+1
        for i = data.x; i < data.y; i = i+2 {
            let idx = a.extras[i]
            buf = to_string(a, idx, buf)
            buf = append(buf, ' ')
            let idx = a.extras[i+1]
            buf = to_string(a, idx, buf)
            if n > 1 && i < data.y-2  {
                buf = append(buf, []byte(" else if "))
            }
        }
        if n%2 != 0 {
            buf = append(buf, []byte(" else "))
            let idx = a.extras[data.y]
            buf = to_string(a, idx, buf)
        }

    case tag.for_bool, tag.for_classic, tag.for_range:
        let src_idx = a.tkns[node.token].start
        let kw = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = append(buf, ' ')
        buf = to_string(a, data.x, buf)
        buf = append(buf, ' ')
        buf = to_string(a, data.y, buf)

    case tag.for_classic_cond:
        let assign = a.extras[data.x]
        if assign != -1 {
            buf = to_string(a, assign, buf)
            buf = append(buf, ';')
        }
        let cond = a.extras[data.x+1]
        if cond != -1 {
            buf = to_string(a, cond, buf)
            buf = append(buf, ';')
        }
        let incr = a.extras[data.x+2]
        if incr != -1 {
            buf = to_string(a, incr, buf)
        }
    case tag.match_stmt:
        let src_idx = a.tkns[node.token].start
        let kw = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = append(buf, ' ')
        buf = to_string(a, data.x, buf)
        buf = append(buf, ' ')
        buf = to_string(a, data.y, buf)

    case tag.match_block:
        buf = append(buf, '{')
        for i = data.x; i <= data.y; i++ {
            let idx = a.extras[i]
            buf = to_string(a, idx, buf)
            if i != data.y {
                buf = append(buf,' ')
            }
        }
        buf = append(buf, '}')

    case tag.case_stmt:
        let src_idx = a.tkns[node.token].start
        let kw = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = append(buf, ' ')
        buf = to_string(a, data.x, buf)
        buf = append(buf, ':')
        if data.y != -1 {
            buf = append(buf, ' ')
            buf = to_string(a, data.y, buf)
        }
    
    case tag.case_block_stmt:
        for i = data.x; i <= data.y; i++ {
            let idx = a.extras[i]
            buf = to_string(a, idx, buf)
            if i != data.y {
                buf = append(buf,' ')
            }
        }
        
    case tag.decl_list:
        for i = data.x; i <= data.y; i++ {
            let idx = a.extras[i]
            buf = to_string(a, idx, buf)
            if i != data.y {
                buf = append(buf,',')
            }
        }

    case tag.let_decl, tag.var_decl,
         tag.for_infinite,
         tag.try_expr, tag.raise_stmt,
         tag.defer_stmt:
        let src_idx = a.tkns[node.token].start
        let kw = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = append(buf, ' ')
        buf = to_string(a, data.x, buf)

    case tag.ident, tag.int, tag.float,
         tag.string, tag.bool, tag.char,
         tag.type_lit:
        let src_idx = a.tkns[node.token].start
        let lit = get_variable_token(a.src, src_idx)
        buf = append(buf, lit)

    case tag.struct_lit:
        buf = to_string(a, data.x, buf)
        buf = to_string(a, data.y, buf)
        
    case tag.anon_struct_lit:
        buf = append(buf, '{')
        for i = data.x; i <= data.y; i = i+2 {
            var ident_idx = a.extras[i]
            buf = to_string(a, ident_idx, buf)
            buf = append(buf, ':')
            var exp_idx = a.extras[i+1]
            buf = to_string(a, exp_idx, buf)
            if i != data.y-1 {
                buf = append(buf, ',')
            }
        }
        buf = append(buf, '}')

    case tag.array_lit:
        buf = append(buf, '[')
        for i = data.x; i <= data.y; i++ {
            var ident_idx = a.extras[i]
            buf = to_string(a, ident_idx, buf)
            if i != data.y {
                buf = append(buf, ',')
            }
        }
        buf = append(buf, ']')

    case tag.negate_num, tag.negate_bool,
        tag.negate_byte, tag.null_unwrap,
        tag.address_of, tag.value_of:
        let src_idx = a.tkns[node.token].start
        let op = a.src[src_idx]
        buf = append(buf, op)        
        buf = to_string(a, data.x, buf)

    case tag.add, tag.sub, tag.mul,
        tag.div, tag.mod, tag.or, tag.lor, tag.land,
        tag.xor, tag.and, tag.andnot, tag.lsh, tag.rsh,
        tag.lt, tag.gt, tag.lte, tag.gte, tag.eq, tag.neq,
        tag.null_coalesce:
        buf = append(buf, '(')

        buf = to_string(a, data.x, buf)

        buf = append(buf, ' ')
        let src_idx = a.tkns[node.token].start
        let op = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, op)
        buf = append(buf, ' ')

        buf = to_string(a, data.y, buf)
        buf = append(buf, ')')

    case tag.dot:
        buf = to_string(a, data.x, buf)
        let src_idx = a.tkns[node.token].start
        let op = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, op)
        buf = to_string(a, data.y, buf)

    case tag.call:
        buf = to_string(a, data.x, buf)   
        buf = append(buf, '(')
        if data.y != -1 {
            buf = to_string(a, data.y, buf)
        } 
        buf = append(buf, ')')

    case tag.expr_list:
        for i = data.x; i <= data.y; i++ {
            let idx = a.extras[i]
            buf = to_string(a, idx, buf)
            if i != data.y {
                buf = append(buf,',')
            }
        }

    case tag.index:
        buf = to_string(a, data.x, buf)   
        buf = append(buf, '[')
        buf = to_string(a, data.y, buf)
        buf = append(buf, ']')

    case tag.slice:
        buf = to_string(a, data.x, buf)
        buf = append(buf, '[')
        buf = to_string(a, data.y, buf)
        buf = append(buf, ']')

    case tag.slice_idxs:
        var idx = a.extras[data.x]
        if idx != -1 {
            buf = to_string(a, idx, buf)
        }
        buf = append(buf, ':')
        idx = a.extras[data.y]
        if idx != -1 {
            buf = to_string(a, idx, buf)
        }

    case tag.incr_decr:
        buf = to_string(a, data.x, buf)
        let src_idx = a.tkns[node.token].start
        let op = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, op)
        
    case tag.catch_expr:
        let call = a.extras[data.x]
        buf = to_string(a, call, buf)
        buf = append(buf, ' ')
        let src_idx = a.tkns[node.token].start
        let kw = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        buf = append(buf, ' ')
        let ident = a.extras[data.x+1]
        buf = to_string(a, ident, buf)
        buf = append(buf, ' ')
        let block = a.extras[data.x+2]
        buf = to_string(a, block, buf)

    case tag.array_type:
        buf = append(buf, '[')
        buf = append(buf, ']')
        buf = to_string(a, data.x, buf)

    case tag.column_type:
        buf = append(buf, '{')
        buf = append(buf, '}')
        buf = to_string(a, data.x, buf)

    case tag.optional_type:
        let src_idx = a.tkns[node.token].start
        let op = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, op)
        buf = to_string(a, data.x, buf)
        
    case tag.mutable_type:
        let src_idx = a.tkns[node.token].start
        let op = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, op)
        buf = append(buf, '<')
        buf = to_string(a, data.x, buf)
        buf = append(buf, '>')

    case tag.return_stmt:
        let src_idx = a.tkns[node.token].start
        let kw = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)
        if data.x != -1 {
            buf = append(buf, ' ')
            for i = data.x; i <= data.y; i++ {
                let idx = a.extras[i]
                buf = to_string(a, idx, buf)
                if i != data.y {
                    buf = append(buf,',')
                }
            }
        }

    case tag.break_stmt, tag.next_stmt:
        let src_idx = a.tkns[node.token].start
        let kw = get_fixed_token(a.src, src_idx, node.tag)
        buf = append(buf, kw)

    case _: raise unexpected_tag
    }
    return buf   
}

fn get_variable_token(src []byte, idx source_index) []byte {
    var l = lexer.new(src, i64(idx))
    l, let tkn = lexer.next_tkn(l)
    return src[tkn.start:tkn.end+1]
}

fn get_fixed_token(src []byte, idx source_index, t tag) []byte {
    let size = match t {
        case tag.struct_def, tag.return_stmt: 6
        case tag.union_def, tag.break_stmt,
             tag.catch_expr, tag.raise_stmt,
             tag.defer_stmt, tag.match_stmt: 5
        case tag.enum_def, tag.type_def, tag.next_stmt,
             tag.case_stmt: 4
        case tag.let_decl, tag.var_decl,
             tag.library, tag.use_def,
             tag.for_infinite, tag.for_bool,
             tag.for_classic, tag.for_range,
             tag.try_expr, tag.mutable_type: 3
        case tag.if_stmt, tag.incr_decr,
             tag.null_coalesce: 2
        case tag.fn_def, tag.fn_err_def,
             tag.lor, tag.land, tag.andnot, 
             tag.lsh, tag.rsh,
             tag.lte, tag.gte,
             tag.eq, tag.neq: 2
        case _: 1
    }
    let i = i64(idx)
    return src[i:i+size]
}
