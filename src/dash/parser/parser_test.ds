lib parser

use "dash/ast"

// BUG: highlight bug when comment removed
@test
fn test_parse_scalar_literals()! {
    try assert_parse_exp("1", "1")
    try assert_parse_exp("1_000", "1_000")
    try assert_parse_exp("1.0", "1.0")
    try assert_parse_exp("false", "false")
    // try assert_parse_exp(`"a\"b"`, `"a\"b"`) // TODO: this is lexer issue
    try assert_parse_exp(`"hello"`, `"hello"`)
    // TODO: add char literal
    // try assert_parse_exp(`'h'`, `'h'`) 

    try assert_parse_error("1_000_", [unexpected_token{i: 0}])
    try assert_parse_error(`", world`, [unexpected_token{i: 0}])
}

@test
fn test_parse_struct_literal()! {
    try assert_parse_exp("a{b: 2}", "a{b:2}")
    try assert_parse_exp("{a: 1}", "{a:1}")
    try assert_parse_exp("{a: 1, b: false}", "{a:1,b:false}")
    try assert_parse_exp("{a: {b: 2}, c: 4}", "{a:{b:2},c:4}")

    try assert_parse_error("{", [expected_identifier{i: 1}])
    try assert_parse_error("a{", [expected_identifier{i: 2}])
    try assert_parse_error("{a", [expected_colon{i: 2}])
    try assert_parse_error("{a:", [expected_expression{i: 3}])
    try assert_parse_error("{a: 1", [expected_brace{i: 4}])
    try assert_parse_error("{a: 1,", [expected_brace{i: 5}])
    try assert_parse_error("{a: 1 b", [expected_comma{i: 4}])
    try assert_parse_error("{a: 1, b", [expected_colon{i: 6}])
    try assert_parse_error("{a: 1, b:", [expected_expression{i: 7}])
    // try assert_parse_error("{}", [empty_struct{i: 0}])
    try assert_parse_error("{a:, b: 2}", [expected_expression{i: 3}])
    try assert_parse_error("{a: 1, b:}", [expected_expression{i: 7}]) 
}

@test
fn test_parse_array_literal()! {
    try assert_parse_exp("[]", "[]")
    try assert_parse_exp("[1]", "[1]")
    try assert_parse_exp("[a,]", "[a]")
    try assert_parse_exp("[1, b, call()]", "[1,b,call()]")
    try assert_parse_exp("[[1], [2,3]]", "[[1],[2,3]]")
    try assert_parse_exp("[[[[[1]]]]]", "[[[[[1]]]]]")
    
    try assert_parse_error("[", [expected_bracket{i: 1}])
    try assert_parse_error("[a", [expected_bracket{i: 2}])
    try assert_parse_error("[a,", [expected_bracket{i: 3}])
    try assert_parse_error("[a,1", [expected_bracket{i: 4}])
    try assert_parse_error("[a,1,", [expected_bracket{i: 5}])
    try assert_parse_error("[a,,]", [expected_expression{i: 3}])
    try assert_parse_error("[,1,]", [expected_expression{i: 1}])
}

@test
fn test_parse_identifiers()! {
    try assert_parse_exp("ab_", "ab_")
    try assert_parse_exp("__ab", "__ab")
    try assert_parse_exp("ab1", "ab1") 
}

@test
fn test_nested_literals()! {
    try assert_parse_exp("{a: [1, 2], b: {c: 3}}", "{a:[1,2],b:{c:3}}")
    try assert_parse_exp("[{a: 1}, {b: 2}]", "[{a:1},{b:2}]")
    try assert_parse_exp("{arr: [func(), call(x)]}", "{arr:[func(),call(x)]}")
    try assert_parse_exp("[[1, 2], [3, 4]]", "[[1,2],[3,4]]")
    
    try assert_parse_error("{a: [1, 2, b: 3}", [expected_comma{i: 9}])
}

@test
fn test_parse_prefix()! {
    try assert_parse_exp("-1", "-1")
    try assert_parse_exp("-a", "-a")
    try assert_parse_exp("!false", "!false")
    try assert_parse_exp("!a", "!a")
    try assert_parse_exp("~b", "~b")
    try assert_parse_exp("?o", "?o")
    try assert_parse_exp("&v", "&v")
    try assert_parse_exp("*p", "*p")
    try assert_parse_exp("(((((((((1)))))))))", "1")

    try assert_parse_error("(", [expected_expression{i: 1}])
    try assert_parse_error("()", [expected_expression{i: 1}])
    try assert_parse_error("(()", [expected_expression{i: 2}])
    try assert_parse_error("(1", [expected_parenthesis{i: 2}])
    try assert_parse_error("(1+", [expected_expression{i: 3}])
    try assert_parse_error("(1+)", [expected_expression{i: 3}])
}

@test
fn test_parse_infix()! {
    // arithemtic infix 
    try assert_parse_exp("1+1", "(1 + 1)")
    try assert_parse_exp("1-1", "(1 - 1)")
    try assert_parse_exp("1*1", "(1 * 1)")
    try assert_parse_exp("1/1", "(1 / 1)")
    try assert_parse_exp("1%1", "(1 % 1)")
    // binary infix
    try assert_parse_exp("1|1", "(1 | 1)")
    try assert_parse_exp("1&1", "(1 & 1)")
    try assert_parse_exp("1||1", "(1 || 1)")
    try assert_parse_exp("1&&1", "(1 && 1)")
    try assert_parse_exp("1^1", "(1 ^ 1)")
    try assert_parse_exp("1&1", "(1 & 1)")
    try assert_parse_exp("1&^1", "(1 &^ 1)")
    try assert_parse_exp("1<<1", "(1 << 1)")
    try assert_parse_exp("1>>1", "(1 >> 1)")
    // boolean infix
    try assert_parse_exp("a==b", "(a == b)")
    try assert_parse_exp("a!=b", "(a != b)")
    try assert_parse_exp("a||b", "(a || b)")
    try assert_parse_exp("a&&b", "(a && b)")
    try assert_parse_exp("a>b", "(a > b)")
    try assert_parse_exp("a>=b", "(a >= b)")
    try assert_parse_exp("a<b", "(a < b)")
    try assert_parse_exp("a<=b", "(a <= b)")
    
    try assert_parse_error("1 + 1_", [unexpected_token{i: 2}])
    try assert_parse_error("1+", [expected_expression{i: 2}])
}

@test
fn test_call_expression()! {
    try assert_parse_exp("a()", "a()")
    try assert_parse_exp("a(1)", "a(1)")
    try assert_parse_exp("a(b)", "a(b)")
    try assert_parse_exp("a(1,b,1.0)", "a(1,b,1.0)")
    try assert_parse_exp("a(b,)", "a(b)")
    try assert_parse_exp("func({a: 1, b: 2})", "func({a:1,b:2})")
    try assert_parse_exp("func([1, 2, 3])", "func([1,2,3])")
    try assert_parse_exp("func(a.b, c[0], d())", "func(a.b,c[0],d())")
    try assert_parse_exp("func(x, {y: z})", "func(x,{y:z})")
    try assert_parse_exp("outer(inner(a, b), c)", "outer(inner(a,b),c)")

    try assert_parse_error("a(", [expected_parenthesis{i: 2}])
    try assert_parse_error("a(b", [expected_parenthesis{i: 3}])
    try assert_parse_error("a(b,", [expected_parenthesis{i: 4}])
    try assert_parse_error("a(b,,", [expected_expression{i: 4}])
    try assert_parse_error("a(b,c,", [expected_parenthesis{i: 6}])
    try assert_parse_error("a(b,,)", [expected_expression{i: 4}])
    try assert_parse_error("a(,)", [expected_expression{i: 2}])
 }

@test
fn test_index_expression()! {
    try assert_parse_exp("a[0]", "a[0]")
    try assert_parse_exp("a[b]", "a[b]")
    try assert_parse_exp("a[1]()", "a[1]()")
    
    try assert_parse_exp("a[b:4]", "a[b:4]")
    try assert_parse_exp("a[:4]", "a[:4]")
    try assert_parse_exp("a[1:]", "a[1:]")
    try assert_parse_exp("a[1:1][0][b]", "a[1:1][0][b]")
    try assert_parse_exp("a[:1][0]", "a[:1][0]")
    try assert_parse_exp("a[b():c()]", "a[b():c()]")

    try assert_parse_error("a[", [expected_expression{i: 2}])
    try assert_parse_error("a[0", [expected_bracket{i: 3}])
    try assert_parse_error("a[0:", [expected_expression{i: 4}])
    try assert_parse_error("a[:", [expected_expression{i: 3}])
    try assert_parse_error("a[1:2:3]", [expected_bracket{i: 5}])
    try assert_parse_error("a[::1]", [expected_expression{i: 3}])
    // try assert_parse_error("a[:]", "")
}

@test
fn test_dot_expression()! {
    try assert_parse_exp("a.b", "a.b")
    try assert_parse_exp("a.b.c.d.e.f", "a.b.c.d.e.f")
    try assert_parse_exp("a.b().c", "a.b().c")
    try assert_parse_exp("a.b[0].c", "a.b[0].c")
    
    try assert_parse_error("a.", [expected_expression{i: 2}])
    try assert_parse_error("a.b.", [expected_expression{i: 4}])
    // try assert_parse_error("a[:4].b", "")
}


@test
fn test_operator_precedence()! { 
    try assert_parse_exp("1+1/1", "(1 + (1 / 1))")
    try assert_parse_exp("1*1%1", "(1 * (1 % 1))")
    // try assert_parse_exp("1--1/1", "(1 - (-1 / 1))")
    try assert_parse_exp("b | ~a", "(b | ~a)")
    try assert_parse_exp("1/1/1", "((1 / 1) / 1)")
    try assert_parse_exp("b | ~a & b", "(b | (~a & b))")
    try assert_parse_exp("(1)+1", "(1 + 1)")
    try assert_parse_exp("(1-1)/1", "((1 - 1) / 1)")
    try assert_parse_exp("(1+2)*(3+4)", "((1 + 2) * (3 + 4))")
    try assert_parse_exp("a >= b || b < c", "((a >= b) || (b < c))")
    try assert_parse_exp("a != (b && b) == c", "((a != (b && b)) == c)")
    try assert_parse_exp("1 * a((1+2), 2)", "(1 * a((1 + 2),2))")

    try assert_parse_exp("*obj.field", "*obj.field")
    try assert_parse_exp("?opt.value", "?opt.value")
    try assert_parse_exp("~bits[i]", "~bits[i]")

    try assert_parse_exp("a.b+1/1", "(a.b + (1 / 1))")
    try assert_parse_exp("a[0]%1", "(a[0] % 1)")
    try assert_parse_exp("a[0:2]%1", "(a[0:2] % 1)")
    try assert_parse_exp("a()*1", "(a() * 1)")
}

@test
fn test_parse_library()! {
    try assert_canonical("lib abc ")

    try assert_error("lib", [expected_identifier{i: 1}])
    try assert_error("lib 1", [expected_identifier{i: 1}])
}

@test
fn test_parse_assignment()! {
    try assert_canonical("lib a let x = 1")
    try assert_canonical("lib a var x = test()")
    try assert_canonical("lib a x = abc{a:b}")
    try assert_canonical("lib a x = 2.2")
    try assert_canonical("lib a let x,var y,z = 1,2,3")
    try assert_canonical("lib a w,x,y,z = 1,2,3")
    try assert_canonical("lib a a,b,let x = 1,2,3")
    try assert_canonical("lib a let x = 1 var y = 2")
    try assert_parse("lib a let a = 1,", "lib a let a = 1")
    // try assert_canonical("lib a pub let x = 1")

    try assert_error("lib a x", [expected_assign_or_comma{i: 3}])
    try assert_error("lib a w,", [expected_assign_or_comma{i: 4}])
    try assert_error("lib a let", [expected_identifier{i: 3}])
    try assert_error("lib a var = 1", [expected_identifier{i: 3}])
    try assert_error("lib a let a", [expected_assign_or_comma{i: 4}])
    try assert_error("lib a let a,", [expected_assign_or_comma{i: 5}])
    try assert_error("lib a let a =", [expected_expression{i: 5}])
    try assert_error("lib a let x = 1,,", [expected_expression{i: 7}])
    try assert_error("lib a let x, var = 1", [expected_identifier{i: 6}])
}

@test
fn test_parse_enum_statement()! {
    try assert_canonical("lib a enum b {x}")
    try assert_canonical("lib a enum b {x y z}")
    // try assert_canonical("lib a pub enum b {x}")

    try assert_error("lib a enum", [expected_identifier{i: 3}])
    try assert_error("lib a enum b", [expected_brace{i: 4}] )
    try assert_error("lib a enum b {", [expected_identifier{i: 5}])
    try assert_error("lib a enum b { x", [expected_brace{i: 6}])
    try assert_error("lib a enum b { x y", [expected_brace{i: 7}])
    try assert_error("lib a enum b {}", [expected_identifier{i:5}])
}

// ------- //
// Helpers //
// ------- //

// assert_parse asserts that input is parsed
// and converted to string to match want
fn assert_parse(input, want string)! {
    let a = try parse([]byte(input), mode.lib)

    let idx = ast.index(len(a.nodes)-1)
    let buf = make([]byte, 0, len(want))
    let got = try ast.to_string(a, idx, buf)
    if want != string(got) {
        println(string(got))
    }
    try assert(want == string(got), "expected AST to match")    
}

// assert_canonical asserts that input is equal
// to the string representation of AST produced
// by parser
fn assert_canonical(input string)! {
    let a1 = try parse([]byte(input), mode.lib)

    let idx = ast.index(len(a1.nodes)-1)
    let buf = make([]byte, 0, len(input))
    let got1 = try ast.to_string(a1, idx, buf)
    if input != string(got1) {
        println(string(got1))
    }
    try assert(input == string(got1), "expected AST to match")

    // re-parse 
    let a2 = try parse(got1, mode.lib)
    let idx = ast.index(len(a2.nodes)-1)
    let buf = make([]byte, 0, len(input))
    let got2 = try ast.to_string(a2, idx, buf)
    if input != string(got2) {
        println(string(got2))
    }

    try assert(string(got1) == string(got2), "expected re-parsed AST to match AST")
}

fn assert_parse_exp(input, want string)! {
    let a = try parse([]byte(input), mode.exp)

    let idx = ast.index(len(a.nodes)-1)
    let buf = make([]byte, 0, len(want))
    let got = try ast.to_string(a, idx, buf)
    if want != string(got) {
        println(string(got))
    }
    try assert(want == string(got), "expected AST to match")    
}

error expected_error

error error_len_mismatch {
    got_len  i64
    want_len i64
}

error error_mismatch {
    got  error
    want error
}

fn assert_error(input string, want []error)! {
    let a = try parse([]byte(input), mode.lib)

    if len(a.errs) == 0 {
        raise expected_error
    }
    if len(a.errs) != len(want) {
        raise error_len_mismatch{got_len: len(a.errs), want_len: len(want)}
    }
    for i = 0; i < len(want); i++ {
        if want[i] != a.errs[i] {
            raise error_mismatch{got: a.errs[i], want: want[i]}
        }
    }
}

fn assert_parse_error(input string, want []error)! {
    let a = try parse([]byte(input), mode.exp)

    if len(a.errs) == 0 {
        raise expected_error
    }
    if len(a.errs) != len(want) {
        raise error_len_mismatch{got_len: len(a.errs), want_len: len(want)}
    }
    for i = 0; i < len(want); i++ {
        if want[i] != a.errs[i] {
            raise error_mismatch{got: a.errs[i], want: want[i]}
        }
    }
}
