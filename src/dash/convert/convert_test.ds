lib convert


@test
fn test_to_u8_array()! {
   let arr = []u8([0,0,0,0,0,0,0,0])

    for i = 7; i >= 0; i-- {
        let want = try put(arr, i, 1)
        let shift = 8 * (7 - i) 
        let x = u64(1 << shift)
        let got = try to_u8_array(x)
        try assert(len(want) == len(got), "expected lengths to match")

        for idx = 0; idx < len(got); idx++ {
            let e1 = try get(want, idx)
            let e2 = try get(got, idx)
            try assert(e1 == e2, "expected array elements to match")
        }
    }
}
