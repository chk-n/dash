@test
fn test_to_string_u64()! {
    let cases = []u64([0, 1, 99, 100, 9999, 10000, 999999, 1000000, ~u64(0)])
    let expected = ["0", "1", "99", "100", "9999", "10000", "999999", "1000000", "18446744073709551615"]

    for i = 0; i < len(cases); i++ {
        let x = try get(cases, i)
        let want = try get(expected, i)
        let got = try to_string(x)
        try assert(got == want, "expected to_string_u64 result to match")
    }
}

